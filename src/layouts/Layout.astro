---
import "../styles/global.css";

interface Props {
    title: string;
    description: string;
    image?: string;
}

const { title, description, image = "/og-image.png" } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>

        <link rel="canonical" href={canonicalURL} />

        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:image" content={imageURL} />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={imageURL} />

        <!-- Google Analytics (GA4) - Load on interaction or idle -->
        <script is:inline>
            (function () {
                var loaded = false;
                function loadGA4() {
                    if (loaded) return;
                    loaded = true;
                    var script = document.createElement("script");
                    script.async = true;
                    script.src =
                        "https://www.googletagmanager.com/gtag/js?id=G-8YVT8WPSLF";
                    document.head.appendChild(script);
                    window.dataLayer = window.dataLayer || [];
                    function gtag() {
                        dataLayer.push(arguments);
                    }
                    gtag("js", new Date());
                    gtag("config", "G-8YVT8WPSLF");
                }
                ["scroll", "pointerdown", "keydown", "touchstart"].forEach(
                    function (evt) {
                        window.addEventListener(evt, loadGA4, {
                            once: true,
                            passive: true,
                        });
                    },
                );
                if ("requestIdleCallback" in window) {
                    requestIdleCallback(loadGA4, { timeout: 5000 });
                } else {
                    setTimeout(loadGA4, 5000);
                }
            })();
        </script>
    </head>
    <body class="min-h-screen bg-gray-50 text-gray-900">
        <header class="bg-white shadow-sm sticky top-0 z-50">
            <nav
                class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between"
            >
                <a href="/" class="text-xl font-bold text-blue-600">ToolsVibe</a
                >
                <ul class="flex gap-6 text-sm font-medium">
                    <li><a href="/" class="hover:text-blue-600">Home</a></li>
                    <li>
                        <a href="/tools" class="hover:text-blue-600">Tools</a>
                    </li>
                    <li>
                        <a href="/blog" class="hover:text-blue-600">Blog</a>
                    </li>
                </ul>
            </nav>
        </header>

        <main class="max-w-6xl mx-auto px-4 py-8">
            <slot />
        </main>

        <footer class="bg-white border-t mt-16">
            <div class="max-w-6xl mx-auto px-4 py-6">
                <div
                    class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-gray-600 mb-4"
                >
                    <a href="/about" class="hover:text-blue-600">About</a>
                    <a href="/contact" class="hover:text-blue-600">Contact</a>
                    <a href="/privacy" class="hover:text-blue-600"
                        >Privacy Policy</a
                    >
                    <a href="/terms" class="hover:text-blue-600"
                        >Terms of Service</a
                    >
                </div>
                <div class="text-center text-sm text-gray-500">
                    © 2026 ToolsVibe. All rights reserved.
                </div>
            </div>
        </footer>
    </body>
</html>
