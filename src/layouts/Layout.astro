---
import "../styles/global.css";

interface Props {
    title: string;
    description: string;
    image?: string;
}

const { title, description, image = "/og-image.png" } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <link
            rel="icon"
            type="image/png"
            href="/favicon-96x96.png"
            sizes="96x96"
        />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="shortcut icon" href="/favicon.ico" />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/apple-touch-icon.png"
        />
        <link rel="manifest" href="/site.webmanifest" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>

        <link rel="canonical" href={canonicalURL} />

        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:image" content={imageURL} />
        <meta property="og:site_name" content="ToolsVibe" />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:url" content={canonicalURL} />
        <meta name="twitter:image" content={imageURL} />

        <!-- Google Analytics (GA4) - Runs in Web Worker via Partytown -->
        <script type="text/partytown">
            window.dataLayer = window.dataLayer || [];
            function gtag() {
                dataLayer.push(arguments);
            }
            gtag("js", new Date());
            gtag("config", "G-8YVT8WPSLF");
        </script>
        <script
            type="text/partytown"
            src="https://www.googletagmanager.com/gtag/js?id=G-8YVT8WPSLF"
        ></script>
    </head>
    <body class="min-h-screen bg-gray-50 text-gray-900">
        <header class="bg-white shadow-sm sticky top-0 z-50">
            <nav class="max-w-6xl mx-auto px-4 py-4">
                <div class="flex items-center justify-between">
                    <a
                        href="/"
                        class="flex items-center gap-2 text-xl font-bold text-blue-600"
                    >
                        <img
                            src="/favicon.svg"
                            alt="ToolsVibe logo"
                            class="w-8 h-8"
                        />
                        <span>ToolsVibe</span>
                    </a>

                    <!-- Desktop Menu -->
                    <ul
                        class="hidden md:flex gap-6 text-sm font-medium list-none"
                    >
                        <li>
                            <a
                                href="/"
                                class:list={[
                                    "hover:text-blue-600",
                                    Astro.url.pathname === "/"
                                        ? "text-blue-600 font-bold"
                                        : "text-gray-700",
                                ]}
                            >
                                Home
                            </a>
                        </li>
                        <li>
                            <a
                                href="/tools/"
                                class:list={[
                                    "hover:text-blue-600",
                                    Astro.url.pathname.startsWith("/tools")
                                        ? "text-blue-600 font-bold"
                                        : "text-gray-700",
                                ]}
                            >
                                Tools
                            </a>
                        </li>
                        <li>
                            <a
                                href="/blog/"
                                class:list={[
                                    "hover:text-blue-600",
                                    Astro.url.pathname.startsWith("/blog")
                                        ? "text-blue-600 font-bold"
                                        : "text-gray-700",
                                ]}
                            >
                                Blog
                            </a>
                        </li>
                        <li>
                            <a
                                href="/about/"
                                class:list={[
                                    "hover:text-blue-600",
                                    Astro.url.pathname.startsWith("/about")
                                        ? "text-blue-600 font-bold"
                                        : "text-gray-700",
                                ]}
                            >
                                About
                            </a>
                        </li>
                    </ul>

                    <!-- Mobile Hamburger Button -->
                    <button
                        id="menu-toggle"
                        class="md:hidden p-3 text-gray-700 hover:text-blue-600"
                        aria-label="Toggle menu"
                        aria-expanded="false"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="24"
                            height="24"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <line x1="3" y1="6" x2="21" y2="6"></line>
                            <line x1="3" y1="12" x2="21" y2="12"></line>
                            <line x1="3" y1="18" x2="21" y2="18"></line>
                        </svg>
                    </button>
                </div>

                <!-- Mobile Menu (hidden by default) -->
                <ul
                    id="mobile-menu"
                    class="hidden md:hidden mt-4 space-y-1 text-sm font-medium list-none border-t border-gray-200 pt-3"
                >
                    <li>
                        <a
                            href="/"
                            class:list={[
                                "block py-2 px-3 rounded hover:bg-blue-50 hover:text-blue-600",
                                Astro.url.pathname === "/"
                                    ? "bg-blue-50 text-blue-600 font-bold"
                                    : "",
                            ]}>Home</a
                        >
                    </li>
                    <li>
                        <a
                            href="/tools/"
                            class:list={[
                                "block py-2 px-3 rounded hover:bg-blue-50 hover:text-blue-600",
                                Astro.url.pathname.startsWith("/tools")
                                    ? "bg-blue-50 text-blue-600 font-bold"
                                    : "",
                            ]}>Tools</a
                        >
                    </li>
                    <li>
                        <a
                            href="/blog/"
                            class:list={[
                                "block py-2 px-3 rounded hover:bg-blue-50 hover:text-blue-600",
                                Astro.url.pathname.startsWith("/blog")
                                    ? "bg-blue-50 text-blue-600 font-bold"
                                    : "",
                            ]}>Blog</a
                        >
                    </li>
                    <li>
                        <a
                            href="/about/"
                            class:list={[
                                "block py-2 px-3 rounded hover:bg-blue-50 hover:text-blue-600",
                                Astro.url.pathname.startsWith("/about")
                                    ? "bg-blue-50 text-blue-600 font-bold"
                                    : "",
                            ]}>About</a
                        >
                    </li>
                </ul>
            </nav>
        </header>

        <script is:inline>
            document.addEventListener("DOMContentLoaded", function () {
                var toggle = document.getElementById("menu-toggle");
                var menu = document.getElementById("mobile-menu");
                if (toggle && menu) {
                    toggle.addEventListener("click", function () {
                        menu.classList.toggle("hidden");
                        var expanded =
                            toggle.getAttribute("aria-expanded") === "true";
                        toggle.setAttribute("aria-expanded", !expanded);
                    });
                }
            });
        </script>

        <main class="max-w-6xl mx-auto px-4 py-8">
            <slot />
        </main>

        <footer class="bg-white border-t mt-16">
            <div class="max-w-6xl mx-auto px-4 py-6">
                <div
                    class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-gray-600 mb-4"
                >
                    <a href="/about/" class="hover:text-blue-600">About</a>
                    <a href="/contact/" class="hover:text-blue-600">Contact</a>
                    <a href="/privacy/" class="hover:text-blue-600"
                        >Privacy Policy</a
                    >
                    <a href="/terms/" class="hover:text-blue-600"
                        >Terms of Service</a
                    >
                </div>
                <div class="text-center text-sm text-gray-500">
                    © 2026 ToolsVibe. All rights reserved.
                </div>
            </div>
        </footer>
    </body>
</html>
