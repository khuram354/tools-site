---
import "../styles/global.css";

interface Props {
    title: string;
    description: string;
    image?: string;
    // Use type="article" (plus dates) on blog posts.
    type?: "website" | "article";
    // Use noindex on pages that should stay out of search results.
    noindex?: boolean;
    // ISO dates, e.g. "2026-10-23". Only used when type="article".
    publishedTime?: string;
    modifiedTime?: string;
}

const {
    title,
    description,
    image = "/og-image.png",
    type = "website",
    noindex = false,
    publishedTime,
    modifiedTime,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);

// Site-wide entity data, output on the homepage only.
const isHome = Astro.url.pathname === "/";
const siteSchema = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "WebSite",
            "@id": new URL("/#website", Astro.site).href,
            url: new URL("/", Astro.site).href,
            name: "ToolsVibe",
            inLanguage: "en",
        },
        {
            "@type": "Organization",
            "@id": new URL("/#organization", Astro.site).href,
            name: "ToolsVibe",
            url: new URL("/", Astro.site).href,
            logo: new URL("/apple-touch-icon.png", Astro.site).href,
        },
    ],
};

// Footer links give every page a site-wide internal link to your key tools.
// using their real URLs. They are your best chance to rank, so link them.
const popularTools = [
    { name: "All Tools", href: "/tools/" },
    { name: "Word Counter", href: "/tools/word-counter/" },
    { name: "Image Compressor", href: "/tools/image-compressor/" },
    { name: "QR Code Generator", href: "/tools/qr-generator/" },
    { name: "EMI Calculator", href: "/tools/emi-calculator/" },
    { name: "Percentage Calculator", href: "/tools/percentage-calculator/" },
    { name: "Unit Converter", href: "/tools/unit-converter/" },
    { name: "Age Calculator", href: "/tools/age-calculator/" },
    {
        name: "Freelancer Tax Calculator",
        href: "/tools/freelancer-tax-calculator/",
    },
    { name: "Image Converter", href: "/tools/image-converter/" },
    { name: "Image Cropper", href: "/tools/image-cropper/" },
    { name: "Image Resizer", href: "/tools/image-resizer/" },
    { name: "Salary Tax Calculator", href: "/tools/salary-tax-calculator/" },
    { name: "Zakat Calculator", href: "/tools/zakat-calculator/" },
    { name: "JSON Formatter", href: "/tools/json-formatter/" },
    { name: "Password Generator", href: "/tools/password-generator/" },
];
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <link
            rel="icon"
            type="image/png"
            href="/favicon-96x96.png"
            sizes="96x96"
        />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="shortcut icon" href="/favicon.ico" />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/apple-touch-icon.png"
        />
        <link rel="manifest" href="/site.webmanifest" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <meta
            name="robots"
            content={noindex
                ? "noindex, follow"
                : "index, follow, max-image-preview:large"}
        />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>

        <link rel="canonical" href={canonicalURL} />

        <meta property="og:type" content={type} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:image" content={imageURL} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:locale" content="en_US" />
        <meta property="og:site_name" content="ToolsVibe" />
        {
            type === "article" && publishedTime && (
                <meta
                    property="article:published_time"
                    content={publishedTime}
                />
            )
        }
        {
            type === "article" && modifiedTime && (
                <meta property="article:modified_time" content={modifiedTime} />
            )
        }

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:url" content={canonicalURL} />
        <meta name="twitter:image" content={imageURL} />

        {
            isHome && (
                <script
                    type="application/ld+json"
                    set:html={JSON.stringify(siteSchema)}
                />
            )
        }

        <!-- Google Analytics (GA4) - Runs in Web Worker via Partytown -->
        <script type="text/partytown">
            window.dataLayer = window.dataLayer || [];
            function gtag() {
                dataLayer.push(arguments);
            }
            gtag("js", new Date());
            gtag("config", "G-8YVT8WPSLF");
        </script>
        <script
            type="text/partytown"
            src="https://www.googletagmanager.com/gtag/js?id=G-8YVT8WPSLF"
        ></script>
    </head>
    <body class="min-h-screen bg-gray-50 text-gray-900">
        <header class="bg-white shadow-sm sticky top-0 z-50">
            <nav class="max-w-6xl mx-auto px-4 py-4">
                <div class="flex items-center justify-between">
                    <a
                        href="/"
                        class="flex items-center gap-2 text-xl font-bold text-blue-600"
                    >
                        <img
                            src="/favicon.svg"
                            alt="ToolsVibe logo"
                            class="w-8 h-8"
                        />
                        <span>ToolsVibe</span>
                    </a>

                    <!-- Desktop Menu -->
                    <ul
                        class="hidden md:flex gap-6 text-sm font-medium list-none"
                    >
                        <li>
                            <a
                                href="/"
                                class:list={[
                                    "hover:text-blue-600",
                                    Astro.url.pathname === "/"
                                        ? "text-blue-600 font-bold"
                                        : "text-gray-700",
                                ]}
                            >
                                Home
                            </a>
                        </li>
                        <li>
                            <a
                                href="/tools/"
                                class:list={[
                                    "hover:text-blue-600",
                                    Astro.url.pathname.startsWith("/tools")
                                        ? "text-blue-600 font-bold"
                                        : "text-gray-700",
                                ]}
                            >
                                Tools
                            </a>
                        </li>
                        <li>
                            <a
                                href="/blog/"
                                class:list={[
                                    "hover:text-blue-600",
                                    Astro.url.pathname.startsWith("/blog")
                                        ? "text-blue-600 font-bold"
                                        : "text-gray-700",
                                ]}
                            >
                                Blog
                            </a>
                        </li>
                        <li>
                            <a
                                href="/about/"
                                class:list={[
                                    "hover:text-blue-600",
                                    Astro.url.pathname.startsWith("/about")
                                        ? "text-blue-600 font-bold"
                                        : "text-gray-700",
                                ]}
                            >
                                About
                            </a>
                        </li>
                    </ul>

                    <!-- Mobile Hamburger Button -->
                    <button
                        id="menu-toggle"
                        class="md:hidden p-3 text-gray-700 hover:text-blue-600"
                        aria-label="Toggle menu"
                        aria-expanded="false"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="24"
                            height="24"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <line x1="3" y1="6" x2="21" y2="6"></line>
                            <line x1="3" y1="12" x2="21" y2="12"></line>
                            <line x1="3" y1="18" x2="21" y2="18"></line>
                        </svg>
                    </button>
                </div>

                <!-- Mobile Menu (hidden by default) -->
                <ul
                    id="mobile-menu"
                    class="hidden md:hidden mt-4 space-y-1 text-sm font-medium list-none border-t border-gray-200 pt-3"
                >
                    <li>
                        <a
                            href="/"
                            class:list={[
                                "block py-2 px-3 rounded hover:bg-blue-50 hover:text-blue-600",
                                Astro.url.pathname === "/"
                                    ? "bg-blue-50 text-blue-600 font-bold"
                                    : "",
                            ]}>Home</a
                        >
                    </li>
                    <li>
                        <a
                            href="/tools/"
                            class:list={[
                                "block py-2 px-3 rounded hover:bg-blue-50 hover:text-blue-600",
                                Astro.url.pathname.startsWith("/tools")
                                    ? "bg-blue-50 text-blue-600 font-bold"
                                    : "",
                            ]}>Tools</a
                        >
                    </li>
                    <li>
                        <a
                            href="/blog/"
                            class:list={[
                                "block py-2 px-3 rounded hover:bg-blue-50 hover:text-blue-600",
                                Astro.url.pathname.startsWith("/blog")
                                    ? "bg-blue-50 text-blue-600 font-bold"
                                    : "",
                            ]}>Blog</a
                        >
                    </li>
                    <li>
                        <a
                            href="/about/"
                            class:list={[
                                "block py-2 px-3 rounded hover:bg-blue-50 hover:text-blue-600",
                                Astro.url.pathname.startsWith("/about")
                                    ? "bg-blue-50 text-blue-600 font-bold"
                                    : "",
                            ]}>About</a
                        >
                    </li>
                </ul>
            </nav>
        </header>

        <script is:inline>
            document.addEventListener("DOMContentLoaded", function () {
                var toggle = document.getElementById("menu-toggle");
                var menu = document.getElementById("mobile-menu");
                if (toggle && menu) {
                    toggle.addEventListener("click", function () {
                        menu.classList.toggle("hidden");
                        var expanded =
                            toggle.getAttribute("aria-expanded") === "true";
                        toggle.setAttribute("aria-expanded", !expanded);
                    });
                }
            });
        </script>

        <main class="max-w-6xl mx-auto px-4 py-8">
            <slot />
        </main>

        <footer class="bg-white border-t mt-16">
            <div class="max-w-6xl mx-auto px-4 py-6">
                <nav aria-label="Popular tools" class="mb-4">
                    <p
                        class="text-center text-xs font-semibold uppercase tracking-wide text-gray-500 mb-2"
                    >
                        Popular Tools
                    </p>
                    <div
                        class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-gray-600"
                    >
                        {
                            popularTools.map((tool) => (
                                <a href={tool.href} class="hover:text-blue-600">
                                    {tool.name}
                                </a>
                            ))
                        }
                    </div>
                </nav>
                <div
                    class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-gray-600 mb-4 pt-4 border-t border-gray-100"
                >
                    <a href="/about/" class="hover:text-blue-600">About</a>
                    <a href="/contact/" class="hover:text-blue-600">Contact</a>
                    <a href="/privacy/" class="hover:text-blue-600"
                        >Privacy Policy</a
                    >
                    <a href="/terms/" class="hover:text-blue-600"
                        >Terms of Service</a
                    >
                </div>
                <div class="text-center text-sm text-gray-500">
                    © 2026 ToolsVibe. All rights reserved.
                </div>
            </div>
        </footer>
    </body>
</html>
