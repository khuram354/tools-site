---
import Layout from "../layouts/Layout.astro";

const faqs = [
    {
        q: "Who runs ToolsVibe?",
        a: "ToolsVibe is an independent project built by Khuram Shahzad and a small team of contributors from Pakistan. It is not backed by any large corporation and relies on minimal, non-intrusive ads to keep the site running.",
    },
    {
        q: "Is ToolsVibe really free?",
        a: "Yes. Every tool on ToolsVibe is free to use with no hidden charges, no premium tiers, and no forced signups. We fund the site through minimal, non-intrusive advertising.",
    },
    {
        q: "How do you protect my privacy?",
        a: "All tools run entirely in your browser. Your text, files, and data never leave your device. We do not store, sell, or share any user data.",
    },
    {
        q: "Can I use ToolsVibe tools for commercial work?",
        a: "Yes. Our tools are free for personal and commercial use. Students, writers, developers, and businesses all use ToolsVibe regularly.",
    },
];
---

<Layout
    title="About — Free Online Tools by ToolsVibe"
    description="Learn about ToolsVibe, a free collection of fast, privacy-friendly online tools for writing, development, finance, and everyday tasks."
>
    <article class="max-w-3xl mx-auto">
        <header class="mb-10">
            <h1 class="text-3xl md:text-4xl font-bold mb-4">About ToolsVibe</h1>
            <p class="text-lg text-gray-600">
                A free collection of fast, privacy-friendly online tools — built
                for people who value their time and their data.
            </p>
        </header>

        <section class="space-y-6 text-gray-700 leading-relaxed">
            <p>
                ToolsVibe is a free collection of online tools built for speed,
                simplicity, and privacy. Every tool runs entirely in your
                browser — nothing is uploaded to a server, and no signup is
                required.
            </p>
            <p>
                ToolsVibe was started because tool websites are cluttered with
                ads, popups, and forced account creation. There had to be
                something different: clean, fast tools that just work.
            </p>

            <h2 class="text-2xl font-bold mt-8 mb-3">Who Runs ToolsVibe?</h2>
            <p>
                ToolsVibe is developed and maintained by <strong
                    >Khuram Shahzad</strong
                >, a web developer from Pakistan, along with a small team of
                contributors. The project started as a personal experiment to
                build fast, ad-light tools for users in Pakistan and around the
                world.
            </p>

            <h3 class="text-xl font-semibold mt-6 mb-3">Client Work</h3>
            <p class="mb-3">
                Alongside ToolsVibe, Khuram Shahzad builds production websites
                for real businesses. One recent project:
            </p>
            <ul class="list-disc pl-6 space-y-2">
                <li>
                    <a
                        href="https://saleemsons.com.pk/"
                        target="_blank"
                        rel="noopener"
                        class="text-blue-600 hover:underline font-medium"
                    >
                        Saleem & Sons
                    </a>{" "}
                    — a business website for a Pakistani company, built with modern
                    web technology.
                </li>
            </ul>
            <p class="mt-3">You can connect with the project here:</p>
            <ul class="list-disc pl-6 space-y-2 mt-2">
                <li>
                    <strong>Portfolio:</strong>{" "}
                    <a
                        href="https://khuram354.github.io/portfolio-v1/"
                        target="_blank"
                        rel="noopener"
                        class="text-blue-600 hover:underline"
                    >
                        khuram354.github.io/portfolio-v1
                    </a>
                </li>
                <li>
                    <strong>GitHub:</strong>{" "}
                    <a
                        href="https://github.com/khuram354"
                        target="_blank"
                        rel="noopener"
                        class="text-blue-600 hover:underline"
                    >
                        github.com/khuram354
                    </a>
                </li>
                <li>
                    <strong>Facebook:</strong>{" "}
                    <a
                        href="https://facebook.com/toolsvibe.online"
                        target="_blank"
                        rel="noopener"
                        class="text-blue-600 hover:underline"
                    >
                        facebook.com/toolsvibe.online
                    </a>
                </li>
                <li>
                    <strong>Email:</strong>{" "}
                    <a
                        href="https://mail.google.com/mail/?view=cm&to=khurammirza354@gmail.com"
                        target="_blank"
                        rel="noopener"
                        class="text-blue-600 hover:underline"
                    >
                        khurammirza354@gmail.com
                    </a>
                </li>
            </ul>

            <h2 class="text-2xl font-bold mt-8 mb-3">Our Mission</h2>
            <p>
                The goal is simple: build the fastest, most private online tools
                on the web. No distractions, no data collection, no hidden fees.
                Just tools that do one thing well — and do it in your browser.
            </p>

            <h2 class="text-2xl font-bold mt-8 mb-3">What We Offer</h2>
            <p>
                ToolsVibe currently offers 15 free tools, with more added
                regularly:
            </p>

            <h3 class="text-xl font-semibold mt-6 mb-3">
                Writing & Text Tools
            </h3>
            <ul class="list-disc pl-6 space-y-2">
                <li>
                    <a
                        href="/tools/word-counter"
                        class="text-blue-600 hover:underline font-medium"
                    >
                        Word Counter
                    </a>{" "}
                    — count words, characters, sentences, and estimate reading time.
                </li>
            </ul>

            <h3 class="text-xl font-semibold mt-6 mb-3">Utility Tools</h3>
            <ul class="list-disc pl-6 space-y-2">
                <li>
                    <a
                        href="/tools/qr-generator"
                        class="text-blue-600 hover:underline font-medium"
                    >
                        QR Code Generator
                    </a>{" "}
                    — create custom QR codes for any text or URL.
                </li>
                <li>
                    <a
                        href="/tools/password-generator"
                        class="text-blue-600 hover:underline font-medium"
                    >
                        Password Generator
                    </a>{" "}
                    — create strong random passwords.
                </li>
                <li>
                    <a
                        href="/tools/unit-converter"
                        class="text-blue-600 hover:underline font-medium"
                    >
                        Unit Converter
                    </a>{" "}
                    — length, weight, temperature, area, volume, speed, and time.
                </li>
                <li>
                    <a
                        href="/tools/age-calculator"
                        class="text-blue-600 hover:underline font-medium"
                    >
                        Age Calculator
                    </a>{" "}
                    — exact age in years, months, days, plus next birthday countdown.
                </li>
                <li>
                    <a
                        href="/tools/percentage-calculator"
                        class="text-blue-600 hover:underline font-medium"
                    >
                        Percentage Calculator
                    </a>{" "}
                    — solve percentage problems, discounts, and percentage change.
                </li>
            </ul>

            <h3 class="text-xl font-semibold mt-6 mb-3">Developer Tools</h3>
            <ul class="list-disc pl-6 space-y-2">
                <li>
                    <a
                        href="/tools/json-formatter"
                        class="text-blue-600 hover:underline font-medium"
                    >
                        JSON Formatter
                    </a>{" "}
                    — format, validate, and beautify JSON data.
                </li>
            </ul>

            <h3 class="text-xl font-semibold mt-6 mb-3">
                Finance & Tax Tools (Pakistan)
            </h3>
            <ul class="list-disc pl-6 space-y-2">
                <li>
                    <a
                        href="/tools/salary-tax-calculator"
                        class="text-blue-600 hover:underline font-medium"
                    >
                        Salary Tax Calculator
                    </a>{" "}
                    — calculate take-home salary and FBR tax for Tax Year 2027.
                </li>
                <li>
                    <a
                        href="/tools/freelancer-tax-calculator"
                        class="text-blue-600 hover:underline font-medium"
                    >
                        Freelancer Tax Calculator
                    </a>{" "}
                    — tax on IT export income and local freelance income.
                </li>
                <li>
                    <a
                        href="/tools/zakat-calculator"
                        class="text-blue-600 hover:underline font-medium"
                    >
                        Zakat Calculator
                    </a>{" "}
                    — calculate Zakat on cash, gold, silver, and investments.
                </li>
                <li>
                    <a
                        href="/tools/emi-calculator"
                        class="text-blue-600 hover:underline font-medium"
                    >
                        EMI Calculator
                    </a>{" "}
                    — monthly loan EMI, total interest, and yearly breakdown.
                </li>
            </ul>

            <h3 class="text-xl font-semibold mt-6 mb-3">Image Tools</h3>
            <ul class="list-disc pl-6 space-y-2">
                <li>
                    <a
                        href="/tools/image-compressor"
                        class="text-blue-600 hover:underline font-medium"
                    >
                        Image Compressor
                    </a>{" "}
                    — reduce JPG, PNG, and WebP file sizes.
                </li>
                <li>
                    <a
                        href="/tools/image-resizer"
                        class="text-blue-600 hover:underline font-medium"
                    >
                        Image Resizer
                    </a>{" "}
                    — resize images with aspect ratio control.
                </li>
                <li>
                    <a
                        href="/tools/image-cropper"
                        class="text-blue-600 hover:underline font-medium"
                    >
                        Image Cropper
                    </a>{" "}
                    — crop images to any size or aspect ratio.
                </li>
                <li>
                    <a
                        href="/tools/image-converter"
                        class="text-blue-600 hover:underline font-medium"
                    >
                        Image Converter
                    </a>{" "}
                    — convert between JPG, PNG, and WebP formats.
                </li>
            </ul>

            <h2 class="text-2xl font-bold mt-8 mb-3">Our Principles</h2>
            <ul class="list-disc pl-6 space-y-2">
                <li>
                    <strong>Privacy first:</strong> your data never leaves your browser.
                    No uploads, no server processing, no tracking beyond basic analytics.
                </li>
                <li>
                    <strong>Free forever:</strong> no paywalls, no forced signups,
                    no premium tiers.
                </li>
                <li>
                    <strong>Fast and simple:</strong> built with modern web technology
                    for instant load times on any device.
                </li>
                <li>
                    <strong>Focused:</strong> each tool does one thing, and does it
                    well.
                </li>
            </ul>

            <h2 class="text-2xl font-bold mt-8 mb-3">Technology</h2>
            <p>
                ToolsVibe is built with{" "}
                <a
                    href="https://astro.build"
                    target="_blank"
                    rel="noopener"
                    class="text-blue-600 hover:underline"
                >
                    Astro
                </a>
                , a modern web framework that ships zero JavaScript by default. That
                means pages load almost instantly and work smoothly even on slower
                connections.
            </p>

            <h2 class="text-2xl font-bold mt-8 mb-3">Get in Touch</h2>
            <p>
                Have feedback, found a bug, or want to suggest a new tool? Visit
                our{" "}
                <a href="/contact" class="text-blue-600 hover:underline"
                    >contact page</a
                >{" "}
                or explore our{" "}
                <a href="/blog" class="text-blue-600 hover:underline">blog</a>{
                    " "
                }
                for guides and tips.
            </p>
        </section>

        <!-- FAQ -->
        <section class="mt-16">
            <h2 class="text-2xl md:text-3xl font-bold mb-3">
                Frequently Asked Questions
            </h2>
            <p class="text-gray-600 mb-8">Common questions about ToolsVibe.</p>
            <div class="space-y-4">
                {
                    faqs.map((faq) => (
                        <div class="p-5 bg-white rounded-xl border border-gray-200">
                            <h3 class="font-semibold mb-2">{faq.q}</h3>
                            <p class="text-sm text-gray-600">{faq.a}</p>
                        </div>
                    ))
                }
            </div>
        </section>
    </article>
</Layout>
