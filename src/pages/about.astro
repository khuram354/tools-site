---
import Layout from "../layouts/Layout.astro";
import { toolCategories, allTools } from "../data/tools";

const origin = "https://toolsvibe.online";
const pageUrl = `${origin}/about/`;

// Personal details in one place, so they are easy to change
const FOUNDER = "Khuram Shahzad";
const CONTACT_EMAIL = "khurammirza354@gmail.com";
const GITHUB_URL = "https://github.com/khuram354";
const FACEBOOK_URL = "https://facebook.com/toolsvibe.online";
const PORTFOLIO_URL = "https://khuram354.github.io/portfolio-v1/";

// One source of truth: shown on the page AND used for the FAQ schema,
// so the visible text and the structured data always match.
const faqs = [
    {
        q: "Who runs ToolsVibe?",
        a: `ToolsVibe is an independent project built by ${FOUNDER} and a small team of contributors from Pakistan. It is not backed by any large corporation.`,
    },
    {
        q: "Is ToolsVibe really free?",
        a: "Yes. Every tool on ToolsVibe is free to use with no hidden charges, no premium tiers, and no forced signups. We fund the site through minimal, non-intrusive advertising.",
    },
    {
        q: "How do you protect my privacy?",
        a: "The tools process what you type, paste, or upload in your browser, so that content never leaves your device. We use Google Analytics to understand how the site is used, and advertising partners may set cookies on pages that show ads. We do not sell personal data. Our Privacy Policy explains this in full.",
    },
    {
        q: "Are the tax and Zakat calculators reliable?",
        a: "They give estimates based on published figures such as FBR tax slabs, and the pages show the tax year and when the figures were last reviewed. Rules and prices change, so the results are not professional advice. Confirm important figures with FBR or a tax professional, and ask a qualified scholar about Zakat rulings.",
    },
    {
        q: "Can I use ToolsVibe tools for commercial work?",
        a: "Yes. You can use the tools, and the files and results you create with them, for personal or commercial work. We do not claim any rights over your content.",
    },
];

const aboutSchema = {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    name: "About ToolsVibe",
    url: pageUrl,
    description:
        "ToolsVibe is a free collection of browser-based tools, including Pakistan tax and Zakat calculators and image tools, built by Khuram Shahzad.",
    isPartOf: {
        "@type": "WebSite",
        "@id": `${origin}/#website`,
        name: "ToolsVibe",
        url: `${origin}/`,
    },
    mainEntity: {
        "@type": "Organization",
        "@id": `${origin}/#organization`,
        name: "ToolsVibe",
        url: `${origin}/`,
        logo: `${origin}/apple-touch-icon.png`,
        founder: {
            "@type": "Person",
            name: FOUNDER,
            url: PORTFOLIO_URL,
            sameAs: [GITHUB_URL],
        },
        sameAs: [FACEBOOK_URL],
    },
};

const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
};

const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item: `${origin}/`,
        },
        {
            "@type": "ListItem",
            position: 2,
            name: "About",
            item: pageUrl,
        },
    ],
};
---

<Layout
    title="About ToolsVibe: Free, Privacy-First Online Tools from Pakistan"
    description="ToolsVibe is a free collection of browser-based tools, including Pakistan tax and Zakat calculators and image tools. Built by Khuram Shahzad."
>
    <article class="max-w-3xl mx-auto">
        <header class="mb-10">
            <nav aria-label="Breadcrumb" class="text-xs text-gray-500 mb-4">
                <a href="/" class="hover:underline">Home</a>
                <span aria-hidden="true">/</span>
                <span>About</span>
            </nav>
            <h1 class="text-3xl md:text-4xl font-bold mb-4">About ToolsVibe</h1>
            <p class="text-lg text-gray-600">
                A free collection of fast, privacy-friendly online tools, built
                for people who value their time and their data.
            </p>
        </header>

        <section class="space-y-6 text-gray-700 leading-relaxed">
            <p>
                ToolsVibe is a free collection of online tools built for speed,
                simplicity, and privacy. The tools run in your browser, so what
                you type, paste, or upload is processed on your own device and
                is not sent to our servers. No signup is required.
            </p>
            <p>
                ToolsVibe was started because tool websites are often cluttered
                with ads, popups, and forced account creation. We wanted
                something different: clean, fast tools that just work, including
                calculators made for users in Pakistan.
            </p>

            <h2 class="text-2xl font-bold mt-8 mb-3">Who Runs ToolsVibe?</h2>
            <p>
                ToolsVibe is developed and maintained by <strong
                    >{FOUNDER}</strong
                >, a web developer from Pakistan, along with a small team of
                contributors. The project started as a personal experiment to
                build fast, light tools for users in Pakistan and around the
                world.
            </p>

            <h3 class="text-xl font-semibold mt-6 mb-3">Client Work</h3>
            <p class="mb-3">
                Alongside ToolsVibe, {FOUNDER} builds production websites for real
                businesses. One recent project:
            </p>
            <ul class="list-disc pl-6 space-y-2">
                <li>
                    <a
                        href="https://saleemsons.com.pk/"
                        target="_blank"
                        rel="noopener"
                        class="text-blue-600 hover:underline font-medium"
                    >
                        Saleem & Sons
                    </a>{" "}
                    — a business website for a Pakistani company, built with modern
                    web technology.
                </li>
            </ul>
            <p class="mt-3">You can connect with the project here:</p>
            <ul class="list-disc pl-6 space-y-2 mt-2">
                <li>
                    <strong>Portfolio:</strong>{" "}
                    <a
                        href={PORTFOLIO_URL}
                        target="_blank"
                        rel="noopener"
                        class="text-blue-600 hover:underline"
                    >
                        khuram354.github.io/portfolio-v1
                    </a>
                </li>
                <li>
                    <strong>GitHub:</strong>{" "}
                    <a
                        href={GITHUB_URL}
                        target="_blank"
                        rel="noopener"
                        class="text-blue-600 hover:underline"
                    >
                        github.com/khuram354
                    </a>
                </li>
                <li>
                    <strong>Facebook:</strong>{" "}
                    <a
                        href={FACEBOOK_URL}
                        target="_blank"
                        rel="noopener"
                        class="text-blue-600 hover:underline"
                    >
                        facebook.com/toolsvibe.online
                    </a>
                </li>
                <li>
                    <strong>Email:</strong>{" "}
                    <a
                        href={`mailto:${CONTACT_EMAIL}`}
                        class="text-blue-600 hover:underline"
                    >
                        {CONTACT_EMAIL}
                    </a>
                </li>
            </ul>

            <h2 class="text-2xl font-bold mt-8 mb-3">Our Mission</h2>
            <p>
                The goal is simple: build fast, private online tools that are
                easy to use. No distractions, no signups, no hidden fees. Just
                tools that do one thing well, and do it in your browser. We
                never collect what you type or upload into a tool.
            </p>

            <h2 class="text-2xl font-bold mt-8 mb-3">What We Offer</h2>
            <p>
                ToolsVibe currently offers {allTools.length} free tools, with more
                added regularly. You can also see them all on the <a
                    href="/tools/"
                    class="text-blue-600 hover:underline font-medium"
                    >Tools page</a
                >.
            </p>

            {
                toolCategories.map((category) => (
                    <div>
                        <h3 class="text-xl font-semibold mt-6 mb-3">
                            {category.name}
                        </h3>
                        <ul class="list-disc pl-6 space-y-2">
                            {category.tools.map((tool) => (
                                <li>
                                    <a
                                        href={tool.href}
                                        class="text-blue-600 hover:underline font-medium"
                                    >
                                        {tool.name}
                                    </a>{" "}
                                    — {tool.description}
                                </li>
                            ))}
                        </ul>
                    </div>
                ))
            }

            <h2 class="text-2xl font-bold mt-8 mb-3">Our Principles</h2>
            <ul class="list-disc pl-6 space-y-2">
                <li>
                    <strong>Privacy first:</strong> what you enter into a tool is
                    processed in your browser and is never uploaded to our servers.
                    We do use Google Analytics to understand how the site is used,
                    and we explain this in our <a
                        href="/privacy/"
                        class="text-blue-600 hover:underline">Privacy Policy</a
                    >.
                </li>
                <li>
                    <strong>Free to use:</strong> no paywalls, no forced signups,
                    no premium tiers.
                </li>
                <li>
                    <strong>Fast and simple:</strong> built to load quickly on any
                    device, including slower connections.
                </li>
                <li>
                    <strong>Focused:</strong> each tool does one thing, and does it
                    well.
                </li>
                <li>
                    <strong>Honest about results:</strong> estimates are shown as
                    estimates, and the tools say when they could not do what you asked.
                </li>
            </ul>

            <h2 class="text-2xl font-bold mt-8 mb-3">
                Accuracy of the Tax and Zakat Calculators
            </h2>
            <p>
                Our Pakistan tax and Zakat calculators use published figures,
                such as FBR tax slabs and the Nisab for Zakat. The tax
                calculators show the tax year and when their figures were last
                reviewed, and the Zakat calculator shows the date of its example
                gold and silver prices. Tax rules and prices change, so please
                treat the results as estimates and not as professional advice.
                Confirm important figures with FBR or a tax professional, and
                ask a qualified scholar about Zakat rulings.
            </p>

            <h2 class="text-2xl font-bold mt-8 mb-3">Technology</h2>
            <p>
                ToolsVibe is built with{" "}
                <a
                    href="https://astro.build"
                    target="_blank"
                    rel="noopener"
                    class="text-blue-600 hover:underline"
                >
                    Astro
                </a>
                , a modern web framework that ships no JavaScript to the page unless
                it is needed. That helps pages stay light and work smoothly even on
                slower connections.
            </p>

            <h2 class="text-2xl font-bold mt-8 mb-3">Get in Touch</h2>
            <p>
                Have feedback, found a bug, or want to suggest a new tool? Visit
                our{" "}
                <a href="/contact/" class="text-blue-600 hover:underline"
                    >contact page</a
                >{" "}
                or explore our{" "}
                <a href="/blog/" class="text-blue-600 hover:underline">blog</a>{
                    " "
                }
                for guides and tips. You can also read our{" "}
                <a href="/privacy/" class="text-blue-600 hover:underline"
                    >Privacy Policy</a
                >{" "}
                and{" "}
                <a href="/terms/" class="text-blue-600 hover:underline"
                    >Terms of Service</a
                >.
            </p>
        </section>

        <!-- FAQ -->
        <section class="mt-16">
            <h2 class="text-2xl md:text-3xl font-bold mb-3">
                Frequently Asked Questions
            </h2>
            <p class="text-gray-600 mb-8">Common questions about ToolsVibe.</p>
            <div class="space-y-4">
                {
                    faqs.map((faq) => (
                        <div class="p-5 bg-white rounded-xl border border-gray-200">
                            <h3 class="font-semibold mb-2">{faq.q}</h3>
                            <p class="text-sm text-gray-600">{faq.a}</p>
                        </div>
                    ))
                }
            </div>
        </section>
    </article>

    <script type="application/ld+json" set:html={JSON.stringify(aboutSchema)} />
    <script
        type="application/ld+json"
        set:html={JSON.stringify(breadcrumbSchema)}
    />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Layout>
