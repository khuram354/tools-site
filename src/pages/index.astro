---
import Layout from '../layouts/Layout.astro';

const tools = [
  {
    name: 'Word Counter',
    description: 'Count words, characters, sentences, and reading time instantly.',
    href: '/tools/word-counter',
    icon: 'word',
  },
  {
    name: 'QR Code Generator',
    description: 'Create custom QR codes for any text or URL. Download as PNG.',
    href: '/tools/qr-generator',
    icon: 'qr',
  },
  {
    name: 'JSON Formatter',
    description: 'Format, validate, and beautify JSON data online.',
    href: '/tools/json-formatter',
    icon: 'json',
  },
];

const features = [
  { title: '100% Free', description: 'No hidden fees, no premium plans.' },
  { title: 'No Signup', description: 'Use any tool without creating an account.' },
  { title: 'Privacy First', description: 'Everything runs in your browser.' },
  { title: 'Fast & Lightweight', description: 'Built with modern web technology.' },
];

const recentPosts = [
  {
    title: 'How to Scan a QR Code on iPhone (2026 Guide)',
    href: '/blog/scan-qr-code-iphone',
    date: 'October 5, 2026',
  },
  {
    title: 'How to Count Words Across All Tabs in Google Docs',
    href: '/blog/word-count-google-docs-all-tabs',
    date: 'October 5, 2026',
  },
  {
    title: 'How to Count Words Accurately (2026 Guide)',
    href: '/blog/how-to-count-words',
    date: 'October 2, 2026',
  },
];

const faqs = [
  {
    q: 'Are these tools really free?',
    a: 'Yes. All tools on ToolsVibe are 100% free with no signup, no limits, and no hidden fees.',
  },
  {
    q: 'Is my data safe?',
    a: 'Absolutely. All tools run entirely in your browser. Your text, files, and data never leave your device.',
  },
  {
    q: 'Do I need to create an account?',
    a: 'No. You can use every tool without signing up or sharing any personal information.',
  },
  {
    q: 'Can I use these tools on mobile?',
    a: 'Yes. All tools are fully responsive and work on phones, tablets, and desktops.',
  },
];
---

<Layout
  title="ToolsVibe — Free Online Tools for Everyone"
  description="Free, fast, and privacy-friendly online tools. Word counter, QR code generator, JSON formatter, and more. No signup required."
>
  <!-- Hero Section -->
  <section class="text-center py-16">
    <h1 class="text-4xl md:text-5xl font-bold mb-4">
      Free Online Tools, <span class="text-blue-600">Made Simple</span>
    </h1>
    <p class="text-lg text-gray-600 max-w-2xl mx-auto mb-8">
      Fast, privacy-friendly tools that work right in your browser.
      No signup, no clutter, no data collection.
    </p>
    <div class="flex flex-wrap gap-3 justify-center">
      <a
        href="/tools"
        class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium transition"
      >
        Browse All Tools
      </a>
      <a
        href="/tools/word-counter"
        class="px-6 py-3 bg-white text-blue-600 border border-blue-600 rounded-lg hover:bg-blue-50 font-medium transition"
      >
        Try Word Counter
      </a>
    </div>
    <div class="flex flex-wrap gap-6 justify-center mt-8 text-sm text-gray-500">
      <span class="flex items-center gap-1">✓ 100% Free</span>
      <span class="flex items-center gap-1">✓ No Signup</span>
      <span class="flex items-center gap-1">✓ Privacy First</span>
    </div>
  </section>

  <!-- Tools Section -->
  <section class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-4">
    {tools.map((tool) => (
      <a
        href={tool.href}
        class="block p-6 bg-white rounded-xl shadow-sm border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
      >
        <div class="w-12 h-12 bg-blue-50 rounded-lg flex items-center justify-center mb-4">
          {tool.icon === 'word' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
              <line x1="16" y1="13" x2="8" y2="13"/>
              <line x1="16" y1="17" x2="8" y2="17"/>
              <polyline points="10 9 9 9 8 9"/>
            </svg>
          )}
          {tool.icon === 'qr' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="7" height="7"/>
              <rect x="14" y="3" width="7" height="7"/>
              <rect x="3" y="14" width="7" height="7"/>
              <rect x="14" y="14" width="7" height="7"/>
            </svg>
          )}
          {tool.icon === 'json' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="16 18 22 12 16 6"/>
              <polyline points="8 6 2 12 8 18"/>
            </svg>
          )}
        </div>
        <h2 class="text-xl font-semibold mb-2">{tool.name}</h2>
        <p class="text-gray-600 text-sm">{tool.description}</p>
      </a>
    ))}
  </section>

  <!-- Why Choose Us -->
  <section class="mt-20">
    <h2 class="text-2xl md:text-3xl font-bold text-center mb-3">Why Choose ToolsVibe?</h2>
    <p class="text-gray-600 text-center max-w-2xl mx-auto mb-10">
      We focus on speed, privacy, and simplicity — so you can get things done.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {features.map((f) => (
        <div class="p-5 bg-white rounded-xl border border-gray-200 text-center">
          <h3 class="font-semibold mb-2">{f.title}</h3>
          <p class="text-sm text-gray-600">{f.description}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- How It Works -->
  <section class="mt-20">
    <h2 class="text-2xl md:text-3xl font-bold text-center mb-3">How It Works</h2>
    <p class="text-gray-600 text-center max-w-2xl mx-auto mb-10">
      Three simple steps — no account, no hassle.
    </p>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="p-6 bg-white rounded-xl border border-gray-200 text-center">
        <div class="w-10 h-10 bg-blue-600 text-white rounded-full flex items-center justify-center font-bold mx-auto mb-3">1</div>
        <h3 class="font-semibold mb-2">Choose a Tool</h3>
        <p class="text-sm text-gray-600">Pick from our collection of free tools.</p>
      </div>
      <div class="p-6 bg-white rounded-xl border border-gray-200 text-center">
        <div class="w-10 h-10 bg-blue-600 text-white rounded-full flex items-center justify-center font-bold mx-auto mb-3">2</div>
        <h3 class="font-semibold mb-2">Use It Instantly</h3>
        <p class="text-sm text-gray-600">Everything runs in your browser. No upload, no wait.</p>
      </div>
      <div class="p-6 bg-white rounded-xl border border-gray-200 text-center">
        <div class="w-10 h-10 bg-blue-600 text-white rounded-full flex items-center justify-center font-bold mx-auto mb-3">3</div>
        <h3 class="font-semibold mb-2">Get Your Result</h3>
        <p class="text-sm text-gray-600">Copy, download, or share — done in seconds.</p>
      </div>
    </div>
  </section>

  <!-- Recent Blog Posts -->
  <section class="mt-20">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-2xl md:text-3xl font-bold">Latest from the Blog</h2>
      <a href="/blog" class="text-blue-600 hover:underline text-sm font-medium">View all →</a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {recentPosts.map((post) => (
        <a
          href={post.href}
          class="block p-5 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
        >
          <p class="text-xs text-gray-500 mb-2">{post.date}</p>
          <h3 class="font-semibold mb-2 leading-snug">{post.title}</h3>
        </a>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section class="mt-20 max-w-3xl mx-auto">
    <h2 class="text-2xl md:text-3xl font-bold text-center mb-3">Frequently Asked Questions</h2>
    <p class="text-gray-600 text-center mb-10">Quick answers to common questions.</p>
    <div class="space-y-4">
      {faqs.map((faq) => (
        <div class="p-5 bg-white rounded-xl border border-gray-200">
          <h3 class="font-semibold mb-2">{faq.q}</h3>
          <p class="text-sm text-gray-600">{faq.a}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- SEO Content -->
  <section class="mt-20 max-w-3xl mx-auto">
    <h2 class="text-2xl font-bold mb-4">Free Online Tools for Everyday Tasks</h2>
    <p class="text-gray-700 mb-4">
      ToolsVibe offers a growing collection of free online tools designed to make your
      daily tasks easier. Whether you need to count words in an essay, generate a QR code
      for your business card, or format JSON for a development project, our tools are
      built to be fast, reliable, and privacy-friendly.
    </p>
    <p class="text-gray-700 mb-4">
      Unlike many other online tool websites, we don't require signups, don't show
      intrusive popups, and don't send your data to any server. Every tool runs entirely
      in your browser, which means your text, files, and information stay on your device.
    </p>
    <p class="text-gray-700">
      Our current tools include a{' '}
      <a href="/tools/word-counter" class="text-blue-600 hover:underline">Word Counter</a>,{' '}
      a <a href="/tools/qr-generator" class="text-blue-600 hover:underline">QR Code Generator</a>,
      and a <a href="/tools/json-formatter" class="text-blue-600 hover:underline">JSON Formatter</a>.
      We're adding new tools regularly — check back often, or browse our{' '}
      <a href="/blog" class="text-blue-600 hover:underline">blog</a> for guides and tips.
    </p>
  </section>
</Layout>