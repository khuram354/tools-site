---
import Layout from "../layouts/Layout.astro";
import { getLatestPosts } from "../data/blog-data/blog-posts";
import { toolCategories, allTools } from "../data/tools";

// Icons for the cards on this page (same drawings as the /tools/ page).
const iconMarkup: Record<string, string> = {
    word: `<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" />`,
    "image-compress": `<polyline points="4 14 10 14 10 20" /><polyline points="20 10 14 10 14 4" /><line x1="14" y1="10" x2="21" y2="3" /><line x1="3" y1="21" x2="10" y2="14" />`,
    qr: `<rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /><rect x="14" y="14" width="7" height="7" />`,
    tax: `<line x1="12" y1="1" x2="12" y2="23" /><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />`,
    freelancer: `<rect x="2" y="7" width="20" height="14" rx="2" ry="2" /><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />`,
    zakat: `<path d="M12 2v20" /><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" /><circle cx="12" cy="12" r="10" />`,
    emi: `<path d="M3 21h18" /><path d="M5 21V7l7-4 7 4v14" /><path d="M9 21v-6h6v6" /><path d="M10 9h.01" /><path d="M14 9h.01" />`,
};

const categoryEmoji: Record<string, string> = {
    "pakistan-tax": "🇵🇰",
    finance: "💰",
    image: "🖼️",
    utility: "🛠️",
    developer: "💻",
    writing: "📝",
};

// Both lists come from src/data/tools.ts, so a new tool only needs adding there.
const pakistanTools =
    toolCategories.find((c) => c.id === "pakistan-tax")?.tools ?? [];

const popularHrefs = [
    "/tools/word-counter/",
    "/tools/image-compressor/",
    "/tools/qr-generator/",
];
const popularTools = popularHrefs.flatMap((href) =>
    allTools.filter((t) => t.href === href),
);

const features = [
    { title: "100% Free", description: "No hidden fees, no premium plans." },
    {
        title: "No Signup",
        description: "Use any tool without creating an account.",
    },
    {
        title: "Privacy First",
        description: "Tool inputs never leave your browser.",
    },
    {
        title: "Fast & Lightweight",
        description: "Built with modern web technology.",
    },
];

const recentPosts = getLatestPosts(3);

const faqs = [
    {
        q: "What is ToolsVibe?",
        a: `ToolsVibe is a free online tools platform with ${allTools.length} tools for writing, images, development, utilities, and Pakistan-specific tax calculations. All tools run in your browser.`,
    },
    {
        q: "Is my data safe?",
        a: "Yes. All tools run in your browser, so your text, images, and inputs never leave your device. We use basic analytics (Google Analytics) to understand how the site is used, and we do not sell personal data.",
    },
    {
        q: "Do I need to create an account?",
        a: "No. Every tool works without signup, email, or personal information.",
    },
    {
        q: "What Pakistan-specific tools are available?",
        a: "We offer Salary Tax Calculator, Freelancer Tax Calculator, Zakat Calculator, and EMI Calculator — all built for Pakistan with current FBR slabs and Nisab thresholds. Results are estimates for planning, so confirm important figures with FBR or a tax professional.",
    },
];
---

<Layout
    title="ToolsVibe: Free Online Tools & Pakistan Tax Calculators"
    description="Free online tools — word counter, image compressor, QR generator — plus Pakistan salary tax, freelancer tax, Zakat and EMI calculators. No signup."
>
    <!-- Hero Section -->
    <section class="text-center py-16">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">
            Free Online Tools <span class="text-blue-600">for Everyone</span>
        </h1>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto mb-8">
            Fast, privacy-friendly tools for writing, images, development, and
            everyday tasks — plus Pakistan-specific tax and Zakat calculators.
            Everything runs in your browser. No signup, and your tool inputs
            never leave your device.
        </p>
        <div class="flex flex-wrap gap-3 justify-center">
            <a
                href="/tools/"
                class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium transition"
            >
                Browse All Tools
            </a>
            <a
                href="#pakistan-tax-calculators"
                class="px-6 py-3 bg-white text-blue-600 border border-blue-600 rounded-lg hover:bg-blue-50 font-medium transition"
            >
                Pakistan Tax Calculators
            </a>
        </div>
        <div
            class="flex flex-wrap gap-6 justify-center mt-8 text-sm text-gray-500"
        >
            <span class="flex items-center gap-1">✓ 100% Free</span>
            <span class="flex items-center gap-1">✓ No Signup</span>
            <span class="flex items-center gap-1"
                >✓ Inputs Stay in Your Browser</span
            >
        </div>
    </section>

    <!-- Pakistan Tax & Zakat -->
    {
        pakistanTools.length > 0 && (
            <section id="pakistan-tax-calculators" class="mt-4 scroll-mt-24">
                <div class="text-center mb-8">
                    <h2 class="text-2xl md:text-3xl font-bold mb-3">
                        Pakistan Tax &amp; Zakat Calculators
                    </h2>
                    <p class="text-gray-600 max-w-2xl mx-auto">
                        Built for users in Pakistan: work out salary tax,
                        freelancer tax, Zakat, and loan EMIs. Results are
                        estimates for planning, so confirm important figures
                        with FBR or a tax professional.
                    </p>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                    {pakistanTools.map((tool) => (
                        <a
                            href={tool.href}
                            class="block p-6 bg-white rounded-xl shadow-sm border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
                        >
                            <div class="w-12 h-12 bg-blue-50 rounded-lg flex items-center justify-center mb-4">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="24"
                                    height="24"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="#2563eb"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true"
                                    set:html={iconMarkup[tool.icon] ?? ""}
                                />
                            </div>
                            <h3 class="text-lg font-semibold mb-2">
                                {tool.name}
                            </h3>
                            <p class="text-gray-600 text-sm">
                                {tool.description}
                            </p>
                        </a>
                    ))}
                </div>
                <p class="text-center text-sm text-gray-600 mt-6">
                    New to this? Read our guides to{" "}
                    <a
                        href="/blog/freelancing-tax-pakistan/"
                        class="text-blue-600 hover:underline"
                    >
                        freelancing tax in Pakistan
                    </a>{" "}
                    and{" "}
                    <a
                        href="/blog/how-to-calculate-zakat-gold/"
                        class="text-blue-600 hover:underline"
                    >
                        calculating Zakat on gold
                    </a>
                    .
                </p>
            </section>
        )
    }

    <!-- Popular Tools -->
    {
        popularTools.length > 0 && (
            <section class="mt-20">
                <h2 class="text-2xl md:text-3xl font-bold text-center mb-8">
                    Popular Free Tools
                </h2>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    {popularTools.map((tool) => (
                        <a
                            href={tool.href}
                            class="block p-6 bg-white rounded-xl shadow-sm border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
                        >
                            <div class="w-12 h-12 bg-blue-50 rounded-lg flex items-center justify-center mb-4">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="24"
                                    height="24"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="#2563eb"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true"
                                    set:html={iconMarkup[tool.icon] ?? ""}
                                />
                            </div>
                            <h3 class="text-xl font-semibold mb-2">
                                {tool.name}
                            </h3>
                            <p class="text-gray-600 text-sm">
                                {tool.description}
                            </p>
                        </a>
                    ))}
                </div>
            </section>
        )
    }

    <!-- All Tools by Category (direct links to every tool) -->
    <section class="mt-20 max-w-5xl mx-auto px-4">
        <h2 class="text-center text-2xl md:text-3xl font-bold mb-3">
            All {allTools.length} Free Tools
        </h2>
        <p class="text-gray-600 text-center mb-8">
            Pick a category or jump straight to a tool.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {
                toolCategories.map((category) => (
                    <div class="p-5 bg-white rounded-xl border border-gray-200">
                        <h3 class="font-semibold mb-3">
                            <a
                                href={`/tools/#${category.id}`}
                                class="hover:text-blue-600"
                            >
                                <span class="mr-2" aria-hidden="true">
                                    {categoryEmoji[category.id] ?? "🧰"}
                                </span>
                                {category.name}
                            </a>
                        </h3>
                        <ul class="space-y-1.5 text-sm list-none">
                            {category.tools.map((tool) => (
                                <li>
                                    <a
                                        href={tool.href}
                                        class="text-blue-600 hover:underline"
                                    >
                                        {tool.name}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>
                ))
            }
        </div>
    </section>

    <!-- Why Choose Us -->
    <section class="mt-20">
        <h2 class="text-2xl md:text-3xl font-bold text-center mb-3">
            Why Choose ToolsVibe?
        </h2>
        <p class="text-gray-600 text-center max-w-2xl mx-auto mb-10">
            We focus on speed, privacy, and simplicity — so you can get things
            done.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {
                features.map((f) => (
                    <div class="p-5 bg-white rounded-xl border border-gray-200 text-center">
                        <h3 class="font-semibold mb-2">{f.title}</h3>
                        <p class="text-sm text-gray-600">{f.description}</p>
                    </div>
                ))
            }
        </div>
    </section>

    <!-- About ToolsVibe -->
    <section class="mt-20 max-w-3xl mx-auto">
        <h2 class="text-2xl font-bold mb-4">About ToolsVibe</h2>
        <p class="text-gray-700 mb-4">
            Most online tool websites are cluttered with ads, popups, and forced
            signups. ToolsVibe is different. We built a clean, fast, and
            privacy-friendly alternative where every tool runs entirely in your
            browser — your text, images, and data never leave your device.
        </p>
        <p class="text-gray-700">
            Our tools are built for students, writers, developers, and small
            business owners — plus a dedicated set of Pakistan-specific tax and
            Zakat calculators for users in Pakistan. No accounts, no uploads,
            and your inputs are never collected — just tools that work.
        </p>
    </section>

    <!-- Latest from the Blog -->
    <section class="mt-20 max-w-3xl mx-auto">
        <div class="flex items-center justify-between mb-6">
            <h2 class="text-2xl font-bold">Latest from the Blog</h2>
            <a
                href="/blog/"
                class="text-blue-600 hover:underline text-sm font-medium"
                >View all →</a
            >
        </div>
        <div class="space-y-3">
            {
                recentPosts.map((post) => (
                    <a
                        href={post.href}
                        class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
                    >
                        <div class="flex items-center justify-between gap-3">
                            <h3 class="font-medium leading-snug">
                                {post.title}
                            </h3>
                            <span class="text-xs text-gray-500 whitespace-nowrap">
                                {post.date}
                            </span>
                        </div>
                    </a>
                ))
            }
        </div>
    </section>

    <!-- FAQ -->
    <section class="mt-20 max-w-3xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-bold text-center mb-3">
            Frequently Asked Questions
        </h2>
        <p class="text-gray-600 text-center mb-10">
            Quick answers to common questions.
        </p>
        <div class="space-y-4">
            {
                faqs.map((faq) => (
                    <div class="p-5 bg-white rounded-xl border border-gray-200">
                        <h3 class="font-semibold mb-2">{faq.q}</h3>
                        <p class="text-sm text-gray-600">{faq.a}</p>
                    </div>
                ))
            }
        </div>
    </section>

    <!--
        WebSite and Organization schema come from Layout.astro
        (homepage only), so they are not repeated here.
    -->

    <!-- FAQPage Schema -->
    <script
        type="application/ld+json"
        set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "FAQPage",
            mainEntity: faqs.map((faq) => ({
                "@type": "Question",
                name: faq.q,
                acceptedAnswer: {
                    "@type": "Answer",
                    text: faq.a,
                },
            })),
        })}
    />
</Layout>
