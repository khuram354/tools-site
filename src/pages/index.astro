---
import Layout from "../layouts/Layout.astro";
import { getLatestPosts } from "../data/blog-data/blog-posts";

const tools = [
    {
        name: "Word Counter",
        description:
            "Count words, characters, sentences, and reading time instantly.",
        href: "/tools/word-counter",
        icon: "word",
    },
    {
        name: "Image Compressor",
        description:
            "Compress JPG, PNG, and WebP images without losing quality.",
        href: "/tools/image-compressor",
        icon: "image-compress",
    },
    {
        name: "QR Code Generator",
        description:
            "Create custom QR codes for any text or URL. Download as PNG.",
        href: "/tools/qr-generator",
        icon: "qr",
    },
];

const features = [
    { title: "100% Free", description: "No hidden fees, no premium plans." },
    {
        title: "No Signup",
        description: "Use any tool without creating an account.",
    },
    {
        title: "Privacy First",
        description: "Tool inputs never leave your browser.",
    },
    {
        title: "Fast & Lightweight",
        description: "Built with modern web technology.",
    },
];

const recentPosts = getLatestPosts(3);

const faqs = [
    {
        q: "What is ToolsVibe?",
        a: "ToolsVibe is a free online tools platform with 15 tools for writing, images, development, utilities, and Pakistan-specific tax calculations. All tools run in your browser.",
    },
    {
        q: "Is my data safe?",
        a: "Yes. All tools run entirely in your browser. Your text, images, and inputs never leave your device. We do not store or sell user data.",
    },
    {
        q: "Do I need to create an account?",
        a: "No. Every tool works without signup, email, or personal information.",
    },
    {
        q: "What Pakistan-specific tools are available?",
        a: "We offer Salary Tax Calculator, Freelancer Tax Calculator, Zakat Calculator, and EMI Calculator — all built for Pakistan with current FBR slabs and Nisab thresholds.",
    },
];
---

<Layout
    title="Free Online Tools: Word Counter, Image Tools & Calculators"
    description="Free online tools for everyone — word counter, image compressor, QR code generator, JSON formatter, and Pakistan tax calculators. No signup, inputs stay in your browser."
>
    <!-- Hero Section -->
    <section class="text-center py-16">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">
            Free Online Tools <span class="text-blue-600">for Everyone</span>
        </h1>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto mb-8">
            Fast, privacy-friendly tools for writing, images, development, and
            everyday tasks — plus Pakistan-specific tax and Zakat calculators.
            Everything runs in your browser. No signup, and your tool inputs
            never leave your device.
        </p>
        <div class="flex flex-wrap gap-3 justify-center">
            <a
                href="/tools"
                class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium transition"
            >
                Browse All Tools
            </a>
            <a
                href="/tools/word-counter"
                class="px-6 py-3 bg-white text-blue-600 border border-blue-600 rounded-lg hover:bg-blue-50 font-medium transition"
            >
                Try Word Counter
            </a>
        </div>
        <div
            class="flex flex-wrap gap-6 justify-center mt-8 text-sm text-gray-500"
        >
            <span class="flex items-center gap-1">✓ 100% Free</span>
            <span class="flex items-center gap-1">✓ No Signup</span>
            <span class="flex items-center gap-1"
                >✓ Inputs Stay in Your Browser</span
            >
        </div>
    </section>

    <!-- Featured Tools (Top 3) -->
    <section class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-4">
        {
            tools.map((tool) => (
                <a
                    href={tool.href}
                    class="block p-6 bg-white rounded-xl shadow-sm border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
                >
                    <div class="w-12 h-12 bg-blue-50 rounded-lg flex items-center justify-center mb-4">
                        {tool.icon === "word" && (
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="24"
                                height="24"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="#2563eb"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                                <polyline points="14 2 14 8 20 8" />
                                <line x1="16" y1="13" x2="8" y2="13" />
                                <line x1="16" y1="17" x2="8" y2="17" />
                            </svg>
                        )}
                        {tool.icon === "image-compress" && (
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="24"
                                height="24"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="#2563eb"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <polyline points="4 14 10 14 10 20" />
                                <polyline points="20 10 14 10 14 4" />
                                <line x1="14" y1="10" x2="21" y2="3" />
                                <line x1="3" y1="21" x2="10" y2="14" />
                            </svg>
                        )}
                        {tool.icon === "qr" && (
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="24"
                                height="24"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="#2563eb"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <rect x="3" y="3" width="7" height="7" />
                                <rect x="14" y="3" width="7" height="7" />
                                <rect x="3" y="14" width="7" height="7" />
                                <rect x="14" y="14" width="7" height="7" />
                            </svg>
                        )}
                    </div>
                    <h2 class="text-xl font-semibold mb-2">{tool.name}</h2>
                    <p class="text-gray-600 text-sm">{tool.description}</p>
                </a>
            ))
        }
    </section>

    <!-- Tool Categories (Global First, Pakistan Last) -->
    <section class="mt-16 max-w-5xl mx-auto px-4">
        <h2 class="text-center text-lg font-semibold text-gray-700 mb-6">
            Explore All 15 Tools by Category
        </h2>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3">
            <a
                href="/tools#writing"
                class="block p-4 bg-white rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-md transition text-center"
            >
                <div class="text-2xl mb-2">📝</div>
                <div class="text-sm font-medium">Writing</div>
                <div class="text-xs text-gray-500 mt-1">Word Counter</div>
            </a>
            <a
                href="/tools#image"
                class="block p-4 bg-white rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-md transition text-center"
            >
                <div class="text-2xl mb-2">🖼️</div>
                <div class="text-sm font-medium">Image Tools</div>
                <div class="text-xs text-gray-500 mt-1">
                    Compress, Resize, Crop
                </div>
            </a>
            <a
                href="/tools#utility"
                class="block p-4 bg-white rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-md transition text-center"
            >
                <div class="text-2xl mb-2">🛠️</div>
                <div class="text-sm font-medium">Utilities</div>
                <div class="text-xs text-gray-500 mt-1">QR, Password, Unit</div>
            </a>
            <a
                href="/tools#developer"
                class="block p-4 bg-white rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-md transition text-center"
            >
                <div class="text-2xl mb-2">💻</div>
                <div class="text-sm font-medium">Developer</div>
                <div class="text-xs text-gray-500 mt-1">JSON Formatter</div>
            </a>
            <a
                href="/tools#finance"
                class="block p-4 bg-white rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-md transition text-center"
            >
                <div class="text-2xl mb-2">💰</div>
                <div class="text-sm font-medium">Finance</div>
                <div class="text-xs text-gray-500 mt-1">Percentage</div>
            </a>
            <a
                href="/tools#pakistan-tax"
                class="block p-4 bg-white rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-md transition text-center"
            >
                <div class="text-2xl mb-2">🇵🇰</div>
                <div class="text-sm font-medium">Pakistan Tax</div>
                <div class="text-xs text-gray-500 mt-1">Salary, Zakat, EMI</div>
            </a>
        </div>
    </section>

    <!-- Why Choose Us -->
    <section class="mt-20">
        <h2 class="text-2xl md:text-3xl font-bold text-center mb-3">
            Why Choose ToolsVibe?
        </h2>
        <p class="text-gray-600 text-center max-w-2xl mx-auto mb-10">
            We focus on speed, privacy, and simplicity — so you can get things
            done.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {
                features.map((f) => (
                    <div class="p-5 bg-white rounded-xl border border-gray-200 text-center">
                        <h3 class="font-semibold mb-2">{f.title}</h3>
                        <p class="text-sm text-gray-600">{f.description}</p>
                    </div>
                ))
            }
        </div>
    </section>

    <!-- Why ToolsVibe (Long-form) -->
    <section class="mt-20 max-w-3xl mx-auto">
        <h2 class="text-2xl font-bold mb-4">Why ToolsVibe?</h2>
        <p class="text-gray-700 mb-4">
            Most online tool websites are cluttered with ads, popups, and forced
            signups. ToolsVibe is different. We built a clean, fast, and
            privacy-friendly alternative where every tool runs entirely in your
            browser — your text, images, and data never leave your device.
        </p>
        <p class="text-gray-700">
            Our tools are used by students, writers, developers, and small
            business owners around the world — plus a dedicated set of
            Pakistan-specific tax and Zakat calculators for users in Pakistan.
            No accounts, no uploads, no data collection — just tools that work.
        </p>
    </section>

    <!-- Latest from the Blog -->
    <section class="mt-20 max-w-3xl mx-auto">
        <div class="flex items-center justify-between mb-6">
            <h2 class="text-2xl font-bold">Latest from the Blog</h2>
            <a
                href="/blog"
                class="text-blue-600 hover:underline text-sm font-medium"
                >View all →</a
            >
        </div>
        <div class="space-y-3">
            {
                recentPosts.map((post) => (
                    <a
                        href={post.href}
                        class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
                    >
                        <div class="flex items-center justify-between gap-3">
                            <h3 class="font-medium leading-snug">
                                {post.title}
                            </h3>
                            <span class="text-xs text-gray-500 whitespace-nowrap">
                                {post.date}
                            </span>
                        </div>
                    </a>
                ))
            }
        </div>
    </section>

    <!-- FAQ -->
    <section class="mt-20 max-w-3xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-bold text-center mb-3">
            Frequently Asked Questions
        </h2>
        <p class="text-gray-600 text-center mb-10">
            Quick answers to common questions.
        </p>
        <div class="space-y-4">
            {
                faqs.map((faq) => (
                    <div class="p-5 bg-white rounded-xl border border-gray-200">
                        <h3 class="font-semibold mb-2">{faq.q}</h3>
                        <p class="text-sm text-gray-600">{faq.a}</p>
                    </div>
                ))
            }
        </div>
    </section>

    <!-- WebSite Schema -->
    <script
        type="application/ld+json"
        set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "WebSite",
            name: "ToolsVibe",
            url: "https://toolsvibe.online",
            description:
                "Free online tools for everyone — word counter, image compressor, QR code generator, JSON formatter, and Pakistan tax calculators.",
        })}
    />
</Layout>
