                        </tr>
                        <tr>
                            <td class="p-3 border-b">3,200,001 – 4,100,000</td>
                            <td class="p-3 border-b"
                                >PKR 316,000 + 25% of amount exceeding 3,200,000</td
                            >
                        </tr>
                        <tr>
                            <td class="p-3 border-b">4,100,001 – 5,600,000</td>
                            <td class="p-3 border-b"
                                >PKR 541,000 + 29% of amount exceeding 4,100,000</td
                            >
                        </tr>
                        <tr>
                            <td class="p-3 border-b">5,600,001 – 7,000,000</td>
                            <td class="p-3 border-b"
                                >PKR 976,000 + 32% of amount exceeding 5,600,000</td
