                            >
                            <th class="text-left p-3 font-semibold border-b"
                                >Tax Rate</th
                            >
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="p-3 border-b">Up to 600,000</td>
                            <td class="p-3 border-b"
                                ><strong>0%</strong> (Tax-Free)</td
                            >
                        </tr>
                        <tr>
                            <td class="p-3 border-b">600,001 – 1,200,000</td>
                            <td class="p-3 border-b"
                                >1% of amount exceeding 600,000</td
                            >
                        </tr>
                        <tr>
                            <td class="p-3 border-b">1,200,001 – 2,200,000</td>
                            <td class="p-3 border-b"
