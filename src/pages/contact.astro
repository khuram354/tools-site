---
import Layout from '../layouts/Layout.astro';

const faqs = [
  {
    q: 'How quickly will I get a response?',
    a: 'We typically respond within 1–2 business days. For urgent bug reports, please mention it in the subject.',
  },
  {
    q: 'Can I request a new tool?',
    a: 'Yes. We welcome tool suggestions. Use the form above or email us directly and describe what you need.',
  },
  {
    q: 'Do you offer technical support?',
    a: 'We offer basic support for our tools. For complex technical issues, please include your browser and device details.',
  },
  {
    q: 'Is my contact information safe?',
    a: 'Yes. We only use your email to respond to your message. We never share or sell contact information.',
  },
];
---

<Layout
  title="Contact — Get in Touch | ToolsVibe"
  description="Contact ToolsVibe for feedback, bug reports, tool suggestions, or business inquiries. We respond within 1-2 business days."
>
  <article class="max-w-3xl mx-auto">
    <header class="mb-10">
      <h1 class="text-3xl md:text-4xl font-bold mb-4">Contact Us</h1>
      <p class="text-lg text-gray-600">
        Have feedback, found a bug, or want to suggest a new tool? We'd love to hear from you.
      </p>
    </header>

    <!-- Contact Form -->
    <section class="bg-white p-6 md:p-8 rounded-xl border border-gray-200 mb-8">
      <h2 class="text-xl font-semibold mb-4">Send Us a Message</h2>
      <form
        name="contact"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="space-y-4"
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="hidden">
          <label>Don't fill this out: <input name="bot-field" /></label>
        </p>

        <div>
          <label for="name" class="block text-sm font-medium mb-1">Your Name</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
            placeholder="Your name"
          />
        </div>

        <div>
          <label for="email" class="block text-sm font-medium mb-1">Your Email</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
            placeholder="you@example.com"
          />
        </div>

        <div>
          <label for="message" class="block text-sm font-medium mb-1">Message</label>
          <textarea
            id="message"
            name="message"
            required
            rows="5"
            class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
            placeholder="Your message..."
          ></textarea>
        </div>

        <button
          type="submit"
          class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium transition"
        >
          Send Message
        </button>
      </form>
    </section>

    <!-- Direct Email -->
    <section class="bg-white p-6 rounded-xl border border-gray-200 mb-8">
      <h2 class="text-xl font-semibold mb-2">Or Email Us Directly</h2>
      <p class="text-gray-700">
        You can also reach us at:
        <a href="mailto:khurammirza354@gmail.com" class="text-blue-600 hover:underline font-medium">
          khurammirza354@gmail.com
        </a>
      </p>
    </section>

    <!-- What to Contact About -->
    <section class="bg-white p-6 rounded-xl border border-gray-200 mb-8">
      <h2 class="text-xl font-semibold mb-2">What to Contact Us About</h2>
      <ul class="list-disc pl-6 space-y-2 text-gray-700">
        <li>Bug reports or issues with a tool</li>
        <li>Suggestions for new tools</li>
        <li>Feedback on the website</li>
        <li>Business or partnership inquiries</li>
      </ul>
    </section>

    <!-- FAQ -->
    <section class="mt-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-3">Frequently Asked Questions</h2>
      <p class="text-gray-600 mb-8">Common questions about contacting us.</p>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <div class="p-5 bg-white rounded-xl border border-gray-200">
            <h3 class="font-semibold mb-2">{faq.q}</h3>
            <p class="text-sm text-gray-600">{faq.a}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- SEO Content -->
    <section class="mt-16">
      <h2 class="text-2xl font-bold mb-4">Get in Touch with ToolsVibe</h2>
      <p class="text-gray-700 mb-4">
        We built ToolsVibe to be a clean, fast, and privacy-friendly alternative to
        cluttered online tool websites. If you have feedback, suggestions, or found a bug,
        we want to hear from you.
      </p>
      <p class="text-gray-700 mb-4">
        Whether you're a student, writer, developer, or business owner, your input helps
        us improve. Every message is read and considered — we genuinely value user
        feedback.
      </p>
      <p class="text-gray-700">
        For quick questions, check our{' '}
        <a href="/blog" class="text-blue-600 hover:underline">blog</a>{' '}
        or browse our{' '}
        <a href="/tools" class="text-blue-600 hover:underline">tools page</a>{' '}
        first — you might find your answer there.
      </p>
    </section>
  </article>
</Layout>