---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact — ToolsSite"
  description="Get in touch with ToolsSite. Send feedback, report bugs, or suggest new tools."
>
  <article class="max-w-3xl mx-auto">
    <h1 class="text-3xl md:text-4xl font-bold mb-4">Contact Us</h1>
    <p class="text-gray-700 mb-8">
      Have feedback, found a bug, or want to suggest a new tool? We'd love to hear from you.
    </p>

    <section class="space-y-6 text-gray-700 leading-relaxed">
      <div class="bg-white p-6 rounded-lg border border-gray-200">
        <h2 class="text-xl font-semibold mb-2">Email</h2>
        <p>
          You can reach us at:
          <a href="mailto:khurammirza354@gmail.com" class="text-blue-600 hover:underline font-medium">
            khurammirza354@gmail.com
          </a>
        </p>
        <p class="text-sm text-gray-500 mt-2">
          (Replace this email with your own before going live.)
        </p>
      </div>

      <div class="bg-white p-6 rounded-lg border border-gray-200">
        <h2 class="text-xl font-semibold mb-2">What to Contact Us About</h2>
        <ul class="list-disc pl-6 space-y-2">
          <li>Bug reports or issues with a tool</li>
          <li>Suggestions for new tools</li>
          <li>Feedback on the website</li>
          <li>Business or partnership inquiries</li>
        </ul>
      </div>

      <div class="bg-white p-6 rounded-lg border border-gray-200">
        <h2 class="text-xl font-semibold mb-2">Response Time</h2>
        <p>
          We usually respond within 1–2 business days. Thanks for your patience!
        </p>
      </div>
    </section>
  </article>
</Layout>