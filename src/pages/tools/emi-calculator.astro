---
import Layout from "../../layouts/Layout.astro";
---

<Layout
    title="ToolsVibe EMI Calculator Pakistan: Real Time Calculate Loan"
    description="Free EMI calculator by ToolsVibe.online. Calculate monthly installments, total interest, and repayment schedules for home, car, and personal loans in Pakistan."
>
    <div class="max-w-3xl mx-auto">
        <header class="mb-8">
            <h1 class="text-3xl md:text-4xl font-bold mb-3">
                Online Loan EMI Calculator
            </h1>
            <p class="text-gray-600 mb-2">
                Easily estimate your monthly installments, total interest, and
                full repayment schedules. Perfect for comparing home, car, and
                personal bank loans in Pakistan.
            </p>
            <p class="text-xs text-gray-500">
                🔒 100% Secure: Calculations run entirely in your browser. Your
                financial data is never saved.
            </p>
        </header>

        <!-- Input Section -->
        <section class="bg-white p-6 rounded-xl border border-gray-200 mb-6">
            <div class="space-y-5">
                <div>
                    <label
                        for="loan-amount"
                        class="block text-sm font-medium mb-2"
                    >
                        Loan Amount (PKR)
                    </label>
                    <input
                        type="number"
                        id="loan-amount"
                        value="2000000"
                        min="0"
                        step="10000"
                        class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                    />
                    <div class="flex gap-2 mt-2">
                        <button
                            data-amount="500000"
                            class="amt-btn px-3 py-1 text-xs bg-gray-100 rounded hover:bg-gray-200 transition"
                            >5 Lakh</button
                        >
                        <button
                            data-amount="1000000"
                            class="amt-btn px-3 py-1 text-xs bg-gray-100 rounded hover:bg-gray-200 transition"
                            >10 Lakh</button
                        >
                        <button
                            data-amount="2000000"
                            class="amt-btn px-3 py-1 text-xs bg-gray-100 rounded hover:bg-gray-200 transition"
                            >20 Lakh</button
                        >
                        <button
                            data-amount="5000000"
                            class="amt-btn px-3 py-1 text-xs bg-gray-100 rounded hover:bg-gray-200 transition"
                            >50 Lakh</button
                        >
                        <button
                            data-amount="10000000"
                            class="amt-btn px-3 py-1 text-xs bg-gray-100 rounded hover:bg-gray-200 transition"
                            >1 Crore</button
                        >
                    </div>
                </div>

                <div>
                    <label
                        for="interest-rate"
                        class="block text-sm font-medium mb-2"
                    >
                        Annual Interest Rate (%)
                    </label>
                    <input
                        type="number"
                        id="interest-rate"
                        value="12"
                        min="0"
                        max="100"
                        step="0.1"
                        class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                    />
                </div>

                <div>
                    <label
                        for="tenure-years"
                        class="block text-sm font-medium mb-2"
                    >
                        Loan Tenure: <span id="tenure-value">5</span> years
                    </label>
                    <input
                        type="range"
                        id="tenure-years"
                        min="1"
                        max="30"
                        value="5"
                        class="w-full"
                    />
                    <div
                        class="flex justify-between text-xs text-gray-500 mt-1"
                    >
                        <span>1 year</span>
                        <span>30 years</span>
                    </div>
                </div>

                <button
                    id="calculate-btn"
                    class="w-full px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium transition"
                >
                    Calculate EMI
                </button>
            </div>
        </section>

        <!-- Results -->
        <section id="results" class="hidden">
            <!-- Main EMI -->
            <div
                class="bg-blue-50 border border-blue-200 p-6 rounded-xl mb-6 text-center"
            >
                <p class="text-sm text-gray-600 mb-2">Monthly EMI</p>
                <p id="emi-result" class="text-4xl font-bold text-blue-700">
                    PKR 0
                </p>
                <p id="emi-sub" class="text-sm text-gray-600 mt-2">—</p>
            </div>

            <!-- Breakdown -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
                <div
                    class="bg-white p-4 rounded-xl border border-gray-200 text-center"
                >
                    <div class="text-xs text-gray-500 mb-1">Principal</div>
                    <div id="principal" class="text-lg font-bold text-gray-700">
                        —
                    </div>
                </div>
                <div
                    class="bg-white p-4 rounded-xl border border-gray-200 text-center"
                >
                    <div class="text-xs text-gray-500 mb-1">Total Interest</div>
                    <div
                        id="total-interest"
                        class="text-lg font-bold text-red-600"
                    >
                        —
                    </div>
                </div>
                <div
                    class="bg-white p-4 rounded-xl border border-gray-200 text-center"
                >
                    <div class="text-xs text-gray-500 mb-1">Total Payment</div>
                    <div
                        id="total-payment"
                        class="text-lg font-bold text-blue-700"
                    >
                        —
                    </div>
                </div>
            </div>

            <!-- Visual Bar -->
            <div class="bg-white p-6 rounded-xl border border-gray-200 mb-6">
                <h3 class="text-lg font-semibold mb-4">
                    Principal vs Interest
                </h3>
                <div class="h-8 rounded-lg overflow-hidden flex">
                    <div
                        id="principal-bar"
                        class="bg-blue-500 transition-all duration-500"
                        style="width: 0%"
                    >
                    </div>
                    <div
                        id="interest-bar"
                        class="bg-red-500 transition-all duration-500"
                        style="width: 0%"
                    >
                    </div>
                </div>
                <div class="flex flex-wrap gap-4 mt-3 text-xs">
                    <span class="flex items-center gap-1"
                        ><span class="w-3 h-3 bg-blue-500 rounded"></span> Principal</span
                    >
                    <span class="flex items-center gap-1"
                        ><span class="w-3 h-3 bg-red-500 rounded"></span> Interest</span
                    >
                </div>
            </div>

            <!-- Yearly Breakdown Table -->
            <div class="bg-white p-6 rounded-xl border border-gray-200">
                <h3 class="text-lg font-semibold mb-4">Yearly Breakdown</h3>
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="border-b border-gray-200">
                                <th class="text-left p-2 font-semibold">Year</th
                                >
                                <th class="text-right p-2 font-semibold"
                                    >Principal Paid</th
                                >
                                <th class="text-right p-2 font-semibold"
                                    >Interest Paid</th
                                >
                                <th class="text-right p-2 font-semibold"
                                    >Balance</th
                                >
                            </tr>
                        </thead>
                        <tbody id="yearly-table"></tbody>
                    </table>
                </div>
            </div>
        </section>
    </div>

    <!-- SEO Content (800+ words) -->
    <section class="max-w-3xl mx-auto mt-16">
        <h2 class="text-2xl font-bold mb-4">About This EMI Calculator</h2>
        <p class="text-gray-700 mb-4">
            This free EMI calculator helps you estimate your monthly loan
            payment (EMI), total interest, and total amount payable. It works
            for home loans, car loans, personal loans, and any other type of
            amortized loan. It runs entirely in your browser — your loan details
            never leave your device.
        </p>
        <p class="text-gray-700 mb-4">
            Whether you're planning to buy a house, finance a car, or take a
            personal loan, knowing your monthly EMI before you sign anything
            helps you make smarter financial decisions. This tool gives you a
            complete breakdown in seconds.
        </p>

        <h3 class="text-xl font-semibold mt-6 mb-3">What is EMI?</h3>
        <p class="text-gray-700 mb-4">
            EMI stands for <strong>Equated Monthly Installment</strong>. It's
            the fixed amount you pay to your lender every month until the loan
            is fully repaid. Each EMI includes both principal (the amount you
            borrowed) and interest (the cost of borrowing). Early EMIs are
            weighted more toward interest, while later ones go more toward
            principal.
        </p>

        <h3 class="text-xl font-semibold mt-6 mb-3">
            How to Use This Calculator
        </h3>
        <ol class="list-decimal pl-6 text-gray-700 space-y-2">
            <li>
                Enter your loan amount in PKR (or use a quick preset like 10
                Lakh or 50 Lakh)
            </li>
            <li>Enter the annual interest rate quoted by your bank</li>
            <li>Set the loan tenure using the slider (1 to 30 years)</li>
            <li>
                Click "Calculate EMI" to see your monthly payment, total
                interest, and total amount payable
            </li>
            <li>
                Review the yearly breakdown to understand how your balance
                decreases over time
            </li>
        </ol>

        <h3 class="text-xl font-semibold mt-6 mb-3">The EMI Formula</h3>
        <p class="text-gray-700 mb-4">
            The amortized EMI formula used by most conventional banks is:
        </p>
        <p
            class="text-gray-700 mb-4 p-3 bg-gray-50 rounded-lg font-mono text-sm"
        >
            EMI = P × r × (1+r)ⁿ ÷ ((1+r)ⁿ − 1)
        </p>
        <p class="text-gray-700 mb-4">Where:</p>
        <ul class="list-disc pl-6 text-gray-700 space-y-2">
            <li><strong>P</strong> = Principal loan amount</li>
            <li>
                <strong>r</strong> = Monthly interest rate (annual rate ÷ 12 ÷ 100)
            </li>
            <li><strong>n</strong> = Total number of monthly installments</li>
        </ul>

        <h3 class="text-xl font-semibold mt-6 mb-3">Common Use Cases</h3>

        <h4 class="font-semibold mt-4 mb-2">1. Home Loan Planning</h4>
        <p class="text-gray-700 mb-4">
            Before applying for a home loan, calculate the EMI for different
            loan amounts and tenures. A 20-year loan has a lower monthly EMI but
            a much higher total interest than a 10-year loan. Use this
            calculator to find the right balance between affordability and cost.
        </p>

        <h4 class="font-semibold mt-4 mb-2">2. Car Loan Comparison</h4>
        <p class="text-gray-700 mb-4">
            Banks offer car loans at different rates and tenures. Enter each
            offer's terms into this calculator and compare the total interest
            and monthly payment side by side.
        </p>

        <h4 class="font-semibold mt-4 mb-2">3. Personal Loan Affordability</h4>
        <p class="text-gray-700 mb-4">
            If you're considering a personal loan for a wedding, education, or
            medical expense, use this tool to check whether the monthly EMI fits
            your budget. A common guideline: your total monthly EMIs should not
            exceed 40% of your net income.
        </p>

        <h4 class="font-semibold mt-4 mb-2">4. Prepayment Planning</h4>
        <p class="text-gray-700 mb-4">
            If you plan to make a lump-sum prepayment, understanding your
            amortization schedule helps you see how much interest you'll save.
            The yearly breakdown shows exactly how much interest is still ahead
            of you.
        </p>

        <h4 class="font-semibold mt-4 mb-2">5. Debt Consolidation Decisions</h4>
        <p class="text-gray-700 mb-4">
            If you have multiple loans, use this calculator to see the total
            monthly burden. It can help you decide whether consolidating into a
            single loan at a lower rate makes sense.
        </p>

        <h4 class="font-semibold mt-4 mb-2">
            6. Comparing Islamic vs Conventional Loans
        </h4>
        <p class="text-gray-700 mb-4">
            Islamic banks (using diminishing musharakah) structure payments
            differently from conventional amortized loans. While this calculator
            uses the conventional formula, it's still useful for estimating what
            the total cost of financing might be — and comparing offers before
            you commit.
        </p>

        <h3 class="text-xl font-semibold mt-6 mb-3">A Worked Example</h3>
        <p class="text-gray-700 mb-4">
            Here's what happens with a typical home loan:
        </p>
        <ul class="list-disc pl-6 text-gray-700 space-y-2">
            <li><strong>Loan amount:</strong> PKR 2,000,000</li>
            <li><strong>Interest rate:</strong> 12% per year</li>
            <li><strong>Tenure:</strong> 5 years (60 months)</li>
            <li><strong>Monthly EMI:</strong> ~PKR 44,489</li>
            <li><strong>Total interest:</strong> ~PKR 669,340</li>
            <li><strong>Total payment:</strong> ~PKR 2,669,340</li>
        </ul>
        <p class="text-gray-700 mt-4 mb-4">
            That's a 33% total cost on top of the principal. If the tenure were
            10 years instead of 5, the monthly EMI would drop to ~PKR 28,694 —
            but total interest would rise to ~PKR 1,443,280.
        </p>

        <h3 class="text-xl font-semibold mt-6 mb-3">Important Notes</h3>
        <ul class="list-disc pl-6 text-gray-700 space-y-2">
            <li>
                <strong>Processing fees:</strong> Most banks charge 1–2% of the loan
                amount as a one-time processing fee. This is not included in the calculation.
            </li>
            <li>
                <strong>Insurance:</strong> Some banks require loan insurance, which
                adds to your monthly cost.
            </li>
            <li>
                <strong>Prepayment penalties:</strong> Some loans have early repayment
                penalties — check the terms.
            </li>
            <li>
                <strong>Rate changes:</strong> Floating-rate loans can change with
                market conditions. This calculator assumes a fixed rate.
            </li>
        </ul>

        <h3 class="text-xl font-semibold mt-6 mb-3">
            Frequently Asked Questions
        </h3>
        <div class="space-y-4 mt-3">
            <div>
                <h4 class="font-semibold text-gray-900">
                    What interest rate should I use?
                </h4>
                <p class="text-gray-700 mt-1">
                    Use the exact rate quoted by your bank in your loan offer
                    letter. Rates vary significantly based on the bank, loan
                    type, tenure, and your credit profile.
                </p>
            </div>
            <div>
                <h4 class="font-semibold text-gray-900">
                    Does a longer tenure reduce my EMI?
                </h4>
                <p class="text-gray-700 mt-1">
                    Yes, a longer tenure reduces your monthly EMI but increases
                    the total interest you pay over the life of the loan. A
                    shorter tenure has a higher EMI but saves on total interest.
                </p>
            </div>
            <div>
                <h4 class="font-semibold text-gray-900">
                    Is this EMI calculator accurate?
                </h4>
                <p class="text-gray-700 mt-1">
                    It uses the standard amortized loan formula. Note that
                    Islamic banks (using diminishing musharakah) and flat-rate
                    loans calculate differently. Always confirm the exact EMI
                    with your bank before signing a loan agreement.
                </p>
            </div>
            <div>
                <h4 class="font-semibold text-gray-900">
                    Does this include processing fees or insurance?
                </h4>
                <p class="text-gray-700 mt-1">
                    No. The calculator only covers principal and interest.
                    Real-world figures may include processing fees (1–2%),
                    insurance, and other charges.
                </p>
            </div>
            <div>
                <h4 class="font-semibold text-gray-900">
                    Can I use this for a car loan?
                </h4>
                <p class="text-gray-700 mt-1">
                    Yes. The same formula applies to any amortized loan — car
                    loans, home loans, personal loans, and business loans.
                </p>
            </div>
            <div>
                <h4 class="font-semibold text-gray-900">
                    Is my financial data safe?
                </h4>
                <p class="text-gray-700 mt-1">
                    Yes. All calculations happen in your browser. Your loan
                    amount, interest rate, and tenure are never sent to any
                    server.
                </p>
            </div>
        </div>
    </section>

    <!-- Related Tools & Guides -->
    <section class="max-w-3xl mx-auto mt-16">
        <h2 class="text-2xl font-bold mb-6">Related Tools</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-10">
            <a
                href="/tools/salary-tax-calculator/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-semibold mb-1">Salary Tax Calculator</h3>
                <p class="text-sm text-gray-600">
                    Calculate take-home salary for Pakistan.
                </p>
            </a>
            <a
                href="/tools/freelancer-tax-calculator/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-semibold mb-1">Freelancer Tax Calculator</h3>
                <p class="text-sm text-gray-600">
                    Tax for IT export and local freelance income.
                </p>
            </a>
            <a
                href="/tools/zakat-calculator/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-semibold mb-1">Zakat Calculator</h3>
                <p class="text-sm text-gray-600">
                    Calculate Zakat on gold, silver, and cash.
                </p>
            </a>
        </div>

        <h2 class="text-2xl font-bold mb-6">Related Guides</h2>
        <div class="space-y-3">
            <a
                href="/blog/salary-tax-pakistan/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-medium">
                    How to Calculate Salary Tax in Pakistan
                </h3>
                <p class="text-sm text-gray-600">Complete FBR slab guide.</p>
            </a>
            <a
                href="/blog/how-to-save-tax-pakistan/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-medium">
                    7 Legal Ways to Save Tax in Pakistan
                </h3>
                <p class="text-sm text-gray-600">Tax credits and deductions.</p>
            </a>
        </div>
    </section>

    <script>
        const loanAmount = document.getElementById(
            "loan-amount",
        ) as HTMLInputElement;
        const interestRate = document.getElementById(
            "interest-rate",
        ) as HTMLInputElement;
        const tenureYears = document.getElementById(
            "tenure-years",
        ) as HTMLInputElement;
        const tenureValue = document.getElementById("tenure-value")!;
        const calculateBtn = document.getElementById("calculate-btn")!;
        const results = document.getElementById("results")!;
        const amtBtns =
            document.querySelectorAll<HTMLButtonElement>(".amt-btn");

        function formatPKR(num: number): string {
            return "PKR " + Math.round(num).toLocaleString("en-US");
        }

        function calculateEMI(
            principal: number,
            annualRate: number,
            years: number,
        ) {
            const monthlyRate = annualRate / 12 / 100;
            const months = years * 12;

            let emi: number;
            if (monthlyRate === 0) {
                emi = principal / months;
            } else {
                const factor = Math.pow(1 + monthlyRate, months);
                emi = (principal * monthlyRate * factor) / (factor - 1);
            }

            const totalPayment = emi * months;
            const totalInterest = totalPayment - principal;

            return { emi, totalPayment, totalInterest, months, monthlyRate };
        }

        function calculate() {
            const principal = parseFloat(loanAmount.value) || 0;
            const rate = parseFloat(interestRate.value) || 0;
            const years = parseInt(tenureYears.value) || 1;

            if (principal <= 0) {
                alert("Please enter a valid loan amount.");
                return;
            }

            const { emi, totalPayment, totalInterest, months, monthlyRate } =
                calculateEMI(principal, rate, years);

            document.getElementById("emi-result")!.textContent = formatPKR(emi);
            document.getElementById("emi-sub")!.textContent =
                `${years} year${years > 1 ? "s" : ""} (${months} months) at ${rate}% per year`;

            document.getElementById("principal")!.textContent =
                formatPKR(principal);
            document.getElementById("total-interest")!.textContent =
                formatPKR(totalInterest);
            document.getElementById("total-payment")!.textContent =
                formatPKR(totalPayment);

            // Visual bar
            const principalPct = (principal / totalPayment) * 100;
            const interestPct = 100 - principalPct;
            document.getElementById("principal-bar")!.style.width =
                principalPct + "%";
            document.getElementById("interest-bar")!.style.width =
                interestPct + "%";

            // Yearly breakdown
            const tableBody = document.getElementById("yearly-table")!;
            tableBody.innerHTML = "";

            let balance = principal;
            for (let y = 1; y <= years; y++) {
                let yearlyPrincipal = 0;
                let yearlyInterest = 0;
                for (let m = 0; m < 12; m++) {
                    const monthInterest = balance * monthlyRate;
                    const monthPrincipal = emi - monthInterest;
                    yearlyInterest += monthInterest;
                    yearlyPrincipal += monthPrincipal;
                    balance -= monthPrincipal;
                }
                if (balance < 0) balance = 0;

                const row = document.createElement("tr");
                row.className = "border-b border-gray-100";
                row.innerHTML = `
          <td class="p-2 font-medium">Year ${y}</td>
          <td class="p-2 text-right">${formatPKR(yearlyPrincipal)}</td>
          <td class="p-2 text-right text-red-600">${formatPKR(yearlyInterest)}</td>
          <td class="p-2 text-right text-gray-600">${formatPKR(balance)}</td>
        `;
                tableBody.appendChild(row);
            }

            results.classList.remove("hidden");
        }

        tenureYears.addEventListener("input", () => {
            tenureValue.textContent = tenureYears.value;
        });

        amtBtns.forEach((btn) => {
            btn.addEventListener("click", () => {
                loanAmount.value = btn.dataset.amount!;
            });
        });

        calculateBtn.addEventListener("click", () => {
            calculate();
            results.scrollIntoView({ behavior: "smooth" });
        });

        calculate();
    </script>

    <script
        type="application/ld+json"
        set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "SoftwareApplication",
            name: "EMI Calculator",
            applicationCategory: "FinanceApplication",
            operatingSystem: "Any",
            description:
                "Free EMI calculator for Pakistan. Calculate monthly loan EMI, total interest, and yearly breakdown for home, car, and personal loans.",
            offers: { "@type": "Offer", price: "0", priceCurrency: "PKR" },
        })}
    />

    <script
        type="application/ld+json"
        set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "FAQPage",
            mainEntity: [
                {
                    "@type": "Question",
                    name: "What interest rate should I use?",
                    acceptedAnswer: {
                        "@type": "Answer",
                        text: "Use the exact rate quoted by your bank in your loan offer letter. Rates vary significantly based on the bank, loan type, tenure, and your credit profile.",
                    },
                },
                {
                    "@type": "Question",
                    name: "Does a longer tenure reduce my EMI?",
                    acceptedAnswer: {
                        "@type": "Answer",
                        text: "Yes, a longer tenure reduces your monthly EMI but increases the total interest you pay over the life of the loan.",
                    },
                },
                {
                    "@type": "Question",
                    name: "Is this EMI calculator accurate?",
                    acceptedAnswer: {
                        "@type": "Answer",
                        text: "It uses the standard amortized loan formula. Note that Islamic banks (using diminishing musharakah) and flat-rate loans calculate differently. Always confirm the exact EMI with your bank before signing a loan agreement.",
                    },
                },
                {
                    "@type": "Question",
                    name: "Is my financial data safe?",
                    acceptedAnswer: {
                        "@type": "Answer",
                        text: "Yes. All calculations happen in your browser. Your loan amount, interest rate, and tenure are never sent to any server.",
                    },
                },
            ],
        })}
    />
</Layout>
