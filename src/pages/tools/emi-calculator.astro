---
import Layout from "../../layouts/Layout.astro";

const siteUrl = "https://toolsvibe.online";
const rawPath = Astro.url.pathname;
const normalizedPath =
    rawPath.endsWith("/") || /\.[a-z0-9]+$/i.test(rawPath)
        ? rawPath
        : `${rawPath}/`;
const pageUrl = new URL(normalizedPath, siteUrl).href;

// <= 58 chars && >= 50 chars
const pageTitle = "EMI Calculator Pakistan: Monthly Loan Payment & Interest";

// <= 150 chars && >= 140 chars
const pageDescription =
    "Free Pakistan EMI calculator in PKR. Work out your monthly installment, total interest, and yearly breakdown for home, car, and personal loans.";

// Single source of truth: shown on the page AND used for the FAQ schema,
// so the visible text and the structured data always match.
const faqs = [
    {
        q: "How is monthly EMI calculated for a loan in Pakistan?",
        a: "Monthly EMI is calculated using the standard amortized loan formula based on principal (P), monthly interest rate (r), and total months (n). Enter your loan amount, annual rate, and tenure to see your monthly installment and yearly schedule.",
    },
    {
        q: "What interest rate or KIBOR rate should I use?",
        a: "Use the annual rate quoted in your bank offer letter. In Pakistan, floating-rate loans are often linked to KIBOR plus a bank spread, so check whether your rate is fixed or resets periodically.",
    },
    {
        q: "Does a longer loan tenure reduce monthly EMI?",
        a: "Yes, a longer tenure lowers your monthly EMI but increases the total interest paid over the loan period. A shorter tenure increases monthly EMI while reducing total interest.",
    },
    {
        q: "Does this work for car loans, home loans, and personal loans?",
        a: "Yes. Any standard amortized loan—including auto financing, home loans, personal loans, and business loans—follows the same repayment math.",
    },
    {
        q: "How do Islamic bank loans or diminishing musharakah differ?",
        a: "Islamic banks using diminishing musharakah structure payments differently from conventional interest-bearing loans. This calculator provides a general estimate. Confirm exact terms and schedules directly with your bank.",
    },
    {
        q: "Are processing fees, insurance, or taxes included?",
        a: "No. The figures cover principal and interest only. Processing fees, takaful/insurance, and bank charges can add to your actual cost.",
    },
    {
        q: "Is my financial data saved or sent to a server?",
        a: "No. All calculations run locally in your browser, and your loan inputs are never stored or uploaded.",
    },
];

const structuredData = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "WebApplication",
            "@id": `${pageUrl}#webapp`,
            name: "EMI Calculator Pakistan",
            url: pageUrl,
            applicationCategory: "FinanceApplication",
            operatingSystem: "Any",
            browserRequirements: "Requires JavaScript",
            inLanguage: "en",
            isAccessibleForFree: true,
            description: pageDescription,
            featureList: [
                "Monthly EMI calculation in PKR",
                "Total interest and total repayment breakdown",
                "Principal vs. interest visual comparison",
                "Year-by-year loan amortization table",
                "100% browser-based calculation with zero data storage",
            ],
            offers: {
                "@type": "Offer",
                price: "0",
                priceCurrency: "PKR",
            },
            author: {
                "@id": `${siteUrl}/#organization`,
            },
            publisher: {
                "@id": `${siteUrl}/#organization`,
            },
        },
        {
            "@type": "BreadcrumbList",
            "@id": `${pageUrl}#breadcrumb`,
            itemListElement: [
                {
                    "@type": "ListItem",
                    position: 1,
                    name: "Home",
                    item: `${siteUrl}/`,
                },
                {
                    "@type": "ListItem",
                    position: 2,
                    name: "Tools",
                    item: `${siteUrl}/tools/`,
                },
                {
                    "@type": "ListItem",
                    position: 3,
                    name: "EMI Calculator",
                    item: pageUrl,
                },
            ],
        },
        {
            "@type": "FAQPage",
            "@id": `${pageUrl}#faq`,
            mainEntity: faqs.map((f) => ({
                "@type": "Question",
                name: f.q,
                acceptedAnswer: {
                    "@type": "Answer",
                    text: f.a,
                },
            })),
        },
    ],
};
---

<Layout title={pageTitle} description={pageDescription}>
    <div class="max-w-3xl mx-auto">
        <header class="mb-8">
            <nav aria-label="Breadcrumb" class="text-xs text-gray-500 mb-4">
                <a href="/" class="hover:underline">
                    Home
                </a>
                <span aria-hidden="true"> / </span>
                <a href="/tools/" class="hover:underline">
                    Tools
                </a>
                <span aria-hidden="true"> / </span>
                <span>EMI Calculator</span>
            </nav>
            <h1 class="text-3xl md:text-4xl font-bold mb-3">
                Loan EMI Calculator for Pakistan
            </h1>
            <p class="text-gray-600 mb-2">
                Estimate your monthly loan installment, total interest, and
                yearly repayment schedule in PKR for home, car, and personal
                loans.
            </p>
            <p class="text-xs text-gray-500">
                100% Private: Calculations run in your browser. Your loan
                details are never saved or sent anywhere.
            </p>
        </header>

        <!-- Input Section -->
        <section
            aria-label="Loan EMI inputs"
            class="bg-white p-6 rounded-xl border border-gray-200 mb-6"
        >
            <div class="space-y-5">
                <div>
                    <label
                        for="loan-amount"
                        class="block text-sm font-medium mb-2"
                    >
                        Loan Amount (PKR)
                    </label>
                    <input
                        type="number"
                        id="loan-amount"
                        value="2000000"
                        min="0"
                        step="10000"
                        class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                    />
                    <div class="flex flex-wrap gap-2 mt-2">
                        <button
                            type="button"
                            data-amount="500000"
                            class="amt-btn px-3 py-1 text-xs bg-gray-100 rounded hover:bg-gray-200 transition"
                        >
                            5 Lakh
                        </button>
                        <button
                            type="button"
                            data-amount="1000000"
                            class="amt-btn px-3 py-1 text-xs bg-gray-100 rounded hover:bg-gray-200 transition"
                        >
                            10 Lakh
                        </button>
                        <button
                            type="button"
                            data-amount="2000000"
                            class="amt-btn px-3 py-1 text-xs bg-gray-100 rounded hover:bg-gray-200 transition"
                        >
                            20 Lakh
                        </button>
                        <button
                            type="button"
                            data-amount="5000000"
                            class="amt-btn px-3 py-1 text-xs bg-gray-100 rounded hover:bg-gray-200 transition"
                        >
                            50 Lakh
                        </button>
                        <button
                            type="button"
                            data-amount="10000000"
                            class="amt-btn px-3 py-1 text-xs bg-gray-100 rounded hover:bg-gray-200 transition"
                        >
                            1 Crore
                        </button>
                    </div>
                </div>

                <div>
                    <label
                        for="interest-rate"
                        class="block text-sm font-medium mb-2"
                    >
                        Annual Interest Rate (%)
                    </label>
                    <input
                        type="number"
                        id="interest-rate"
                        value="12"
                        min="0"
                        max="100"
                        step="0.1"
                        class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                    />
                </div>

                <div>
                    <label
                        for="tenure-years"
                        class="block text-sm font-medium mb-2"
                    >
                        Loan Tenure: <span id="tenure-value">5</span> years
                    </label>
                    <input
                        type="range"
                        id="tenure-years"
                        min="1"
                        max="30"
                        value="5"
                        class="w-full"
                    />
                    <div class="flex justify-between text-xs text-gray-500 mt-1">
                        <span>1 year</span>
                        <span>30 years</span>
                    </div>
                </div>

                <p
                    id="error"
                    role="alert"
                    class="hidden text-sm text-red-600"
                ></p>

                <button
                    type="button"
                    id="calculate-btn"
                    class="w-full px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium transition"
                >
                    Calculate EMI
                </button>
            </div>
        </section>

        <!-- Results -->
        <section id="results" class="hidden" aria-live="polite">
            <!-- Main EMI -->
            <div class="bg-blue-50 border border-blue-200 p-6 rounded-xl mb-6 text-center">
                <p class="text-sm text-gray-600 mb-2">Monthly EMI</p>
                <p id="emi-result" class="text-4xl font-bold text-blue-700">
                    PKR 0
                </p>
                <p id="emi-sub" class="text-sm text-gray-600 mt-2">
                    —
                </p>
            </div>

            <!-- Breakdown -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
                <div class="bg-white p-4 rounded-xl border border-gray-200 text-center">
                    <div class="text-xs text-gray-500 mb-1">Principal</div>
                    <div id="principal" class="text-lg font-bold text-gray-700">
                        —
                    </div>
                </div>
                <div class="bg-white p-4 rounded-xl border border-gray-200 text-center">
                    <div class="text-xs text-gray-500 mb-1">Total Interest</div>
                    <div
                        id="total-interest"
                        class="text-lg font-bold text-red-600"
                    >
                        —
                    </div>
                </div>
                <div class="bg-white p-4 rounded-xl border border-gray-200 text-center">
                    <div class="text-xs text-gray-500 mb-1">Total Payment</div>
                    <div
                        id="total-payment"
                        class="text-lg font-bold text-blue-700"
                    >
                        —
                    </div>
                </div>
            </div>

            <!-- Visual Bar -->
            <div class="bg-white p-6 rounded-xl border border-gray-200 mb-6">
                <h2 class="text-lg font-semibold mb-4">
                    Principal vs Interest
                </h2>
                <div class="h-8 rounded-lg overflow-hidden flex">
                    <div
                        id="principal-bar"
                        class="bg-blue-500 transition-all duration-500"
                        style="width: 0%"
                    ></div>
                    <div
                        id="interest-bar"
                        class="bg-red-500 transition-all duration-500"
                        style="width: 0%"
                    ></div>
                </div>
                <div class="flex flex-wrap gap-4 mt-3 text-xs">
                    <span class="flex items-center gap-1">
                        <span class="w-3 h-3 bg-blue-500 rounded"></span>
                        Principal
                    </span>
                    <span class="flex items-center gap-1">
                        <span class="w-3 h-3 bg-red-500 rounded"></span>
                        Interest
                    </span>
                </div>
            </div>

            <!-- Yearly Breakdown Table -->
            <div class="bg-white p-6 rounded-xl border border-gray-200">
                <h2 class="text-lg font-semibold mb-4">Yearly Breakdown</h2>
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="border-b border-gray-200">
                                <th class="text-left p-2 font-semibold">
                                    Year
                                </th>
                                <th class="text-right p-2 font-semibold">
                                    Principal Paid
                                </th>
                                <th class="text-right p-2 font-semibold">
                                    Interest Paid
                                </th>
                                <th class="text-right p-2 font-semibold">
                                    Balance
                                </th>
                            </tr>
                        </thead>
                        <tbody id="yearly-table"></tbody>
                    </table>
                </div>
            </div>
        </section>
    </div>

    <!-- SEO Content -->
    <section class="max-w-3xl mx-auto mt-16">
        <h2 class="text-2xl font-bold mb-4">About This EMI Calculator</h2>
        <p class="text-gray-700 mb-4">
            This free EMI calculator helps you estimate your monthly loan
            installment, total interest, and total repayment in PKR. It works
            usefully for home loans, car loans, personal loans, and other
            amortized loans, with all calculations running directly in your
            browser.
        </p>
        <p class="text-gray-700 mb-4">
            Checking your monthly payment before applying makes it easier to
            compare bank offers, adjust loan tenure, and see how interest adds
            up over time.
        </p>

        <h2 class="text-2xl font-bold mt-10 mb-3">What Is EMI?</h2>
        <p class="text-gray-700 mb-4">
            EMI stands for <strong>Equated Monthly Installment</strong>—the
            fixed monthly payment made to a lender until the loan is paid off.
            Each payment covers both principal and interest, with interest
            typically making up a larger share in the earlier months and
            principal growing over time.
        </p>

        <h2 class="text-2xl font-bold mt-10 mb-3">
            How to Use This Calculator
        </h2>
        <ol class="list-decimal pl-6 text-gray-700 space-y-2">
            <li>
                Enter your loan amount in PKR (or pick a preset like 5 Lakh, 10
                Lakh, 20 Lakh, 50 Lakh, or 1 Crore)
            </li>
            <li>Enter the annual interest rate quoted by your bank</li>
            <li>Select your loan tenure from 1 to 30 years using the slider</li>
            <li>
                View your monthly EMI, total interest, total payment, and yearly
                amortization breakdown
            </li>
        </ol>

        <h2 class="text-2xl font-bold mt-10 mb-3">The EMI Formula</h2>
        <p class="text-gray-700 mb-4">
            Standard amortized loans use this formula to calculate monthly EMI:
        </p>
        <p class="text-gray-700 mb-4 p-3 bg-gray-50 rounded-lg font-mono text-sm">
            EMI = P × r × (1+r)ⁿ ÷ ((1+r)ⁿ − 1)
        </p>
        <ul class="list-disc pl-6 text-gray-700 space-y-2">
            <li>
                <strong>P</strong> = Principal loan amount
            </li>
            <li>
                <strong>r</strong> = Monthly interest rate (annual rate ÷ 12 ÷
                100)
            </li>
            <li>
                <strong>n</strong> = Total number of monthly installments
            </li>
        </ul>

        <h2 class="text-2xl font-bold mt-10 mb-3">Common Use Cases</h2>

        <h3 class="text-lg font-semibold mt-4 mb-2">
            1. Home Loan Tenure and Affordability Planning
        </h3>
        <p class="text-gray-700 mb-4">
            Compare shorter and longer tenures to see how monthly EMI trades off
            against total interest over 10, 15, or 20 years before committing to
            a mortgage or home financing plan.
        </p>

        <h3 class="text-lg font-semibold mt-4 mb-2">
            2. Car Loan Offer Comparison
        </h3>
        <p class="text-gray-700 mb-4">
            Test different auto loan rates and tenures side by side to compare
            monthly installments and total borrowing cost across banks.
        </p>

        <h3 class="text-lg font-semibold mt-4 mb-2">
            3. Personal Loan Budget Check
        </h3>
        <p class="text-gray-700 mb-4">
            Check whether a monthly personal loan installment fits comfortably
            alongside your regular household expenses and monthly income.
        </p>

        <h3 class="text-lg font-semibold mt-4 mb-2">
            4. Prepayment and Debt Consolidation Planning
        </h3>
        <p class="text-gray-700 mb-4">
            Use the yearly breakdown to see how remaining principal declines
            each year, or compare multiple existing loans against a single
            consolidated loan at a lower rate.
        </p>

        <h2 class="text-2xl font-bold mt-10 mb-3">A Worked Example</h2>
        <p class="text-gray-700 mb-4">
            For a sample loan of <strong>PKR 2,000,000</strong> at{" "}
            <strong>12%</strong> annual interest over <strong>5 years</strong>{" "}
            (60 months):
        </p>
        <ul class="list-disc pl-6 text-gray-700 space-y-2">
            <li>
                <strong>Monthly EMI:</strong> PKR 44,489
            </li>
            <li>
                <strong>Total interest:</strong> PKR 669,334
            </li>
            <li>
                <strong>Total payment:</strong> PKR 2,669,334
            </li>
        </ul>
        <p class="text-gray-700 mt-4 mb-4">
            Extending the same PKR 2,000,000 loan to 10 years at 12% lowers the
            monthly EMI to PKR 28,694, while total interest increases to PKR
            1,443,303.
        </p>

        <h2 class="text-2xl font-bold mt-10 mb-3">Important Notes</h2>
        <ul class="list-disc pl-6 text-gray-700 space-y-2">
            <li>
                <strong>KIBOR & floating rates:</strong> Many loans in Pakistan
                are priced on a floating basis (such as KIBOR plus a spread) and
                can reset periodically, whereas this calculator models a fixed
                rate.
            </li>
            <li>
                <strong>Islamic financing:</strong> Diminishing musharakah and
                other Islamic structures work differently from conventional
                amortized interest—confirm exact schedules with your bank.
            </li>
            <li>
                <strong>Extra charges:</strong> Processing fees,
                insurance/takaful, and any early settlement terms are separate
                from base principal and interest.
            </li>
        </ul>

        <h2 class="text-2xl font-bold mt-10 mb-3">
            Frequently Asked Questions
        </h2>
        <div class="space-y-4 mt-3">
            {faqs.map((f) => (
                <div>
                    <h3 class="text-base font-semibold text-gray-900">{f.q}</h3>
                    <p class="text-gray-700 mt-1">{f.a}</p>
                </div>
            ))}
        </div>
    </section>

    <!-- Related Tools -->
    <section class="max-w-3xl mx-auto mt-16">
        <h2 class="text-2xl font-bold mb-6">Related Tools</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-10">
            <a
                href="/tools/salary-tax-calculator/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-semibold mb-1">Salary Tax Calculator</h3>
                <p class="text-sm text-gray-600">
                    Calculate take-home salary for Pakistan.
                </p>
            </a>
            <a
                href="/tools/freelancer-tax-calculator/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-semibold mb-1">Freelancer Tax Calculator</h3>
                <p class="text-sm text-gray-600">
                    Tax for IT export and local freelance income.
                </p>
            </a>
            <a
                href="/tools/zakat-calculator/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-semibold mb-1">Zakat Calculator</h3>
                <p class="text-sm text-gray-600">
                    Calculate Zakat on gold, silver, and cash.
                </p>
            </a>
        </div>
    </section>

    <script>
        const loanAmount = document.getElementById(
            "loan-amount",
        ) as HTMLInputElement;
        const interestRate = document.getElementById(
            "interest-rate",
        ) as HTMLInputElement;
        const tenureYears = document.getElementById(
            "tenure-years",
        ) as HTMLInputElement;
        const tenureValue = document.getElementById("tenure-value")!;
        const calculateBtn = document.getElementById("calculate-btn")!;
        const results = document.getElementById("results")!;
        const errorBox = document.getElementById("error")!;
        const amtBtns =
            document.querySelectorAll<HTMLButtonElement>(".amt-btn");

        function formatPKR(num: number): string {
            return "PKR " + Math.round(num).toLocaleString("en-US");
        }

        function calculateEMI(
            principal: number,
            annualRate: number,
            years: number,
        ) {
            const monthlyRate = annualRate / 12 / 100;
            const months = years * 12;

            let emi: number;
            if (monthlyRate === 0) {
                emi = principal / months;
            } else {
                const factor = Math.pow(1 + monthlyRate, months);
                emi = (principal * monthlyRate * factor) / (factor - 1);
            }

            const totalPayment = emi * months;
            const totalInterest = totalPayment - principal;

            return { emi, totalPayment, totalInterest, months, monthlyRate };
        }

        function calculate(): boolean {
            const principal = parseFloat(loanAmount.value);
            const rate = parseFloat(interestRate.value);
            const years = parseInt(tenureYears.value, 10);

            let message = "";
            if (!(principal > 0)) {
                message = "Please enter a valid loan amount.";
            } else if (!(rate >= 0 && rate <= 100)) {
                message = "Please enter an interest rate between 0 and 100.";
            } else if (!(years >= 1)) {
                message = "Please choose a loan tenure of at least 1 year.";
            }

            if (message) {
                results.classList.add("hidden");
                errorBox.textContent = message;
                errorBox.classList.remove("hidden");
                return false;
            }
            errorBox.classList.add("hidden");

            const { emi, totalPayment, totalInterest, months, monthlyRate } =
                calculateEMI(principal, rate, years);

            document.getElementById("emi-result")!.textContent = formatPKR(emi);
            document.getElementById("emi-sub")!.textContent =
                `${years} year${years > 1 ? "s" : ""} (${months} months) at ${rate}% per year`;

            document.getElementById("principal")!.textContent =
                formatPKR(principal);
            document.getElementById("total-interest")!.textContent =
                formatPKR(totalInterest);
            document.getElementById("total-payment")!.textContent =
                formatPKR(totalPayment);

            const principalPct =
                totalPayment > 0 ? (principal / totalPayment) * 100 : 100;
            const interestPct = 100 - principalPct;
            document.getElementById("principal-bar")!.style.width =
                principalPct + "%";
            document.getElementById("interest-bar")!.style.width =
                interestPct + "%";

            const tableBody = document.getElementById("yearly-table")!;
            tableBody.innerHTML = "";

            let balance = principal;
            for (let y = 1; y <= years; y++) {
                let yearlyPrincipal = 0;
                let yearlyInterest = 0;
                for (let m = 0; m < 12; m++) {
                    const monthInterest = balance * monthlyRate;
                    const monthPrincipal = emi - monthInterest;
                    yearlyInterest += monthInterest;
                    yearlyPrincipal += monthPrincipal;
                    balance -= monthPrincipal;
                }
                if (balance < 0) balance = 0;

                const row = document.createElement("tr");
                row.className = "border-b border-gray-100";
                row.innerHTML = `
          <td class="p-2 font-medium">Year ${y}</td>
          <td class="p-2 text-right">${formatPKR(yearlyPrincipal)}</td>
          <td class="p-2 text-right text-red-600">${formatPKR(yearlyInterest)}</td>
          <td class="p-2 text-right text-gray-600">${formatPKR(balance)}</td>
        `;
                tableBody.appendChild(row);
            }

            results.classList.remove("hidden");
            return true;
        }

        tenureYears.addEventListener("input", () => {
            tenureValue.textContent = tenureYears.value;
            calculate();
        });
        loanAmount.addEventListener("input", () => calculate());
        interestRate.addEventListener("input", () => calculate());

        amtBtns.forEach((btn) => {
            btn.addEventListener("click", () => {
                if (btn.dataset.amount) {
                    loanAmount.value = btn.dataset.amount;
                    calculate();
                }
            });
        });

        calculateBtn.addEventListener("click", () => {
            if (calculate()) {
                results.scrollIntoView({ behavior: "smooth" });
            }
        });

        calculate();
    </script>

    <script
        type="application/ld+json"
        set:html={JSON.stringify(structuredData)}
    />
</Layout>
