---
import Layout from "../../layouts/Layout.astro";
---

<Layout
    title="Image Compressor — Compress JPG, PNG & WebP Online Free"
    description="Compress JPG, PNG, and WebP images online for free. Reduce image file size without losing quality. No signup, no upload to server."
>
    <div class="max-w-3xl mx-auto">
        <header class="mb-8">
            <h1 class="text-3xl md:text-4xl font-bold mb-3">
                Image Compressor
            </h1>
            <p class="text-gray-600 mb-2">
                Compress JPG, PNG, and WebP images right in your browser. No
                upload, no signup, 100% private.
            </p>
            <p class="text-xs text-gray-500">
                Works entirely in your browser. Your images never leave your
                device.
            </p>
        </header>

        <!-- Upload Section -->
        <section class="bg-white p-6 rounded-xl border border-gray-200 mb-6">
            <div
                id="drop-zone"
                class="border-2 border-dashed border-gray-300 rounded-lg p-8 text-center hover:border-blue-400 transition cursor-pointer"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="48"
                    height="48"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="#2563eb"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="mx-auto mb-3"
                >
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="17 8 12 3 7 8"></polyline>
                    <line x1="12" y1="3" x2="12" y2="15"></line>
                </svg>
                <p class="font-medium mb-1">Click or tap to choose an image</p>
                <p class="text-sm text-gray-500">JPG, PNG, or WebP</p>
                <input
                    type="file"
                    id="file-input"
                    accept="image/jpeg,image/png,image/webp"
                    class="hidden"
                />
            </div>

            <div class="mt-4">
                <label for="quality" class="block text-sm font-medium mb-2">
                    Compression Quality: <span id="quality-value">70</span>%
                </label>
                <input
                    type="range"
                    id="quality"
                    min="10"
                    max="100"
                    value="70"
                    class="w-full"
                />
                <div class="flex justify-between text-xs text-gray-500 mt-1">
                    <span>Smaller file</span>
                    <span>Better quality</span>
                </div>
            </div>

            <button
                id="compress-btn"
                class="mt-4 px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium transition disabled:opacity-50 disabled:cursor-not-allowed"
                disabled
            >
                Compress Image
            </button>
        </section>

        <!-- Results -->
        <section id="results" class="hidden">
            <div class="bg-white p-6 rounded-xl border border-gray-200 mb-6">
                <h2 class="text-xl font-semibold mb-4">Compression Result</h2>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
                    <div class="bg-gray-50 p-4 rounded-lg text-center">
                        <div class="text-sm text-gray-500 mb-1">
                            Original Size
                        </div>
                        <div
                            id="original-size"
                            class="text-lg font-bold text-gray-700"
                        >
                            —
                        </div>
                    </div>
                    <div class="bg-green-50 p-4 rounded-lg text-center">
                        <div class="text-sm text-gray-500 mb-1">
                            Compressed Size
                        </div>
                        <div
                            id="compressed-size"
                            class="text-lg font-bold text-green-600"
                        >
                            —
                        </div>
                    </div>
                    <div class="bg-blue-50 p-4 rounded-lg text-center">
                        <div class="text-sm text-gray-500 mb-1">Saved</div>
                        <div
                            id="saved-percent"
                            class="text-lg font-bold text-blue-600"
                        >
                            —
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <p class="text-sm font-medium mb-2">Original</p>
                        <img
                            id="preview-original"
                            class="w-full rounded-lg border border-gray-200"
                            alt="Original"
                        />
                    </div>
                    <div>
                        <p class="text-sm font-medium mb-2">Compressed</p>
                        <img
                            id="preview-compressed"
                            class="w-full rounded-lg border border-gray-200"
                            alt="Compressed"
                        />
                    </div>
                </div>

                <div class="flex flex-wrap gap-3 mt-6">
                    <a
                        id="download-btn"
                        class="px-6 py-3 bg-green-600 text-white rounded-lg hover:bg-green-700 font-medium transition"
                        download
                    >
                        Download Compressed Image
                    </a>
                    <button
                        id="reset-btn"
                        class="px-6 py-3 bg-gray-200 text-gray-800 rounded-lg hover:bg-gray-300 font-medium transition"
                    >
                        Compress Another Image
                    </button>
                </div>
            </div>
        </section>
    </div>

    <!-- SEO Content (800+ words) -->
    <section class="max-w-3xl mx-auto mt-16">
        <h2 class="text-2xl font-bold mb-4">About This Image Compressor</h2>
        <p class="text-gray-700 mb-4">
            This free online image compressor lets you reduce the file size of
            JPG, PNG, and WebP images without any visible loss in quality.
            Whether you're preparing photos for a website, sending images over
            WhatsApp, or uploading files to a form with strict size limits, this
            tool gets the job done in seconds — right in your browser, with no
            upload and no signup.
        </p>
        <p class="text-gray-700 mb-4">
            Most image compression tools upload your files to a server, process
            them, and send them back. This tool works differently. Everything
            happens on your device using JavaScript. That means your images
            never leave your computer or phone — a big advantage for anyone
            handling private photos, client work, or sensitive documents.
        </p>

        <h3 class="text-xl font-semibold mt-6 mb-3">How to Use</h3>
        <ol class="list-decimal pl-6 text-gray-700 space-y-2">
            <li>
                Click or tap the upload area to choose an image from your device
            </li>
            <li>
                Adjust the compression quality using the slider (70% is a good
                starting point)
            </li>
            <li>Click "Compress Image"</li>
            <li>Compare the original and compressed versions side by side</li>
            <li>Download the compressed image to your device</li>
        </ol>

        <h3 class="text-xl font-semibold mt-6 mb-3">Why Use This Tool?</h3>
        <ul class="list-disc pl-6 text-gray-700 space-y-2">
            <li>
                <strong>Privacy first:</strong> Your images never leave your browser.
                No server, no storage, no tracking.
            </li>
            <li>
                <strong>No signup:</strong> Open the tool, compress an image, download
                it. That's it.
            </li>
            <li>
                <strong>Free with no limits:</strong> Compress as many images as you
                want, as often as you want.
            </li>
            <li>
                <strong>Works on any device:</strong> Desktop, laptop, tablet, or
                phone — no app needed.
            </li>
            <li>
                <strong>Adjustable quality:</strong> You control the trade-off between
                file size and image quality.
            </li>
        </ul>

        <h3 class="text-xl font-semibold mt-6 mb-3">Real Use Cases</h3>

        <h4 class="font-semibold mt-4 mb-2">
            1. Preparing Images for a Website
        </h4>
        <p class="text-gray-700 mb-4">
            Large images are the number one reason websites load slowly. A
            single uncompressed hero image can add 2–3 seconds to your page load
            time. Compressing images before uploading them to WordPress,
            Shopify, or a custom site is one of the easiest SEO wins available.
            Google uses page speed as a ranking factor, and faster pages also
            keep visitors around longer.
        </p>

        <h4 class="font-semibold mt-4 mb-2">
            2. Meeting Upload Limits on Government Forms
        </h4>
        <p class="text-gray-700 mb-4">
            Many government portals, job applications, and university admission
            forms have strict image size limits — often 100 KB, 50 KB, or even
            20 KB. This tool lets you compress an image down to those limits
            without opening Photoshop or any desktop software.
        </p>

        <h4 class="font-semibold mt-4 mb-2">
            3. Sending Photos on WhatsApp, Discord, or Email
        </h4>
        <p class="text-gray-700 mb-4">
            Modern phone photos are often 5–10 MB, which makes them slow to send
            and sometimes too large for chat apps or email attachments.
            Compressing them first keeps them shareable without losing visible
            quality.
        </p>

        <h4 class="font-semibold mt-4 mb-2">
            4. Reducing Storage on Your Device
        </h4>
        <p class="text-gray-700 mb-4">
            If your phone is running out of space, compressing your photo
            library can free up gigabytes. Each photo typically shrinks by
            60–90% with this tool.
        </p>

        <h4 class="font-semibold mt-4 mb-2">
            5. Faster E-commerce Product Photos
        </h4>
        <p class="text-gray-700 mb-4">
            If you run a small online store, compressing product images speeds
            up category pages and product detail pages — both of which affect
            conversion rates.
        </p>

        <h3 class="text-xl font-semibold mt-6 mb-3">A Worked Example</h3>
        <p class="text-gray-700 mb-4">
            Here's what happens when you compress a typical phone photo at 70%
            quality:
        </p>
        <ul class="list-disc pl-6 text-gray-700 space-y-2">
            <li>Original file: 4.2 MB (JPG, 4032 × 3024 pixels)</li>
            <li>Compressed file: 380 KB (same dimensions)</li>
            <li>File size reduction: 91%</li>
            <li>Visible quality difference: none at normal viewing size</li>
        </ul>
        <p class="text-gray-700 mt-4">
            That's the difference between a 10-second upload and a 2-second one
            — without any quality loss that a normal viewer would notice.
        </p>

        <h3 class="text-xl font-semibold mt-6 mb-3">
            Understanding Compression Quality
        </h3>
        <p class="text-gray-700 mb-4">
            The quality slider runs from 10% to 100%. Here's what each range
            does:
        </p>
        <ul class="list-disc pl-6 text-gray-700 space-y-2">
            <li>
                <strong>90–100%:</strong> Almost no visible difference. Good for print
                or high-resolution display.
            </li>
            <li>
                <strong>70–85%:</strong> The sweet spot for web use. Small files,
                clean visuals.
            </li>
            <li>
                <strong>50–70%:</strong> Smaller files, with slight artifacts visible
                on close inspection.
            </li>
            <li>
                <strong>Below 50%:</strong> Visible quality loss. Use only when file
                size is more important than quality.
            </li>
        </ul>
        <p class="text-gray-700 mt-4">
            For most photos, 70–80% is the best balance. Start there and adjust
            based on how the result looks.
        </p>

        <h3 class="text-xl font-semibold mt-6 mb-3">Supported Formats</h3>
        <ul class="list-disc pl-6 text-gray-700 space-y-2">
            <li>
                <strong>JPG / JPEG:</strong> Best for photos. Already uses lossy compression,
                so additional compression reduces size further.
            </li>
            <li>
                <strong>PNG:</strong> Best for images with transparency or sharp text.
                Compression here targets metadata and repeated colors rather than
                visual data.
            </li>
            <li>
                <strong>WebP:</strong> Modern format with better compression than
                JPG. Ideal for web use on any browser from 2020 onwards.
            </li>
        </ul>

        <h3 class="text-xl font-semibold mt-6 mb-3">
            Frequently Asked Questions
        </h3>
        <div class="space-y-4 mt-3">
            <div>
                <h4 class="font-semibold text-gray-900">
                    Are my images uploaded to a server?
                </h4>
                <p class="text-gray-700 mt-1">
                    No. All compression happens in your browser using
                    JavaScript. Your images never leave your device.
                </p>
            </div>
            <div>
                <h4 class="font-semibold text-gray-900">
                    What quality setting should I use?
                </h4>
                <p class="text-gray-700 mt-1">
                    For most web images, 70–80% is a good balance between file
                    size and quality. For photos you plan to print, use 90% or
                    higher.
                </p>
            </div>
            <div>
                <h4 class="font-semibold text-gray-900">
                    Does compression affect image dimensions?
                </h4>
                <p class="text-gray-700 mt-1">
                    No. This tool only reduces file size, not the width or
                    height of the image. If you need to change dimensions, use
                    our <a
                        href="/tools/image-resizer"
                        class="text-blue-600 hover:underline font-medium"
                        >Image Resizer</a
                    > tool.
                </p>
            </div>
            <div>
                <h4 class="font-semibold text-gray-900">
                    Can I compress multiple images at once?
                </h4>
                <p class="text-gray-700 mt-1">
                    This tool compresses one image at a time. For bulk work,
                    open multiple browser tabs and process images in parallel.
                </p>
            </div>
            <div>
                <h4 class="font-semibold text-gray-900">
                    Does compression reduce image quality?
                </h4>
                <p class="text-gray-700 mt-1">
                    At 70%+ quality, most people can't see a difference. Below
                    60%, artifacts (blurry patches, banding) start becoming
                    visible. Always work from the original file to avoid
                    re-compression losses.
                </p>
            </div>
            <div>
                <h4 class="font-semibold text-gray-900">Is this tool free?</h4>
                <p class="text-gray-700 mt-1">
                    Yes, completely free with no signup, no limits, and no
                    watermarks.
                </p>
            </div>
        </div>
    </section>

    <!-- Related Tools & Guides -->
    <section class="max-w-3xl mx-auto mt-16">
        <h2 class="text-2xl font-bold mb-6">Related Tools</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-10">
            <a
                href="/tools/image-resizer"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-semibold mb-1">Image Resizer</h3>
                <p class="text-sm text-gray-600">
                    Change image dimensions with aspect ratio control.
                </p>
            </a>
            <a
                href="/tools/image-converter"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-semibold mb-1">Image Converter</h3>
                <p class="text-sm text-gray-600">
                    Convert between JPG, PNG, and WebP formats.
                </p>
            </a>
            <a
                href="/tools/image-cropper"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-semibold mb-1">Image Cropper</h3>
                <p class="text-sm text-gray-600">
                    Crop images to any size or aspect ratio.
                </p>
            </a>
        </div>

        <h2 class="text-2xl font-bold mb-6">Related Guides</h2>
        <div class="space-y-3">
            <a
                href="/blog/compress-images-discord"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-medium">How to Compress Images for Discord</h3>
                <p class="text-sm text-gray-600">
                    Fit the 8MB upload limit without losing quality.
                </p>
            </a>
            <a
                href="/blog/compress-images-for-website"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-medium">How to Compress Images for Website</h3>
                <p class="text-sm text-gray-600">
                    Speed up your site and improve SEO with smaller images.
                </p>
            </a>
            <a
                href="/blog/bulk-resize-images"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-medium">How to Bulk Resize Images Online</h3>
                <p class="text-sm text-gray-600">
                    Process dozens of images in minutes.
                </p>
            </a>
        </div>
    </section>

    <script>
        import imageCompression from "browser-image-compression";

        const dropZone = document.getElementById("drop-zone") as HTMLDivElement;
        const fileInput = document.getElementById(
            "file-input",
        ) as HTMLInputElement;
        const qualitySlider = document.getElementById(
            "quality",
        ) as HTMLInputElement;
        const qualityValue = document.getElementById("quality-value")!;
        const compressBtn = document.getElementById(
            "compress-btn",
        ) as HTMLButtonElement;
        const results = document.getElementById("results")!;
        const downloadBtn = document.getElementById(
            "download-btn",
        ) as HTMLAnchorElement;
        const resetBtn = document.getElementById("reset-btn")!;

        let selectedFile: File | null = null;

        qualitySlider.addEventListener("input", () => {
            qualityValue.textContent = qualitySlider.value;
        });

        dropZone.addEventListener("click", () => fileInput.click());

        dropZone.addEventListener("dragover", (e) => {
            e.preventDefault();
            dropZone.classList.add("border-blue-500", "bg-blue-50");
        });

        dropZone.addEventListener("dragleave", () => {
            dropZone.classList.remove("border-blue-500", "bg-blue-50");
        });

        dropZone.addEventListener("drop", (e) => {
            e.preventDefault();
            dropZone.classList.remove("border-blue-500", "bg-blue-50");
            const files = (e as DragEvent).dataTransfer?.files;
            if (files && files.length > 0) handleFile(files[0]);
        });

        fileInput.addEventListener("change", () => {
            if (fileInput.files && fileInput.files.length > 0) {
                handleFile(fileInput.files[0]);
            }
        });

        function handleFile(file: File) {
            if (!file.type.startsWith("image/")) {
                alert("Please select an image file (JPG, PNG, or WebP).");
                return;
            }
            if (file.size > 20 * 1024 * 1024) {
                alert(
                    "File size too large. Please select an image under 20 MB.",
                );
                return;
            }
            selectedFile = file;
            compressBtn.disabled = false;
            dropZone.querySelector("p")!.textContent = `Selected: ${file.name}`;
        }

        function formatBytes(bytes: number): string {
            if (bytes < 1024) return bytes + " B";
            if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + " KB";
            return (bytes / (1024 * 1024)).toFixed(2) + " MB";
        }

        compressBtn.addEventListener("click", async () => {
            if (!selectedFile) return;
            compressBtn.disabled = true;
            compressBtn.textContent = "Compressing...";

            const quality = parseInt(qualitySlider.value) / 100;

            try {
                const compressedFile = await imageCompression(selectedFile, {
                    maxSizeMB: 10,
                    initialQuality: quality,
                    useWebWorker: true,
                });

                const originalSize = selectedFile.size;
                const compressedSize = compressedFile.size;
                const savedPercent =
                    ((originalSize - compressedSize) / originalSize) * 100;

                document.getElementById("original-size")!.textContent =
                    formatBytes(originalSize);
                document.getElementById("compressed-size")!.textContent =
                    formatBytes(compressedSize);
                document.getElementById("saved-percent")!.textContent =
                    savedPercent.toFixed(1) + "%";

                const originalUrl = URL.createObjectURL(selectedFile);
                const compressedUrl = URL.createObjectURL(compressedFile);
                (
                    document.getElementById(
                        "preview-original",
                    ) as HTMLImageElement
                ).src = originalUrl;
                (
                    document.getElementById(
                        "preview-compressed",
                    ) as HTMLImageElement
                ).src = compressedUrl;

                const originalName = selectedFile.name;
                const ext = originalName.split(".").pop();
                const baseName = originalName.replace(/\.[^.]+$/, "");
                downloadBtn.href = compressedUrl;
                downloadBtn.download = `${baseName}-compressed.${ext}`;

                results.classList.remove("hidden");
                results.scrollIntoView({ behavior: "smooth" });
            } catch (err) {
                alert(
                    "Compression failed. Please try again with a different image.",
                );
            } finally {
                compressBtn.disabled = false;
                compressBtn.textContent = "Compress Image";
            }
        });

        resetBtn.addEventListener("click", () => {
            selectedFile = null;
            fileInput.value = "";
            results.classList.add("hidden");
            compressBtn.disabled = true;
            compressBtn.textContent = "Compress Image";
            dropZone.querySelector("p")!.textContent =
                "Click or tap to choose an image";
        });
    </script>

    <script
        type="application/ld+json"
        set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "SoftwareApplication",
            name: "Image Compressor",
            applicationCategory: "MultimediaApplication",
            operatingSystem: "Any",
            description:
                "Free online image compressor. Compress JPG, PNG, and WebP images without losing quality. 100% client-side, no upload.",
            offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
        })}
    />

    <script
        type="application/ld+json"
        set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "FAQPage",
            mainEntity: [
                {
                    "@type": "Question",
                    name: "Are my images uploaded to a server?",
                    acceptedAnswer: {
                        "@type": "Answer",
                        text: "No. All compression happens in your browser using JavaScript. Your images never leave your device.",
                    },
                },
                {
                    "@type": "Question",
                    name: "What quality setting should I use?",
                    acceptedAnswer: {
                        "@type": "Answer",
                        text: "For most web images, 70–80% is a good balance between file size and quality. For photos you plan to print, use 90% or higher.",
                    },
                },
                {
                    "@type": "Question",
                    name: "Does compression affect image dimensions?",
                    acceptedAnswer: {
                        "@type": "Answer",
                        text: "No. This tool only reduces file size, not the width or height of the image. If you need to change dimensions, use our Image Resizer tool.",
                    },
                },
                {
                    "@type": "Question",
                    name: "Does compression reduce image quality?",
                    acceptedAnswer: {
                        "@type": "Answer",
                        text: "At 70%+ quality, most people can't see a difference. Below 60%, artifacts start becoming visible. Always work from the original file to avoid re-compression losses.",
                    },
                },
                {
                    "@type": "Question",
                    name: "Is this tool free?",
                    acceptedAnswer: {
                        "@type": "Answer",
                        text: "Yes, completely free with no signup, no limits, and no watermarks.",
                    },
                },
            ],
        })}
    />
</Layout>
