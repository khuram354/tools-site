---
import Layout from "../../layouts/Layout.astro";
---

<Layout
    title="Image Resizer — Resize JPG, PNG & WebP Online Free"
    description="Resize JPG, PNG, and WebP images online for free. Change width and height, maintain aspect ratio, and download instantly. No signup, 100% private."
>
    <div class="max-w-3xl mx-auto">
        <header class="mb-8">
            <h1 class="text-3xl md:text-4xl font-bold mb-3">Image Resizer</h1>
            <p class="text-gray-600 mb-2">
                Resize JPG, PNG, and WebP images to any dimension. Maintain
                aspect ratio or set custom width and height.
            </p>
            <p class="text-xs text-gray-500">
                Works entirely in your browser. Your images never leave your
                device.
            </p>
        </header>

        <!-- Upload Section -->
        <section class="bg-white p-6 rounded-xl border border-gray-200 mb-6">
            <div
                id="drop-zone"
                class="border-2 border-dashed border-gray-300 rounded-lg p-8 text-center hover:border-blue-400 transition cursor-pointer"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="48"
                    height="48"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="#2563eb"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="mx-auto mb-3"
                >
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"
                    ></rect>
                    <circle cx="8.5" cy="8.5" r="1.5"></circle>
                    <polyline points="21 15 16 10 5 21"></polyline>
                </svg>
                <p class="font-medium mb-1">Click or tap to choose an image</p>
                <p class="text-sm text-gray-500">JPG, PNG, or WebP</p>
                <input
                    type="file"
                    id="file-input"
                    accept="image/jpeg,image/png,image/webp"
                    class="hidden"
                />
            </div>

            <!-- Dimensions Input -->
            <div id="dimensions-section" class="mt-6 hidden">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label
                            for="width"
                            class="block text-sm font-medium mb-2"
                            >Width (px)</label
                        >
                        <input
                            type="number"
                            id="width"
                            min="1"
                            max="10000"
                            class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                        />
                    </div>
                    <div>
                        <label
                            for="height"
                            class="block text-sm font-medium mb-2"
                            >Height (px)</label
                        >
                        <input
                            type="number"
                            id="height"
                            min="1"
                            max="10000"
                            class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                        />
                    </div>
                </div>

                <div class="mt-3">
                    <label class="flex items-center gap-2 text-sm">
                        <input
                            type="checkbox"
                            id="maintain-ratio"
                            class="rounded"
                            checked
                        />
                        <span>Maintain aspect ratio</span>
                    </label>
                </div>

                <!-- Presets -->
                <div class="mt-4">
                    <p class="text-sm font-medium mb-3">Quick Presets:</p>
                    <div class="grid grid-cols-2 sm:grid-cols-5 gap-2">
                        <button
                            data-preset="50"
                            class="preset-btn px-3 py-2.5 text-sm font-medium bg-white text-gray-700 border border-gray-300 rounded-lg hover:bg-blue-600 hover:text-white hover:border-blue-600 transition"
                            >50%</button
                        >
                        <button
                            data-preset="75"
                            class="preset-btn px-3 py-2.5 text-sm font-medium bg-white text-gray-700 border border-gray-300 rounded-lg hover:bg-blue-600 hover:text-white hover:border-blue-600 transition"
                            >75%</button
                        >
                        <button
                            data-preset="1920"
                            class="preset-btn px-3 py-2.5 text-sm font-medium bg-white text-gray-700 border border-gray-300 rounded-lg hover:bg-blue-600 hover:text-white hover:border-blue-600 transition"
                            >1920px</button
                        >
                        <button
                            data-preset="1280"
                            class="preset-btn px-3 py-2.5 text-sm font-medium bg-white text-gray-700 border border-gray-300 rounded-lg hover:bg-blue-600 hover:text-white hover:border-blue-600 transition"
                            >1280px</button
                        >
                        <button
                            data-preset="800"
                            class="preset-btn px-3 py-2.5 text-sm font-medium bg-white text-gray-700 border border-gray-300 rounded-lg hover:bg-blue-600 hover:text-white hover:border-blue-600 transition"
                            >800px</button
                        >
                    </div>
                </div>

                <button
                    id="resize-btn"
                    class="mt-6 px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium transition"
                >
                    Resize Image
                </button>
            </div>
        </section>

        <!-- Results -->
        <section id="results" class="hidden">
            <div class="bg-white p-6 rounded-xl border border-gray-200 mb-6">
                <h2 class="text-xl font-semibold mb-4">Resize Result</h2>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                    <div class="bg-gray-50 p-4 rounded-lg text-center">
                        <div class="text-sm text-gray-500 mb-1">
                            Original Dimensions
                        </div>
                        <div
                            id="original-dims"
                            class="text-lg font-bold text-gray-700"
                        >
                            —
                        </div>
                    </div>
                    <div class="bg-blue-50 p-4 rounded-lg text-center">
                        <div class="text-sm text-gray-500 mb-1">
                            New Dimensions
                        </div>
                        <div
                            id="new-dims"
                            class="text-lg font-bold text-blue-600"
                        >
                            —
                        </div>
                    </div>
                </div>

                <div
                    id="size-saved"
                    class="hidden mb-6 p-3 rounded-lg text-center text-sm font-medium"
                >
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <div class="flex items-center justify-between mb-2">
                            <p class="text-sm font-medium">Original</p>
                            <p id="original-size" class="text-xs text-gray-500">
                                —
                            </p>
                        </div>
                        <img
                            id="preview-original"
                            class="w-full rounded-lg border border-gray-200"
                            alt="Original"
                        />
                    </div>
                    <div>
                        <div class="flex items-center justify-between mb-2">
                            <p class="text-sm font-medium">Resized</p>
                            <p
                                id="new-size"
                                class="text-xs text-green-600 font-medium"
                            >
                                —
                            </p>
                        </div>
                        <img
                            id="preview-resized"
                            class="w-full rounded-lg border border-gray-200"
                            alt="Resized"
                        />
                    </div>
                </div>

                <div class="flex flex-wrap gap-3 mt-6">
                    <a
                        id="download-btn"
                        class="px-6 py-3 bg-green-600 text-white rounded-lg hover:bg-green-700 font-medium transition"
                        download
                    >
                        Download Resized Image
                    </a>
                    <button
                        id="reset-btn"
                        class="px-6 py-3 bg-gray-200 text-gray-800 rounded-lg hover:bg-gray-300 font-medium transition"
                    >
                        Resize Another Image
                    </button>
                </div>
            </div>
        </section>
    </div>

    <!-- SEO Content -->
    <section class="max-w-3xl mx-auto mt-16">
        <h2 class="text-2xl font-bold mb-4">About This Image Resizer</h2>
        <p class="text-gray-700 mb-4">
            This free online image resizer lets you change the dimensions of
            JPG, PNG, and WebP images instantly. It runs entirely in your
            browser, so your images are never uploaded to any server.
        </p>

        <h3 class="text-xl font-semibold mt-6 mb-3">How to Use</h3>
        <ol class="list-decimal pl-6 text-gray-700 space-y-2">
            <li>Click or tap the upload area to choose an image</li>
            <li>Enter your desired width and height, or use a quick preset</li>
            <li>Keep "Maintain aspect ratio" checked to avoid distortion</li>
            <li>Click "Resize Image"</li>
            <li>Preview the result and download</li>
        </ol>

        <h3 class="text-xl font-semibold mt-6 mb-3">Features</h3>
        <ul class="list-disc pl-6 text-gray-700 space-y-2">
            <li>Supports JPG, PNG, and WebP formats</li>
            <li>Maintain aspect ratio option</li>
            <li>Quick presets (50%, 75%, 1920px, 1280px, 800px)</li>
            <li>Before/after preview with file sizes</li>
            <li>100% client-side — your images never leave your device</li>
            <li>No signup, no watermarks, completely free</li>
        </ul>

        <h3 class="text-xl font-semibold mt-6 mb-3">
            Frequently Asked Questions
        </h3>
        <div class="space-y-4 mt-3">
            <div>
                <h4 class="font-semibold text-gray-900">
                    Are my images uploaded to a server?
                </h4>
                <p class="text-gray-700 mt-1">
                    No. All resizing happens in your browser using JavaScript.
                    Your images never leave your device.
                </p>
            </div>
            <div>
                <h4 class="font-semibold text-gray-900">
                    What does "Maintain aspect ratio" do?
                </h4>
                <p class="text-gray-700 mt-1">
                    It keeps the original width-to-height ratio, so your image
                    doesn't look stretched or squished. When you change the
                    width, the height adjusts automatically (and vice versa).
                </p>
            </div>
            <div>
                <h4 class="font-semibold text-gray-900">
                    Does resizing affect image quality?
                </h4>
                <p class="text-gray-700 mt-1">
                    Reducing dimensions generally maintains quality. Enlarging
                    an image can make it look blurry, since the tool is
                    stretching existing pixels.
                </p>
            </div>
            <div>
                <h4 class="font-semibold text-gray-900">Is this tool free?</h4>
                <p class="text-gray-700 mt-1">
                    Yes, completely free with no signup, no limits, and no
                    watermarks.
                </p>
            </div>
        </div>
    </section>

    <!-- Related Tools & Guides -->
    <section class="max-w-3xl mx-auto mt-16">
        <h2 class="text-2xl font-bold mb-6">Related Tools</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-10">
            <a
                href="/tools/image-compressor/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-semibold mb-1">Image Compressor</h3>
                <p class="text-sm text-gray-600">
                    Reduce image file size without losing quality.
                </p>
            </a>
            <a
                href="/tools/image-converter/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-semibold mb-1">Image Converter</h3>
                <p class="text-sm text-gray-600">
                    Convert between JPG, PNG, and WebP.
                </p>
            </a>
            <a
                href="/tools/image-cropper/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-semibold mb-1">Image Cropper</h3>
                <p class="text-sm text-gray-600">
                    Crop images to any size or aspect ratio.
                </p>
            </a>
        </div>

        <h2 class="text-2xl font-bold mb-6">Related Guides</h2>
        <div class="space-y-3">
            <a
                href="/blog/bulk-resize-images/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-medium">How to Bulk Resize Images Online</h3>
                <p class="text-sm text-gray-600">
                    Process dozens of images in minutes.
                </p>
            </a>
            <a
                href="/blog/resize-images-wordpress/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-medium">How to Resize Images in WordPress</h3>
                <p class="text-sm text-gray-600">
                    Fix slow pages and wrong dimensions.
                </p>
            </a>
        </div>
    </section>

    <script>
        const dropZone = document.getElementById("drop-zone") as HTMLDivElement;
        const fileInput = document.getElementById(
            "file-input",
        ) as HTMLInputElement;
        const dimensionsSection =
            document.getElementById("dimensions-section")!;
        const widthInput = document.getElementById("width") as HTMLInputElement;
        const heightInput = document.getElementById(
            "height",
        ) as HTMLInputElement;
        const maintainRatio = document.getElementById(
            "maintain-ratio",
        ) as HTMLInputElement;
        const resizeBtn = document.getElementById("resize-btn")!;
        const results = document.getElementById("results")!;
        const downloadBtn = document.getElementById(
            "download-btn",
        ) as HTMLAnchorElement;
        const resetBtn = document.getElementById("reset-btn")!;
        const presetBtns =
            document.querySelectorAll<HTMLButtonElement>(".preset-btn");

        let selectedFile: File | null = null;
        let originalWidth = 0;
        let originalHeight = 0;
        let originalImage: HTMLImageElement | null = null;

        function formatBytes(bytes: number): string {
            if (bytes < 1024) return bytes + " B";
            if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + " KB";
            return (bytes / (1024 * 1024)).toFixed(2) + " MB";
        }

        function syncHeightFromWidth() {
            if (!originalWidth || !originalHeight) return;
            const w = parseInt(widthInput.value) || 0;
            const ratio = originalHeight / originalWidth;
            heightInput.value = Math.round(w * ratio).toString();
        }

        function syncWidthFromHeight() {
            if (!originalWidth || !originalHeight) return;
            const h = parseInt(heightInput.value) || 0;
            const ratio = originalWidth / originalHeight;
            widthInput.value = Math.round(h * ratio).toString();
        }

        if (maintainRatio.checked) {
            widthInput.addEventListener("input", syncHeightFromWidth);
            heightInput.addEventListener("input", syncWidthFromHeight);
        }

        maintainRatio.addEventListener("change", () => {
            if (maintainRatio.checked) {
                widthInput.addEventListener("input", syncHeightFromWidth);
                heightInput.addEventListener("input", syncWidthFromHeight);
            } else {
                widthInput.removeEventListener("input", syncHeightFromWidth);
                heightInput.removeEventListener("input", syncWidthFromHeight);
            }
        });

        dropZone.addEventListener("click", () => fileInput.click());

        dropZone.addEventListener("dragover", (e) => {
            e.preventDefault();
            dropZone.classList.add("border-blue-500", "bg-blue-50");
        });

        dropZone.addEventListener("dragleave", () => {
            dropZone.classList.remove("border-blue-500", "bg-blue-50");
        });

        dropZone.addEventListener("drop", (e) => {
            e.preventDefault();
            dropZone.classList.remove("border-blue-500", "bg-blue-50");
            const files = (e as DragEvent).dataTransfer?.files;
            if (files && files.length > 0) handleFile(files[0]);
        });

        fileInput.addEventListener("change", () => {
            if (fileInput.files && fileInput.files.length > 0) {
                handleFile(fileInput.files[0]);
            }
        });

        function handleFile(file: File) {
            if (!file.type.startsWith("image/")) {
                alert("Please select an image file (JPG, PNG, or WebP).");
                return;
            }
            if (file.size > 20 * 1024 * 1024) {
                alert(
                    "File size too large. Please select an image under 20 MB.",
                );
                return;
            }
            selectedFile = file;
            const img = new Image();
            img.onload = () => {
                originalWidth = img.naturalWidth;
                originalHeight = img.naturalHeight;
                originalImage = img;
                widthInput.value = originalWidth.toString();
                heightInput.value = originalHeight.toString();
                dimensionsSection.classList.remove("hidden");
                dropZone.querySelector("p")!.textContent =
                    `Selected: ${file.name} (${originalWidth} × ${originalHeight})`;
            };
            img.src = URL.createObjectURL(file);
        }

        presetBtns.forEach((btn) => {
            btn.addEventListener("click", () => {
                const preset = btn.dataset.preset!;
                if (preset.endsWith("%")) {
                    const percent = parseInt(preset) / 100;
                    widthInput.value = Math.round(
                        originalWidth * percent,
                    ).toString();
                    heightInput.value = Math.round(
                        originalHeight * percent,
                    ).toString();
                } else {
                    const targetWidth = parseInt(preset);
                    const ratio = originalHeight / originalWidth;
                    widthInput.value = targetWidth.toString();
                    heightInput.value = Math.round(
                        targetWidth * ratio,
                    ).toString();
                }
            });
        });

        resizeBtn.addEventListener("click", () => {
            if (!selectedFile || !originalImage) return;
            const newWidth = parseInt(widthInput.value);
            const newHeight = parseInt(heightInput.value);
            if (!newWidth || !newHeight || newWidth < 1 || newHeight < 1) {
                alert("Please enter valid dimensions.");
                return;
            }

            const canvas = document.createElement("canvas");
            canvas.width = newWidth;
            canvas.height = newHeight;
            const ctx = canvas.getContext("2d")!;
            ctx.drawImage(originalImage, 0, 0, newWidth, newHeight);

            canvas.toBlob(
                (blob) => {
                    if (!blob) return;
                    const resizedUrl = URL.createObjectURL(blob);

                    document.getElementById("original-dims")!.textContent =
                        `${originalWidth} × ${originalHeight}`;
                    document.getElementById("new-dims")!.textContent =
                        `${newWidth} × ${newHeight}`;

                    const originalSize = selectedFile!.size;
                    const newSize = blob.size;
                    const savedPercent =
                        ((originalSize - newSize) / originalSize) * 100;

                    document.getElementById("original-size")!.textContent =
                        formatBytes(originalSize);
                    document.getElementById("new-size")!.textContent =
                        formatBytes(newSize);

                    const savedBox = document.getElementById("size-saved")!;
                    savedBox.classList.remove("hidden");
                    if (savedPercent >= 0) {
                        savedBox.textContent = `✓ File size reduced by ${savedPercent.toFixed(1)}% (${formatBytes(originalSize - newSize)} saved)`;
                        savedBox.className =
                            "mb-6 p-3 rounded-lg text-center text-sm font-medium bg-green-50 text-green-700 border border-green-200";
                    } else {
                        savedBox.textContent = `File size increased by ${Math.abs(savedPercent).toFixed(1)}% (${formatBytes(newSize - originalSize)} larger)`;
                        savedBox.className =
                            "mb-6 p-3 rounded-lg text-center text-sm font-medium bg-yellow-50 text-yellow-700 border border-yellow-200";
                    }

                    (
                        document.getElementById(
                            "preview-original",
                        ) as HTMLImageElement
                    ).src = URL.createObjectURL(selectedFile!);
                    (
                        document.getElementById(
                            "preview-resized",
                        ) as HTMLImageElement
                    ).src = resizedUrl;

                    const originalName = selectedFile!.name;
                    const ext = originalName.split(".").pop();
                    const baseName = originalName.replace(/\.[^.]+$/, "");
                    downloadBtn.href = resizedUrl;
                    downloadBtn.download = `${baseName}-${newWidth}x${newHeight}.${ext}`;

                    results.classList.remove("hidden");
                    results.scrollIntoView({ behavior: "smooth" });
                },
                selectedFile.type,
                0.95,
            );
        });

        resetBtn.addEventListener("click", () => {
            selectedFile = null;
            originalImage = null;
            fileInput.value = "";
            results.classList.add("hidden");
            dimensionsSection.classList.add("hidden");
            dropZone.querySelector("p")!.textContent =
                "Click or tap here to choose an image";
        });
    </script>

    <script
        type="application/ld+json"
        set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "SoftwareApplication",
            name: "Image Resizer",
            applicationCategory: "MultimediaApplication",
            operatingSystem: "Any",
            description:
                "Free online image resizer. Resize JPG, PNG, and WebP images with aspect ratio control.",
            offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
        })}
    />

    <script
        type="application/ld+json"
        set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "FAQPage",
            mainEntity: [
                {
                    "@type": "Question",
                    name: "Are my images uploaded to a server?",
                    acceptedAnswer: {
                        "@type": "Answer",
                        text: "No. All resizing happens in your browser using JavaScript. Your images never leave your device.",
                    },
                },
                {
                    "@type": "Question",
                    name: "What does Maintain aspect ratio do?",
                    acceptedAnswer: {
                        "@type": "Answer",
                        text: "It keeps the original width-to-height ratio, so your image doesn't look stretched or squished. When you change the width, the height adjusts automatically.",
                    },
                },
                {
                    "@type": "Question",
                    name: "Does resizing affect image quality?",
                    acceptedAnswer: {
                        "@type": "Answer",
                        text: "Reducing dimensions generally maintains quality. Enlarging an image can make it look blurry, since the tool is stretching existing pixels.",
                    },
                },
                {
                    "@type": "Question",
                    name: "Is this tool free?",
                    acceptedAnswer: {
                        "@type": "Answer",
                        text: "Yes, completely free with no signup, no limits, and no watermarks.",
                    },
                },
            ],
        })}
    />
</Layout>
