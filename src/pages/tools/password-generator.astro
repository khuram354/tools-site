---
import Layout from "../../layouts/Layout.astro";

const pageUrl = new URL(Astro.url.pathname, "https://toolsvibe.online").href;

// ---------------------------------------------------------------------------
// Settings shared by the page text and the generator script (the script reads
// them from the hidden config element below), so the two can never disagree.
// ---------------------------------------------------------------------------
const CHAR_SETS = {
    uppercase: "ABCDEFGHIJKLMNOPQRSTUVWXYZ",
    lowercase: "abcdefghijklmnopqrstuvwxyz",
    numbers: "0123456789",
    symbols: "!@#$%^&*()_+-=[]{}|;:,.<>?",
};
// Characters that are easy to mix up when typing a password by hand
const SIMILAR_CHARS = "0O1lI";

// Strength is measured in bits of entropy (every extra bit doubles the guesses)
const STRENGTH_LEVELS = [
    {
        min: 0,
        label: "Weak",
        width: 25,
        bar: "bg-red-500",
        text: "text-red-600",
    },
    {
        min: 40,
        label: "Fair",
        width: 50,
        bar: "bg-yellow-500",
        text: "text-yellow-600",
    },
    {
        min: 60,
        label: "Strong",
        width: 75,
        bar: "bg-green-500",
        text: "text-green-600",
    },
    {
        min: 100,
        label: "Very Strong",
        width: 100,
        bar: "bg-green-600",
        text: "text-green-700",
    },
];

// Bits of entropy for a random password of `length` characters that must
// contain at least one character from every selected set (inclusion-exclusion).
// The same function is used in the page script.
function entropyBits(length: number, setSizes: number[]): number {
    const total = setSizes.reduce((a, b) => a + b, 0);
    let valid = 0;
    for (let mask = 0; mask < 1 << setSizes.length; mask++) {
        let removed = 0;
        let count = 0;
        for (let i = 0; i < setSizes.length; i++) {
            if (mask & (1 << i)) {
                removed += setSizes[i];
                count++;
            }
        }
        valid += (count % 2 ? -1 : 1) * Math.pow(total - removed, length);
    }
    return Math.log2(valid);
}

function levelFor(bits: number) {
    let level = STRENGTH_LEVELS[0];
    for (const l of STRENGTH_LEVELS) if (bits >= l.min) level = l;
    return level;
}

const allSizes = Object.values(CHAR_SETS).map((s) => s.length);
const POOL = allSizes.reduce((a, b) => a + b, 0);
const strengthRows = [8, 12, 16, 20].map((len) => {
    const bits = entropyBits(len, allSizes);
    return { len, bits: Math.round(bits), label: levelFor(bits).label };
});
const bits16 = Math.round(entropyBits(16, allSizes));
const fourMoreCharsFactor = Math.round(Math.pow(POOL, 4) / 1e6); // in millions

// One source of truth: shown on the page AND used for the FAQ schema,
// so the visible text and the structured data always match.
const faqs = [
    {
        q: "Are these passwords truly random?",
        a: "Yes. We use your browser's cryptographically secure random number generator (crypto.getRandomValues) and pick each character without bias. It is much safer than Math.random(), which is not suitable for passwords.",
    },
    {
        q: "Is my password sent to a server?",
        a: "No. All password generation happens in your browser. Your passwords never leave your device, and nothing is logged, transmitted, or stored by this tool.",
    },
    {
        q: "How long should my password be?",
        a: `16 characters is a strong default: 16 random characters from all four character types give about ${bits16} bits of strength. For high-security accounts (email, banking, work), use 20 or more. For low-risk accounts, 12 characters is reasonable.`,
    },
    {
        q: "What do the strength bits mean?",
        a: "Bits measure how many guesses an attacker would need: every extra bit doubles it. Under 40 bits is weak, 60 or more is strong, and 100 or more is very strong. The rating assumes a randomly generated password that you use on one site only.",
    },
    {
        q: "Should I include symbols in my password?",
        a: "Yes, if the site allows them, because symbols enlarge the pool of characters. If you will often type the password on a phone, you can leave symbols out and make the password longer instead.",
    },
    {
        q: "How often should I change my passwords?",
        a: "Current NIST guidance is not to change passwords on a schedule, and to change one only if there is a breach or you suspect it has been compromised. Forced periodic changes tend to lead to weaker passwords.",
    },
    {
        q: "Is this tool free?",
        a: "Yes. It is free, needs no signup, and has no limits.",
    },
];

const webAppSchema = {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Password Generator",
    url: pageUrl,
    applicationCategory: "SecurityApplication",
    operatingSystem: "Any",
    browserRequirements: "Requires JavaScript",
    isAccessibleForFree: true,
    description:
        "Free online password generator. Create strong, random passwords with a custom length and character types, and see the strength in bits.",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};

const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
};

const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item: "https://toolsvibe.online/",
        },
        {
            "@type": "ListItem",
            position: 2,
            name: "Tools",
            item: "https://toolsvibe.online/tools/",
        },
        {
            "@type": "ListItem",
            position: 3,
            name: "Password Generator",
            item: pageUrl,
        },
    ],
};
---

<Layout
    title="Password Generator: Create Strong Random Passwords"
    description="Free random password generator. Pick length and characters, see strength in bits, and copy. Created in your browser, never sent or stored."
>
    <div class="max-w-3xl mx-auto">
        <header class="mb-8">
            <nav aria-label="Breadcrumb" class="text-xs text-gray-500 mb-4">
                <a href="/" class="hover:underline">Home</a>
                <span aria-hidden="true">/</span>
                <a href="/tools/" class="hover:underline">Tools</a>
                <span aria-hidden="true">/</span>
                <span>Password Generator</span>
            </nav>
            <h1 class="text-3xl md:text-4xl font-bold mb-3">
                Secure Password Generator
            </h1>
            <p class="text-gray-600 mb-2">
                Instantly create strong, completely random passwords for your
                online accounts. Fully customize the length, symbols, numbers,
                and letter casing below.
            </p>
            <p
                class="text-xs text-emerald-600 flex items-center gap-1 font-medium"
            >
                🛡️ Private: Passwords are generated in your browser and are
                never stored or sent anywhere.
            </p>
        </header>

        <!-- Settings the script reads (same values as the page text) -->
        <div
            id="calc-config"
            data-sets={JSON.stringify(CHAR_SETS)}
            data-similar={SIMILAR_CHARS}
            data-levels={JSON.stringify(STRENGTH_LEVELS)}
            hidden
        >
        </div>

        <!-- Generator Section -->
        <section class="bg-white p-6 rounded-xl border border-gray-200 mb-6">
            <!-- Password Display -->
            <div class="mb-6">
                <label
