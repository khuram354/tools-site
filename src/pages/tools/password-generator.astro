---
import Layout from "../../layouts/Layout.astro";
---

<Layout
    title="Password Generator — Create Strong Random Passwords Free"
    description="Generate strong, secure random passwords online. Customize length, symbols, numbers, and case. 100% private — runs in your browser."
>
    <div class="max-w-3xl mx-auto">
        <header class="mb-8">
            <h1 class="text-3xl md:text-4xl font-bold mb-3">
                Password Generator
            </h1>
            <p class="text-gray-600 mb-2">
                Generate strong, random passwords for your accounts. Customize
                length, symbols, and character types.
            </p>
            <p class="text-xs text-gray-500">
                Works entirely in your browser. No password is ever sent to a
                server.
            </p>
        </header>

        <!-- Generator Section -->
        <section class="bg-white p-6 rounded-xl border border-gray-200 mb-6">
            <!-- Password Display -->
            <div class="mb-6">
                <label class="block text-sm font-medium mb-2"
                    >Your Password</label
                >
                <div class="flex gap-2">
                    <input
                        type="text"
                        id="password-output"
                        readonly
                        class="flex-1 p-4 border border-gray-300 rounded-lg font-mono text-lg bg-gray-50 focus:outline-none"
                        placeholder="Click Generate to create a password"
                    />
                    <button
                        id="copy-btn"
                        class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium transition"
                        title="Copy password"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <rect
                                x="9"
                                y="9"
                                width="13"
                                height="13"
                                rx="2"
                                ry="2"></rect>
                            <path
                                d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
                            ></path>
                        </svg>
                    </button>
                </div>
                <!-- Strength Meter -->
                <div class="mt-3">
                    <div class="flex items-center gap-2">
                        <div
                            class="flex-1 h-2 bg-gray-200 rounded-full overflow-hidden"
                        >
                            <div
                                id="strength-bar"
                                class="h-full w-0 bg-red-500 transition-all duration-300"
                            >
                            </div>
                        </div>
                        <span
                            id="strength-text"
                            class="text-sm font-medium text-gray-500">—</span
                        >
                    </div>
                </div>
            </div>

            <!-- Length Slider -->
            <div class="mb-6">
                <label for="length" class="block text-sm font-medium mb-2">
                    Password Length: <span id="length-value">16</span>
                </label>
                <input
                    type="range"
                    id="length"
                    min="4"
                    max="64"
                    value="16"
                    class="w-full"
                />
                <div class="flex justify-between text-xs text-gray-500 mt-1">
                    <span>4</span>
                    <span>64</span>
                </div>
            </div>

            <!-- Options -->
            <div class="grid grid-cols-2 gap-3 mb-6">
                <label
                    class="flex items-center gap-2 text-sm p-3 bg-gray-50 rounded-lg cursor-pointer hover:bg-gray-100 transition"
                >
                    <input
                        type="checkbox"
                        id="uppercase"
                        class="rounded"
                        checked
                    />
                    <span>Uppercase (A-Z)</span>
                </label>
                <label
                    class="flex items-center gap-2 text-sm p-3 bg-gray-50 rounded-lg cursor-pointer hover:bg-gray-100 transition"
                >
                    <input
                        type="checkbox"
                        id="lowercase"
                        class="rounded"
                        checked
                    />
                    <span>Lowercase (a-z)</span>
                </label>
                <label
                    class="flex items-center gap-2 text-sm p-3 bg-gray-50 rounded-lg cursor-pointer hover:bg-gray-100 transition"
                >
                    <input
                        type="checkbox"
                        id="numbers"
                        class="rounded"
                        checked
                    />
                    <span>Numbers (0-9)</span>
                </label>
                <label
                    class="flex items-center gap-2 text-sm p-3 bg-gray-50 rounded-lg cursor-pointer hover:bg-gray-100 transition"
                >
                    <input
                        type="checkbox"
                        id="symbols"
                        class="rounded"
                        checked
                    />
                    <span>Symbols (!@#$)</span>
                </label>
            </div>

            <button
                id="generate-btn"
                class="w-full px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium transition"
            >
                Generate Password
            </button>
        </section>

        <!-- Generate Multiple -->
        <section class="bg-white p-6 rounded-xl border border-gray-200 mb-6">
            <h2 class="text-xl font-semibold mb-4">Need Multiple Passwords?</h2>
            <p class="text-sm text-gray-600 mb-4">
                Generate 5 passwords at once. Click any password to copy it.
            </p>
            <button
                id="generate-multiple-btn"
                class="px-5 py-2 bg-gray-200 text-gray-800 rounded-lg hover:bg-gray-300 font-medium transition text-sm"
            >
                Generate 5 Passwords
            </button>
            <div id="multiple-output" class="mt-4 space-y-2"></div>
        </section>
    </div>

    <!-- SEO Content -->
    <section class="max-w-3xl mx-auto mt-16">
        <h2 class="text-2xl font-bold mb-4">About This Password Generator</h2>
        <p class="text-gray-700 mb-4">
            This free password generator creates strong, random passwords that
            are nearly impossible to guess. It runs entirely in your browser —
            no password is ever sent to a server.
        </p>

        <h3 class="text-xl font-semibold mt-6 mb-3">How to Use</h3>
        <ol class="list-decimal pl-6 text-gray-700 space-y-2">
            <li>
                Adjust the password length using the slider (16 characters is a
                good default)
            </li>
            <li>
                Choose which character types to include (uppercase, lowercase,
                numbers, symbols)
            </li>
            <li>Click "Generate Password"</li>
            <li>Click the copy button to copy it to your clipboard</li>
        </ol>

        <h3 class="text-xl font-semibold mt-6 mb-3">Features</h3>
        <ul class="list-disc pl-6 text-gray-700 space-y-2">
            <li>Password length from 4 to 64 characters</li>
            <li>Customizable character types</li>
            <li>Real-time password strength meter</li>
            <li>Generate 5 passwords at once</li>
            <li>One-click copy to clipboard</li>
            <li>100% client-side — passwords never leave your device</li>
            <li>No signup, no limits, completely free</li>
        </ul>

        <h3 class="text-xl font-semibold mt-6 mb-3">
            What Makes a Strong Password?
        </h3>
        <ul class="list-disc pl-6 text-gray-700 space-y-2">
            <li>
                <strong>Length:</strong> At least 12 characters, ideally 16+
            </li>
            <li>
                <strong>Variety:</strong> Mix uppercase, lowercase, numbers, and symbols
            </li>
            <li>
                <strong>Randomness:</strong> Avoid words, names, or patterns
            </li>
            <li>
                <strong>Uniqueness:</strong> Never reuse a password across sites
            </li>
        </ul>

        <h3 class="text-xl font-semibold mt-6 mb-3">
            Frequently Asked Questions
        </h3>
        <div class="space-y-4 mt-3">
            <div>
                <h4 class="font-semibold text-gray-900">
                    Are these passwords truly random?
                </h4>
                <p class="text-gray-700 mt-1">
                    Yes. We use your browser's built-in cryptographic random
                    number generator (<code>crypto.getRandomValues</code>),
                    which is the same technology trusted by security software.
                </p>
            </div>
            <div>
                <h4 class="font-semibold text-gray-900">
                    Is my password sent to a server?
                </h4>
                <p class="text-gray-700 mt-1">
                    No. All password generation happens in your browser. Your
                    passwords never leave your device.
                </p>
            </div>
            <div>
                <h4 class="font-semibold text-gray-900">
                    How long should my password be?
                </h4>
                <p class="text-gray-700 mt-1">
                    16 characters is a strong default. For high-security
                    accounts (email, banking), use 20+ characters.
                </p>
            </div>
            <div>
                <h4 class="font-semibold text-gray-900">Is this tool free?</h4>
                <p class="text-gray-700 mt-1">
                    Yes, completely free with no signup, no limits, and no
                    watermarks.
                </p>
            </div>
        </div>
    </section>

    <script>
        const passwordOutput = document.getElementById(
            "password-output",
        ) as HTMLInputElement;
        const lengthSlider = document.getElementById(
            "length",
        ) as HTMLInputElement;
        const lengthValue = document.getElementById("length-value")!;
        const uppercaseCheck = document.getElementById(
            "uppercase",
        ) as HTMLInputElement;
        const lowercaseCheck = document.getElementById(
            "lowercase",
        ) as HTMLInputElement;
        const numbersCheck = document.getElementById(
            "numbers",
        ) as HTMLInputElement;
        const symbolsCheck = document.getElementById(
            "symbols",
        ) as HTMLInputElement;
        const generateBtn = document.getElementById("generate-btn")!;
        const copyBtn = document.getElementById("copy-btn")!;
        const strengthBar = document.getElementById("strength-bar")!;
        const strengthText = document.getElementById("strength-text")!;
        const generateMultipleBtn = document.getElementById(
            "generate-multiple-btn",
        )!;
        const multipleOutput = document.getElementById("multiple-output")!;

        const CHAR_SETS = {
            uppercase: "ABCDEFGHIJKLMNOPQRSTUVWXYZ",
            lowercase: "abcdefghijklmnopqrstuvwxyz",
            numbers: "0123456789",
            symbols: "!@#$%^&*()_+-=[]{}|;:,.<>?",
        };

        function getSelectedChars(): string {
            let chars = "";
            if (uppercaseCheck.checked) chars += CHAR_SETS.uppercase;
            if (lowercaseCheck.checked) chars += CHAR_SETS.lowercase;
            if (numbersCheck.checked) chars += CHAR_SETS.numbers;
            if (symbolsCheck.checked) chars += CHAR_SETS.symbols;
            return chars;
        }

        function generatePassword(length: number, chars: string): string {
            if (!chars) return "";
            const array = new Uint32Array(length);
            crypto.getRandomValues(array);
            let password = "";
            for (let i = 0; i < length; i++) {
                password += chars[array[i] % chars.length];
            }
            return password;
        }

        function calculateStrength(password: string): {
            level: number;
            text: string;
            color: string;
        } {
            let score = 0;
            if (password.length >= 8) score++;
            if (password.length >= 12) score++;
            if (password.length >= 16) score++;
            if (/[A-Z]/.test(password)) score++;
            if (/[a-z]/.test(password)) score++;
            if (/[0-9]/.test(password)) score++;
            if (/[^A-Za-z0-9]/.test(password)) score++;

            if (score <= 3)
                return { level: 25, text: "Weak", color: "bg-red-500" };
            if (score <= 5)
                return { level: 55, text: "Medium", color: "bg-yellow-500" };
            if (score <= 6)
                return { level: 80, text: "Strong", color: "bg-green-500" };
            return { level: 100, text: "Very Strong", color: "bg-green-600" };
        }

        function updateStrength(password: string) {
            const { level, text, color } = calculateStrength(password);
            strengthBar.style.width = level + "%";
            strengthBar.className =
                "h-full transition-all duration-300 " + color;
            strengthText.textContent = text;
            strengthText.className =
                "text-sm font-medium " +
                (text === "Weak"
                    ? "text-red-600"
                    : text === "Medium"
                      ? "text-yellow-600"
                      : "text-green-600");
        }

        function generate() {
            const chars = getSelectedChars();
            if (!chars) {
                alert("Please select at least one character type.");
                return;
            }
            const length = parseInt(lengthSlider.value);
            const password = generatePassword(length, chars);
            passwordOutput.value = password;
            updateStrength(password);
        }

        lengthSlider.addEventListener("input", () => {
            lengthValue.textContent = lengthSlider.value;
        });

        generateBtn.addEventListener("click", generate);

        copyBtn.addEventListener("click", () => {
            if (!passwordOutput.value) return;
            navigator.clipboard.writeText(passwordOutput.value);
            const originalHTML = copyBtn.innerHTML;
            copyBtn.innerHTML = '<span class="text-sm">Copied!</span>';
            setTimeout(() => (copyBtn.innerHTML = originalHTML), 1500);
        });

        generateMultipleBtn.addEventListener("click", () => {
            const chars = getSelectedChars();
            if (!chars) {
                alert("Please select at least one character type.");
                return;
            }
            const length = parseInt(lengthSlider.value);
            multipleOutput.innerHTML = "";
            for (let i = 0; i < 5; i++) {
                const password = generatePassword(length, chars);
                const row = document.createElement("button");
                row.className =
                    "w-full text-left p-3 bg-gray-50 border border-gray-200 rounded-lg font-mono text-sm hover:bg-blue-50 hover:border-blue-300 transition";
                row.textContent = password;
                row.addEventListener("click", () => {
                    navigator.clipboard.writeText(password);
                    const original = row.textContent;
                    row.textContent = "✓ Copied!";
                    setTimeout(() => (row.textContent = original), 1500);
                });
                multipleOutput.appendChild(row);
            }
        });

        // Auto-generate on load
        generate();
    </script>
</Layout>
