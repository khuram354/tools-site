---
import Layout from "../../layouts/Layout.astro";
import {
    calculateAnnualTax,
    formatPKR,
    EOBI_EMPLOYEE_CONTRIBUTION,
    salariedSlabs,
    LAST_UPDATED,
} from "../../data/tax-data/pakistan-salaried";

const pageUrl = new URL(Astro.url.pathname, "https://toolsvibe.online").href;

// The slab table below is built from the SAME list the calculator uses
// (src/data/tax-data/pakistan-salaried.ts), so the two can never disagree.
const fmt = (n: number) => n.toLocaleString("en-US");
const slabRows = salariedSlabs.map((s) => {
    const floor = Math.max(s.min - 1, 0);
    const pct = Math.round(s.rate * 100);
    return {
        range:
            s.max === null
                ? `Above ${fmt(floor)}`
                : s.min === 0
                  ? `Up to ${fmt(s.max)}`
                  : `${fmt(s.min)} – ${fmt(s.max)}`,
        rate:
            s.rate === 0
                ? "0% (Tax-Free)"
                : s.fixedTax > 0
                  ? `PKR ${fmt(s.fixedTax)} + ${pct}% of amount exceeding ${fmt(floor)}`
                  : `${pct}% of amount exceeding ${fmt(floor)}`,
    };
});

// "Last reviewed" comes from LAST_UPDATED in the data file.
const lastReviewed = new Date(`${LAST_UPDATED}T00:00:00Z`).toLocaleDateString(
    "en-US",
    { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" },
);

// The worked example is calculated with the SAME function as the calculator,
// so the numbers shown on the page can never disagree with the tool.
const exampleMonthlyGross = 150000;
const exampleYearlyGross = exampleMonthlyGross * 12;
const exampleYearlyTax = calculateAnnualTax(exampleYearlyGross).tax;
const exampleMonthlyTax = exampleYearlyTax / 12;
const exampleNetMonthly =
    exampleMonthlyGross - exampleMonthlyTax - EOBI_EMPLOYEE_CONTRIBUTION;

// One source of truth: shown on the page AND used for the FAQ schema,
// so the visible text and the structured data always match.
const faqs = [
    {
        q: "Are these tax slabs accurate for 2026-27?",
        a: "They follow the salaried slabs under the Finance Act 2026 for Tax Year 2027 (July 2026 – June 2027). Tax rules can change, so confirm important figures with FBR or a tax professional.",
    },
    {
        q: "Does this calculator include the 9% surcharge?",
        a: "No. The 9% surcharge on salaried individuals has been abolished from Tax Year 2027, so your tax is simply the slab calculation.",
    },
    {
        q: "Does the calculator include tax credits or deductions?",
        a: "No. It applies the slabs to your annual gross salary. Deductions and credits, such as Zakat, donations to approved charities, or pension contributions, can lower your actual tax. Check them with your employer or a tax professional.",
    },
    {
        q: "Is my salary data stored anywhere?",
        a: "No. All calculations happen in your browser. Your salary information never leaves your device.",
    },
    {
        q: "Can I calculate tax for a different tax year?",
        a: "Our calculator currently supports Tax Year 2027 (FY 2026-27). Future years will be added as FBR announces new slabs.",
    },
    {
        q: "Does the calculator work on mobile?",
        a: "Yes. The tool works on any device: laptop, tablet, phone, or desktop.",
    },
    {
        q: "Is this tool free?",
        a: "Yes. It is free, needs no signup, and has no limits.",
    },
];

const webAppSchema = {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Salary Tax Calculator Pakistan",
    url: pageUrl,
    applicationCategory: "FinanceApplication",
    operatingSystem: "Any",
    browserRequirements: "Requires JavaScript",
    isAccessibleForFree: true,
    description:
        "Free salary tax calculator for Pakistan. Calculate monthly take-home salary and FBR income tax for Tax Year 2027 (FY 2026-27).",
    offers: { "@type": "Offer", price: "0", priceCurrency: "PKR" },
};

const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
};

const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item: "https://toolsvibe.online/",
        },
        {
            "@type": "ListItem",
            position: 2,
            name: "Tools",
            item: "https://toolsvibe.online/tools/",
        },
        {
            "@type": "ListItem",
            position: 3,
            name: "Salary Tax Calculator",
            item: pageUrl,
        },
    ],
};
---

<Layout
    title="Salary Tax Calculator Pakistan 2026-27 — Take-Home Pay"
    description="Free salary tax calculator for Pakistan, Tax Year 2027. See your monthly tax, yearly tax and take-home pay under the Finance Act 2026 slabs."
>
    <div class="max-w-4xl mx-auto">
        <header class="mb-8">
            <nav aria-label="Breadcrumb" class="text-xs text-gray-500 mb-4">
                <a href="/" class="hover:underline">Home</a>
                <span aria-hidden="true">/</span>
                <a href="/tools/" class="hover:underline">Tools</a>
                <span aria-hidden="true">/</span>
                <span>Salary Tax Calculator</span>
            </nav>
            <h1 class="text-3xl md:text-4xl font-bold mb-3">
                Salary Tax Calculator — Pakistan
            </h1>
            <p class="text-gray-600 mb-2">
                Calculate your income tax and take-home salary based on FBR Tax
                Year 2027 (FY 2026-27) slabs.
            </p>
            <p class="text-xs text-gray-500">
                Last reviewed: {lastReviewed} · Source:{" "}
                <a
                    href="https://www.fbr.gov.pk/"
                    target="_blank"
                    rel="noopener"
                    class="text-blue-600 hover:underline"
                >
                    Federal Board of Revenue (FBR)
                </a>{" "}
                — Finance Act 2026
            </p>
        </header>

        <!-- Input Section -->
        <section class="bg-white p-6 rounded-xl border border-gray-200 mb-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label
                        for="monthly-salary"
                        class="block text-sm font-medium mb-2"
                    >
                        Monthly Gross Salary (PKR)
                    </label>
                    <input
                        type="number"
                        id="monthly-salary"
                        value="150000"
                        min="0"
                        step="1000"
                        class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                        placeholder="e.g. 150000"
                    />
                </div>
                <div>
                    <label for="tax-year" class="block text-sm font-medium mb-2"
                        >Tax Year</label
                    >
                    <select
                        id="tax-year"
                        class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                    >
                        <option value="2026-27" selected
                            >Tax Year 2027 (FY 2026-27)</option
                        >
                    </select>
                </div>
            </div>

            <div class="mt-4">
                <label class="flex items-center gap-2 text-sm">
                    <input
                        type="checkbox"
                        id="apply-eobi"
                        class="rounded"
                        checked
                    />
                    <span
                        >Include EOBI deduction (PKR {
                            EOBI_EMPLOYEE_CONTRIBUTION
                        }/month, if your employer is registered with EOBI)</span
                    >
                </label>
                <p class="text-xs text-gray-500 mt-1 ml-6">
                    The employee share is 1% of the minimum wage, so the exact
                    amount depends on the minimum wage that applies to you.
                </p>
            </div>

            <p id="error" role="alert" class="hidden mt-4 text-sm text-red-600">
            </p>

            <button
                id="calculate-btn"
                class="mt-6 px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium transition"
            >
                Calculate Tax
            </button>
        </section>

        <p class="text-sm text-gray-500 mb-6">
            <strong>Note:</strong> These slabs apply to individuals whose salary makes
            up more than 75% of their income. If salary is less than 75% of your income,
            non-salaried slabs apply. This estimate applies the slabs to your gross
            salary and does not include tax credits or deductions.
        </p>

        <!-- Results Section -->
        <section id="results" class="hidden" aria-live="polite">
            <!-- Summary Cards -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
                <div
                    class="bg-white p-4 rounded-xl border border-gray-200 text-center"
                >
                    <div class="text-sm text-gray-500 mb-1">Monthly Tax</div>
                    <div
                        id="monthly-tax"
                        class="text-xl font-bold text-red-600"
                    >
                        PKR 0
                    </div>
                </div>
                <div
                    class="bg-white p-4 rounded-xl border border-gray-200 text-center"
                >
                    <div class="text-sm text-gray-500 mb-1">Yearly Tax</div>
                    <div id="yearly-tax" class="text-xl font-bold text-red-600">
                        PKR 0
                    </div>
                </div>
                <div
                    class="bg-white p-4 rounded-xl border border-gray-200 text-center"
                >
                    <div class="text-sm text-gray-500 mb-1">
                        Monthly Take-Home
                    </div>
                    <div
                        id="monthly-net"
                        class="text-xl font-bold text-green-600"
                    >
                        PKR 0
                    </div>
                </div>
                <div
                    class="bg-white p-4 rounded-xl border border-gray-200 text-center"
                >
                    <div class="text-sm text-gray-500 mb-1">
                        Yearly Take-Home
                    </div>
                    <div
                        id="yearly-net"
                        class="text-xl font-bold text-green-600"
                    >
                        PKR 0
                    </div>
                </div>
            </div>

            <!-- Detailed Breakdown -->
            <div class="bg-white p-6 rounded-xl border border-gray-200 mb-6">
                <h2 class="text-xl font-semibold mb-4">Detailed Breakdown</h2>
                <table class="w-full text-sm">
                    <tbody class="divide-y divide-gray-100">
                        <tr>
                            <td class="py-2 text-gray-600"
                                >Monthly Gross Salary</td
                            >
                            <td
                                id="breakdown-gross-monthly"
                                class="py-2 text-right font-medium">PKR 0</td
                            >
                        </tr>
                        <tr>
                            <td class="py-2 text-gray-600"
                                >Yearly Gross Salary</td
                            >
                            <td
                                id="breakdown-gross-yearly"
                                class="py-2 text-right font-medium">PKR 0</td
                            >
                        </tr>
                        <tr>
                            <td class="py-2 text-gray-600"
                                >EOBI Deduction (Monthly)</td
                            >
                            <td
                                id="breakdown-eobi"
                                class="py-2 text-right font-medium">PKR 0</td
                            >
                        </tr>
                        <tr>
                            <td class="py-2 text-gray-600"
                                >Taxable Annual Income</td
                            >
                            <td
                                id="breakdown-taxable"
                                class="py-2 text-right font-medium">PKR 0</td
                            >
                        </tr>
                        <tr>
                            <td class="py-2 text-gray-600"
                                >FBR Income Tax (Yearly)</td
                            >
                            <td
                                id="breakdown-tax-yearly"
                                class="py-2 text-right font-medium text-red-600"
                                >PKR 0</td
                            >
                        </tr>
                        <tr>
                            <td class="py-2 text-gray-600"
                                >FBR Income Tax (Monthly)</td
                            >
                            <td
                                id="breakdown-tax-monthly"
                                class="py-2 text-right font-medium text-red-600"
                                >PKR 0</td
                            >
                        </tr>
                        <tr class="bg-gray-50">
                            <td class="py-3 font-semibold"
                                >Net Monthly Take-Home</td
                            >
                            <td
                                id="breakdown-net"
                                class="py-3 text-right font-bold text-green-600 text-lg"
                                >PKR 0</td
                            >
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Slab Info -->
            <div class="bg-blue-50 p-4 rounded-xl border border-blue-200 mb-6">
                <h3 class="font-semibold mb-2">Your Tax Slab</h3>
                <p id="slab-info" class="text-sm text-gray-700">—</p>
            </div>

            <!-- Tax Saving Tips -->
            <div
                id="tax-tips"
                class="hidden bg-yellow-50 p-4 rounded-xl border border-yellow-200 mb-6"
            >
                <h3 class="font-semibold mb-2">💡 Tax Saving Tips</h3>
                <ul class="text-sm text-gray-700 space-y-1 list-disc pl-5">
                    <li>
                        Contributions to approved pension schemes (such as
                        Voluntary Pension Schemes) may qualify for a tax credit
                    </li>
                    <li>
                        Zakat paid and donations to approved charities may
                        reduce your tax, as a deduction or a credit depending on
                        the rule, so keep the receipts
                    </li>
                    <li>Keep documentation of all tax-deductible expenses</li>
                    <li>Consult a tax professional for personalized advice</li>
                </ul>
            </div>

            <!-- Action Buttons -->
            <div class="flex flex-wrap gap-3">
                <button
                    id="copy-btn"
                    class="px-5 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 text-sm font-medium"
                >
                    Copy Summary
                </button>
                <button
                    id="reset-btn"
                    class="px-5 py-2 bg-gray-200 text-gray-800 rounded-lg hover:bg-gray-300 text-sm font-medium"
                >
                    Reset
                </button>
            </div>
        </section>
    </div>

    <!-- SEO Content -->
    <section class="max-w-3xl mx-auto mt-16">
        <h2 class="text-2xl font-bold mb-4">
            About This Salary Tax Calculator
        </h2>
        <p class="text-gray-700 mb-4">
            This free salary tax calculator helps Pakistani salaried individuals
            calculate their monthly and yearly income tax based on the FBR tax
            slabs for Tax Year 2027 (FY 2026-27). It is fast, and runs entirely
            in your browser, so your salary information never leaves your
            device.
        </p>
        <p class="text-gray-700 mb-4">
            Every July, when the new tax year begins, the same questions come
            up: "How much tax will I pay this year?" and "Is my take-home salary
            going to change?" Most people rely on HR or a colleague to explain
            it — but it's actually simple once you know the slabs. This guide
            breaks it down step by step.
        </p>

        <h3 class="text-xl font-semibold mt-6 mb-3">How to Use</h3>
        <ol class="list-decimal pl-6 text-gray-700 space-y-2">
            <li>Enter your monthly gross salary in PKR</li>
            <li>Select the tax year (currently supports Tax Year 2027)</li>
            <li>Optionally include the EOBI deduction</li>
            <li>
                See your breakdown. It updates as you type, and "Calculate Tax"
                jumps you to the results.
            </li>
        </ol>

        <h3 class="text-xl font-semibold mt-6 mb-3">
            What This Calculator Shows
        </h3>
        <ul class="list-disc pl-6 text-gray-700 space-y-2">
            <li>
                <strong>Monthly tax:</strong> What gets deducted from your salary
                each month
            </li>
            <li>
                <strong>Yearly tax:</strong> The total FBR income tax on your annual
                income
            </li>
            <li>
                <strong>Monthly take-home:</strong> Your net salary after tax and
                EOBI
            </li>
            <li>
                <strong>Yearly take-home:</strong> Total amount you receive in a year
            </li>
            <li>
                <strong>Taxable annual income:</strong> The base on which tax is calculated
            </li>
            <li>
                <strong>Your tax slab:</strong> Which FBR bracket you fall into
            </li>
            <li>
                <strong>Tax saving tips:</strong> General ways to reduce your tax
            </li>
        </ul>

        <h3 class="text-xl font-semibold mt-6 mb-3">
            FBR Tax Slabs for Salaried Individuals (Tax Year 2027)
        </h3>
        <p class="text-gray-700 mb-4">
            Here are the slabs for FY 2026-27 under the Finance Act 2026:
        </p>
        <div class="overflow-x-auto mt-4">
            <table class="w-full text-sm border border-gray-200 rounded-lg">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="text-left p-3 font-semibold border-b"
                            >Annual Taxable Income (PKR)</th
                        >
                        <th class="text-left p-3 font-semibold border-b"
                            >Tax Rate</th
                        >
                    </tr>
                </thead>
                <tbody>
                    {
                        slabRows.map((row, i) => (
                            <tr>
                                <td
                                    class={
                                        i < slabRows.length - 1
                                            ? "p-3 border-b"
                                            : "p-3"
                                    }
                                >
                                    {row.range}
                                </td>
                                <td
                                    class={
                                        i < slabRows.length - 1
                                            ? "p-3 border-b"
                                            : "p-3"
                                    }
                                >
                                    {row.rate}
                                </td>
                            </tr>
                        ))
                    }
                </tbody>
            </table>
        </div>
        <p class="text-gray-700 mt-4">
            <strong>Note:</strong> The 9% surcharge on salaried individuals has been
            abolished for Tax Year 2027. Your tax is simply the slab calculation.
        </p>

        <h3 class="text-xl font-semibold mt-6 mb-3">A Worked Example</h3>
        <p class="text-gray-700 mb-4">
            Using the calculator, here's what happens if your monthly gross
            salary is {formatPKR(exampleMonthlyGross)}:
        </p>
        <ul class="list-disc pl-6 text-gray-700 space-y-2">
            <li>
                <strong>Annual gross:</strong>
                {formatPKR(exampleYearlyGross)}
            </li>
            <li>
                <strong>EOBI (if applicable):</strong>
                {formatPKR(EOBI_EMPLOYEE_CONTRIBUTION)}/month
            </li>
            <li>
                <strong>Tax slab:</strong> 1,200,001 – 2,200,000 (PKR 6,000 + 11%)
            </li>
            <li>
                <strong>Yearly tax:</strong>
                {formatPKR(exampleYearlyTax)}
            </li>
            <li>
                <strong>Monthly tax:</strong>
                {formatPKR(exampleMonthlyTax)}
            </li>
            <li>
                <strong>Net take-home:</strong>
                {formatPKR(exampleNetMonthly)}/month
            </li>
        </ul>

        <h3 class="text-xl font-semibold mt-6 mb-3">What Is a Salary Slip?</h3>
        <p class="text-gray-700 mb-4">
            A <strong>salary slip</strong> (also called pay slip or payslip) is a
            document your employer gives you every month showing:
        </p>
        <ul class="list-disc pl-6 text-gray-700 space-y-2">
            <li>Basic salary</li>
            <li>Allowances (house rent, medical, transport)</li>
            <li>Deductions (income tax, EOBI, provident fund)</li>
            <li>Net pay (what actually lands in your bank account)</li>
        </ul>
        <p class="text-gray-700 mt-4">
            When you use our calculator, you can cross-check the "income tax"
            line on your salary slip to make sure your employer is deducting the
            correct amount.
        </p>

        <h3 class="text-xl font-semibold mt-6 mb-3">
            Common Mistakes to Avoid
        </h3>
        <ul class="list-disc pl-6 text-gray-700 space-y-2">
            <li>
                <strong>Confusing monthly and annual slab:</strong> Your slab is decided
                by your <em>annual</em> taxable income, not monthly.
            </li>
            <li>
                <strong>Forgetting EOBI:</strong> If your employer is registered with
                EOBI, your share is deducted every month (1% of the minimum wage)
                and reduces your take-home.
            </li>
            <li>
                <strong>Not checking your salary slip:</strong> Employers sometimes
                miscalculate. Compare your salary slip against our calculator.
            </li>
            <li>
                <strong>Ignoring tax credits and deductions:</strong> Pension contributions,
                certain investments, Zakat, and donations may reduce your tax. Use
                our <a
                    href="/blog/how-to-save-tax-pakistan/"
                    class="text-blue-600 hover:underline font-medium"
                    >tax saving guide</a
                > to learn more.
            </li>
        </ul>

        <h3 class="text-xl font-semibold mt-6 mb-3">
            Frequently Asked Questions
        </h3>
        <div class="space-y-4 mt-3">
            {
                faqs.map((f) => (
                    <div>
                        <h4 class="font-semibold text-gray-900">{f.q}</h4>
                        <p class="text-gray-700 mt-1">{f.a}</p>
                    </div>
                ))
            }
        </div>

        <p
            class="text-xs text-gray-500 mt-6 p-3 bg-gray-50 rounded-lg border border-gray-200"
        >
            <strong>Disclaimer:</strong> This calculator is for estimation only, not
            tax advice. For final figures, consult FBR or a certified tax professional.
        </p>
    </section>

    <!-- Related Tools & Guides -->
    <section class="max-w-3xl mx-auto mt-16">
        <h2 class="text-2xl font-bold mb-6">Related Tools</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-10">
            <a
                href="/tools/freelancer-tax-calculator/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-semibold mb-1">Freelancer Tax Calculator</h3>
                <p class="text-sm text-gray-600">
                    Tax for IT export income and local freelance income.
                </p>
            </a>
            <a
                href="/tools/zakat-calculator/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-semibold mb-1">Zakat Calculator</h3>
                <p class="text-sm text-gray-600">
                    Calculate Zakat on gold, silver, and cash.
                </p>
            </a>
            <a
                href="/tools/emi-calculator/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-semibold mb-1">EMI Calculator</h3>
                <p class="text-sm text-gray-600">
                    Calculate loan EMI and total interest.
                </p>
            </a>
        </div>

        <h2 class="text-2xl font-bold mb-6">Related Guides</h2>
        <div class="space-y-3">
            <a
                href="/blog/salary-tax-calculator-pakistan/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-medium">
                    Salary Tax Calculator Pakistan 2026-27
                </h3>
                <p class="text-sm text-gray-600">
                    Step-by-step guide to using the calculator.
                </p>
            </a>
            <a
                href="/blog/salary-tax-pakistan/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-medium">
                    How to Calculate Salary Tax in Pakistan
                </h3>
                <p class="text-sm text-gray-600">
                    Complete FBR slab guide with examples.
                </p>
            </a>
            <a
                href="/blog/how-to-save-tax-pakistan/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-medium">
                    7 Legal Ways to Save Tax in Pakistan
                </h3>
                <p class="text-sm text-gray-600">
                    Reduce your tax bill with FBR-approved credits.
                </p>
            </a>
        </div>
    </section>

    <script>
        import {
            calculateAnnualTax,
            formatPKR,
            EOBI_EMPLOYEE_CONTRIBUTION,
        } from "../../data/tax-data/pakistan-salaried";

        interface Calculation {
            monthlyGross: number;
            yearlyGross: number;
            eobiMonthly: number;
            taxableIncome: number;
            tax: number;
            monthlyTax: number;
            netMonthly: number;
            netYearly: number;
        }

        const salaryInput = document.getElementById(
            "monthly-salary",
        ) as HTMLInputElement;
        const eobiCheckbox = document.getElementById(
            "apply-eobi",
        ) as HTMLInputElement;
        const calculateBtn = document.getElementById("calculate-btn")!;
        const results = document.getElementById("results")!;
        const errorBox = document.getElementById("error")!;
        const copyBtn = document.getElementById("copy-btn")!;
        const resetBtn = document.getElementById("reset-btn")!;

        let lastCalculation: Calculation | null = null;

        // Returns true when the input was valid and the results were updated.
        // With showErrors = false (live typing) invalid input is ignored and
        // the previous results stay on screen.
        function calculate(showErrors: boolean): boolean {
            const monthlyGross = parseFloat(salaryInput.value);
            if (!(monthlyGross > 0)) {
                if (showErrors) {
                    errorBox.textContent =
                        "Please enter a valid monthly salary.";
                    errorBox.classList.remove("hidden");
                }
                return false;
            }
            errorBox.classList.add("hidden");

            const yearlyGross = monthlyGross * 12;
            const eobiMonthly = eobiCheckbox.checked
                ? EOBI_EMPLOYEE_CONTRIBUTION
                : 0;
            const taxableIncome = yearlyGross;

            const { tax, slab } = calculateAnnualTax(taxableIncome);
            const monthlyTax = tax / 12;
            const netMonthly = monthlyGross - monthlyTax - eobiMonthly;
            const netYearly = netMonthly * 12;

            document.getElementById("monthly-tax")!.textContent =
                formatPKR(monthlyTax);
            document.getElementById("yearly-tax")!.textContent = formatPKR(tax);
            document.getElementById("monthly-net")!.textContent =
                formatPKR(netMonthly);
            document.getElementById("yearly-net")!.textContent =
                formatPKR(netYearly);

            document.getElementById("breakdown-gross-monthly")!.textContent =
                formatPKR(monthlyGross);
            document.getElementById("breakdown-gross-yearly")!.textContent =
                formatPKR(yearlyGross);
            document.getElementById("breakdown-eobi")!.textContent =
                formatPKR(eobiMonthly);
            document.getElementById("breakdown-taxable")!.textContent =
                formatPKR(taxableIncome);
            document.getElementById("breakdown-tax-yearly")!.textContent =
                formatPKR(tax);
            document.getElementById("breakdown-tax-monthly")!.textContent =
                formatPKR(monthlyTax);
            document.getElementById("breakdown-net")!.textContent =
                formatPKR(netMonthly);

            if (slab) {
                document.getElementById("slab-info")!.textContent =
                    slab.description;
            }

            const tips = document.getElementById("tax-tips")!;
            if (tax > 0) {
                tips.classList.remove("hidden");
            } else {
                tips.classList.add("hidden");
            }

            results.classList.remove("hidden");

            lastCalculation = {
                monthlyGross,
                yearlyGross,
                eobiMonthly,
                taxableIncome,
                tax,
                monthlyTax,
                netMonthly,
                netYearly,
            };
            return true;
        }

        // Live updates while the person changes a value.
        salaryInput.addEventListener("input", () => calculate(false));
        eobiCheckbox.addEventListener("change", () => calculate(false));

        calculateBtn.addEventListener("click", () => {
            if (calculate(true)) {
                results.scrollIntoView({ behavior: "smooth" });
            }
        });

        copyBtn.addEventListener("click", async () => {
            if (!lastCalculation) return;
            const c = lastCalculation;
            const text = `📊 ToolsVibe Tax Report (FY 2026-27)
-----------------------------------
Monthly Gross: ${formatPKR(c.monthlyGross)}
Yearly Gross: ${formatPKR(c.yearlyGross)}
EOBI Deduction: ${formatPKR(c.eobiMonthly)}/month
Taxable Income: ${formatPKR(c.taxableIncome)}
FBR Tax (Monthly): ${formatPKR(c.monthlyTax)}
Net Take-Home (Monthly): ${formatPKR(c.netMonthly)}

Calculated via: toolsvibe.online`;
            try {
                await navigator.clipboard.writeText(text);
                copyBtn.textContent = "Copied!";
            } catch {
                copyBtn.textContent = "Copy failed";
            }
            setTimeout(() => (copyBtn.textContent = "Copy Summary"), 2000);
        });

        resetBtn.addEventListener("click", () => {
            salaryInput.value = "150000";
            eobiCheckbox.checked = true;
            errorBox.classList.add("hidden");
            calculate(false);
        });

        calculate(false);
    </script>

    <script
        type="application/ld+json"
        set:html={JSON.stringify(webAppSchema)}
    />
    <script
        type="application/ld+json"
        set:html={JSON.stringify(breadcrumbSchema)}
    />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Layout>
