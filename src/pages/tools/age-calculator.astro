---
import Layout from "../../layouts/Layout.astro";

const pageUrl = new URL(Astro.url.pathname, "https://toolsvibe.online").href;

// One source of truth: rendered on the page AND used for FAQ schema,
// so the visible text and the structured data can never drift apart.
const faqs = [
    {
        q: "How is age calculated?",
        a: "Age is calculated by counting full years first, then the remaining full months, then the remaining days. The calculator compares your date of birth with the date you choose (today by default).",
    },
    {
        q: "How is a February 29 birthday handled?",
        a: "In years that are not leap years, a February 29 birthday is counted on February 28. Some jurisdictions use March 1 instead, so check the rule that applies to your form or document.",
    },
    {
        q: "Is my date of birth saved?",
        a: "No. The calculation runs in your browser, and the dates you enter are not sent to any server or stored.",
    },
    {
        q: "Can I calculate my age on a past or future date?",
        a: "Yes. Change the 'Age at Date' field to any date. This is useful when a form asks for your age as of a closing date or cut-off date.",
    },
    {
        q: "How many days old am I?",
        a: "Enter your date of birth and read the Total Days box. It counts every full day between your birth date and the date you choose. Total hours and minutes are that number multiplied by 24 and 60.",
    },
    {
        q: "Is this tool free?",
        a: "Yes. It is free, needs no signup, and has no limits.",
    },
];

const webAppSchema = {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Exact Age Calculator",
    url: pageUrl,
    applicationCategory: "UtilitiesApplication",
    operatingSystem: "Any",
    browserRequirements: "Requires JavaScript",
    isAccessibleForFree: true,
    description:
        "Free online age calculator. Find your exact age in years, months, and days, plus total days, hours, and minutes lived and your next birthday countdown.",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};

const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
};

const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item: "https://toolsvibe.online/",
        },
        {
            "@type": "ListItem",
            position: 2,
            name: "Tools",
            item: "https://toolsvibe.online/tools/",
        },
        {
            "@type": "ListItem",
            position: 3,
            name: "Age Calculator",
            item: pageUrl,
        },
    ],
};
---

<Layout
    title="Age Calculator: Exact Age in Years, Months & Days"
    description="Free age calculator: enter your date of birth to get your exact age in years, months and days, total days lived, and days until your next birthday."
>
    <div class="max-w-3xl mx-auto">
        <header class="mb-8">
            <nav aria-label="Breadcrumb" class="text-xs text-gray-500 mb-4">
                <a href="/" class="hover:underline">Home</a>
                <span aria-hidden="true">/</span>
                <a href="/tools/" class="hover:underline">Tools</a>
                <span aria-hidden="true">/</span>
                <span>Age Calculator</span>
            </nav>
            <h1 class="text-3xl md:text-4xl font-bold mb-3">
                Exact Age Calculator
            </h1>
            <p class="text-gray-600 mb-2">
                Find your exact age in years, months, and days, plus your total
                days, hours, and minutes lived and a countdown to your next
                birthday.
            </p>
            <p class="text-xs text-gray-500">
                🔒 100% Private: Calculations run locally in your browser. Your
                date of birth is never saved.
            </p>
        </header>

        <!-- Input Section -->
        <section class="bg-white p-6 rounded-xl border border-gray-200 mb-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label for="dob" class="block text-sm font-medium mb-2"
                        >Date of Birth</label
                    >
                    <input
                        type="date"
                        id="dob"
                        class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                    />
                </div>
                <div>
                    <label
                        for="calc-date"
                        class="block text-sm font-medium mb-2"
                        >Age at Date (default: today)</label
                    >
                    <input
                        type="date"
                        id="calc-date"
                        class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                    />
                </div>
            </div>

            <p id="error" role="alert" class="hidden mt-4 text-sm text-red-600">
            </p>

            <button
                id="calculate-btn"
                class="mt-6 px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium transition"
            >
                Calculate Age
            </button>
        </section>

        <!-- Results -->
        <section id="results" class="hidden" aria-live="polite">
            <!-- Main Result -->
            <div
                class="bg-blue-50 border border-blue-200 p-6 rounded-xl mb-6 text-center"
            >
                <p class="text-sm text-gray-600 mb-2">Your Age</p>
                <p id="age-main" class="text-4xl font-bold text-blue-700 mb-2">
                    —
                </p>
                <p id="age-sub" class="text-sm text-gray-600">—</p>
            </div>

            <!-- Detailed Breakdown -->
            <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-6">
                <div
                    class="bg-white p-4 rounded-xl border border-gray-200 text-center"
                >
                    <div id="years" class="text-2xl font-bold text-gray-800">
                        —
                    </div>
                    <div class="text-xs text-gray-500 mt-1">Years</div>
                </div>
                <div
                    class="bg-white p-4 rounded-xl border border-gray-200 text-center"
                >
                    <div id="months" class="text-2xl font-bold text-gray-800">
                        —
                    </div>
                    <div class="text-xs text-gray-500 mt-1">Months</div>
                </div>
                <div
                    class="bg-white p-4 rounded-xl border border-gray-200 text-center"
                >
                    <div id="days" class="text-2xl font-bold text-gray-800">
                        —
                    </div>
                    <div class="text-xs text-gray-500 mt-1">Days</div>
                </div>
                <div
                    class="bg-white p-4 rounded-xl border border-gray-200 text-center"
                >
                    <div
                        id="total-days"
                        class="text-xl font-bold text-gray-800"
                    >
                        —
                    </div>
                    <div class="text-xs text-gray-500 mt-1">Total Days</div>
                </div>
                <div
                    class="bg-white p-4 rounded-xl border border-gray-200 text-center"
                >
                    <div
                        id="total-hours"
                        class="text-xl font-bold text-gray-800"
                    >
                        —
                    </div>
                    <div class="text-xs text-gray-500 mt-1">Total Hours</div>
                </div>
                <div
                    class="bg-white p-4 rounded-xl border border-gray-200 text-center"
                >
                    <div
                        id="total-minutes"
                        class="text-xl font-bold text-gray-800"
                    >
                        —
                    </div>
                    <div class="text-xs text-gray-500 mt-1">Total Minutes</div>
                </div>
            </div>

            <!-- Next Birthday -->
            <div class="bg-green-50 border border-green-200 p-6 rounded-xl">
                <h2 class="text-lg font-semibold mb-3">Next Birthday</h2>
                <p id="next-birthday" class="text-sm text-gray-700 mb-2">—</p>
                <p id="next-birthday-day" class="text-sm text-gray-700">—</p>
            </div>
        </section>
    </div>

    <!-- SEO Content -->
    <section class="max-w-3xl mx-auto mt-16">
        <h2 class="text-2xl font-bold mb-4">About This Age Calculator</h2>
        <p class="text-gray-700 mb-4">
            This free age calculator tells you your exact age in years, months,
            and days, plus the total days, hours, and minutes you have lived. It
            also shows how many days remain until your next birthday and which
            day of the week it falls on. Everything runs in your browser, so no
            data is sent anywhere.
        </p>
        <p class="text-gray-700 mb-4">
            Most age calculators only show your age in years. This one gives you
            the full breakdown, and you can change the calculation date to find
            your age on any past or future date.
        </p>

        <h3 class="text-xl font-semibold mt-6 mb-3">How to Use</h3>
        <ol class="list-decimal pl-6 text-gray-700 space-y-2">
            <li>Enter your date of birth</li>
            <li>
                (Optional) Change the "Age at Date" field to find your age on a
                specific date
            </li>
            <li>Click "Calculate Age"</li>
            <li>
                See your exact age, total days, hours, minutes, and next
                birthday
            </li>
        </ol>

        <h3 class="text-xl font-semibold mt-6 mb-3">
            What This Calculator Shows
        </h3>
        <ul class="list-disc pl-6 text-gray-700 space-y-2">
            <li>
                <strong>Exact age:</strong> Full years, then months, then days
            </li>
            <li>
                <strong>Total days lived:</strong> Every full day since your birth
            </li>
            <li><strong>Total hours lived:</strong> Total days × 24</li>
            <li><strong>Total minutes lived:</strong> Total hours × 60</li>
            <li>
                <strong>Next birthday:</strong> Days remaining, and the day of the
                week it falls on
            </li>
            <li>
                <strong>Custom calculation date:</strong> Your age on any date, past
                or future
            </li>
        </ul>

        <h3 class="text-xl font-semibold mt-6 mb-3">Common Use Cases</h3>

        <h4 class="font-semibold mt-4 mb-2">
            1. Forms and Applications With an Age Cut-Off
        </h4>
        <p class="text-gray-700 mb-4">
            Job applications, school admissions, and exams often ask for your
            age in years, months, and days as of a closing date. Set "Age at
            Date" to that date to get the figure to enter. Always follow the
            rule stated by the organization, since each one defines its own
            cut-off.
        </p>

        <h4 class="font-semibold mt-4 mb-2">
            2. Planning Birthday Celebrations
        </h4>
        <p class="text-gray-700 mb-4">
            The countdown shows how many days remain until your birthday and
            what day of the week it falls on. Useful for planning parties,
            booking venues, or coordinating with family.
        </p>

        <h4 class="font-semibold mt-4 mb-2">3. Curious Statistics</h4>
        <p class="text-gray-700 mb-4">
            How many days have you lived? How many hours? The totals are
            surprisingly large and make fun personal milestones.
        </p>

        <h4 class="font-semibold mt-4 mb-2">
            4. Past or Future Age Calculations
        </h4>
        <p class="text-gray-700 mb-4">
            Want to know how old you were on a specific past date, or how old
            you will be on a future date? Change the calculation date and get
            the exact answer.
        </p>

        <h3 class="text-xl font-semibold mt-6 mb-3">A Worked Example</h3>
        <p class="text-gray-700 mb-4">
            If your date of birth is <strong>June 15, 1995</strong> and the calculation
            date is <strong>October 20, 2026</strong>, the calculator shows:
        </p>
        <ul class="list-disc pl-6 text-gray-700 space-y-2">
            <li><strong>Exact age:</strong> 31 years, 4 months, 5 days</li>
            <li><strong>Total days:</strong> 11,450 days</li>
            <li><strong>Total hours:</strong> 274,800 hours</li>
            <li><strong>Total minutes:</strong> 16,488,000 minutes</li>
            <li>
                <strong>Next birthday:</strong> June 15, 2027 (Tuesday), 238 days
                after the calculation date
            </li>
        </ul>

        <h3 class="text-xl font-semibold mt-6 mb-3">How Age Is Calculated</h3>
        <p class="text-gray-700 mb-4">
            The calculator counts full years first, then the remaining full
            months, then the remaining days. Leap years are included in the day
            counts.
        </p>
        <p class="text-gray-700 mb-4">
            If you were born on February 29, your birthday is counted on
            February 28 in years that are not leap years. Some jurisdictions use
            March 1 instead, so check the rule for your document if the exact
            date matters. This tool is for general information and is not legal
            advice.
        </p>

        <h3 class="text-xl font-semibold mt-6 mb-3">
            Frequently Asked Questions
        </h3>
        <div class="space-y-4 mt-3">
            {
                faqs.map((f) => (
                    <div>
                        <h4 class="font-semibold text-gray-900">{f.q}</h4>
                        <p class="text-gray-700 mt-1">{f.a}</p>
                    </div>
                ))
            }
        </div>
    </section>

    <!-- Related Tools -->
    <section class="max-w-3xl mx-auto mt-16">
        <h2 class="text-2xl font-bold mb-6">Related Tools</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <a
                href="/tools/unit-converter/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-semibold mb-1">Unit Converter</h3>
                <p class="text-sm text-gray-600">
                    Convert length, weight, and temperature.
                </p>
            </a>
            <a
                href="/tools/percentage-calculator/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-semibold mb-1">Percentage Calculator</h3>
                <p class="text-sm text-gray-600">
                    Solve percentage problems and discounts.
                </p>
            </a>
            <a
                href="/tools/emi-calculator/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-semibold mb-1">EMI Calculator</h3>
                <p class="text-sm text-gray-600">
                    Calculate loan EMI and total interest.
                </p>
            </a>
        </div>
    </section>

    <script>
        const dobInput = document.getElementById("dob") as HTMLInputElement;
        const calcDateInput = document.getElementById(
            "calc-date",
        ) as HTMLInputElement;
        const calculateBtn = document.getElementById("calculate-btn")!;
        const results = document.getElementById("results")!;
        const errorBox = document.getElementById("error")!;

        const MS_PER_DAY = 86_400_000;

        // "YYYY-MM-DD" -> LOCAL date. (new Date("YYYY-MM-DD") is parsed as UTC
        // and can land on the previous day for visitors west of UTC.)
        function parseLocalDate(value: string): Date {
            const [y, m, d] = value.split("-").map(Number);
            return new Date(y, m - 1, d);
        }

        function toInputValue(date: Date): string {
            const pad = (n: number) => String(n).padStart(2, "0");
            return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;
        }

        // Whole calendar days between two dates, unaffected by daylight saving.
        function daysBetween(from: Date, to: Date): number {
            const a = Date.UTC(
                from.getFullYear(),
                from.getMonth(),
                from.getDate(),
            );
            const b = Date.UTC(to.getFullYear(), to.getMonth(), to.getDate());
            return Math.round((b - a) / MS_PER_DAY);
        }

        // Same day-of-month `months` later, clamped to the last day of that
        // month (Jan 31 + 1 month = Feb 28/29; Feb 29 + 1 year = Feb 28).
        function addMonths(date: Date, months: number): Date {
            const first = new Date(
                date.getFullYear(),
                date.getMonth() + months,
                1,
            );
            const lastDay = new Date(
                first.getFullYear(),
                first.getMonth() + 1,
                0,
            ).getDate();
            return new Date(
                first.getFullYear(),
                first.getMonth(),
                Math.min(date.getDate(), lastDay),
            );
        }

        function showError(message: string) {
            errorBox.textContent = message;
            errorBox.classList.remove("hidden");
            results.classList.add("hidden");
        }

        const today = new Date();
        calcDateInput.value = toInputValue(today);
        dobInput.max = toInputValue(today);

        function calculateAge() {
            errorBox.classList.add("hidden");

            if (!dobInput.value) {
                showError("Please enter your date of birth.");
                return;
            }

            const dob = parseLocalDate(dobInput.value);
            const calcDate = calcDateInput.value
                ? parseLocalDate(calcDateInput.value)
                : parseLocalDate(toInputValue(new Date()));

            if (dob > calcDate) {
                showError(
                    "Date of birth cannot be after the calculation date.",
                );
                return;
            }

            // Exact years, months, days
            let totalMonths =
                (calcDate.getFullYear() - dob.getFullYear()) * 12 +
                (calcDate.getMonth() - dob.getMonth());
            let anchor = addMonths(dob, totalMonths);
            if (anchor > calcDate) {
                totalMonths--;
                anchor = addMonths(dob, totalMonths);
            }
            const years = Math.floor(totalMonths / 12);
            const months = totalMonths % 12;
            const days = daysBetween(anchor, calcDate);

            // Total days/hours/minutes
            const totalDays = daysBetween(dob, calcDate);
            const totalHours = totalDays * 24;
            const totalMinutes = totalHours * 60;

            // Update UI
            document.getElementById("age-main")!.textContent =
                `${years} years, ${months} months, ${days} days`;
            document.getElementById("age-sub")!.textContent =
                `Calculated on ${calcDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}`;

            document.getElementById("years")!.textContent = years.toString();
            document.getElementById("months")!.textContent = months.toString();
            document.getElementById("days")!.textContent = days.toString();
            document.getElementById("total-days")!.textContent =
                totalDays.toLocaleString();
            document.getElementById("total-hours")!.textContent =
                totalHours.toLocaleString();
            document.getElementById("total-minutes")!.textContent =
                totalMinutes.toLocaleString();

            // Next birthday (on or after the calculation date)
            let nextBday = addMonths(
                dob,
                (calcDate.getFullYear() - dob.getFullYear()) * 12,
            );
            if (nextBday < calcDate) {
                nextBday = addMonths(
                    dob,
                    (calcDate.getFullYear() + 1 - dob.getFullYear()) * 12,
                );
            }
            const daysUntil = daysBetween(calcDate, nextBday);
            const dayName = nextBday.toLocaleDateString("en-US", {
                weekday: "long",
            });
            const dateStr = nextBday.toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
            });

            document.getElementById("next-birthday")!.textContent =
                daysUntil === 0
                    ? `🎉 Today is your birthday!`
                    : `${daysUntil} day${daysUntil === 1 ? "" : "s"} until your next birthday`;
            document.getElementById("next-birthday-day")!.textContent =
                daysUntil === 0 ? `—` : `Falls on ${dateStr} (${dayName})`;

            results.classList.remove("hidden");
            results.scrollIntoView({ behavior: "smooth" });
        }

        calculateBtn.addEventListener("click", calculateAge);
    </script>

    <script
        type="application/ld+json"
        set:html={JSON.stringify(webAppSchema)}
    />
    <script
        type="application/ld+json"
        set:html={JSON.stringify(breadcrumbSchema)}
    />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Layout>
