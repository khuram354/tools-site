---
import Layout from "../../layouts/Layout.astro";
---

<Layout
    title="Exact Age Calculator — Find Your Age in Years, Days & Hours"
    description="Free age calculator by ToolsVibe. Find your exact age in years, months, and days, track total hours lived, and view a live countdown to your next birthday."
>
    <div class="max-w-3xl mx-auto">
        <header class="mb-8">
            <h1 class="text-3xl md:text-4xl font-bold mb-3">
                Exact Age Calculator
            </h1>
            <p class="text-gray-600 mb-2">
                Find your exact age down to the years, months, and days—plus
                your total hours, minutes, and a live upcoming birthday
                countdown.
            </p>
            <p class="text-xs text-gray-500">
                🔒 100% Private: Calculations run locally in your browser. Your
                date of birth is never saved.
            </p>
        </header>

        <!-- Input Section -->
        <section class="bg-white p-6 rounded-xl border border-gray-200 mb-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label for="dob" class="block text-sm font-medium mb-2"
                        >Date of Birth</label
                    >
                    <input
                        type="date"
                        id="dob"
                        class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                    />
                </div>
                <div>
                    <label
                        for="calc-date"
                        class="block text-sm font-medium mb-2"
                        >Age at Date (default: today)</label
                    >
                    <input
                        type="date"
                        id="calc-date"
                        class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                    />
                </div>
            </div>

            <button
                id="calculate-btn"
                class="mt-6 px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium transition"
            >
                Calculate Age
            </button>
        </section>

        <!-- Results -->
        <section id="results" class="hidden">
            <!-- Main Result -->
            <div
                class="bg-blue-50 border border-blue-200 p-6 rounded-xl mb-6 text-center"
            >
                <p class="text-sm text-gray-600 mb-2">Your Age</p>
                <p id="age-main" class="text-4xl font-bold text-blue-700 mb-2">
                    —
                </p>
                <p id="age-sub" class="text-sm text-gray-600">—</p>
            </div>

            <!-- Detailed Breakdown -->
            <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-6">
                <div
                    class="bg-white p-4 rounded-xl border border-gray-200 text-center"
                >
                    <div id="years" class="text-2xl font-bold text-gray-800">
                        —
                    </div>
                    <div class="text-xs text-gray-500 mt-1">Years</div>
                </div>
                <div
                    class="bg-white p-4 rounded-xl border border-gray-200 text-center"
                >
                    <div id="months" class="text-2xl font-bold text-gray-800">
                        —
                    </div>
                    <div class="text-xs text-gray-500 mt-1">Months</div>
                </div>
                <div
                    class="bg-white p-4 rounded-xl border border-gray-200 text-center"
                >
                    <div id="days" class="text-2xl font-bold text-gray-800">
                        —
                    </div>
                    <div class="text-xs text-gray-500 mt-1">Days</div>
                </div>
                <div
                    class="bg-white p-4 rounded-xl border border-gray-200 text-center"
                >
                    <div
                        id="total-days"
                        class="text-xl font-bold text-gray-800"
                    >
                        —
                    </div>
                    <div class="text-xs text-gray-500 mt-1">Total Days</div>
                </div>
                <div
                    class="bg-white p-4 rounded-xl border border-gray-200 text-center"
                >
                    <div
                        id="total-hours"
                        class="text-xl font-bold text-gray-800"
                    >
                        —
                    </div>
                    <div class="text-xs text-gray-500 mt-1">Total Hours</div>
                </div>
                <div
                    class="bg-white p-4 rounded-xl border border-gray-200 text-center"
                >
                    <div
                        id="total-minutes"
                        class="text-xl font-bold text-gray-800"
                    >
                        —
                    </div>
                    <div class="text-xs text-gray-500 mt-1">Total Minutes</div>
                </div>
            </div>

            <!-- Next Birthday -->
            <div class="bg-green-50 border border-green-200 p-6 rounded-xl">
                <h2 class="text-lg font-semibold mb-3">Next Birthday</h2>
                <p id="next-birthday" class="text-sm text-gray-700 mb-2">—</p>
                <p id="next-birthday-day" class="text-sm text-gray-700">—</p>
            </div>
        </section>
    </div>
    <!-- SEO Content (800+ words) -->
    <section class="max-w-3xl mx-auto mt-16">
        <h2 class="text-2xl font-bold mb-4">About This Age Calculator</h2>
        <p class="text-gray-700 mb-4">
            This free age calculator tells you your exact age in years, months,
            days, hours, and minutes. It also shows your next birthday
            countdown. Runs entirely in your browser — no data is sent anywhere.
            Whether you need your exact age for a form, want to know how many
            days you've lived, or are curious about your next birthday, this
            tool gives you the answer instantly.
        </p>
        <p class="text-gray-700 mb-4">
            Most age calculators just show your age in years. This one goes
            further: exact years, months, and days, plus total days, hours, and
            minutes lived. It's the same calculation method used on official
            documents and applications.
        </p>

        <h3 class="text-xl font-semibold mt-6 mb-3">How to Use</h3>
        <ol class="list-decimal pl-6 text-gray-700 space-y-2">
            <li>Enter your date of birth</li>
            <li>
                (Optional) Change the calculation date — useful for finding your
                age on a specific date
            </li>
            <li>Click "Calculate Age"</li>
            <li>
                See your exact age, total days, hours, minutes, and next
                birthday countdown
            </li>
        </ol>

        <h3 class="text-xl font-semibold mt-6 mb-3">
            What This Calculator Shows
        </h3>
        <ul class="list-disc pl-6 text-gray-700 space-y-2">
            <li>
                <strong>Exact age:</strong> Years, months, and days (standard international
                method)
            </li>
            <li>
                <strong>Total days lived:</strong> Every day since your birth
            </li>
            <li><strong>Total hours lived:</strong> Total days × 24</li>
            <li><strong>Total minutes lived:</strong> Total hours × 60</li>
            <li>
                <strong>Next birthday:</strong> How many days until your next birthday,
                and what day of the week it falls on
            </li>
            <li>
                <strong>Custom calculation date:</strong> Find your age on any date
                — past, present, or future
            </li>
        </ul>

        <h3 class="text-xl font-semibold mt-6 mb-3">Common Use Cases</h3>

        <h4 class="font-semibold mt-4 mb-2">1. Filling Out Forms</h4>
        <p class="text-gray-700 mb-4">
            Many forms — job applications, visa applications, school admissions
            — require your exact age in years, months, and days. This tool gives
            you the precise figure to enter.
        </p>

        <h4 class="font-semibold mt-4 mb-2">
            2. Checking Eligibility for Age-Limited Services
        </h4>
        <p class="text-gray-700 mb-4">
            Some services have minimum or maximum age requirements. If a form
            asks "are you at least 18 years old as of [date]?", this calculator
            lets you confirm with a specific date.
        </p>

        <h4 class="font-semibold mt-4 mb-2">
            3. Planning Birthday Celebrations
        </h4>
        <p class="text-gray-700 mb-4">
            The next-birthday countdown shows how many days remain until your
            birthday, and what day of the week it falls on. Useful for planning
            parties, booking venues, or coordinating with family.
        </p>

        <h4 class="font-semibold mt-4 mb-2">4. Curious Statistics</h4>
        <p class="text-gray-700 mb-4">
            How many days have you lived? How many hours? How many minutes? The
            totals are surprisingly large — and useful for personal milestones
            or health tracking.
        </p>

        <h4 class="font-semibold mt-4 mb-2">
            5. Historical or Future Age Calculations
        </h4>
        <p class="text-gray-700 mb-4">
            Want to know how old you were on a specific past date, or how old
            you'll be on a future date? Change the calculation date and get the
            exact answer.
        </p>

        <h4 class="font-semibold mt-4 mb-2">
            6. Age Verification for Contracts
        </h4>
        <p class="text-gray-700 mb-4">
            Legal documents sometimes require proof of exact age as of a
            specific date. This tool gives you the precise figure to confirm.
        </p>

        <h3 class="text-xl font-semibold mt-6 mb-3">A Worked Example</h3>
        <p class="text-gray-700 mb-4">
            If your date of birth is <strong>June 15, 1995</strong> and today is <strong
                >October 20, 2026</strong
            >, here's what the calculator shows:
        </p>
        <ul class="list-disc pl-6 text-gray-700 space-y-2">
            <li><strong>Exact age:</strong> 31 years, 4 months, 5 days</li>
            <li><strong>Total days:</strong> ~11,450 days</li>
            <li><strong>Total hours:</strong> ~274,800 hours</li>
            <li><strong>Total minutes:</strong> ~16,488,000 minutes</li>
            <li>
                <strong>Next birthday:</strong> June 15, 2027 (Tuesday) — about 238
                days away
            </li>
        </ul>

        <h3 class="text-xl font-semibold mt-6 mb-3">How Age Is Calculated</h3>
        <p class="text-gray-700 mb-4">
            Age is calculated using the standard international method: full
            years first, then remaining months, then remaining days. This is the
            same method used for official documents, legal forms, and government
            registrations.
        </p>
        <p class="text-gray-700 mb-4">
            Leap years are automatically handled. If you were born on February
            29, the calculator adjusts so your age is accurate on any
            calculation date.
        </p>

        <h3 class="text-xl font-semibold mt-6 mb-3">
            Frequently Asked Questions
        </h3>
        <div class="space-y-4 mt-3">
            <div>
                <h4 class="font-semibold text-gray-900">
                    How is age calculated?
                </h4>
                <p class="text-gray-700 mt-1">
                    Age is calculated using the standard international method:
                    full years first, then remaining months, then remaining
                    days. This is the same method used for official documents.
                </p>
            </div>
            <div>
                <h4 class="font-semibold text-gray-900">
                    Does this account for leap years?
                </h4>
                <p class="text-gray-700 mt-1">
                    Yes. Leap years are automatically handled, so your age will
                    be accurate even if you were born on February 29.
                </p>
            </div>
            <div>
                <h4 class="font-semibold text-gray-900">
                    Is my date of birth saved?
                </h4>
                <p class="text-gray-700 mt-1">
                    No. All calculations happen in your browser. Your date of
                    birth is never sent to any server or stored anywhere.
                </p>
            </div>
            <div>
                <h4 class="font-semibold text-gray-900">
                    Can I calculate my age on a future date?
                </h4>
                <p class="text-gray-700 mt-1">
                    Yes. Change the "Age at Date" field to any date in the past,
                    present, or future. The calculator shows your exact age on
                    that date.
                </p>
            </div>
            <div>
                <h4 class="font-semibold text-gray-900">
                    Why is the total days count so large?
                </h4>
                <p class="text-gray-700 mt-1">
                    Total days counts every day since your birth. For a
                    30-year-old, that's about 11,000 days — which is a lot of
                    days when you count them all.
                </p>
            </div>
            <div>
                <h4 class="font-semibold text-gray-900">Is this tool free?</h4>
                <p class="text-gray-700 mt-1">
                    Yes, completely free with no signup, no limits, and no
                    watermarks.
                </p>
            </div>
        </div>
    </section>

    <!-- Related Tools -->
    <section class="max-w-3xl mx-auto mt-16">
        <h2 class="text-2xl font-bold mb-6">Related Tools</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <a
                href="/tools/unit-converter/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-semibold mb-1">Unit Converter</h3>
                <p class="text-sm text-gray-600">
                    Convert length, weight, and temperature.
                </p>
            </a>
            <a
                href="/tools/percentage-calculator/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-semibold mb-1">Percentage Calculator</h3>
                <p class="text-sm text-gray-600">
                    Solve percentage problems and discounts.
                </p>
            </a>
            <a
                href="/tools/emi-calculator/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-semibold mb-1">EMI Calculator</h3>
                <p class="text-sm text-gray-600">
                    Calculate loan EMI and total interest.
                </p>
            </a>
        </div>
    </section>

    <script>
        const dobInput = document.getElementById("dob") as HTMLInputElement;
        const calcDateInput = document.getElementById(
            "calc-date",
        ) as HTMLInputElement;
        const calculateBtn = document.getElementById("calculate-btn")!;
        const results = document.getElementById("results")!;

        const today = new Date();
        calcDateInput.value = today.toISOString().split("T")[0];

        function calculateAge() {
            if (!dobInput.value) {
                alert("Please enter your date of birth.");
                return;
            }

            const dob = new Date(dobInput.value);
            const calcDate = calcDateInput.value
                ? new Date(calcDateInput.value)
                : new Date();

            if (dob > calcDate) {
                alert("Date of birth cannot be after the calculation date.");
                return;
            }

            // Exact years, months, days
            let years = calcDate.getFullYear() - dob.getFullYear();
            let months = calcDate.getMonth() - dob.getMonth();
            let days = calcDate.getDate() - dob.getDate();

            if (days < 0) {
                months--;
                const prevMonth = new Date(
                    calcDate.getFullYear(),
                    calcDate.getMonth(),
                    0,
                );
                days += prevMonth.getDate();
            }
            if (months < 0) {
                years--;
                months += 12;
            }

            // Total days/hours/minutes
            const msPerDay = 1000 * 60 * 60 * 24;
            const totalDays = Math.floor(
                (calcDate.getTime() - dob.getTime()) / msPerDay,
            );
            const totalHours = totalDays * 24;
            const totalMinutes = totalHours * 60;

            // Update UI
            document.getElementById("age-main")!.textContent =
                `${years} years, ${months} months, ${days} days`;
            document.getElementById("age-sub")!.textContent =
                `Calculated on ${calcDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}`;

            document.getElementById("years")!.textContent = years.toString();
            document.getElementById("months")!.textContent = months.toString();
            document.getElementById("days")!.textContent = days.toString();
            document.getElementById("total-days")!.textContent =
                totalDays.toLocaleString();
            document.getElementById("total-hours")!.textContent =
                totalHours.toLocaleString();
            document.getElementById("total-minutes")!.textContent =
                totalMinutes.toLocaleString();

            // Next birthday
            const nextBday = new Date(
                calcDate.getFullYear(),
                dob.getMonth(),
                dob.getDate(),
            );
            if (nextBday < calcDate) {
                nextBday.setFullYear(calcDate.getFullYear() + 1);
            }
            const daysUntil = Math.ceil(
                (nextBday.getTime() - calcDate.getTime()) / msPerDay,
            );
            const dayName = nextBday.toLocaleDateString("en-US", {
                weekday: "long",
            });
            const dateStr = nextBday.toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
            });

            document.getElementById("next-birthday")!.textContent =
                daysUntil === 0
                    ? `🎉 Today is your birthday!`
                    : `${daysUntil} day${daysUntil === 1 ? "" : "s"} until your next birthday`;
            document.getElementById("next-birthday-day")!.textContent =
                daysUntil === 0 ? `—` : `Falls on ${dateStr} (${dayName})`;

            results.classList.remove("hidden");
            results.scrollIntoView({ behavior: "smooth" });
        }

        calculateBtn.addEventListener("click", calculateAge);
    </script>

    <script
        type="application/ld+json"
        set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "SoftwareApplication",
            name: "Age Calculator",
            applicationCategory: "UtilityApplication",
            operatingSystem: "Any",
            description:
                "Free online age calculator. Find your exact age in years, months, days, hours, and minutes, plus next birthday countdown.",
            offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
        })}
    />

    <script
        type="application/ld+json"
        set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "FAQPage",
            mainEntity: [
                {
                    "@type": "Question",
                    name: "How is age calculated?",
                    acceptedAnswer: {
                        "@type": "Answer",
                        text: "Age is calculated using the standard international method: full years first, then remaining months, then remaining days.",
                    },
                },
                {
                    "@type": "Question",
                    name: "Does this account for leap years?",
                    acceptedAnswer: {
                        "@type": "Answer",
                        text: "Yes. Leap years are automatically handled, so your age will be accurate even if you were born on February 29.",
                    },
                },
                {
                    "@type": "Question",
                    name: "Is my date of birth saved?",
                    acceptedAnswer: {
                        "@type": "Answer",
                        text: "No. All calculations happen in your browser. Your date of birth is never sent to any server or stored anywhere.",
                    },
                },
                {
                    "@type": "Question",
                    name: "Is this tool free?",
                    acceptedAnswer: {
                        "@type": "Answer",
                        text: "Yes, completely free with no signup, no limits, and no watermarks.",
                    },
                },
            ],
        })}
    />
</Layout>
