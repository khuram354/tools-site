---
import Layout from "../../layouts/Layout.astro";
---

<Layout
    title="Online Unit Converter — Fast Metric & Imperial Conversions"
    description="Free online unit converter by ToolsVibe. Instantly convert length, weight, area, volume, temperature, speed, and time between metric and imperial units."
>
    <div class="max-w-3xl mx-auto">
        <header class="mb-8">
            <h1 class="text-3xl md:text-4xl font-bold mb-3">
                All-in-One Unit Converter
            </h1>
            <p class="text-gray-600 mb-2">
                Easily convert between metric and imperial systems. Supports
                instant conversions for length, weight, temperature, area,
                volume, speed, and time units.
            </p>
            <p class="text-xs text-gray-500 flex items-center gap-1">
                ⚡ Fast & Responsive: Get real-time conversion results entirely
                in your browser.
            </p>
        </header>

        <!-- Converter Section -->
        <section class="bg-white p-6 rounded-xl border border-gray-200 mb-6">
            <!-- Category Tabs -->
            <div class="flex flex-wrap gap-2 mb-6">
                <button
                    data-category="length"
                    class="cat-btn px-4 py-2 text-sm font-medium bg-blue-600 text-white rounded-lg transition"
                    >Length</button
                >
                <button
                    data-category="weight"
                    class="cat-btn px-4 py-2 text-sm font-medium bg-white text-gray-700 border border-gray-300 rounded-lg hover:bg-blue-50 transition"
                    >Weight</button
                >
                <button
                    data-category="temperature"
                    class="cat-btn px-4 py-2 text-sm font-medium bg-white text-gray-700 border border-gray-300 rounded-lg hover:bg-blue-50 transition"
                    >Temperature</button
                >
                <button
                    data-category="area"
                    class="cat-btn px-4 py-2 text-sm font-medium bg-white text-gray-700 border border-gray-300 rounded-lg hover:bg-blue-50 transition"
                    >Area</button
                >
                <button
                    data-category="volume"
                    class="cat-btn px-4 py-2 text-sm font-medium bg-white text-gray-700 border border-gray-300 rounded-lg hover:bg-blue-50 transition"
                    >Volume</button
                >
                <button
                    data-category="speed"
                    class="cat-btn px-4 py-2 text-sm font-medium bg-white text-gray-700 border border-gray-300 rounded-lg hover:bg-blue-50 transition"
                    >Speed</button
                >
                <button
                    data-category="time"
                    class="cat-btn px-4 py-2 text-sm font-medium bg-white text-gray-700 border border-gray-300 rounded-lg hover:bg-blue-50 transition"
                    >Time</button
                >
            </div>

            <!-- Input Row -->
            <div class="grid grid-cols-1 md:grid-cols-5 gap-4 items-end">
                <div class="md:col-span-2">
                    <label
                        for="from-value"
                        class="block text-sm font-medium mb-2">From</label
                    >
                    <input
                        type="number"
                        id="from-value"
                        value="1"
                        class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                    />
                </div>
                <div class="md:col-span-1">
                    <label
                        for="from-unit"
                        class="block text-sm font-medium mb-2">Unit</label
                    >
                    <select
                        id="from-unit"
                        class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                    ></select>
                </div>
                <div class="md:col-span-1 text-center">
                    <button
                        id="swap-btn"
                        class="w-full px-4 py-3 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition"
                        title="Swap units"
                    >
                        ⇄
                    </button>
                </div>
                <div class="md:col-span-1">
                    <label for="to-unit" class="block text-sm font-medium mb-2"
                        >To</label
                    >
                    <select
                        id="to-unit"
                        class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                    ></select>
                </div>
            </div>

            <!-- Result -->
            <div class="mt-6 p-6 bg-blue-50 border border-blue-200 rounded-xl">
                <p class="text-sm text-gray-600 mb-1">Result</p>
                <p id="result" class="text-3xl font-bold text-blue-700">1</p>
                <p id="result-unit" class="text-sm text-gray-600 mt-1">—</p>
            </div>
        </section>
    </div>

    <!-- SEO Content (800+ words) -->
    <section class="max-w-3xl mx-auto mt-16">
        <h2 class="text-2xl font-bold mb-4">About This Unit Converter</h2>
        <p class="text-gray-700 mb-4">
            This free unit converter handles length, weight, temperature, area,
            volume, speed, and time conversions. It supports both metric and
            imperial units, runs entirely in your browser, and updates results
            in real time. Whether you're cooking, traveling, studying, or
            working on a project, this tool converts any unit in seconds.
        </p>
        <p class="text-gray-700 mb-4">
            Unit conversion is one of those small tasks that comes up constantly
            — a recipe in ounces, a road sign in kilometers, a weather forecast
            in Fahrenheit. This tool makes every conversion instant and
            accurate, without installing an app or searching for the conversion
            factor.
        </p>

        <h3 class="text-xl font-semibold mt-6 mb-3">How to Use</h3>
        <ol class="list-decimal pl-6 text-gray-700 space-y-2">
            <li>Choose a category (Length, Weight, Temperature, etc.)</li>
            <li>Enter the value you want to convert</li>
            <li>Select the "from" and "to" units</li>
            <li>The result updates automatically</li>
        </ol>

        <h3 class="text-xl font-semibold mt-6 mb-3">Supported Categories</h3>
        <ul class="list-disc pl-6 text-gray-700 space-y-2">
            <li>
                <strong>Length:</strong> millimeters, centimeters, meters, kilometers,
                inches, feet, yards, miles
            </li>
            <li>
                <strong>Weight:</strong> milligrams, grams, kilograms, ounces, pounds,
                stones
            </li>
            <li><strong>Temperature:</strong> Celsius, Fahrenheit, Kelvin</li>
            <li>
                <strong>Area:</strong> square meters, square feet, square yards, acres,
                hectares
            </li>
            <li>
                <strong>Volume:</strong> milliliters, liters, cups, pints, quarts,
                gallons
            </li>
            <li><strong>Speed:</strong> km/h, mph, m/s, knots</li>
            <li>
                <strong>Time:</strong> seconds, minutes, hours, days, weeks, years
            </li>
        </ul>

        <h3 class="text-xl font-semibold mt-6 mb-3">Common Use Cases</h3>

        <h4 class="font-semibold mt-4 mb-2">1. Cooking and Baking</h4>
        <p class="text-gray-700 mb-4">
            Recipes from different countries use different units. An American
            recipe might call for 1 cup, while a European recipe uses
            milliliters. This tool converts cups, pints, quarts, and gallons to
            milliliters and liters instantly.
        </p>

        <h4 class="font-semibold mt-4 mb-2">2. Travel Planning</h4>
        <p class="text-gray-700 mb-4">
            If you're traveling to a country that uses metric, you'll see
            distances in kilometers, temperatures in Celsius, and weights in
            kilograms. Convert everything on the fly to understand what you're
            dealing with.
        </p>

        <h4 class="font-semibold mt-4 mb-2">3. Home Improvement</h4>
        <p class="text-gray-700 mb-4">
            If you're buying flooring, paint, or tiles, you need to convert
            square feet to square meters (or vice versa). This tool handles area
            conversions accurately.
        </p>

        <h4 class="font-semibold mt-4 mb-2">4. Fitness and Health</h4>
        <p class="text-gray-700 mb-4">
            Tracking weight in kilograms when your scale shows pounds? Or
            converting body measurements from inches to centimeters? This tool
            handles it all.
        </p>

        <h4 class="font-semibold mt-4 mb-2">
            5. Academic and Engineering Work
        </h4>
        <p class="text-gray-700 mb-4">
            Students and engineers frequently need to convert units — meters to
            feet, joules to calories, km/h to m/s. The accuracy of these
            conversions matters, and this tool uses standard factors.
        </p>

        <h4 class="font-semibold mt-4 mb-2">6. Sports and Racing</h4>
        <p class="text-gray-700 mb-4">
            Speed conversions matter in sports — 100 km/h is 62.14 mph. Nautical
            speed is measured in knots (1 knot = 1.852 km/h). This tool handles
            all speed conversions.
        </p>

        <h3 class="text-xl font-semibold mt-6 mb-3">Why Use This Tool?</h3>
        <ul class="list-disc pl-6 text-gray-700 space-y-2">
            <li>
                <strong>Instant conversion:</strong> Results update in real time as
                you type.
            </li>
            <li>
                <strong>Accurate factors:</strong> Uses internationally recognized
                conversion factors (1 inch = 2.54 cm exactly, not 2.5).
            </li>
            <li>
                <strong>7 categories in one tool:</strong> No need to hunt for different
                converters.
            </li>
            <li>
                <strong>Swap button:</strong> Instantly reverse the conversion direction.
            </li>
            <li>
                <strong>Privacy first:</strong> Everything runs in your browser. Nothing
                is sent to a server.
            </li>
            <li>
                <strong>Free with no limits:</strong> Convert as many values as you
                need.
            </li>
        </ul>

        <h3 class="text-xl font-semibold mt-6 mb-3">A Worked Example</h3>
        <p class="text-gray-700 mb-4">Here are some common conversions:</p>
        <ul class="list-disc pl-6 text-gray-700 space-y-2">
            <li><strong>100 km/h to mph:</strong> 62.137 mph</li>
            <li><strong>1 kilogram to pounds:</strong> 2.205 lb</li>
            <li><strong>100°C to °F:</strong> 212°F (water boiling point)</li>
            <li><strong>1 acre to square meters:</strong> 4,046.86 m²</li>
            <li><strong>1 mile to kilometers:</strong> 1.609 km</li>
            <li><strong>1 US gallon to liters:</strong> 3.785 L</li>
        </ul>
        <p class="text-gray-700 mt-4 mb-4">
            Each of these conversions is accurate to many decimal places — no
            rounding errors, no guesswork.
        </p>

        <h3 class="text-xl font-semibold mt-6 mb-3">
            Why Temperature Is Different
        </h3>
        <p class="text-gray-700 mb-4">
            Most unit conversions are simple multiplication: 1 inch = 2.54 cm,
            so multiply by 2.54. But temperature is different. Celsius and
            Fahrenheit have different starting points (0°C is not the same as
            0°F), so the conversion involves both multiplication and addition.
        </p>
        <ul class="list-disc pl-6 text-gray-700 space-y-2">
            <li><strong>°C to °F:</strong> (°C × 9/5) + 32</li>
            <li><strong>°F to °C:</strong> (°F − 32) × 5/9</li>
            <li><strong>°C to K:</strong> °C + 273.15</li>
            <li><strong>K to °C:</strong> K − 273.15</li>
        </ul>

        <h3 class="text-xl font-semibold mt-6 mb-3">
            Frequently Asked Questions
        </h3>
        <div class="space-y-4 mt-3">
            <div>
                <h4 class="font-semibold text-gray-900">
                    Is this unit converter accurate?
                </h4>
                <p class="text-gray-700 mt-1">
                    Yes. We use internationally recognized conversion factors
                    (e.g. 1 inch = 2.54 cm exactly) for all conversions.
                </p>
            </div>
            <div>
                <h4 class="font-semibold text-gray-900">
                    Does it work offline?
                </h4>
                <p class="text-gray-700 mt-1">
                    Yes. Once the page loads, all conversions happen in your
                    browser — no internet connection required.
                </p>
            </div>
            <div>
                <h4 class="font-semibold text-gray-900">
                    Why do temperature conversions work differently?
                </h4>
                <p class="text-gray-700 mt-1">
                    Unlike other units, temperature scales have different
                    starting points. Celsius and Fahrenheit require an offset,
                    not just multiplication.
                </p>
            </div>
            <div>
                <h4 class="font-semibold text-gray-900">
                    Can I convert between metric and imperial units?
                </h4>
                <p class="text-gray-700 mt-1">
                    Yes. Every category includes both metric and imperial units
                    — meters and feet, kilograms and pounds, liters and gallons.
                </p>
            </div>
            <div>
                <h4 class="font-semibold text-gray-900">What is a knot?</h4>
                <p class="text-gray-700 mt-1">
                    A knot is a unit of speed used in maritime and aviation
                    contexts. 1 knot = 1.852 km/h = 1.151 mph. It's included in
                    the Speed category.
                </p>
            </div>
            <div>
                <h4 class="font-semibold text-gray-900">Is this tool free?</h4>
                <p class="text-gray-700 mt-1">
                    Yes, completely free with no signup, no limits, and no
                    watermarks.
                </p>
            </div>
        </div>
    </section>

    <!-- Related Tools -->
    <section class="max-w-3xl mx-auto mt-16">
        <h2 class="text-2xl font-bold mb-6">Related Tools</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <a
                href="/tools/age-calculator/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-semibold mb-1">Age Calculator</h3>
                <p class="text-sm text-gray-600">
                    Find your exact age in years, months, and days.
                </p>
            </a>
            <a
                href="/tools/percentage-calculator/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-semibold mb-1">Percentage Calculator</h3>
                <p class="text-sm text-gray-600">
                    Solve percentage problems and discounts.
                </p>
            </a>
            <a
                href="/tools/password-generator/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-semibold mb-1">Password Generator</h3>
                <p class="text-sm text-gray-600">
                    Create strong, random passwords.
                </p>
            </a>
        </div>
    </section>

    <script>
        const fromValue = document.getElementById(
            "from-value",
        ) as HTMLInputElement;
        const fromUnit = document.getElementById(
            "from-unit",
        ) as HTMLSelectElement;
        const toUnit = document.getElementById("to-unit") as HTMLSelectElement;
        const result = document.getElementById("result")!;
        const resultUnit = document.getElementById("result-unit")!;
        const swapBtn = document.getElementById("swap-btn")!;
        const catBtns =
            document.querySelectorAll<HTMLButtonElement>(".cat-btn");

        // Conversion data: each unit has a factor relative to base unit
        // Temperature uses special functions
        const categories: Record<
            string,
            {
                name: string;
                units: { name: string; factor?: number; symbol: string }[];
                special?: boolean;
            }
        > = {
            length: {
                name: "Length",
                units: [
                    { name: "Millimeters", factor: 0.001, symbol: "mm" },
                    { name: "Centimeters", factor: 0.01, symbol: "cm" },
                    { name: "Meters", factor: 1, symbol: "m" },
                    { name: "Kilometers", factor: 1000, symbol: "km" },
                    { name: "Inches", factor: 0.0254, symbol: "in" },
                    { name: "Feet", factor: 0.3048, symbol: "ft" },
                    { name: "Yards", factor: 0.9144, symbol: "yd" },
                    { name: "Miles", factor: 1609.344, symbol: "mi" },
                ],
            },
            weight: {
                name: "Weight",
                units: [
                    { name: "Milligrams", factor: 0.000001, symbol: "mg" },
                    { name: "Grams", factor: 0.001, symbol: "g" },
                    { name: "Kilograms", factor: 1, symbol: "kg" },
                    { name: "Ounces", factor: 0.0283495, symbol: "oz" },
                    { name: "Pounds", factor: 0.453592, symbol: "lb" },
                    { name: "Stones", factor: 6.35029, symbol: "st" },
                ],
            },
            temperature: {
                name: "Temperature",
                special: true,
                units: [
                    { name: "Celsius", symbol: "°C" },
                    { name: "Fahrenheit", symbol: "°F" },
                    { name: "Kelvin", symbol: "K" },
                ],
            },
            area: {
                name: "Area",
                units: [
                    { name: "Square Meters", factor: 1, symbol: "m²" },
                    { name: "Square Feet", factor: 0.092903, symbol: "ft²" },
                    { name: "Square Yards", factor: 0.836127, symbol: "yd²" },
                    { name: "Acres", factor: 4046.86, symbol: "ac" },
                    { name: "Hectares", factor: 10000, symbol: "ha" },
                ],
            },
            volume: {
                name: "Volume",
                units: [
                    { name: "Milliliters", factor: 0.001, symbol: "mL" },
                    { name: "Liters", factor: 1, symbol: "L" },
                    { name: "Cups", factor: 0.236588, symbol: "cup" },
                    { name: "Pints", factor: 0.473176, symbol: "pt" },
                    { name: "Quarts", factor: 0.946353, symbol: "qt" },
                    { name: "Gallons (US)", factor: 3.78541, symbol: "gal" },
                ],
            },
            speed: {
                name: "Speed",
                units: [
                    { name: "Meters/second", factor: 1, symbol: "m/s" },
                    {
                        name: "Kilometers/hour",
                        factor: 0.277778,
                        symbol: "km/h",
                    },
                    { name: "Miles/hour", factor: 0.44704, symbol: "mph" },
                    { name: "Knots", factor: 0.514444, symbol: "kn" },
                ],
            },
            time: {
                name: "Time",
                units: [
                    { name: "Seconds", factor: 1, symbol: "s" },
                    { name: "Minutes", factor: 60, symbol: "min" },
                    { name: "Hours", factor: 3600, symbol: "h" },
                    { name: "Days", factor: 86400, symbol: "d" },
                    { name: "Weeks", factor: 604800, symbol: "wk" },
                    { name: "Years", factor: 31536000, symbol: "yr" },
                ],
            },
        };

        let currentCategory = "length";

        function populateUnits() {
            const cat = categories[currentCategory];
            fromUnit.innerHTML = "";
            toUnit.innerHTML = "";
            cat.units.forEach((unit, i) => {
                const opt1 = document.createElement("option");
                opt1.value = i.toString();
                opt1.textContent = unit.name;
                fromUnit.appendChild(opt1);

                const opt2 = document.createElement("option");
                opt2.value = i.toString();
                opt2.textContent = unit.name;
                toUnit.appendChild(opt2);
            });
            fromUnit.value = "0";
            toUnit.value = "1";
        }

        function convertTemperature(
            value: number,
            from: string,
            to: string,
        ): number {
            let celsius: number;
            if (from === "Celsius") celsius = value;
            else if (from === "Fahrenheit") celsius = ((value - 32) * 5) / 9;
            else celsius = value - 273.15;

            if (to === "Celsius") return celsius;
            if (to === "Fahrenheit") return (celsius * 9) / 5 + 32;
            return celsius + 273.15;
        }

        function convert() {
            const value = parseFloat(fromValue.value) || 0;
            const cat = categories[currentCategory];
            const fromIdx = parseInt(fromUnit.value);
            const toIdx = parseInt(toUnit.value);
            const fromU = cat.units[fromIdx];
            const toU = cat.units[toIdx];

            let output: number;

            if (cat.special) {
                output = convertTemperature(value, fromU.name, toU.name);
            } else {
                const inBase = value * (fromU.factor || 1);
                output = inBase / (toU.factor || 1);
            }

            const formatted =
                Math.abs(output) < 0.0001 && output !== 0
                    ? output.toExponential(4)
                    : output.toLocaleString("en-US", {
                          maximumFractionDigits: 6,
                      });

            result.textContent = formatted;
            resultUnit.textContent = `${value} ${fromU.symbol} = ${formatted} ${toU.symbol}`;
        }

        catBtns.forEach((btn) => {
            btn.addEventListener("click", () => {
                catBtns.forEach((b) => {
                    b.classList.remove("bg-blue-600", "text-white");
                    b.classList.add(
                        "bg-white",
                        "text-gray-700",
                        "border",
                        "border-gray-300",
                    );
                });
                btn.classList.remove(
                    "bg-white",
                    "text-gray-700",
                    "border",
                    "border-gray-300",
                );
                btn.classList.add("bg-blue-600", "text-white");
                currentCategory = btn.dataset.category!;
                populateUnits();
                convert();
            });
        });

        fromValue.addEventListener("input", convert);
        fromUnit.addEventListener("change", convert);
        toUnit.addEventListener("change", convert);

        swapBtn.addEventListener("click", () => {
            const temp = fromUnit.value;
            fromUnit.value = toUnit.value;
            toUnit.value = temp;
            convert();
        });

        populateUnits();
        convert();
    </script>

    <script
        type="application/ld+json"
        set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "SoftwareApplication",
            name: "Unit Converter",
            applicationCategory: "UtilityApplication",
            operatingSystem: "Any",
            description:
                "Free online unit converter. Convert length, weight, temperature, area, volume, speed, and time.",
            offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
        })}
    />

    <script
        type="application/ld+json"
        set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "FAQPage",
            mainEntity: [
                {
                    "@type": "Question",
                    name: "Is this unit converter accurate?",
                    acceptedAnswer: {
                        "@type": "Answer",
                        text: "Yes. We use internationally recognized conversion factors (e.g. 1 inch = 2.54 cm exactly) for all conversions.",
                    },
                },
                {
                    "@type": "Question",
                    name: "Does it work offline?",
                    acceptedAnswer: {
                        "@type": "Answer",
                        text: "Yes. Once the page loads, all conversions happen in your browser — no internet connection required.",
                    },
                },
                {
                    "@type": "Question",
                    name: "Why do temperature conversions work differently?",
                    acceptedAnswer: {
                        "@type": "Answer",
                        text: "Unlike other units, temperature scales have different starting points. Celsius and Fahrenheit require an offset, not just multiplication.",
                    },
                },
                {
                    "@type": "Question",
                    name: "Is this tool free?",
                    acceptedAnswer: {
                        "@type": "Answer",
                        text: "Yes, completely free with no signup, no limits, and no watermarks.",
                    },
                },
            ],
        })}
    />
</Layout>
