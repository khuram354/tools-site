---
import Layout from "../../layouts/Layout.astro";

const pageUrl = new URL(Astro.url.pathname, "https://toolsvibe.online").href;

// ---------------------------------------------------------------------------
// All units live in this list. The converter script, the category tabs, the
// "Supported Categories" text and the worked examples below are all built from
// it, so they can never disagree. Factors are exact (international) values.
// ---------------------------------------------------------------------------
interface Unit {
    name: string;
    symbol: string;
    factor?: number; // size of one unit in the category's base unit
    marlas?: number; // for marla-based units: how many marla this unit is
}
interface Category {
    id: string;
    name: string;
    special?: boolean; // temperature uses formulas instead of factors
    from: string; // symbol selected by default in "From"
    to: string; // symbol selected by default in "To"
    units: Unit[];
}

const SQFT = 0.09290304; // square metres in one square foot (exact)
const US_GALLON = 3.785411784; // litres (exact)

const CATEGORIES: Category[] = [
    {
        id: "length",
        name: "Length",
        from: "km",
        to: "mi",
        units: [
            { name: "Millimeters", symbol: "mm", factor: 0.001 },
            { name: "Centimeters", symbol: "cm", factor: 0.01 },
            { name: "Meters", symbol: "m", factor: 1 },
            { name: "Kilometers", symbol: "km", factor: 1000 },
            { name: "Inches", symbol: "in", factor: 0.0254 },
            { name: "Feet", symbol: "ft", factor: 0.3048 },
            { name: "Yards", symbol: "yd", factor: 0.9144 },
            { name: "Miles", symbol: "mi", factor: 1609.344 },
        ],
    },
    {
        id: "weight",
        name: "Weight",
        from: "kg",
        to: "lb",
        units: [
            { name: "Milligrams", symbol: "mg", factor: 0.000001 },
            { name: "Grams", symbol: "g", factor: 0.001 },
            { name: "Kilograms", symbol: "kg", factor: 1 },
            { name: "Ounces", symbol: "oz", factor: 0.028349523125 },
            { name: "Pounds", symbol: "lb", factor: 0.45359237 },
            { name: "Stones", symbol: "st", factor: 6.35029318 },
            { name: "Tola", symbol: "tola", factor: 0.0116638038 },
        ],
    },
    {
        id: "temperature",
        name: "Temperature",
        special: true,
        from: "°C",
        to: "°F",
        units: [
            { name: "Celsius", symbol: "°C" },
            { name: "Fahrenheit", symbol: "°F" },
            { name: "Kelvin", symbol: "K" },
        ],
    },
    {
        id: "area",
        name: "Area",
        from: "marla",
        to: "ft²",
        units: [
            { name: "Square Meters", symbol: "m²", factor: 1 },
            { name: "Square Feet", symbol: "ft²", factor: SQFT },
            { name: "Square Yards", symbol: "yd²", factor: 0.83612736 },
            { name: "Acres", symbol: "ac", factor: 4046.8564224 },
            { name: "Hectares", symbol: "ha", factor: 10000 },
            { name: "Marla", symbol: "marla", marlas: 1 },
            { name: "Kanal", symbol: "kanal", marlas: 20 },
        ],
    },
    {
        id: "volume",
        name: "Volume",
        from: "L",
        to: "gal",
        units: [
            { name: "Milliliters", symbol: "mL", factor: 0.001 },
            { name: "Liters", symbol: "L", factor: 1 },
            { name: "Cups (US)", symbol: "cup", factor: US_GALLON / 16 },
            { name: "Pints (US)", symbol: "pt", factor: US_GALLON / 8 },
            { name: "Quarts (US)", symbol: "qt", factor: US_GALLON / 4 },
            { name: "Gallons (US)", symbol: "gal", factor: US_GALLON },
        ],
    },
    {
        id: "speed",
        name: "Speed",
        from: "km/h",
        to: "mph",
        units: [
            { name: "Meters/second", symbol: "m/s", factor: 1 },
            { name: "Kilometers/hour", symbol: "km/h", factor: 1 / 3.6 },
            { name: "Miles/hour", symbol: "mph", factor: 0.44704 },
            { name: "Knots", symbol: "kn", factor: 1852 / 3600 },
        ],
    },
    {
        id: "time",
        name: "Time",
        from: "h",
        to: "min",
        units: [
            { name: "Seconds", symbol: "s", factor: 1 },
            { name: "Minutes", symbol: "min", factor: 60 },
            { name: "Hours", symbol: "h", factor: 3600 },
            { name: "Days", symbol: "d", factor: 86400 },
            { name: "Weeks", symbol: "wk", factor: 604800 },
            { name: "Years (365 days)", symbol: "yr", factor: 31536000 },
        ],
    },
];

// A marla is not the same size everywhere in Pakistan. A kanal is always 20 marla.
const MARLA_STANDARDS = [
    { value: 272.25, label: "272.25 sq ft (traditional standard)" },
    { value: 250, label: "250 sq ft" },
    { value: 225, label: "225 sq ft" },
];
const DEFAULT_MARLA_SQFT = MARLA_STANDARDS[0].value;

// --- maths used for the worked examples (same logic as the page script) ---
const factorOf = (u: Unit) =>
    u.marlas ? u.marlas * DEFAULT_MARLA_SQFT * SQFT : (u.factor ?? 1);

function unitOf(catId: string, symbol: string): Unit {
    const cat = CATEGORIES.find((c) => c.id === catId)!;
    return cat.units.find((u) => u.symbol === symbol)!;
}

function celsiusFrom(value: number, symbol: string): number {
    if (symbol === "°C") return value;
    if (symbol === "°F") return ((value - 32) * 5) / 9;
    return value - 273.15;
}

function convertExample(
    catId: string,
    value: number,
    fromSymbol: string,
    toSymbol: string,
): number {
    if (catId === "temperature") {
        const c = celsiusFrom(value, fromSymbol);
        if (toSymbol === "°C") return c;
        if (toSymbol === "°F") return (c * 9) / 5 + 32;
        return c + 273.15;
    }
    return (
        (value * factorOf(unitOf(catId, fromSymbol))) /
        factorOf(unitOf(catId, toSymbol))
    );
}

// Same number formatting as the converter itself
function formatNumber(n: number): string {
    if (!Number.isFinite(n)) return "—";
    if (n === 0) return "0";
    const abs = Math.abs(n);
    if (abs < 0.0001 || abs >= 1e21) {
        return Number(n.toPrecision(7)).toExponential();
    }
    if (abs < 1) {
        return n.toLocaleString("en-US", { maximumSignificantDigits: 7 });
    }
    return n.toLocaleString("en-US", { maximumFractionDigits: 6 });
}

const round2 = (n: number) =>
    n.toLocaleString("en-US", { maximumFractionDigits: 2 });

const examples = [
    {
        label: "100 km/h to mph",
        cat: "speed",
        v: 100,
        from: "km/h",
        to: "mph",
        unit: "mph",
        note: "",
    },
    {
        label: "1 kilogram to pounds",
        cat: "weight",
        v: 1,
        from: "kg",
        to: "lb",
        unit: "lb",
        note: "",
    },
    {
        label: "100°C to °F",
        cat: "temperature",
        v: 100,
        from: "°C",
        to: "°F",
        unit: "°F",
        note: " (water boils)",
    },
    {
        label: "1 acre to square meters",
        cat: "area",
        v: 1,
        from: "ac",
        to: "m²",
        unit: "m²",
        note: "",
    },
    {
        label: "1 mile to kilometers",
        cat: "length",
        v: 1,
        from: "mi",
        to: "km",
        unit: "km",
        note: "",
    },
    {
        label: "1 US gallon to liters",
        cat: "volume",
        v: 1,
        from: "gal",
        to: "L",
        unit: "L",
        note: "",
    },
    {
        label: "1 tola to grams",
        cat: "weight",
        v: 1,
        from: "tola",
        to: "g",
        unit: "g",
        note: "",
    },
    {
        label: "1 marla to square feet",
        cat: "area",
        v: 1,
        from: "marla",
        to: "ft²",
        unit: "ft²",
        note: " (traditional 272.25 sq ft marla)",
    },
    {
        label: "1 kanal to marla",
        cat: "area",
        v: 1,
        from: "kanal",
        to: "marla",
        unit: "marla",
        note: "",
    },
].map((e) => ({
    ...e,
    result: formatNumber(convertExample(e.cat, e.v, e.from, e.to)),
}));

// Figures for the Pakistani units table (traditional marla)
const marlaSqFt = convertExample("area", 1, "marla", "ft²");
const marlaSqYd = convertExample("area", 1, "marla", "yd²");
const marlaSqM = convertExample("area", 1, "marla", "m²");
const kanalSqFt = convertExample("area", 1, "kanal", "ft²");
const kanalSqYd = convertExample("area", 1, "kanal", "yd²");
const kanalSqM = convertExample("area", 1, "kanal", "m²");
const acreKanal = convertExample("area", 1, "ac", "kanal");
const acreMarla = convertExample("area", 1, "ac", "marla");

// One source of truth: shown on the page AND used for the FAQ schema,
// so the visible text and the structured data always match.
const faqs = [
    {
        q: "Is this unit converter accurate?",
        a: "Yes. It uses the exact internationally defined factors (for example, 1 inch = 2.54 cm and 1 pound = 0.45359237 kg exactly) and shows results to up to 6 decimal places.",
    },
    {
        q: "How many square feet are in a marla and a kanal?",
        a: `By default this converter uses a marla of ${round2(marlaSqFt)} square feet, with 1 kanal = 20 marla = ${round2(kanalSqFt)} square feet. With that traditional marla, 1 acre = ${formatNumber(acreKanal)} kanal = ${formatNumber(acreMarla)} marla. The size of a marla is not the same everywhere in Pakistan, and some housing schemes and cities use 225 or 250 square feet. Use the "Marla size" setting to match the value in your documents.`,
    },
    {
        q: "How many grams are in a tola?",
        a: "One tola is 11.6638038 grams, usually rounded to 11.664 grams. Gold prices in Pakistan are quoted per tola.",
    },
    {
        q: "Are the cup, pint, quart and gallon US or UK units?",
        a: "They are US customary units. UK (imperial) pints, quarts and gallons are larger: a UK gallon is about 4.546 liters, compared with 3.785 liters for a US gallon.",
    },
    {
        q: "Does it work offline?",
        a: "Once the page has loaded, all conversions happen in your browser, so it keeps working without an internet connection.",
    },
    {
        q: "Why do temperature conversions work differently?",
        a: "Unlike other units, temperature scales have different starting points. Celsius and Fahrenheit require an offset, not just multiplication.",
    },
    {
        q: "Can I convert between metric and imperial units?",
        a: "Yes. Length, weight, area, and volume include both metric and imperial units: meters and feet, kilograms and pounds, liters and gallons.",
    },
    {
        q: "What is a knot?",
        a: "A knot is a unit of speed used in maritime and aviation contexts. 1 knot = 1.852 km/h = 1.151 mph. It's included in the Speed category.",
    },
    {
        q: "Is this tool free?",
        a: "Yes. It is free, needs no signup, and has no limits.",
    },
];

const webAppSchema = {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Unit Converter",
    url: pageUrl,
    applicationCategory: "UtilitiesApplication",
    operatingSystem: "Any",
    browserRequirements: "Requires JavaScript",
    isAccessibleForFree: true,
    description:
        "Free online unit converter for length, weight, temperature, area, volume, speed and time, including Pakistani units such as tola, marla and kanal.",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};

const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
};

const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item: "https://toolsvibe.online/",
        },
        {
            "@type": "ListItem",
            position: 2,
            name: "Tools",
            item: "https://toolsvibe.online/tools/",
        },
        {
            "@type": "ListItem",
            position: 3,
            name: "Unit Converter",
            item: pageUrl,
        },
    ],
};

const TAB_BASE =
    "cat-btn px-4 py-2 text-sm font-medium rounded-lg transition border ";
const TAB_ON = "bg-blue-600 text-white border-blue-600";
const TAB_OFF = "bg-white text-gray-700 border-gray-300 hover:bg-blue-50";
---

<Layout
    title="Unit Converter: Metric, Imperial, Tola, Marla & Kanal"
    description="Free unit converter for length, weight, temperature, area, volume, speed and time, plus tola, marla and kanal. Instant, in your browser."
>
    <div class="max-w-3xl mx-auto">
        <header class="mb-8">
            <nav aria-label="Breadcrumb" class="text-xs text-gray-500 mb-4">
                <a href="/" class="hover:underline">Home</a>
                <span aria-hidden="true">/</span>
                <a href="/tools/" class="hover:underline">Tools</a>
                <span aria-hidden="true">/</span>
                <span>Unit Converter</span>
            </nav>
            <h1 class="text-3xl md:text-4xl font-bold mb-3">Unit Converter</h1>
            <p class="text-gray-600 mb-2">
                Easily convert between metric and imperial systems, and between
                everyday Pakistani units like tola, marla, and kanal. Supports
                instant conversions for length, weight, temperature, area,
                volume, speed, and time.
            </p>
            <p class="text-xs text-gray-500 flex items-center gap-1">
                ⚡ Fast & Responsive: Results update as you type, entirely in
                your browser.
            </p>
        </header>

        <!-- Data the converter script reads (same list as the page text) -->
        <div
            id="calc-config"
            data-categories={JSON.stringify(CATEGORIES)}
            data-sqft={SQFT}
            hidden
        >
        </div>

        <!-- Converter Section -->
        <section class="bg-white p-6 rounded-xl border border-gray-200 mb-6">
            <!-- Category Tabs -->
            <div class="flex flex-wrap gap-2 mb-6">
                {
                    CATEGORIES.map((cat, i) => (
                        <button
                            type="button"
                            data-category={cat.id}
                            aria-pressed={i === 0 ? "true" : "false"}
                            class={TAB_BASE + (i === 0 ? TAB_ON : TAB_OFF)}
                        >
                            {cat.name}
                        </button>
                    ))
                }
            </div>

            <!-- Input Row -->
            <div class="grid grid-cols-1 md:grid-cols-5 gap-4 items-end">
                <div class="md:col-span-2">
                    <label
                        for="from-value"
                        class="block text-sm font-medium mb-2">From</label
                    >
                    <input
                        type="number"
                        id="from-value"
                        value="1"
                        class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                    />
                </div>
                <div class="md:col-span-1">
                    <label
                        for="from-unit"
                        class="block text-sm font-medium mb-2">Unit</label
                    >
                    <select
                        id="from-unit"
                        class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                    ></select>
                </div>
                <div class="md:col-span-1 text-center">
                    <button
                        type="button"
                        id="swap-btn"
                        class="w-full px-4 py-3 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition"
                        title="Swap units"
                        aria-label="Swap units"
                    >
                        ⇄
                    </button>
                </div>
                <div class="md:col-span-1">
                    <label for="to-unit" class="block text-sm font-medium mb-2"
                        >To</label
                    >
                    <select
                        id="to-unit"
                        class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                    ></select>
                </div>
            </div>

            <!-- Marla size (shown for the Area category) -->
            <div id="marla-setting" class="hidden mt-4">
                <label for="marla-size" class="block text-sm font-medium mb-2"
                    >Marla size</label
                >
                <select
                    id="marla-size"
                    class="w-full md:w-auto p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                >
                    {
                        MARLA_STANDARDS.map((m) => (
                            <option value={m.value}>{m.label}</option>
                        ))
                    }
                </select>
                <p class="text-xs text-gray-500 mt-1">
                    A marla is not the same size everywhere in Pakistan. Pick
                    the size your documents use. A kanal is always 20 marla.
                </p>
            </div>

            <!-- Result -->
            <div
                class="mt-6 p-6 bg-blue-50 border border-blue-200 rounded-xl"
                aria-live="polite"
            >
                <p class="text-sm text-gray-600 mb-1">Result</p>
                <p id="result" class="text-3xl font-bold text-blue-700">1</p>
                <p id="result-unit" class="text-sm text-gray-600 mt-1">—</p>
            </div>
            <p id="note" class="hidden mt-3 text-sm text-red-600">
                That is below absolute zero (0 K), which is not physically
                possible.
            </p>
        </section>
    </div>

    <!-- SEO Content -->
    <section class="max-w-3xl mx-auto mt-16">
        <h2 class="text-2xl font-bold mb-4">About This Unit Converter</h2>
        <p class="text-gray-700 mb-4">
            This free unit converter handles length, weight, temperature, area,
            volume, speed, and time conversions. It supports metric and imperial
            units as well as the Pakistani units tola, marla, and kanal, runs
            entirely in your browser, and updates results in real time. Whether
            you're cooking, traveling, studying, buying land, or working on a
            project, this tool converts any unit in seconds.
        </p>
        <p class="text-gray-700 mb-4">
            Unit conversion is one of those small tasks that comes up
            constantly: a recipe in ounces, a road sign in kilometers, a weather
            forecast in Fahrenheit, a plot measured in marla. This tool makes
            every conversion instant, without installing an app or searching for
            the conversion factor.
        </p>

        <h3 class="text-xl font-semibold mt-6 mb-3">How to Use</h3>
        <ol class="list-decimal pl-6 text-gray-700 space-y-2">
            <li>Choose a category (Length, Weight, Temperature, etc.)</li>
            <li>Enter the value you want to convert</li>
            <li>Select the "from" and "to" units</li>
            <li>The result updates automatically</li>
        </ol>

        <h3 class="text-xl font-semibold mt-6 mb-3">Supported Categories</h3>
        <ul class="list-disc pl-6 text-gray-700 space-y-2">
            {
                CATEGORIES.map((cat) => (
                    <li>
                        <strong>{cat.name}:</strong>{" "}
                        {cat.units.map((u) => u.name.toLowerCase()).join(", ")}
                    </li>
                ))
            }
        </ul>

        <h3 class="text-xl font-semibold mt-6 mb-3">
            Tola, Marla and Kanal (Pakistani Units)
        </h3>
        <p class="text-gray-700 mb-4">
            Gold in Pakistan is weighed in <strong>tola</strong>, and plots of
            land are measured in <strong>marla</strong> and
            <strong>kanal</strong>. One tola is 11.6638038 grams. A kanal is
            always 20 marla, but the size of a marla depends on where you are.
            This table uses the traditional marla:
        </p>
        <div class="overflow-x-auto">
            <table class="w-full text-sm border border-gray-200 rounded-lg">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="text-left p-3 font-semibold border-b"
                            >Unit</th
                        >
                        <th class="text-left p-3 font-semibold border-b"
                            >Square feet</th
                        >
                        <th class="text-left p-3 font-semibold border-b"
                            >Square yards</th
                        >
                        <th class="text-left p-3 font-semibold border-b"
                            >Square meters</th
                        >
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="p-3 border-b">1 marla</td>
                        <td class="p-3 border-b">{round2(marlaSqFt)}</td>
                        <td class="p-3 border-b">{round2(marlaSqYd)}</td>
                        <td class="p-3 border-b">{round2(marlaSqM)}</td>
                    </tr>
                    <tr>
                        <td class="p-3">1 kanal (20 marla)</td>
                        <td class="p-3">{round2(kanalSqFt)}</td>
                        <td class="p-3">{round2(kanalSqYd)}</td>
                        <td class="p-3">{round2(kanalSqM)}</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <p class="text-gray-700 mt-3 mb-4">
            With this marla, 1 acre is {formatNumber(acreKanal)} kanal or {
                formatNumber(acreMarla)
            } marla. Some housing schemes and cities use a marla of 225 or 250 square
            feet instead, so choose the "Marla size" setting that matches your documents
            before you rely on a conversion.
        </p>

        <h3 class="text-xl font-semibold mt-6 mb-3">Common Use Cases</h3>

        <h4 class="font-semibold mt-4 mb-2">1. Cooking and Baking</h4>
        <p class="text-gray-700 mb-4">
            Recipes from different countries use different units. An American
            recipe might call for 1 cup, while a European recipe uses
            milliliters. This tool converts US cups, pints, quarts, and gallons
            to milliliters and liters instantly.
        </p>

        <h4 class="font-semibold mt-4 mb-2">2. Property and Land</h4>
        <p class="text-gray-700 mb-4">
            Plot sizes in Pakistan are quoted in marla and kanal, while
            construction plans use square feet or square meters. Choose the Area
            category and convert, for example, 10 marla to square feet.
        </p>

        <h4 class="font-semibold mt-4 mb-2">3. Gold and Jewelry</h4>
        <p class="text-gray-700 mb-4">
            Gold is priced per tola but sold by weight in grams. Convert tola to
            grams to compare a jeweller's rate with an international price per
            gram or ounce.
        </p>

        <h4 class="font-semibold mt-4 mb-2">4. Travel Planning</h4>
        <p class="text-gray-700 mb-4">
            If you're traveling to a country that uses miles, Fahrenheit, or
            pounds, convert everything on the fly to understand what you're
            dealing with.
        </p>

        <h4 class="font-semibold mt-4 mb-2">5. Home Improvement</h4>
        <p class="text-gray-700 mb-4">
            If you're buying flooring, paint, or tiles, you need to convert
            square feet to square meters (or vice versa). This tool handles area
            conversions with exact factors.
        </p>

        <h4 class="font-semibold mt-4 mb-2">6. Fitness and Health</h4>
        <p class="text-gray-700 mb-4">
            Tracking weight in kilograms when your scale shows pounds? Or
            converting body measurements from inches to centimeters? This tool
            handles it all.
        </p>

        <h4 class="font-semibold mt-4 mb-2">
            7. Academic and Engineering Work
        </h4>
        <p class="text-gray-700 mb-4">
            Students and engineers frequently need to convert units: meters to
            feet, km/h to m/s, acres to hectares. This tool uses the exact
            international conversion factors.
        </p>

        <h4 class="font-semibold mt-4 mb-2">8. Sports and Racing</h4>
        <p class="text-gray-700 mb-4">
            Speed conversions matter in sports: 100 km/h is about 62.14 mph.
            Nautical speed is measured in knots (1 knot = 1.852 km/h).
        </p>

        <h3 class="text-xl font-semibold mt-6 mb-3">Why Use This Tool?</h3>
        <ul class="list-disc pl-6 text-gray-700 space-y-2">
            <li>
                <strong>Instant conversion:</strong> Results update in real time as
                you type.
            </li>
            <li>
                <strong>Exact factors:</strong> Uses the internationally defined values
                (1 inch = 2.54 cm exactly, 1 pound = 0.45359237 kg exactly), not rounded
                ones.
            </li>
            <li>
                <strong>{CATEGORIES.length} categories in one tool:</strong> No need
                to hunt for different converters.
            </li>
            <li>
                <strong>Pakistani units:</strong> Tola, marla, and kanal, with a setting
                for the size of a marla.
            </li>
            <li>
                <strong>Swap button:</strong> Instantly reverse the conversion direction.
            </li>
            <li>
                <strong>Privacy first:</strong> Everything runs in your browser. Nothing
                is sent to a server.
            </li>
        </ul>

        <h3 class="text-xl font-semibold mt-6 mb-3">Worked Examples</h3>
        <p class="text-gray-700 mb-4">
            Here are some common conversions, as this converter shows them:
        </p>
        <ul class="list-disc pl-6 text-gray-700 space-y-2">
            {
                examples.map((e) => (
                    <li>
                        <strong>{e.label}:</strong> {e.result} {e.unit}
                        {e.note}
                    </li>
                ))
            }
        </ul>
        <p class="text-gray-700 mt-4 mb-4">
            Results are shown to up to 6 decimal places, so the last digit can
            be rounded.
        </p>

        <h3 class="text-xl font-semibold mt-6 mb-3">
            Why Temperature Is Different
        </h3>
        <p class="text-gray-700 mb-4">
            Most unit conversions are simple multiplication: 1 inch = 2.54 cm,
            so multiply by 2.54. But temperature is different. Celsius and
            Fahrenheit have different starting points (0°C is not the same as
            0°F), so the conversion involves both multiplication and addition.
        </p>
        <ul class="list-disc pl-6 text-gray-700 space-y-2">
            <li><strong>°C to °F:</strong> (°C × 9/5) + 32</li>
            <li><strong>°F to °C:</strong> (°F − 32) × 5/9</li>
            <li><strong>°C to K:</strong> °C + 273.15</li>
            <li><strong>K to °C:</strong> K − 273.15</li>
        </ul>

        <h3 class="text-xl font-semibold mt-6 mb-3">
            Frequently Asked Questions
        </h3>
        <div class="space-y-4 mt-3">
            {
                faqs.map((f) => (
                    <div>
                        <h4 class="font-semibold text-gray-900">{f.q}</h4>
                        <p class="text-gray-700 mt-1">{f.a}</p>
                    </div>
                ))
            }
        </div>
    </section>

    <!-- Related Tools -->
    <section class="max-w-3xl mx-auto mt-16">
        <h2 class="text-2xl font-bold mb-6">Related Tools</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <a
                href="/tools/age-calculator/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-semibold mb-1">Age Calculator</h3>
                <p class="text-sm text-gray-600">
                    Find your exact age in years, months, and days.
                </p>
            </a>
            <a
                href="/tools/percentage-calculator/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-semibold mb-1">Percentage Calculator</h3>
                <p class="text-sm text-gray-600">
                    Solve percentage problems and discounts.
                </p>
            </a>
            <a
                href="/tools/zakat-calculator/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
