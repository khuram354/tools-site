    <script>
        interface Unit {
            name: string;
            symbol: string;
            factor?: number;
            marlas?: number;
        }
        interface Category {
            id: string;
            name: string;
            special?: boolean;
            from: string;
            to: string;
            units: Unit[];
        }

        const cfg = document.getElementById("calc-config")!;
        const categories: Category[] = JSON.parse(cfg.dataset.categories!);
        const SQFT = parseFloat(cfg.dataset.sqft!);

        const fromValue = document.getElementById(
            "from-value",
        ) as HTMLInputElement;
        const fromUnit = document.getElementById(
            "from-unit",
        ) as HTMLSelectElement;
        const toUnit = document.getElementById("to-unit") as HTMLSelectElement;
        const result = document.getElementById("result")!;
        const resultUnit = document.getElementById("result-unit")!;
        const swapBtn = document.getElementById("swap-btn")!;
        const note = document.getElementById("note")!;
        const marlaSetting = document.getElementById("marla-setting")!;
        const marlaSelect = document.getElementById(
            "marla-size",
        ) as HTMLSelectElement;
        const catBtns = document.querySelectorAll<HTMLButtonElement>(
            "button[data-category]",
        );

        const TAB_BASE =
            "cat-btn px-4 py-2 text-sm font-medium rounded-lg transition border ";
        const TAB_ON = "bg-blue-600 text-white border-blue-600";
        const TAB_OFF =
            "bg-white text-gray-700 border-gray-300 hover:bg-blue-50";

        let current: Category = categories[0];

        // Size of one unit in the category's base unit
        function factorOf(u: Unit): number {
            if (u.marlas) {
                return u.marlas * parseFloat(marlaSelect.value) * SQFT;
            }
            return u.factor ?? 1;
        }

        // Same formatting as the page's worked examples
        function formatNumber(n: number): string {
            if (!Number.isFinite(n)) return "—";
            if (n === 0) return "0";
            const abs = Math.abs(n);
            if (abs < 0.0001 || abs >= 1e21) {
                return Number(n.toPrecision(7)).toExponential();
            }
            if (abs < 1) {
                return n.toLocaleString("en-US", {
                    maximumSignificantDigits: 7,
                });
            }
            return n.toLocaleString("en-US", { maximumFractionDigits: 6 });
        }

        function toCelsius(value: number, symbol: string): number {
            if (symbol === "°C") return value;
            if (symbol === "°F") return ((value - 32) * 5) / 9;
            return value - 273.15;
        }

        function convertTemperature(
            value: number,
            from: string,
            to: string,
        ): number {
            const c = toCelsius(value, from);
            if (to === "°C") return c;
            if (to === "°F") return (c * 9) / 5 + 32;
            return c + 273.15;
        }

        function populateUnits() {
            fromUnit.innerHTML = "";
            toUnit.innerHTML = "";
            current.units.forEach((unit, i) => {
                for (const select of [fromUnit, toUnit]) {
                    const opt = document.createElement("option");
                    opt.value = String(i);
                    opt.textContent = unit.name;
                    select.appendChild(opt);
                }
            });
            const fromIdx = current.units.findIndex(
                (u) => u.symbol === current.from,
            );
            const toIdx = current.units.findIndex(
                (u) => u.symbol === current.to,
            );
            fromUnit.value = String(fromIdx >= 0 ? fromIdx : 0);
            toUnit.value = String(toIdx >= 0 ? toIdx : 1);
        }

        function convert() {
            note.classList.add("hidden");
            const raw = fromValue.value.trim();
            const value = parseFloat(raw);
            if (raw === "" || !Number.isFinite(value)) {
                result.textContent = "—";
                resultUnit.textContent = "Enter a number to convert";
                return;
            }

            const fromU = current.units[parseInt(fromUnit.value, 10)];
            const toU = current.units[parseInt(toUnit.value, 10)];

            let output: number;
            if (current.special) {
                output = convertTemperature(value, fromU.symbol, toU.symbol);
                if (toCelsius(value, fromU.symbol) < -273.15 - 1e-9) {
                    note.classList.remove("hidden");
                }
            } else {
                output = (value * factorOf(fromU)) / factorOf(toU);
            }

            const formatted = formatNumber(output);
            result.textContent = formatted;
            resultUnit.textContent = `${formatNumber(value)} ${fromU.symbol} = ${formatted} ${toU.symbol}`;
        }

        function selectCategory(id: string) {
            current = categories.find((c) => c.id === id) || categories[0];
            catBtns.forEach((b) => {
                const on = b.dataset.category === current.id;
                b.className = TAB_BASE + (on ? TAB_ON : TAB_OFF);
                b.setAttribute("aria-pressed", on ? "true" : "false");
            });
            marlaSetting.classList.toggle("hidden", current.id !== "area");
            populateUnits();
            convert();
        }

        catBtns.forEach((btn) => {
            btn.addEventListener("click", () =>
                selectCategory(btn.dataset.category!),
            );
        });

        fromValue.addEventListener("input", convert);
        fromUnit.addEventListener("change", convert);
        toUnit.addEventListener("change", convert);
        marlaSelect.addEventListener("change", convert);

        swapBtn.addEventListener("click", () => {
            const temp = fromUnit.value;
            fromUnit.value = toUnit.value;
            toUnit.value = temp;
            convert();
        });

        selectCategory(categories[0].id);
    </script>

    <script
        type="application/ld+json"
        set:html={JSON.stringify(webAppSchema)}
    />
    <script
        type="application/ld+json"
        set:html={JSON.stringify(breadcrumbSchema)}
    />
