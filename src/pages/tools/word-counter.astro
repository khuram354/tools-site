                class="bg-white p-4 rounded-lg border border-gray-200 text-center"
            >
                <div id="char-count" class="text-3xl font-bold text-blue-600">
                    0
                </div>
                <div class="text-sm text-gray-600 mt-1">Characters</div>
            </div>
            <div
                class="bg-white p-4 rounded-lg border border-gray-200 text-center"
            >
                <div
                    id="char-nospace-count"
                    class="text-3xl font-bold text-blue-600"
                >
                    0
                </div>
                <div class="text-sm text-gray-600 mt-1">
                    Characters (no spaces)
                </div>
            </div>
            <div
                class="bg-white p-4 rounded-lg border border-gray-200 text-center"
            >
                <div
                    id="sentence-count"
                    class="text-3xl font-bold text-blue-600"
                >
                    0
                </div>
                <div class="text-sm text-gray-600 mt-1">Sentences</div>
            </div>
            <div
                class="bg-white p-4 rounded-lg border border-gray-200 text-center"
            >
                <div
                    id="paragraph-count"
                    class="text-3xl font-bold text-blue-600"
                >
                    0
                </div>
