---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Word Counter — Free Online Word & Character Counter"
  description="Free online word counter. Count words, characters, sentences, and paragraphs instantly. Estimate reading time. No signup required."
>
  <div class="max-w-3xl mx-auto">
    <h1 class="text-3xl md:text-4xl font-bold mb-3">Word Counter</h1>
    <p class="text-gray-600 mb-6">
      Paste or type your text below to instantly count words, characters, sentences, and reading time.
    </p>

    <textarea
      id="text-input"
      class="w-full h-64 p-4 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 resize-y"
      placeholder="Type or paste your text here..."
    ></textarea>

    <div class="flex gap-3 mt-3">
      <button
        id="copy-btn"
        class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 text-sm font-medium"
      >
        Copy Text
      </button>
      <button
        id="clear-btn"
        class="px-4 py-2 bg-gray-200 text-gray-800 rounded-lg hover:bg-gray-300 text-sm font-medium"
      >
        Clear
      </button>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-6">
      <div class="bg-white p-4 rounded-lg border border-gray-200 text-center">
        <div id="word-count" class="text-3xl font-bold text-blue-600">0</div>
        <div class="text-sm text-gray-600 mt-1">Words</div>
      </div>
      <div class="bg-white p-4 rounded-lg border border-gray-200 text-center">
        <div id="char-count" class="text-3xl font-bold text-blue-600">0</div>
        <div class="text-sm text-gray-600 mt-1">Characters</div>
      </div>
      <div class="bg-white p-4 rounded-lg border border-gray-200 text-center">
        <div id="sentence-count" class="text-3xl font-bold text-blue-600">0</div>
        <div class="text-sm text-gray-600 mt-1">Sentences</div>
      </div>
      <div class="bg-white p-4 rounded-lg border border-gray-200 text-center">
        <div id="reading-time" class="text-3xl font-bold text-blue-600">0m</div>
        <div class="text-sm text-gray-600 mt-1">Reading Time</div>
      </div>
    </div>
  </div>

    <section class="max-w-3xl mx-auto mt-16 prose prose-gray">
    <h2 class="text-2xl font-bold mb-4">About This Word Counter</h2>
    <p class="text-gray-700 mb-4">
      This free online word counter helps you instantly count words, characters, sentences,
      and estimate reading time. It is perfect for students, writers, bloggers, and anyone
      who needs accurate word counts.
    </p>

    <h3 class="text-xl font-semibold mt-6 mb-3">How to Use</h3>
    <ol class="list-decimal pl-6 text-gray-700 space-y-2">
      <li>Paste or type your text into the box above.</li>
      <li>Word, character, and sentence counts update in real time.</li>
      <li>Use the "Copy Text" button to copy your text, or "Clear" to start over.</li>
    </ol>

    <h3 class="text-xl font-semibold mt-6 mb-3">Features</h3>
    <ul class="list-disc pl-6 text-gray-700 space-y-2">
      <li>Real-time word and character counting</li>
      <li>Sentence detection</li>
      <li>Reading time estimation (based on 200 words per minute)</li>
      <li>Works offline — no data is sent to any server</li>
      <li>100% free, no signup required</li>
    </ul>

    <h3 class="text-xl font-semibold mt-6 mb-3">Frequently Asked Questions</h3>
    <div class="space-y-4 mt-3">
      <div>
        <h4 class="font-semibold text-gray-900">Is my text saved anywhere?</h4>
        <p class="text-gray-700">No. All counting happens in your browser. Your text never leaves your device.</p>
      </div>
      <div>
        <h4 class="font-semibold text-gray-900">How is reading time calculated?</h4>
        <p class="text-gray-700">Reading time is estimated at 200 words per minute, which is the average adult reading speed.</p>
      </div>
      <div>
        <h4 class="font-semibold text-gray-900">Is this tool free?</h4>
        <p class="text-gray-700">Yes, completely free with no limits or signup.</p>
      </div>
    </div>
  </section>

  <script>
    const input = document.getElementById('text-input') as HTMLTextAreaElement;
    const wordCount = document.getElementById('word-count')!;
    const charCount = document.getElementById('char-count')!;
    const sentenceCount = document.getElementById('sentence-count')!;
    const readingTime = document.getElementById('reading-time')!;

    function updateCounts() {
      const text = input.value;

      const words = text.trim() ? text.trim().split(/\s+/).length : 0;
      const chars = text.length;
      const sentences = text.trim()
        ? text.split(/[.!?]+/).filter((s) => s.trim().length > 0).length
        : 0;
      const minutes = Math.ceil(words / 200);

      wordCount.textContent = words.toString();
      charCount.textContent = chars.toString();
      sentenceCount.textContent = sentences.toString();
      readingTime.textContent = minutes + 'm';
    }

    input.addEventListener('input', updateCounts);

        document.getElementById('copy-btn')!.addEventListener('click', () => {
      if (input.value) {
        navigator.clipboard.writeText(input.value);
      }
    });

    document.getElementById('clear-btn')!.addEventListener('click', () => {
      input.value = '';
      updateCounts();
      input.focus();
    });
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "Word Counter",
    "applicationCategory": "UtilityApplication",
    "operatingSystem": "Any",
    "description": "Free online word counter. Count words, characters, sentences, and estimate reading time instantly.",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    }
  })} />
</Layout>