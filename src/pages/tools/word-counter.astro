            class="w-full h-64 p-4 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 resize-y"
            placeholder="Type or paste your text here..."></textarea>

        <div class="flex gap-3 mt-3">
            <button
