---
import Layout from "../../layouts/Layout.astro";

const pageUrl = new URL(Astro.url.pathname, "https://toolsvibe.online").href;

// ---------------------------------------------------------------------------
// Settings shared by the page text and the counter script (the script reads
// them from the hidden config element below).
// ---------------------------------------------------------------------------
const READING_WPM = 200; // words per minute used for the reading time
const LIMITS = [
    { name: "X post", limit: 280 },
    { name: "Instagram caption", limit: 2200 },
    { name: "LinkedIn post", limit: 3000 },
    { name: "Meta description", limit: 160 },
];

// --- counting functions (the page script uses the same logic) ---
function countWords(text: string): number {
    const t = text.trim();
    return t ? t.split(/\s+/).length : 0;
}

// Counts what a person sees as one character, so an emoji counts as 1
function countChars(text: string): number {
    if (!text) return 0;
    const Segmenter = (Intl as any).Segmenter;
    if (text.length < 200000 && Segmenter) {
        let n = 0;
        for (const _ of new Segmenter().segment(text)) n++;
        return n;
    }
    return Array.from(text).length;
}

// A sentence ends at . ! or ? that is followed by a space or the end of the
// text, so "3.14" and "example.com" do not count as sentence ends
function countSentences(text: string): number {
    const t = text.trim();
    if (!t) return 0;
    const ends = t.match(/[.!?]+["')\]]*(?=\s|$)/g);
    const count = ends ? ends.length : 0;
    return /[.!?]["')\]]*$/.test(t) ? count : count + 1;
}

// Every non-empty line is one paragraph
function countParagraphs(text: string): number {
    return text.split(/\r?\n/).filter((l) => l.trim() !== "").length;
}

function formatDuration(words: number, wpm: number): string {
    if (words === 0) return "0 sec";
    const total = Math.max(1, Math.round((words / wpm) * 60));
    if (total < 60) return `${total} sec`;
    const m = Math.floor(total / 60);
    const s = total % 60;
    return s === 0 ? `${m} min` : `${m} min ${s} sec`;
}

const fmt = (n: number) => n.toLocaleString("en-US");

// The worked example is counted with the same functions as the tool
const SAMPLE =
    "Word counting is one of those small skills that saves real time. Whether you're writing a 2,000-word blog post or a 280-character tweet, getting the count right matters.";
const sample = {
    words: countWords(SAMPLE),
    chars: countChars(SAMPLE),
    noSpaces: countChars(SAMPLE.replace(/\s/g, "")),
    sentences: countSentences(SAMPLE),
    paragraphs: countParagraphs(SAMPLE),
    reading: formatDuration(countWords(SAMPLE), READING_WPM),
};

// One source of truth: shown on the page AND used for the FAQ schema,
// so the visible text and the structured data always match.
const faqs = [
    {
        q: "Is my text saved anywhere?",
        a: "No. All counting happens in your browser. Your text never leaves your device, and nothing is stored on any server.",
    },
    {
        q: "How is reading time calculated?",
        a: `Reading time is estimated at ${READING_WPM} words per minute, a conservative average for adults. A 1,000-word article shows as ${formatDuration(1000, READING_WPM)}. Fast readers will finish sooner, and dense technical text takes longer.`,
    },
    {
        q: "How are words counted?",
        a: "Words are groups of characters separated by spaces or line breaks, so hyphenated words and numbers count as one word. This works for languages written with spaces, including English and Urdu. Languages written without spaces, such as Chinese or Japanese, are not counted correctly.",
    },
    {
        q: "Does this count characters with or without spaces?",
        a: "Both. The Characters count includes spaces, punctuation, and line breaks, and a separate count shows characters without spaces. An emoji counts as one character.",
    },
    {
        q: "How are sentences counted?",
        a: 'A sentence ends at a period, exclamation mark, or question mark that is followed by a space or the end of the text. Numbers like 3.14 and web addresses are not counted as sentence ends, but abbreviations such as "Dr." or "e.g." can add extra counts. This is a limitation of any sentence-counting tool.',
    },
    {
        q: "How are paragraphs counted?",
        a: "Every non-empty line counts as one paragraph, the same way a word processor counts each press of the Enter key. Text with hard line breaks inside a paragraph will show more paragraphs than you expect.",
    },
    {
        q: "Why does my count differ from X (Twitter)?",
        a: "X counts every link as a fixed length and counts emoji and some other characters as two, so its own counter can differ from the plain character count here. Use the limit checker as a guide and confirm in the app.",
    },
    {
        q: "Can I count words in a specific section only?",
        a: "Yes. Select and copy just that section, then paste it into the box. The count will reflect only that text.",
    },
    {
        q: "Is this tool free?",
        a: "Yes. It is free, needs no signup, and has no limits.",
    },
];

const webAppSchema = {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Word Counter",
    url: pageUrl,
    applicationCategory: "UtilitiesApplication",
    operatingSystem: "Any",
    browserRequirements: "Requires JavaScript",
    isAccessibleForFree: true,
    description:
        "Free online word counter. Count words, characters, sentences, and paragraphs, check reading time and character limits.",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};

const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
};

const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item: "https://toolsvibe.online/",
        },
        {
            "@type": "ListItem",
            position: 2,
            name: "Tools",
            item: "https://toolsvibe.online/tools/",
        },
        {
            "@type": "ListItem",
            position: 3,
            name: "Word Counter",
            item: pageUrl,
        },
    ],
};
---

<Layout
    title="Word Counter: Free Online Word & Character Counter"
    description="Free word counter and character counter. Count words, characters, sentences and paragraphs, check reading time and post limits. Runs in your browser."
>
    <div class="max-w-3xl mx-auto">
        <nav aria-label="Breadcrumb" class="text-xs text-gray-500 mb-4">
            <a href="/" class="hover:underline">Home</a>
