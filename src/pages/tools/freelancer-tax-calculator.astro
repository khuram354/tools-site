---
import Layout from "../../layouts/Layout.astro";

const pageUrl = new URL(Astro.url.pathname, "https://toolsvibe.online").href;

interface Slab {
    from: number;
    upTo: number | null;
    base: number;
    rate: number;
}

// Non-salaried individual slabs, Tax Year 2027 (FY 2026-27).
// ONE source of truth: this list drives the table on the page AND the
// calculator below (through the data-slabs attribute). When FBR changes the
// slabs, edit only this list.
const slabs: Slab[] = [
    { from: 0, upTo: 600000, base: 0, rate: 0 },
    { from: 600000, upTo: 1200000, base: 0, rate: 0.15 },
    { from: 1200000, upTo: 1600000, base: 90000, rate: 0.2 },
    { from: 1600000, upTo: 3200000, base: 170000, rate: 0.3 },
    { from: 3200000, upTo: 5600000, base: 650000, rate: 0.4 },
    { from: 5600000, upTo: null, base: 1610000, rate: 0.45 },
];

const fmt = (n: number) => n.toLocaleString("en-US");
const slabRows = slabs.map((s) => ({
    range:
        s.from === 0
            ? `Up to Rs ${fmt(s.upTo!)}`
            : s.upTo !== null
              ? `Rs ${fmt(s.from + 1)} – ${fmt(s.upTo)}`
              : `Above Rs ${fmt(s.from)}`,
    tax:
        s.rate === 0
            ? "Nil"
            : s.base > 0
              ? `Rs ${fmt(s.base)} + ${Math.round(s.rate * 100)}% of the amount over Rs ${fmt(s.from)}`
              : `${Math.round(s.rate * 100)}% of the amount over Rs ${fmt(s.from)}`,
}));

// One source of truth: shown on the page AND used for the FAQ schema,
// so the visible text and the structured data always match.
const faqs = [
    {
        q: "Do I need to register with PSEB?",
        a: "Only if you want the 0.25% rate on IT export income. Without PSEB registration the 1% rate applies. Registration involves paperwork and may involve fees, so check PSEB for the current requirements.",
    },
    {
        q: "Do I need to file a tax return?",
        a: "Generally yes. If your taxable income is above PKR 600,000 you need to file an annual return on the FBR IRIS portal, and filing keeps you on the Active Taxpayer List (ATL). Check FBR for any other filing conditions that apply to you.",
    },
    {
        q: "What counts as approved banking channels?",
        a: "Export proceeds received into a Pakistani bank account as an inward foreign remittance, where your bank deducts the tax at the time the money is received. Ask your bank to confirm how your credits are recorded, and keep the bank credit advices. Income left in foreign wallets or accounts is not withheld at source.",
    },
    {
        q: "Is the 0.25% rate still available?",
        a: "Yes. The Finance Act 2026 extended the 0.25% rate for PSEB-registered IT and IT-enabled services exporters under Section 154A through Tax Year 2029 (30 June 2029).",
    },
    {
        q: "Can I deduct business expenses from export income?",
        a: "No. For IT export income the tax withheld under Section 154A is generally a final tax on the amount received, so expenses are not deducted from it. For local freelance income, business expenses can be deducted before calculating tax.",
    },
    {
        q: "Is my data safe?",
        a: "Yes. All calculations happen in your browser. Your income details are never sent to any server.",
    },
];

const webAppSchema = {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Freelancer Tax Calculator Pakistan",
    url: pageUrl,
    applicationCategory: "FinanceApplication",
    operatingSystem: "Any",
    browserRequirements: "Requires JavaScript",
    isAccessibleForFree: true,
    description:
        "Free freelancer tax calculator for Pakistan. Estimate income tax on IT export income (Section 154A) and local freelance income for Tax Year 2027.",
    offers: { "@type": "Offer", price: "0", priceCurrency: "PKR" },
};

const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
};

const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item: "https://toolsvibe.online/",
        },
        {
            "@type": "ListItem",
            position: 2,
            name: "Tools",
            item: "https://toolsvibe.online/tools/",
        },
        {
            "@type": "ListItem",
            position: 3,
            name: "Freelancer Tax Calculator",
            item: pageUrl,
        },
    ],
};
---

<Layout
    title="Freelancer Tax Calculator Pakistan 2026-27: IT Export Tax"
    description="Free freelancer tax calculator for Pakistan, Tax Year 2027. Estimate tax on IT export income (Section 154A, 0.25% for PSEB) and local freelance income."
>
    <div class="max-w-3xl mx-auto">
        <header class="mb-8">
            <nav aria-label="Breadcrumb" class="text-xs text-gray-500 mb-4">
                <a href="/" class="hover:underline">Home</a>
                <span aria-hidden="true">/</span>
                <a href="/tools/" class="hover:underline">Tools</a>
                <span aria-hidden="true">/</span>
                <span>Freelancer Tax Calculator</span>
            </nav>
            <h1 class="text-3xl md:text-4xl font-bold mb-3">
                Freelancer Tax Calculator Pakistan (Tax Year 2027)
            </h1>
            <p class="text-gray-600 mb-2">
                Estimate your FBR income tax liability. Supports concessionary
                IT export income (Section 154A flat 0.25% or 1%) alongside local
                freelance and non-salaried business income.
            </p>
            <p class="text-xs text-gray-500">
                ⚡ Updated for the Finance Act 2026 rates. Calculations are
                instant and private.
            </p>
            <p class="text-xs text-gray-500">
                Last reviewed: October 25, 2026 · Source: Finance Act 2026 (<a
                    href="https://www.fbr.gov.pk/"
                    target="_blank"
                    rel="noopener"
                    class="underline">FBR</a
                >)
            </p>
        </header>

        <!-- Slab data for the calculator script (same list as the table below) -->
        <div id="calc-config" data-slabs={JSON.stringify(slabs)} hidden></div>

        <!-- Input Section -->
        <section class="bg-white p-6 rounded-xl border border-gray-200 mb-6">
            <div class="space-y-5">
                <!-- Income Type -->
                <div>
                    <label class="block text-sm font-medium mb-3"
                        >Income Type</label
                    >
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <label
                            class="flex items-start gap-2 text-sm p-3 bg-gray-50 rounded-lg cursor-pointer hover:bg-gray-100 transition border border-gray-200"
                        >
                            <input
                                type="radio"
                                name="income-type"
                                value="export"
                                checked
                                class="mt-1"
                            />
                            <div>
                                <div class="font-medium">
                                    IT / Export Income
                                </div>
                                <div class="text-xs text-gray-500 mt-1">
                                    Foreign clients (Upwork, Fiverr, direct)
                                </div>
                            </div>
                        </label>
                        <label
                            class="flex items-start gap-2 text-sm p-3 bg-gray-50 rounded-lg cursor-pointer hover:bg-gray-100 transition border border-gray-200"
                        >
                            <input
                                type="radio"
                                name="income-type"
                                value="local"
                                class="mt-1"
                            />
                            <div>
                                <div class="font-medium">
                                    Local Freelance Income
                                </div>
                                <div class="text-xs text-gray-500 mt-1">
                                    Pakistani clients
                                </div>
                            </div>
                        </label>
                    </div>
                </div>

                <!-- PSEB Registration -->
                <div id="pseb-section">
                    <label
                        class="flex items-center gap-2 text-sm p-3 bg-gray-50 rounded-lg cursor-pointer hover:bg-gray-100 transition border border-gray-200"
                    >
                        <input
                            type="checkbox"
                            id="pseb-registered"
                            class="rounded"
                            checked
                        />
                        <span
                            >Registered with PSEB (Pakistan Software Export
                            Board)</span
                        >
                    </label>
                </div>

                <!-- Annual Income -->
                <div>
                    <label
                        id="income-label"
                        for="annual-income"
                        class="block text-sm font-medium mb-2"
                    >
                        Annual Freelance Income (PKR)
                    </label>
                    <input
                        type="number"
                        id="annual-income"
                        value="2400000"
                        min="0"
                        step="10000"
                        class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                    />
                </div>

                <p id="error" role="alert" class="hidden text-sm text-red-600">
                </p>

                <button
                    id="calculate-btn"
                    class="w-full px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium transition"
                >
                    Calculate Tax
                </button>
            </div>
        </section>

        <!-- Results -->
        <section id="results" class="hidden" aria-live="polite">
            <!-- Main Result -->
            <div
                class="bg-blue-50 border border-blue-200 p-6 rounded-xl mb-6 text-center"
            >
                <p class="text-sm text-gray-600 mb-2">Annual Tax</p>
                <p id="tax-result" class="text-4xl font-bold text-blue-700">
                    PKR 0
                </p>
                <p id="tax-sub" class="text-sm text-gray-600 mt-2">—</p>
                <p class="text-xs text-gray-500 mt-3">
                    Estimate only. Confirm your final figures with FBR or a tax
                    professional.
                </p>
            </div>

            <!-- Effective Rate -->
            <div class="bg-white p-6 rounded-xl border border-gray-200 mb-6">
                <h2 class="text-lg font-semibold mb-4">Tax Breakdown</h2>
                <table class="w-full text-sm">
                    <tbody class="divide-y divide-gray-100">
                        <tr>
                            <td class="py-2 text-gray-600"
                                >Gross Annual Income</td
                            >
                            <td
                                id="breakdown-gross"
                                class="py-2 text-right font-medium">PKR 0</td
                            >
                        </tr>
                        <tr>
                            <td class="py-2 text-gray-600">Tax Rate Applied</td>
                            <td
                                id="breakdown-rate"
                                class="py-2 text-right font-medium">—</td
                            >
                        </tr>
                        <tr>
                            <td class="py-2 text-gray-600">Applicable Regime</td
                            >
                            <td
                                id="breakdown-regime"
                                class="py-2 text-right font-medium">—</td
                            >
                        </tr>
                        <tr class="bg-gray-50">
                            <td class="py-3 font-semibold">Total Tax Payable</td
                            >
                            <td
                                id="breakdown-tax"
                                class="py-3 text-right font-bold text-red-600 text-lg"
                                >PKR 0</td
                            >
                        </tr>
                        <tr>
                            <td class="py-2 text-gray-600"
                                >Net Income (After Tax)</td
                            >
                            <td
                                id="breakdown-net"
                                class="py-2 text-right font-bold text-green-600"
                                >PKR 0</td
                            >
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Surcharge note -->
            <div
                id="income-note"
                class="hidden bg-orange-50 border border-orange-200 p-4 rounded-xl mb-6"
            >
                <h3 class="font-semibold mb-2">⚠️ Surcharge may apply</h3>
                <p class="text-sm text-gray-700">
                    Your income is above Rs 10 million. A Section 4AB surcharge
                    may apply on top of this tax and is not included in this
                    estimate. Check the current rate with FBR or a tax
                    professional.
                </p>
            </div>

            <!-- Tax Saving Tip -->
            <div
                id="saving-tip"
                class="hidden bg-yellow-50 border border-yellow-200 p-4 rounded-xl mb-6"
            >
                <h3 class="font-semibold mb-2">💡 Tax Saving Tip</h3>
                <p id="saving-tip-text" class="text-sm text-gray-700"></p>
            </div>
        </section>
    </div>

    <!-- SEO Content -->
    <section class="max-w-3xl mx-auto mt-16">
        <h2 class="text-2xl font-bold mb-4">
            About This Freelancer Tax Calculator
        </h2>
        <p class="text-gray-700 mb-4">
            This free calculator helps Pakistani freelancers estimate their
            income tax for Tax Year 2027 (FY 2026-27). It supports two income
            types: IT/export income under Section 154A, and local freelance
            income under the standard non-salaried slabs. Everything runs in
            your browser, so your income details never leave your device.
        </p>
        <p class="text-gray-700 mb-4">
            Pakistan has a large and growing freelancing community, with many
            people earning through Upwork, Fiverr, and direct foreign clients.
            But the tax rules for freelancers differ from those for salaried
            employees, and many freelancers don't know what they owe until
            filing season. This tool makes it clearer.
        </p>

        <h3 class="text-xl font-semibold mt-6 mb-3">
            Freelancer Tax Rates in Pakistan (2026-27)
        </h3>

        <h4 class="font-semibold mt-4 mb-2">
            IT / Export Income (Section 154A)
        </h4>
        <ul class="list-disc pl-6 text-gray-700 space-y-2">
            <li>
                <strong>0.25%</strong> — IT and IT-enabled services exporters registered
                with PSEB
            </li>
            <li>
                <strong>1%</strong> — exporters not registered with PSEB (other service
                exports are also taxed at 1%)
            </li>
            <li>
                Your bank deducts this tax when export proceeds are received,
                and it is generally treated as a final tax
            </li>
        </ul>

        <h4 class="font-semibold mt-4 mb-2">Local Freelance Income</h4>
        <ul class="list-disc pl-6 text-gray-700 space-y-2">
            <li>
                Taxed under the normal non-salaried slabs (0% to 45%), shown in
                the table below
            </li>
            <li>Business expenses can be deducted before calculating tax</li>
        </ul>

        <h4 class="font-semibold mt-6 mb-2">
            Non-Salaried Slabs for Local Freelance Income (Tax Year 2027)
        </h4>
        <div class="overflow-x-auto mb-4">
            <table class="w-full text-sm border border-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="text-left p-2 font-semibold"
                            >Taxable income (PKR)</th
                        >
                        <th class="text-left p-2 font-semibold">Tax</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    {
                        slabRows.map((r) => (
                            <tr>
                                <td class="p-2">{r.range}</td>
                                <td class="p-2">{r.tax}</td>
                            </tr>
                        ))
                    }
                </tbody>
            </table>
        </div>
        <p class="text-sm text-gray-600 mb-4">
            Slab rates apply to taxable income after allowable expenses. A
            surcharge may apply above Rs 10 million, so check FBR for the
            current rule.
        </p>

        <h3 class="text-xl font-semibold mt-6 mb-3">
            How to Use This Calculator
        </h3>
        <ol class="list-decimal pl-6 text-gray-700 space-y-2">
            <li>Choose your income type: IT/Export or Local Freelance</li>
            <li>If IT/Export, indicate whether you're registered with PSEB</li>
            <li>
                Enter your annual income in PKR (for local income, enter your
                taxable income after business expenses)
            </li>
            <li>
                See your annual tax, effective rate, and net income. The results
                update as you type.
            </li>
        </ol>

        <h3 class="text-xl font-semibold mt-6 mb-3">
            Why PSEB Registration Matters
        </h3>
        <p class="text-gray-700 mb-4">
            PSEB (Pakistan Software Export Board) registration reduces the rate
            on IT export income from 1% to 0.25%, a 75% reduction. On PKR
            2,400,000 of annual income, that is a difference of PKR 18,000 per
            year. On PKR 10,000,000, the difference is PKR 75,000. Registration
            involves paperwork and may involve fees, so check PSEB for the
            current requirements.
        </p>

        <h3 class="text-xl font-semibold mt-6 mb-3">
            How Tax Is Collected on Export Income
        </h3>
        <p class="text-gray-700 mb-4">
            Under Section 154A, your bank deducts the tax when your export
            proceeds are received in Pakistan through banking channels. Income
            kept in foreign wallets or accounts, or received through informal
            channels, is not withheld at source, and how it is taxed is a
            question for FBR or a tax professional.
        </p>
        <p class="text-gray-700 mb-4">
            Some exporter reliefs, such as the Section 65F tax credit, have
            their own conditions, including a requirement that 80% of export
            proceeds are brought into Pakistan through normal banking channels.
            They are time-limited and are not part of this calculator, so check
            FBR to see whether they apply to you.
        </p>
        <p class="text-gray-700 mb-4">
            Keep your bank credit advices, PSEB registration certificate, and
            client contracts for at least six years.
        </p>

        <h3 class="text-xl font-semibold mt-6 mb-3">Common Use Cases</h3>

        <h4 class="font-semibold mt-4 mb-2">1. Estimating IT Export Tax</h4>
        <p class="text-gray-700 mb-4">
            If you're a software developer, designer, writer, or digital
            marketer earning from foreign clients, your income is taxed under
            Section 154A. This calculator shows the tax at 0.25%
            (PSEB-registered) or 1% (not registered).
        </p>

        <h4 class="font-semibold mt-4 mb-2">2. Checking if PSEB is Worth It</h4>
        <p class="text-gray-700 mb-4">
            PSEB registration takes paperwork and may involve fees. If your
            annual income is PKR 2,400,000, PSEB saves you PKR 18,000 per year.
            If it's PKR 500,000, the savings are PKR 3,750. Compare the savings
            with the cost and effort of registering.
        </p>

        <h4 class="font-semibold mt-4 mb-2">3. Local Freelance Tax Planning</h4>
        <p class="text-gray-700 mb-4">
            If you work with Pakistani clients, your income falls under the
            non-salaried slabs. This means higher rates (up to 45%) but allows
            deducting business expenses. Enter your taxable income after
            expenses to see your tax under these slabs.
        </p>

        <h4 class="font-semibold mt-4 mb-2">4. Filing Season Preparation</h4>
        <p class="text-gray-700 mb-4">
            Before filing on the FBR IRIS portal, use this calculator to
            estimate your liability. This helps you plan cash flow and avoid
            surprises.
        </p>

        <h4 class="font-semibold mt-4 mb-2">
            5. Comparing Export vs Local Work
        </h4>
        <p class="text-gray-700 mb-4">
            If you can work with foreign clients (export) or local clients, the
            tax difference is large: 0.25% on export income versus slab rates of
            up to 45% on local income. This calculator helps you see the tax
            impact of each choice.
        </p>

        <h4 class="font-semibold mt-4 mb-2">
            6. Staying on the Active Taxpayer List (ATL)
        </h4>
        <p class="text-gray-700 mb-4">
            Filing your return helps you stay on the ATL. Non-filers may face
            higher withholding taxes on banking transactions, vehicle
            registration, and property purchases. This calculator helps you
            understand your tax burden before filing.
        </p>

        <h3 class="text-xl font-semibold mt-6 mb-3">Worked Examples</h3>
        <p class="text-gray-700 mb-4">
            <strong>IT export income, PSEB-registered:</strong>
        </p>
        <ul class="list-disc pl-6 text-gray-700 space-y-2">
            <li><strong>Annual income:</strong> PKR 2,400,000</li>
            <li><strong>Tax rate:</strong> 0.25%</li>
            <li><strong>Annual tax:</strong> PKR 6,000</li>
            <li><strong>Monthly equivalent:</strong> PKR 500</li>
            <li><strong>Net income (after tax):</strong> PKR 2,394,000</li>
        </ul>
        <p class="text-gray-700 mt-4 mb-4">
            <strong>Local freelance income:</strong> the same PKR 2,400,000 of taxable
            income falls in the 30% slab. Tax is PKR 170,000 plus 30% of the amount
            over PKR 1,600,000, which comes to PKR 410,000, an effective rate of about
            17.1%.
        </p>

        <h3 class="text-xl font-semibold mt-6 mb-3">
            Frequently Asked Questions
        </h3>
        <div class="space-y-4 mt-3">
            {
                faqs.map((f) => (
                    <div>
                        <h4 class="font-semibold text-gray-900">{f.q}</h4>
                        <p class="text-gray-700 mt-1">{f.a}</p>
                    </div>
                ))
            }
        </div>

        <p
            class="text-sm text-gray-500 mt-6 p-3 bg-gray-50 rounded-lg border border-gray-200"
        >
            <strong>Disclaimer:</strong> This calculator is for estimation only, not
            tax advice. Actual liability depends on expenses, deductions, surcharges,
            and other income. For final figures, consult FBR or a certified tax professional.
        </p>
    </section>

    <!-- Related Tools & Guides -->
    <section class="max-w-3xl mx-auto mt-16">
        <h2 class="text-2xl font-bold mb-6">Related Tools</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-10">
            <a
                href="/tools/salary-tax-calculator/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-semibold mb-1">Salary Tax Calculator</h3>
                <p class="text-sm text-gray-600">
                    Calculate take-home salary for salaried individuals.
                </p>
            </a>
            <a
                href="/tools/zakat-calculator/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-semibold mb-1">Zakat Calculator</h3>
                <p class="text-sm text-gray-600">
                    Calculate Zakat on gold, silver, and cash.
                </p>
            </a>
            <a
                href="/tools/emi-calculator/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-semibold mb-1">EMI Calculator</h3>
                <p class="text-sm text-gray-600">
                    Calculate loan EMI and total interest.
                </p>
            </a>
        </div>

        <h2 class="text-2xl font-bold mb-6">Related Guides</h2>
        <div class="space-y-3">
            <a
                href="/blog/freelancing-tax-pakistan/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-medium">Freelancing Tax in Pakistan</h3>
                <p class="text-sm text-gray-600">
                    How IT export and local freelance income are taxed.
                </p>
            </a>
            <a
                href="/blog/how-to-save-tax-pakistan/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-medium">
                    7 Legal Ways to Save Tax in Pakistan
                </h3>
                <p class="text-sm text-gray-600">
                    Reduce your tax bill with FBR-approved credits.
                </p>
            </a>
            <a
                href="/blog/salary-tax-pakistan/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-medium">
                    How to Calculate Salary Tax in Pakistan
                </h3>
                <p class="text-sm text-gray-600">
                    Complete FBR slab guide with examples.
                </p>
            </a>
        </div>
    </section>

    <script>
        interface Slab {
            from: number;
            upTo: number | null;
            base: number;
            rate: number;
        }

        const incomeTypeRadios = document.querySelectorAll<HTMLInputElement>(
            'input[name="income-type"]',
        );
        const psebSection = document.getElementById("pseb-section")!;
        const psebCheckbox = document.getElementById(
            "pseb-registered",
        ) as HTMLInputElement;
        const annualIncome = document.getElementById(
            "annual-income",
        ) as HTMLInputElement;
        const incomeLabel = document.getElementById("income-label")!;
        const calculateBtn = document.getElementById("calculate-btn")!;
        const results = document.getElementById("results")!;
        const errorBox = document.getElementById("error")!;
        const incomeNote = document.getElementById("income-note")!;

        // Slabs come from the same list that builds the table on the page.
        const slabs: Slab[] = JSON.parse(
            document.getElementById("calc-config")!.dataset.slabs!,
        );

        const SURCHARGE_THRESHOLD = 10_000_000;

        function formatPKR(num: number): string {
            return "PKR " + Math.round(num).toLocaleString("en-US");
        }

        function getIncomeType(): "export" | "local" {
            for (const radio of incomeTypeRadios) {
                if (radio.checked) return radio.value as "export" | "local";
            }
            return "export";
        }

        function calculateLocalTax(income: number): {
            tax: number;
            slabRate: number;
        } {
            for (const s of slabs) {
                if (s.upTo === null || income <= s.upTo) {
                    return {
                        tax: s.base + (income - s.from) * s.rate,
                        slabRate: s.rate,
                    };
                }
            }
            return { tax: 0, slabRate: 0 };
        }

        function updateTypeUI() {
            const isExport = getIncomeType() === "export";
            psebSection.classList.toggle("hidden", !isExport);
            incomeLabel.textContent = isExport
                ? "Annual Freelance Income (PKR)"
                : "Annual Taxable Income after Business Expenses (PKR)";
        }

        // Returns true when the input was valid and the results were updated.
        // With showErrors = false (live typing) invalid input is ignored and
        // the previous results stay on screen.
        function calculate(showErrors: boolean): boolean {
            const income = parseFloat(annualIncome.value);
            if (!(income > 0)) {
                if (showErrors) {
                    errorBox.textContent =
                        "Please enter a valid annual income.";
                    errorBox.classList.remove("hidden");
                }
                return false;
            }
            errorBox.classList.add("hidden");

            const type = getIncomeType();
            let tax = 0;
            let rate = "";
            let effective = "";
            let regime = "";
            let savingTip = "";

            if (type === "export") {
                if (psebCheckbox.checked) {
                    tax = income * 0.0025;
                    rate = "0.25%";
                    regime = "Section 154A (PSEB-registered)";
                } else {
                    tax = income * 0.01;
                    rate = "1%";
                    regime = "Section 154A (Non-PSEB)";
                    savingTip =
                        "Register with PSEB to reduce your tax rate from 1% to 0.25%. On your income, that saves " +
                        formatPKR(income * 0.0075) +
                        " per year.";
                }
                effective = rate;
            } else {
                const local = calculateLocalTax(income);
                tax = local.tax;
                const slabPct = Math.round(local.slabRate * 100) + "%";
                const effPct = ((tax / income) * 100).toFixed(1) + "%";
                rate = tax > 0 ? `${slabPct} slab, ${effPct} effective` : "0%";
                effective = tax > 0 ? effPct : "0%";
                regime = "Non-Salaried Slabs (Local Income)";
                if (tax > 0) {
                    savingTip =
                        "Keep records of business expenses (software, internet, equipment) to reduce your taxable income.";
                }
            }

            document.getElementById("tax-result")!.textContent = formatPKR(tax);
            document.getElementById("tax-sub")!.textContent =
                `${effective} effective rate on ${formatPKR(income)}`;

            document.getElementById("breakdown-gross")!.textContent =
                formatPKR(income);
            document.getElementById("breakdown-rate")!.textContent = rate;
            document.getElementById("breakdown-regime")!.textContent = regime;
            document.getElementById("breakdown-tax")!.textContent =
                formatPKR(tax);
            document.getElementById("breakdown-net")!.textContent = formatPKR(
                income - tax,
            );

            incomeNote.classList.toggle(
                "hidden",
                !(type === "local" && income > SURCHARGE_THRESHOLD),
            );

            const tipBox = document.getElementById("saving-tip")!;
            if (savingTip) {
                document.getElementById("saving-tip-text")!.textContent =
                    savingTip;
                tipBox.classList.remove("hidden");
            } else {
                tipBox.classList.add("hidden");
            }

            results.classList.remove("hidden");
            return true;
        }

        incomeTypeRadios.forEach((radio) => {
            radio.addEventListener("change", () => {
                updateTypeUI();
                calculate(false);
            });
        });
        psebCheckbox.addEventListener("change", () => calculate(false));
        annualIncome.addEventListener("input", () => calculate(false));

        calculateBtn.addEventListener("click", () => {
            if (calculate(true)) {
                results.scrollIntoView({ behavior: "smooth" });
            }
        });

        updateTypeUI();
        calculate(false);
    </script>

    <script
        type="application/ld+json"
        set:html={JSON.stringify(webAppSchema)}
    />
    <script
        type="application/ld+json"
        set:html={JSON.stringify(breadcrumbSchema)}
    />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Layout>
