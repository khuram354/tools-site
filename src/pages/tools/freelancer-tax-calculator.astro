---
import Layout from "../../layouts/Layout.astro";
---

<Layout
    title="Freelancer Tax Calculator Pakistan 2026-27 — IT Export Tax"
    description="Calculate your freelancer tax in Pakistan for Tax Year 2027. Supports IT export income (Section 154A) and local freelance income with FBR slabs."
>
    <div class="max-w-3xl mx-auto">
        <header class="mb-8">
            <h1 class="text-3xl md:text-4xl font-bold mb-3">
                Freelancer Tax Calculator Pakistan (Tax Year 2027)
            </h1>
            <p class="text-gray-600 mb-2">
                Estimate your FBR income tax liability. Supports concessionary
                IT export income (Section 154A flat 0.25% or 1%) alongside local
                freelance and non-salaried business income.
            </p>
            <p class="text-xs text-gray-500">
                ⚡ Updated for the latest Finance Act 2026 schedules.
                Calculations are instant and private.
            </p>
            <p class="text-xs text-gray-500">
                Last updated: October 15, 2026 · Source: FBR — Finance Act 2026
            </p>
        </header>

        <!-- Input Section -->
        <section class="bg-white p-6 rounded-xl border border-gray-200 mb-6">
            <div class="space-y-5">
                <!-- Income Type -->
                <div>
                    <label class="block text-sm font-medium mb-3"
                        >Income Type</label
                    >
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <label
                            class="flex items-start gap-2 text-sm p-3 bg-gray-50 rounded-lg cursor-pointer hover:bg-gray-100 transition border border-gray-200"
                        >
                            <input
                                type="radio"
                                name="income-type"
                                value="export"
                                checked
                                class="mt-1"
                            />
                            <div>
                                <div class="font-medium">
                                    IT / Export Income
                                </div>
                                <div class="text-xs text-gray-500 mt-1">
                                    Foreign clients (Upwork, Fiverr, direct)
                                </div>
                            </div>
                        </label>
                        <label
                            class="flex items-start gap-2 text-sm p-3 bg-gray-50 rounded-lg cursor-pointer hover:bg-gray-100 transition border border-gray-200"
                        >
                            <input
                                type="radio"
                                name="income-type"
                                value="local"
                                class="mt-1"
                            />
                            <div>
                                <div class="font-medium">
                                    Local Freelance Income
                                </div>
                                <div class="text-xs text-gray-500 mt-1">
                                    Pakistani clients
                                </div>
                            </div>
                        </label>
                    </div>
                </div>

                <!-- PSEB Registration -->
                <div id="pseb-section">
                    <label
                        class="flex items-center gap-2 text-sm p-3 bg-gray-50 rounded-lg cursor-pointer hover:bg-gray-100 transition border border-gray-200"
                    >
                        <input
                            type="checkbox"
                            id="pseb-registered"
                            class="rounded"
                            checked
                        />
                        <span
                            >Registered with PSEB (Pakistan Software Export
                            Board)</span
                        >
                    </label>
                </div>

                <!-- Annual Income -->
                <div>
                    <label
                        for="annual-income"
                        class="block text-sm font-medium mb-2"
                    >
                        Annual Freelance Income (PKR)
                    </label>
                    <input
                        type="number"
                        id="annual-income"
                        value="2400000"
                        min="0"
                        step="10000"
                        class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                    />
                </div>

                <button
                    id="calculate-btn"
                    class="w-full px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium transition"
                >
                    Calculate Tax
                </button>
            </div>
        </section>

        <!-- Results -->
        <section id="results" class="hidden">
            <!-- Main Result -->
            <div
                class="bg-blue-50 border border-blue-200 p-6 rounded-xl mb-6 text-center"
            >
                <p class="text-sm text-gray-600 mb-2">Annual Tax</p>
                <p id="tax-result" class="text-4xl font-bold text-blue-700">
                    PKR 0
                </p>
                <p id="tax-sub" class="text-sm text-gray-600 mt-2">—</p>
            </div>

            <!-- Effective Rate -->
            <div class="bg-white p-6 rounded-xl border border-gray-200 mb-6">
                <h3 class="text-lg font-semibold mb-4">Tax Breakdown</h3>
                <table class="w-full text-sm">
                    <tbody class="divide-y divide-gray-100">
                        <tr>
                            <td class="py-2 text-gray-600"
                                >Gross Annual Income</td
                            >
                            <td
                                id="breakdown-gross"
                                class="py-2 text-right font-medium">PKR 0</td
                            >
                        </tr>
                        <tr>
                            <td class="py-2 text-gray-600">Tax Rate Applied</td>
                            <td
                                id="breakdown-rate"
                                class="py-2 text-right font-medium">—</td
                            >
                        </tr>
                        <tr>
                            <td class="py-2 text-gray-600">Applicable Regime</td
                            >
                            <td
                                id="breakdown-regime"
                                class="py-2 text-right font-medium">—</td
                            >
                        </tr>
                        <tr class="bg-gray-50">
                            <td class="py-3 font-semibold">Total Tax Payable</td
                            >
                            <td
                                id="breakdown-tax"
                                class="py-3 text-right font-bold text-red-600 text-lg"
                                >PKR 0</td
                            >
                        </tr>
                        <tr>
                            <td class="py-2 text-gray-600"
                                >Net Income (After Tax)</td
                            >
                            <td
                                id="breakdown-net"
                                class="py-2 text-right font-bold text-green-600"
                                >PKR 0</td
                            >
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Tax Saving Tip -->
            <div
                id="saving-tip"
                class="hidden bg-yellow-50 border border-yellow-200 p-4 rounded-xl mb-6"
            >
                <h3 class="font-semibold mb-2">💡 Tax Saving Tip</h3>
                <p id="saving-tip-text" class="text-sm text-gray-700"></p>
            </div>
        </section>
    </div>

    <!-- SEO Content (800+ words) -->
    <section class="max-w-3xl mx-auto mt-16">
        <h2 class="text-2xl font-bold mb-4">
            About This Freelancer Tax Calculator
        </h2>
        <p class="text-gray-700 mb-4">
            This free calculator helps Pakistani freelancers estimate their
            income tax for Tax Year 2027 (FY 2026-27). It supports two income
            types: IT/export income under Section 154A, and local freelance
            income under the standard business slabs. Everything runs in your
            browser — your income details never leave your device.
        </p>
        <p class="text-gray-700 mb-4">
            Pakistan has become one of the largest freelancing markets in the
            world, with hundreds of thousands of freelancers earning through
            Upwork, Fiverr, and direct foreign clients. But tax rules for
            freelancers are different from salaried employees — and many
            freelancers don't know what they owe until filing season. This tool
            makes it clear.
        </p>

        <h3 class="text-xl font-semibold mt-6 mb-3">
            Freelancer Tax Rates in Pakistan (2026-27)
        </h3>

        <h4 class="font-semibold mt-4 mb-2">
            IT / Export Income (Section 154A)
        </h4>
        <ul class="list-disc pl-6 text-gray-700 space-y-2">
            <li><strong>0.25%</strong> — PSEB-registered freelancers</li>
            <li><strong>1%</strong> — Non-PSEB-registered freelancers</li>
            <li>
                This is a final tax on gross income received through approved
                banking channels
            </li>
        </ul>

        <h4 class="font-semibold mt-4 mb-2">Local Freelance Income</h4>
        <ul class="list-disc pl-6 text-gray-700 space-y-2">
            <li>Taxed under normal non-salaried slabs (0% to 45%)</li>
            <li>Business expenses can be deducted before calculating tax</li>
        </ul>

        <h3 class="text-xl font-semibold mt-6 mb-3">
            How to Use This Calculator
        </h3>
        <ol class="list-decimal pl-6 text-gray-700 space-y-2">
            <li>Choose your income type: IT/Export or Local Freelance</li>
            <li>If IT/Export, indicate whether you're registered with PSEB</li>
            <li>Enter your annual freelance income in PKR</li>
            <li>
                Click "Calculate Tax" to see your annual tax, effective rate,
                and net income
            </li>
        </ol>

        <h3 class="text-xl font-semibold mt-6 mb-3">
            Why PSEB Registration Matters
        </h3>
        <p class="text-gray-700 mb-4">
            PSEB (Pakistan Software Export Board) registration reduces your tax
            rate from 1% to 0.25% on IT export income — a 75% reduction. On PKR
            2,400,000 annual income, that's a difference of PKR 18,000 per year.
            On PKR 10,000,000, the difference is PKR 75,000.
        </p>

        <h3 class="text-xl font-semibold mt-6 mb-3">
            The 80% Remittance Requirement
        </h3>
        <p class="text-gray-700 mb-4">
            For IT export income to qualify for the reduced 0.25% rate, FBR
            requires that <strong>at least 80% of your export proceeds</strong> are
            received through approved banking channels in Pakistan. Income kept in
            foreign wallets or received through informal channels does not qualify.
        </p>
        <p class="text-gray-700 mb-4">
            Keep records of all bank credits, PSEB registration certificate, and
            your client contracts for at least 6 years.
        </p>

        <h3 class="text-xl font-semibold mt-6 mb-3">Common Use Cases</h3>

        <h4 class="font-semibold mt-4 mb-2">1. Estimating IT Export Tax</h4>
        <p class="text-gray-700 mb-4">
            If you're a software developer, designer, writer, or digital
            marketer earning from foreign clients, your income is taxed under
            Section 154A. This calculator shows your final tax at 0.25%
            (PSEB-registered) or 1% (non-registered).
        </p>

        <h4 class="font-semibold mt-4 mb-2">2. Checking if PSEB is Worth It</h4>
        <p class="text-gray-700 mb-4">
            PSEB registration has a fee and paperwork. If your annual income is
            PKR 2,400,000, PSEB saves you PKR 18,000 per year — worth the
            effort. If it's PKR 500,000, the savings are PKR 3,750 — might not
            be worth the hassle. This tool helps you decide.
        </p>

        <h4 class="font-semibold mt-4 mb-2">3. Local Freelance Tax Planning</h4>
        <p class="text-gray-700 mb-4">
            If you work with Pakistani clients, your income falls under the
            non-salaried slabs. This means higher rates (up to 45%) but allows
            deducting business expenses. The calculator shows your tax under
            these slabs.
        </p>

        <h4 class="font-semibold mt-4 mb-2">4. Filing Season Preparation</h4>
        <p class="text-gray-700 mb-4">
            Before filing on the FBR IRIS portal, use this calculator to
            estimate your liability. This helps you plan cash flow and avoid
            surprises.
        </p>

        <h4 class="font-semibold mt-4 mb-2">
            5. Comparing Export vs Local Work
        </h4>
        <p class="text-gray-700 mb-4">
            If you have the option to work with foreign clients (export) or
            local clients, the tax difference is significant — 0.25% vs up to
            45%. This calculator helps you see the tax impact of each choice.
        </p>

        <h4 class="font-semibold mt-4 mb-2">
            6. Staying on the Active Taxpayer List (ATL)
        </h4>
        <p class="text-gray-700 mb-4">
            Filing your return is required to stay on the ATL. Non-filers face
            higher withholding taxes on banking transactions, vehicle
            registration, and property purchases. This calculator helps you
            understand your tax burden before filing.
        </p>

        <h3 class="text-xl font-semibold mt-6 mb-3">A Worked Example</h3>
        <p class="text-gray-700 mb-4">
            Here's what happens for a typical IT freelancer:
        </p>
        <ul class="list-disc pl-6 text-gray-700 space-y-2">
            <li><strong>Annual income:</strong> PKR 2,400,000</li>
            <li><strong>PSEB-registered:</strong> Yes</li>
            <li><strong>Tax rate:</strong> 0.25%</li>
            <li><strong>Annual tax:</strong> PKR 6,000</li>
            <li><strong>Monthly equivalent:</strong> PKR 500</li>
            <li><strong>Net income (after tax):</strong> PKR 2,394,000</li>
        </ul>
        <p class="text-gray-700 mt-4 mb-4">
            That's a 0.25% effective rate — one of the lowest tax rates
            available to any income category in Pakistan.
        </p>

        <h3 class="text-xl font-semibold mt-6 mb-3">
            Frequently Asked Questions
        </h3>
        <div class="space-y-4 mt-3">
            <div>
                <h4 class="font-semibold text-gray-900">
                    Do I need to register with PSEB?
                </h4>
                <p class="text-gray-700 mt-1">
                    Yes, if you want the 0.25% rate on IT export income. Without
                    PSEB registration, you pay 1%. Registration is free but
                    requires documentation.
                </p>
            </div>
            <div>
                <h4 class="font-semibold text-gray-900">
                    Do I need to file a tax return?
                </h4>
                <p class="text-gray-700 mt-1">
                    Yes. Every freelancer with income above PKR 600,000 must
                    file an annual return on the FBR IRIS portal to stay on the
                    Active Taxpayer List (ATL).
                </p>
            </div>
            <div>
                <h4 class="font-semibold text-gray-900">
                    What counts as "approved banking channels"?
                </h4>
                <p class="text-gray-700 mt-1">
                    Any Pakistani bank account receiving foreign remittances
                    qualifies. This includes Payoneer, Wise, and direct wire
                    transfers routed through Pakistani institutions. Income left
                    in foreign platform wallets does not qualify.
                </p>
            </div>
            <div>
                <h4 class="font-semibold text-gray-900">
                    Is the 0.25% rate still available?
                </h4>
                <p class="text-gray-700 mt-1">
                    Yes. The 0.25% Final Tax Regime under Section 154A has been
                    extended through Tax Year 2029.
                </p>
            </div>
            <div>
                <h4 class="font-semibold text-gray-900">
                    Can I deduct business expenses from export income?
                </h4>
                <p class="text-gray-700 mt-1">
                    No. The 0.25% rate is a final tax on gross income — no
                    deductions are allowed. For local freelance income, however,
                    business expenses can be deducted.
                </p>
            </div>
            <div>
                <h4 class="font-semibold text-gray-900">Is my data safe?</h4>
                <p class="text-gray-700 mt-1">
                    Yes. All calculations happen in your browser. Your income
                    details are never sent to any server.
                </p>
            </div>
        </div>

        <p
            class="text-sm text-gray-500 mt-6 p-3 bg-gray-50 rounded-lg border border-gray-200"
        >
            <strong>Disclaimer:</strong> This calculator is for estimation only, not
            tax advice. Actual liability depends on expenses, deductions, and other
            income. For final figures, consult FBR or a certified tax professional.
        </p>
    </section>

    <!-- Related Tools & Guides -->
    <section class="max-w-3xl mx-auto mt-16">
        <h2 class="text-2xl font-bold mb-6">Related Tools</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-10">
            <a
                href="/tools/salary-tax-calculator/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-semibold mb-1">Salary Tax Calculator</h3>
                <p class="text-sm text-gray-600">
                    Calculate take-home salary for salaried individuals.
                </p>
            </a>
            <a
                href="/tools/zakat-calculator/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-semibold mb-1">Zakat Calculator</h3>
                <p class="text-sm text-gray-600">
                    Calculate Zakat on gold, silver, and cash.
                </p>
            </a>
            <a
                href="/tools/emi-calculator/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-semibold mb-1">EMI Calculator</h3>
                <p class="text-sm text-gray-600">
                    Calculate loan EMI and total interest.
                </p>
            </a>
        </div>

        <h2 class="text-2xl font-bold mb-6">Related Guides</h2>
        <div class="space-y-3">
            <a
                href="/blog/salary-tax-pakistan/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-medium">
                    How to Calculate Salary Tax in Pakistan
                </h3>
                <p class="text-sm text-gray-600">
                    Complete FBR slab guide with examples.
                </p>
            </a>
            <a
                href="/blog/how-to-save-tax-pakistan/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-medium">
                    7 Legal Ways to Save Tax in Pakistan
                </h3>
                <p class="text-sm text-gray-600">
                    Reduce your tax bill with FBR-approved credits.
                </p>
            </a>
            <a
                href="/blog/salary-tax-calculator-pakistan/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-medium">
                    Salary Tax Calculator Pakistan 2026-27
                </h3>
                <p class="text-sm text-gray-600">
                    Step-by-step guide to using the calculator.
                </p>
            </a>
        </div>
    </section>

    <script>
        const incomeTypeRadios = document.querySelectorAll<HTMLInputElement>(
            'input[name="income-type"]',
        );
        const psebSection = document.getElementById("pseb-section")!;
        const psebCheckbox = document.getElementById(
            "pseb-registered",
        ) as HTMLInputElement;
        const annualIncome = document.getElementById(
            "annual-income",
        ) as HTMLInputElement;
        const calculateBtn = document.getElementById("calculate-btn")!;
        const results = document.getElementById("results")!;

        function formatPKR(num: number): string {
            return "PKR " + Math.round(num).toLocaleString("en-US");
        }

        function getIncomeType(): "export" | "local" {
            for (const radio of incomeTypeRadios) {
                if (radio.checked) return radio.value as "export" | "local";
            }
            return "export";
        }

        // Non-salaried slabs (Finance Act 2026)
        function calculateLocalTax(income: number): {
            tax: number;
            rate: string;
        } {
            if (income <= 600000) return { tax: 0, rate: "0%" };
            if (income <= 1200000)
                return { tax: (income - 600000) * 0.15, rate: "15%" };
            if (income <= 1600000)
                return { tax: 90000 + (income - 1200000) * 0.2, rate: "20%" };
            if (income <= 3200000)
                return { tax: 170000 + (income - 1600000) * 0.3, rate: "30%" };
            if (income <= 5600000)
                return { tax: 650000 + (income - 3200000) * 0.4, rate: "40%" };
            return { tax: 1610000 + (income - 5600000) * 0.45, rate: "45%" };
        }

        incomeTypeRadios.forEach((radio) => {
            radio.addEventListener("change", () => {
                if (getIncomeType() === "export") {
                    psebSection.classList.remove("hidden");
                } else {
                    psebSection.classList.add("hidden");
                }
            });
        });

        function calculate() {
            const income = parseFloat(annualIncome.value) || 0;
            if (income <= 0) {
                alert("Please enter a valid annual income.");
                return;
            }

            const type = getIncomeType();
            let tax = 0;
            let rate = "";
            let regime = "";
            let savingTip = "";

            if (type === "export") {
                if (psebCheckbox.checked) {
                    tax = income * 0.0025;
                    rate = "0.25%";
                    regime = "Section 154A (PSEB-registered)";
                } else {
                    tax = income * 0.01;
                    rate = "1%";
                    regime = "Section 154A (Non-PSEB)";
                    savingTip =
                        "Register with PSEB to reduce your tax rate from 1% to 0.25%. On your income, that saves " +
                        formatPKR(income * 0.0075) +
                        " per year.";
                }
            } else {
                const local = calculateLocalTax(income);
                tax = local.tax;
                rate = local.rate;
                regime = "Non-Salaried Slabs (Local Income)";
                if (tax > 0) {
                    savingTip =
                        "Keep records of business expenses (software, internet, equipment) to reduce your taxable income.";
                }
            }

            document.getElementById("tax-result")!.textContent = formatPKR(tax);
            document.getElementById("tax-sub")!.textContent =
                `${rate} effective rate on ${formatPKR(income)}`;

            document.getElementById("breakdown-gross")!.textContent =
                formatPKR(income);
            document.getElementById("breakdown-rate")!.textContent = rate;
            document.getElementById("breakdown-regime")!.textContent = regime;
            document.getElementById("breakdown-tax")!.textContent =
                formatPKR(tax);
            document.getElementById("breakdown-net")!.textContent = formatPKR(
                income - tax,
            );

            const tipBox = document.getElementById("saving-tip")!;
            if (savingTip) {
                document.getElementById("saving-tip-text")!.textContent =
                    savingTip;
                tipBox.classList.remove("hidden");
            } else {
                tipBox.classList.add("hidden");
            }

            results.classList.remove("hidden");
        }

        calculateBtn.addEventListener("click", () => {
            calculate();
            results.scrollIntoView({ behavior: "smooth" });
        });

        calculate();
    </script>

    <script
        type="application/ld+json"
        set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "SoftwareApplication",
            name: "Freelancer Tax Calculator",
            applicationCategory: "FinanceApplication",
            operatingSystem: "Any",
            description:
                "Free freelancer tax calculator for Pakistan. Calculate income tax on IT export income (Section 154A) and local freelance income for Tax Year 2027.",
            offers: { "@type": "Offer", price: "0", priceCurrency: "PKR" },
        })}
    />

    <script
        type="application/ld+json"
        set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "FAQPage",
            mainEntity: [
                {
                    "@type": "Question",
                    name: "Do I need to register with PSEB?",
                    acceptedAnswer: {
                        "@type": "Answer",
                        text: "Yes, if you want the 0.25% rate on IT export income. Without PSEB registration, you pay 1%.",
                    },
                },
                {
                    "@type": "Question",
                    name: "Do I need to file a tax return?",
                    acceptedAnswer: {
                        "@type": "Answer",
                        text: "Yes. Every freelancer with income above PKR 600,000 must file an annual return on the FBR IRIS portal to stay on the Active Taxpayer List.",
                    },
                },
                {
                    "@type": "Question",
                    name: "What counts as approved banking channels?",
                    acceptedAnswer: {
                        "@type": "Answer",
                        text: "Any Pakistani bank account receiving foreign remittances qualifies. This includes Payoneer, Wise, and direct wire transfers routed through Pakistani institutions.",
                    },
                },
                {
                    "@type": "Question",
                    name: "Is the 0.25% rate still available?",
                    acceptedAnswer: {
                        "@type": "Answer",
                        text: "Yes. The 0.25% Final Tax Regime under Section 154A has been extended through Tax Year 2029.",
                    },
                },
            ],
        })}
    />
</Layout>
