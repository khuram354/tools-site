---
import Layout from "../../layouts/Layout.astro";

const tools = [
    {
        name: "Word Counter",
        description:
            "Count words, characters, sentences, and estimate reading time instantly.",
        href: "/tools/word-counter",
        icon: "word",
    },
    {
        name: "QR Code Generator",
        description:
            "Create custom QR codes for any text or URL. Download as PNG, free.",
        href: "/tools/qr-generator",
        icon: "qr",
    },
    {
        name: "JSON Formatter",
        description:
            "Format, validate, and beautify JSON data online. Detect syntax errors.",
        href: "/tools/json-formatter",
        icon: "json",
    },
    {
        name: "Salary Tax Calculator",
        description:
            "Calculate income tax and take-home salary for Pakistan (FY 2026-27).",
        href: "/tools/salary-tax-calculator",
        icon: "tax",
    },
    {
        name: "Image Compressor",
        description: "Compress JPG, PNG, and WebP images to reduce file size.",
        href: "/tools/image-compressor",
        icon: "image-compress",
    },
    {
        name: "Image Resizer",
        description:
            "Resize images to any dimension with aspect ratio control.",
        href: "/tools/image-resizer",
        icon: "image-resize",
    },
    {
        name: "Image Cropper",
        description: "Crop images to any size or aspect ratio.",
        href: "/tools/image-cropper",
        icon: "image-crop",
    },
    {
        name: "Image Converter",
        description: "Convert between JPG, PNG, and WebP formats.",
        href: "/tools/image-converter",
        icon: "image-convert",
    },
];

const faqs = [
    {
        q: "How many tools are available on ToolsVibe?",
        a: "We currently offer eight tools — Word Counter, QR Code Generator, and JSON Formatter and four tools for images. We add new tools regularly, so check back often.",
    },
    {
        q: "Are these tools suitable for professional use?",
        a: "Yes. Our tools are used by students, writers, developers, and businesses worldwide. They are accurate, fast, and reliable for both personal and professional tasks.",
    },
    {
        q: "Do the tools work offline?",
        a: "Once a tool page is loaded in your browser, it works without an internet connection because all processing happens locally on your device.",
    },
    {
        q: "Can I request a new tool?",
        a: "Absolutely. We love suggestions. Visit our contact page and tell us what tool you would like to see next.",
    },
];
---

<Layout
    title="Free Online Tools: Word Counter, QR Code, JSON & More"
    description="Browse all free online tools from ToolsVibe. Word counter, QR code generator, JSON formatter, and more. No signup required."
>
    <div class="max-w-6xl mx-auto">
        <header class="mb-12 text-center">
            <h1 class="text-3xl md:text-4xl font-bold mb-3">All Tools</h1>
            <p class="text-gray-600 max-w-2xl mx-auto">
                Free, fast, privacy-friendly tools that run entirely in your
                browser. No signup, no uploads, no data collection.
            </p>
        </header>

        <!-- Tools Grid -->
        <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {
                tools.map((tool) => (
                    <a
                        href={tool.href}
                        class="block p-6 bg-white rounded-xl shadow-sm border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
                    >
                        <div class="w-12 h-12 bg-blue-50 rounded-lg flex items-center justify-center mb-4">
                            {tool.icon === "word" && (
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="24"
                                    height="24"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="#2563eb"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                                    <polyline points="14 2 14 8 20 8" />
                                    <line x1="16" y1="13" x2="8" y2="13" />
                                    <line x1="16" y1="17" x2="8" y2="17" />
                                </svg>
                            )}
                            {tool.icon === "qr" && (
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="24"
                                    height="24"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="#2563eb"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <rect x="3" y="3" width="7" height="7" />
                                    <rect x="14" y="3" width="7" height="7" />
                                    <rect x="3" y="14" width="7" height="7" />
                                    <rect x="14" y="14" width="7" height="7" />
                                </svg>
                            )}
                            {tool.icon === "json" && (
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="24"
                                    height="24"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="#2563eb"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <polyline points="16 18 22 12 16 6" />
                                    <polyline points="8 6 2 12 8 18" />
                                </svg>
                            )}
                            {tool.icon === "tax" && (
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="24"
                                    height="24"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="#2563eb"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <line x1="12" y1="1" x2="12" y2="23" />
                                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                                </svg>
                            )}
                            {tool.icon === "image-compress" && (
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="24"
                                    height="24"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="#2563eb"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <polyline points="4 14 10 14 10 20" />
                                    <polyline points="20 10 14 10 14 4" />
                                    <line x1="14" y1="10" x2="21" y2="3" />
                                    <line x1="3" y1="21" x2="10" y2="14" />
                                </svg>
                            )}
                            {tool.icon === "image-resize" && (
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="24"
                                    height="24"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="#2563eb"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <rect
                                        x="3"
                                        y="3"
                                        width="18"
                                        height="18"
                                        rx="2"
                                        ry="2"
                                    />
                                    <line x1="9" y1="9" x2="15" y2="15" />
                                    <polyline points="15 9 15 15 9 15" />
                                </svg>
                            )}
                            {tool.icon === "image-crop" && (
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="24"
                                    height="24"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="#2563eb"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <path d="M6.13 1L6 16a2 2 0 0 0 2 2h15" />
                                    <path d="M1 6.13L16 6a2 2 0 0 1 2 2v15" />
                                </svg>
                            )}
                            {tool.icon === "image-convert" && (
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="24"
                                    height="24"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="#2563eb"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <polyline points="16 3 21 3 21 8" />
                                    <line x1="4" y1="20" x2="21" y2="3" />
                                    <polyline points="21 16 21 21 16 21" />
                                    <line x1="15" y1="15" x2="21" y2="21" />
                                    <line x1="4" y1="4" x2="9" y2="9" />
                                </svg>
                            )}
                        </div>
                        <h2 class="text-xl font-semibold mb-2">{tool.name}</h2>
                        <p class="text-gray-600 text-sm">{tool.description}</p>
                    </a>
                ))
            }
        </section>

        <!-- Coming Soon -->
        <section class="mt-16 text-center">
            <div
                class="inline-block px-4 py-2 bg-blue-50 text-blue-700 rounded-full text-sm font-medium mb-4"
            >
                More tools coming soon
            </div>
            <p class="text-gray-600 max-w-xl mx-auto">
                We're constantly adding new tools. Bookmark this page or check
                back often to discover what's new.
            </p>
        </section>

        <!-- SEO Content -->
        <section class="mt-20 max-w-3xl mx-auto">
            <h2 class="text-2xl font-bold mb-4">
                Browse Our Collection of Free Online Tools
            </h2>
            <p class="text-gray-700 mb-4">
                Our tools are organized by category to help you find what you
                need quickly. Each tool is built with a single purpose in mind:
                to complete a specific task fast, without friction.
            </p>

            <h3 class="text-xl font-semibold mt-8 mb-3">
                Writing & Text Tools
            </h3>
            <p class="text-gray-700 mb-4">
                The{" "}
                <a
                    href="/tools/word-counter"
                    class="text-blue-600 hover:underline font-medium"
                >
                    Word Counter
                </a>{" "}
                is perfect for students, bloggers, and content writers who need accurate
                word, character, and sentence counts. It also estimates reading time,
                which is useful for planning articles and social media posts.
            </p>

            <h3 class="text-xl font-semibold mt-8 mb-3">Utility Tools</h3>
            <p class="text-gray-700 mb-4">
                The{" "}
                <a
                    href="/tools/qr-generator"
                    class="text-blue-600 hover:underline font-medium"
                >
                    QR Code Generator
                </a>{" "}
                lets you create QR codes for URLs, text, phone numbers, or any other
                data. It supports multiple sizes and error correction levels, and
                you can download the result as a PNG image instantly.
            </p>

            <h3 class="text-xl font-semibold mt-8 mb-3">Developer Tools</h3>
            <p class="text-gray-700 mb-4">
                The{" "}
                <a
                    href="/tools/json-formatter"
                    class="text-blue-600 hover:underline font-medium"
                >
                    JSON Formatter
                </a>{" "}
                is designed for developers who work with APIs and JSON data. It formats,
                validates, and beautifies JSON, and clearly highlights syntax errors
                so you can fix them fast.
            </p>
            <h3 class="text-xl font-semibold mt-8 mb-3">Image Tools</h3>
            <p class="text-gray-700 mb-4">
                Our image tools make it easy to work with photos and graphics:
            </p>
            <ul class="list-disc pl-6 text-gray-700 space-y-2 mb-4">
                <li>
                    <a
                        href="/tools/image-compressor"
                        class="text-blue-600 hover:underline font-medium"
                    >
                        Image Compressor
                    </a>{" "}
                    — reduce JPG, PNG, and WebP file sizes without losing visible
                    quality.
                </li>
                <li>
                    <a
                        href="/tools/image-resizer"
                        class="text-blue-600 hover:underline font-medium"
                    >
                        Image Resizer
                    </a>{" "}
                    — change image dimensions with aspect ratio control and quick
                    presets.
                </li>
                <li>
                    <a
                        href="/tools/image-cropper"
                        class="text-blue-600 hover:underline font-medium"
                    >
                        Image Cropper
                    </a>{" "}
                    — crop images to any size or aspect ratio (1:1, 16:9, 4:3, and
                    more).
                </li>
                <li>
                    <a
                        href="/tools/image-converter"
                        class="text-blue-600 hover:underline font-medium"
                    >
                        Image Converter
                    </a>{" "}
                    — convert between JPG, PNG, and WebP formats instantly.
                </li>
            </ul>

            <h3 class="text-xl font-semibold mt-8 mb-3">
                Why We Keep It Simple
            </h3>
            <p class="text-gray-700">
                We believe online tools should be fast and focused. No forced
                signups, no annoying popups, no selling your data. Every tool on
                this page does one thing well — and does it in your browser.
                Explore our{" "}
                <a href="/blog" class="text-blue-600 hover:underline">blog</a>{
                    " "
                }
                for guides on using these tools effectively.
            </p>
        </section>

        <!-- FAQ -->
        <section class="mt-20 max-w-3xl mx-auto">
            <h2 class="text-2xl md:text-3xl font-bold text-center mb-3">
                Frequently Asked Questions
            </h2>
            <p class="text-gray-600 text-center mb-10">
                Quick answers about our tools.
            </p>
            <div class="space-y-4">
                {
                    faqs.map((faq) => (
                        <div class="p-5 bg-white rounded-xl border border-gray-200">
                            <h3 class="font-semibold mb-2">{faq.q}</h3>
                            <p class="text-sm text-gray-600">{faq.a}</p>
                        </div>
                    ))
                }
            </div>
        </section>
    </div>

    <script
        type="application/ld+json"
        set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "CollectionPage",
            name: "All Tools — Free Online Tools",
            url: "https://toolsvibe.online/tools",
            description:
                "Browse all free online tools from ToolsVibe — Word Counter, QR Code Generator, JSON Formatter, Salary Tax Calculator, and image tools.",
            hasPart: [
                {
                    "@type": "SoftwareApplication",
                    name: "Word Counter",
                    url: "https://toolsvibe.online/tools/word-counter",
                    applicationCategory: "UtilityApplication",
                    operatingSystem: "Any",
                    offers: {
                        "@type": "Offer",
                        price: "0",
                        priceCurrency: "USD",
                    },
                },
                {
                    "@type": "SoftwareApplication",
                    name: "QR Code Generator",
                    url: "https://toolsvibe.online/tools/qr-generator",
                    applicationCategory: "UtilityApplication",
                    operatingSystem: "Any",
                    offers: {
                        "@type": "Offer",
                        price: "0",
                        priceCurrency: "USD",
                    },
                },
                {
                    "@type": "SoftwareApplication",
                    name: "JSON Formatter",
                    url: "https://toolsvibe.online/tools/json-formatter",
                    applicationCategory: "DeveloperApplication",
                    operatingSystem: "Any",
                    offers: {
                        "@type": "Offer",
                        price: "0",
                        priceCurrency: "USD",
                    },
                },
                {
                    "@type": "SoftwareApplication",
                    name: "Salary Tax Calculator",
                    url: "https://toolsvibe.online/tools/salary-tax-calculator",
                    applicationCategory: "FinanceApplication",
                    operatingSystem: "Any",
                    offers: {
                        "@type": "Offer",
                        price: "0",
                        priceCurrency: "USD",
                    },
                },
                {
                    "@type": "SoftwareApplication",
                    name: "Image Compressor",
                    url: "https://toolsvibe.online/tools/image-compressor",
                    applicationCategory: "MultimediaApplication",
                    operatingSystem: "Any",
                    offers: {
                        "@type": "Offer",
                        price: "0",
                        priceCurrency: "USD",
                    },
                },
                {
                    "@type": "SoftwareApplication",
                    name: "Image Resizer",
                    url: "https://toolsvibe.online/tools/image-resizer",
                    applicationCategory: "MultimediaApplication",
                    operatingSystem: "Any",
                    offers: {
                        "@type": "Offer",
                        price: "0",
                        priceCurrency: "USD",
                    },
                },
                {
                    "@type": "SoftwareApplication",
                    name: "Image Cropper",
                    url: "https://toolsvibe.online/tools/image-cropper",
                    applicationCategory: "MultimediaApplication",
                    operatingSystem: "Any",
                    offers: {
                        "@type": "Offer",
                        price: "0",
                        priceCurrency: "USD",
                    },
                },
                {
                    "@type": "SoftwareApplication",
                    name: "Image Converter",
                    url: "https://toolsvibe.online/tools/image-converter",
                    applicationCategory: "MultimediaApplication",
                    operatingSystem: "Any",
                    offers: {
                        "@type": "Offer",
                        price: "0",
                        priceCurrency: "USD",
                    },
                },
            ],
        })}
    />
</Layout>
