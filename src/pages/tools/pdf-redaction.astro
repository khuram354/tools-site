---
import Layout from "../../layouts/Layout.astro";

const pageUrl = new URL(Astro.url.pathname, "https://toolsvibe.online").href;

const faqs = [
    {
        q: "Is my PDF uploaded to a server?",
        a: "Absolutely not. All the heavy lifting happens right inside your web browser. Your file never leaves your device, which makes it completely safe for sensitive documents like ID cards, bank statements, and legal contracts.",
    },
    {
        q: "What is the difference between a black box and true redaction?",
        a: "This is the biggest mistake people make. Drawing a black box on a PDF only hides the text visually—anyone can just delete the box or copy-paste to see what is underneath. Our tool performs true redaction by flattening the page into an image and permanently burning the black boxes into the pixels. The text is deleted forever and cannot be recovered.",
    },
    {
        q: "Can I redact a scanned PDF without Adobe?",
        a: "Yes. You don't need an expensive Adobe Acrobat subscription. Because our redaction process converts the page to an image, it works perfectly on both native digital PDFs and scanned paper documents.",
    },
    {
        q: "Is this PDF redaction tool really free?",
        a: "Yes, it is 100% free. There are no hidden charges, no daily limits, and you don't even need to create an account.",
    },
];

const webAppSchema = {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Secure PDF Redaction Tool",
    url: pageUrl,
    applicationCategory: "SecurityApplication",
    operatingSystem: "Any",
    browserRequirements: "Requires JavaScript",
    isAccessibleForFree: true,
    description:
        "Free, browser-based PDF redaction tool. Permanently remove sensitive text and images from your PDFs without uploading them to a server.",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};

const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
};

const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item: "https://toolsvibe.online/",
        },
        {
            "@type": "ListItem",
            position: 2,
            name: "Tools",
            item: "https://toolsvibe.online/tools/",
        },
        {
            "@type": "ListItem",
            position: 3,
            name: "PDF Redaction",
            item: pageUrl,
        },
    ],
};
---

<Layout
    title="Free PDF Redaction Tool: Permanently Remove Sensitive Data"
    description="Redact PDF files for free without Adobe. Permanently remove text, images, and sensitive data. 100% private, browser-based, no uploads required."
>
    <div class="max-w-3xl mx-auto">
        <nav aria-label="Breadcrumb" class="text-xs text-gray-500 mb-4">
            <a href="/" class="hover:underline">Home</a>
            <span aria-hidden="true">/</span>
            <a href="/tools/" class="hover:underline">Tools</a>
            <span aria-hidden="true">/</span>
            <span>PDF Redaction</span>
        </nav>

        <h1 class="text-3xl md:text-4xl font-bold mb-3">
            Secure PDF Redaction
        </h1>
        <p class="text-gray-600 mb-6">
            Permanently black out sensitive text and images in your PDF. Unlike
            simple drawing tools, our software burns the redactions into the
            file so the text is <strong>truly gone</strong>. No uploads, no
            signups, and completely free.
        </p>

        <!-- Upload Section -->
        <div
            id="drop-zone"
            class="border-2 border-dashed border-gray-300 rounded-xl p-8 text-center hover:border-blue-400 transition cursor-pointer mb-6 bg-white"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="48"
                height="48"
                viewBox="0 0 24 24"
                fill="none"
                stroke="#2563eb"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="mx-auto mb-3"
            >
                <path
                    d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
                ></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
            <p id="drop-text" class="font-medium mb-1">
                Click or drag a PDF here
            </p>
            <p class="text-sm text-gray-500">
                Only .pdf files are supported (Max 20MB)
            </p>
            <input type="file" id="file-input" accept=".pdf" class="hidden" />
        </div>

        <p id="error-msg" class="hidden text-red-600 text-sm mb-4" role="alert">
        </p>

        <!-- Workspace -->
        <div id="workspace" class="hidden">
            <div
                class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-4 gap-2"
            >
                <p class="text-sm text-gray-600 font-medium">
                    Draw boxes over the text you want to delete. Drag to move,
                    pull corners to resize.
                </p>
                <button
                    id="reset-btn"
                    class="text-sm text-red-600 hover:underline font-medium"
                >
                    Clear File
                </button>
            </div>

            <!-- Controls for Mobile (Hidden on Desktop) -->
            <div
                id="mobile-controls"
                class="flex justify-between items-center mb-4 sm:hidden bg-white p-3 rounded-lg border border-gray-200"
            >
                <button
                    id="prev-page-btn"
                    class="px-4 py-2 bg-gray-100 rounded text-gray-700 disabled:opacity-50"
                    >← Prev</button
                >
                <span
                    id="page-indicator"
                    class="text-sm font-medium text-gray-700">Page 1 / 1</span
                >
                <button
                    id="next-page-btn"
                    class="px-4 py-2 bg-gray-100 rounded text-gray-700 disabled:opacity-50"
                    >Next →</button
                >
            </div>

            <!-- Multi-page Scroll Container -->
            <div
                id="pdf-container"
                class="relative border border-gray-200 rounded-xl overflow-y-auto overflow-x-hidden bg-gray-100 py-4 px-2 sm:px-4 flex flex-col items-center gap-6 shadow-inner"
                style="max-height: 60vh;"
            >
                <!-- Pages will be injected here -->
            </div>

            <div class="flex flex-wrap gap-3 mt-6">
                <button
                    id="apply-btn"
                    class="w-full sm:w-auto px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium transition"
                >
                    Apply Redactions & Download
                </button>
            </div>
        </div>
    </div>

    <!-- SEO Content -->
    <section class="max-w-3xl mx-auto mt-16">
        <h2 class="text-2xl font-bold mb-4">Why You Need True PDF Redaction</h2>
        <p class="text-gray-700 mb-4">
            When you need to share a document but it contains personal
            information—like your CNIC number, phone number, or bank details—you
            have to hide it. Most free online tools simply draw a black
            rectangle over the text. This is extremely dangerous. If you send
            that PDF to someone, they can easily open it in an editor, drag the
            black box away, and read your private information.
        </p>
        <p class="text-gray-700 mb-4">
            Our tool solves this. When you draw a box, we convert the PDF page
            into a flat image and permanently burn the black box into the
            pixels. The text underneath is destroyed forever. No one can copy
            it, search it, or recover it. It’s the safest way to redact a PDF
            without paying for expensive Adobe software.
        </p>

        <h3 class="text-xl font-semibold mt-6 mb-3">How to Use</h3>
        <ol class="list-decimal pl-6 text-gray-700 space-y-2">
            <li>Upload your PDF file.</li>
            <li>
                Use your mouse or touch screen to draw black boxes over the
                sensitive text. You can drag them to move, resize from the blue
                corner, or click the red "X" to delete.
            </li>
            <li>
                Click "Apply Redactions". The tool will securely rebuild the PDF
                and download it to your device.
            </li>
        </ol>

        <h3 class="text-xl font-semibold mt-6 mb-3">
            Frequently Asked Questions
        </h3>
        <div class="space-y-4 mt-3">
            {
                faqs.map((f) => (
                    <div>
                        <h4 class="font-semibold text-gray-900">{f.q}</h4>
                        <p class="text-gray-700 mt-1">{f.a}</p>
                    </div>
                ))
            }
        </div>
    </section>

    <!-- Related Tools -->
    <section class="max-w-3xl mx-auto mt-16">
        <h2 class="text-2xl font-bold mb-6">Related Tools</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-10">
            <a
                href="/tools/image-compressor/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-semibold mb-1">Image Compressor</h3>
                <p class="text-sm text-gray-600">Reduce image file sizes.</p>
            </a>
            <a
                href="/tools/image-converter/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-semibold mb-1">Image Converter</h3>
                <p class="text-sm text-gray-600">Convert JPG, PNG, and WebP.</p>
            </a>
            <a
                href="/tools/password-generator/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-semibold mb-1">Password Generator</h3>
                <p class="text-sm text-gray-600">Create strong passwords.</p>
            </a>
        </div>
    </section>

    <!-- Scripts -->
    <script>
        import * as pdfjsLib from "pdfjs-dist/legacy/build/pdf.mjs";
        import { PDFDocument } from "pdf-lib";

        pdfjsLib.GlobalWorkerOptions.workerSrc = new URL(
            "pdfjs-dist/legacy/build/pdf.worker.min.mjs",
            import.meta.url,
        ).toString();

        const dropZone = document.getElementById("drop-zone")!;
        const fileInput = document.getElementById(
            "file-input",
        ) as HTMLInputElement;
        const errorMsg = document.getElementById("error-msg")!;
        const workspace = document.getElementById("workspace")!;
        const pdfContainer = document.getElementById("pdf-container")!;
        const applyBtn = document.getElementById(
            "apply-btn",
        ) as HTMLButtonElement;
        const resetBtn = document.getElementById("reset-btn")!;
        const dropText = document.getElementById("drop-text")!;

        // Mobile Controls
        const prevBtn = document.getElementById(
            "prev-page-btn",
        ) as HTMLButtonElement;
        const nextBtn = document.getElementById(
            "next-page-btn",
        ) as HTMLButtonElement;
        const pageIndicator = document.getElementById("page-indicator")!;
        let currentMobilePage = 0;

        let currentPdfFile: File | null = null;
        let pdfDoc: any = null;
        let allRedactions: { x: number; y: number; w: number; h: number }[][] =
            [];
        let pageViewports: any[] = [];
        let actualScales: number[] = [];

        const isMobile = () => window.innerWidth < 640;

        dropZone.addEventListener("click", () => fileInput.click());
        dropZone.addEventListener("dragover", (e) => {
            e.preventDefault();
            dropZone.classList.add("border-blue-500", "bg-blue-50");
        });
        dropZone.addEventListener("dragleave", () => {
            dropZone.classList.remove("border-blue-500", "bg-blue-50");
        });
        dropZone.addEventListener("drop", (e) => {
            e.preventDefault();
            dropZone.classList.remove("border-blue-500", "bg-blue-50");
            const files = (e as DragEvent).dataTransfer?.files;
            if (files && files.length > 0) handleFile(files[0]);
        });
        fileInput.addEventListener("change", () => {
            if (fileInput.files && fileInput.files.length > 0) {
                handleFile(fileInput.files[0]);
            }
        });

        async function handleFile(file: File) {
            if (file.type !== "application/pdf") {
                showError("Please select a valid PDF file.");
                return;
            }
            if (file.size > 20 * 1024 * 1024) {
                showError("File is too large. Please select a PDF under 20MB.");
                return;
            }

            currentPdfFile = file;
            errorMsg.classList.add("hidden");
            dropText.textContent = `Loading: ${file.name}...`;

            try {
                const arrayBuffer = await file.arrayBuffer();
                pdfDoc = await pdfjsLib.getDocument({
                    data: arrayBuffer,
                    verbosity: 0,
                }).promise;

                pdfContainer.innerHTML = "";
                allRedactions = new Array(pdfDoc.numPages)
                    .fill(null)
                    .map(() => []);
                pageViewports = new Array(pdfDoc.numPages);
                actualScales = new Array(pdfDoc.numPages);
                currentMobilePage = 0;

                // Workspace ko pehle show karein taake width calculate ho jaye
                workspace.classList.remove("hidden");
                dropZone.classList.add("hidden");

                // Browser ko thoda waqt dein layout draw karne ka
                await new Promise((r) => setTimeout(r, 150));

                if (isMobile()) {
                    await renderMobilePage(0);
                } else {
                    for (let i = 1; i <= pdfDoc.numPages; i++) {
                        await renderDesktopPage(i);
                        await new Promise((r) => setTimeout(r, 10));
                    }
                }
            } catch (err) {
                console.error(err);
                showError(
                    "Failed to load PDF. The file might be corrupted or password-protected.",
                );
                dropText.textContent = "Click or drag a PDF here";
                // Agar error aaye toh workspace wapas hide kar dein
                workspace.classList.add("hidden");
                dropZone.classList.remove("hidden");
            }
        }

        // --- Mobile Render (One page at a time) ---
        async function renderMobilePage(pageIndex: number) {
            pdfContainer.innerHTML = "";
            pageIndicator.textContent = `Page ${pageIndex + 1} / ${pdfDoc.numPages}`;

            prevBtn.disabled = pageIndex === 0;
            nextBtn.disabled = pageIndex === pdfDoc.numPages - 1;

            const page = await pdfDoc.getPage(pageIndex + 1);

            // Force screen se width lene ke bajaye container se lein
            let containerWidth = pdfContainer.clientWidth;
            // Agar container ki width 0 ho (display:none tha), toh screen se lein
            if (containerWidth === 0) containerWidth = window.innerWidth - 40;

            const unscaledViewport = page.getViewport({ scale: 1 });

            // Fit to screen width minus padding
            const scale = (containerWidth - 32) / unscaledViewport.width;
            const viewport = page.getViewport({ scale });

            pageViewports[pageIndex] = viewport;
            actualScales[pageIndex] = scale;

            const canvasWidth = Math.floor(viewport.width);
            const canvasHeight = Math.floor(viewport.height);

            const pageWrapper = document.createElement("div");
            pageWrapper.className = "relative shadow-lg bg-white mx-auto";
            pageWrapper.style.width = `${canvasWidth}px`;
            pageWrapper.style.height = `${canvasHeight}px`;

            const canvas = document.createElement("canvas");
            canvas.width = canvasWidth;
            canvas.height = canvasHeight;
            canvas.className = "block";

            const overlay = document.createElement("div");
            overlay.className = "absolute inset-0 cursor-crosshair touch-none";

            pageWrapper.appendChild(canvas);
            pageWrapper.appendChild(overlay);
            pdfContainer.appendChild(pageWrapper);

            const context = canvas.getContext("2d")!;
            await page.render({ canvasContext: context, viewport }).promise;

            // Re-draw existing boxes for this page
            if (allRedactions[pageIndex]) {
                allRedactions[pageIndex].forEach((box, idx) => {
                    if (box) {
                        const x = box.x * scale;
                        const y = canvasHeight - box.y * scale - box.h * scale;
                        const w = box.w * scale;
                        const h = box.h * scale;
                        createBoxElement(
                            x,
                            y,
                            w,
                            h,
                            idx,
                            overlay,
                            pageIndex,
                            viewport,
                            scale,
                        );
                    }
                });
            }

            attachOverlayEvents(overlay, pageIndex, viewport, scale);
        }

        prevBtn.addEventListener("click", () => {
            if (currentMobilePage > 0) {
                currentMobilePage--;
                renderMobilePage(currentMobilePage);
            }
        });

        nextBtn.addEventListener("click", () => {
            if (currentMobilePage < pdfDoc.numPages - 1) {
                currentMobilePage++;
                renderMobilePage(currentMobilePage);
            }
        });

        // --- Desktop Render (All pages) ---
        async function renderDesktopPage(pageNum: number) {
            const page = await pdfDoc.getPage(pageNum);
            const scale = 1.5;
            const viewport = page.getViewport({ scale });

            pageViewports[pageNum - 1] = viewport;
            actualScales[pageNum - 1] = scale;

            const canvasWidth = Math.floor(viewport.width);
            const canvasHeight = Math.floor(viewport.height);

            const pageWrapper = document.createElement("div");
            pageWrapper.className = "relative shadow-lg bg-white mb-4";
            pageWrapper.style.width = `${canvasWidth}px`;
            pageWrapper.style.height = `${canvasHeight}px`;
            pageWrapper.dataset.pageIndex = (pageNum - 1).toString();

            const canvas = document.createElement("canvas");
            canvas.width = canvasWidth;
            canvas.height = canvasHeight;
            canvas.className = "block";

            const overlay = document.createElement("div");
            overlay.className = "absolute inset-0 cursor-crosshair touch-none";

            pageWrapper.appendChild(canvas);
            pageWrapper.appendChild(overlay);
            pdfContainer.appendChild(pageWrapper);

            const context = canvas.getContext("2d")!;
            await page.render({ canvasContext: context, viewport }).promise;

            attachOverlayEvents(overlay, pageNum - 1, viewport, scale);
        }

        function showError(msg: string) {
            errorMsg.textContent = msg;
            errorMsg.classList.remove("hidden");
        }

        resetBtn.addEventListener("click", () => {
            currentPdfFile = null;
            pdfDoc = null;
            workspace.classList.add("hidden");
            dropZone.classList.remove("hidden");
            dropText.textContent = "Click or drag a PDF here";
            fileInput.value = "";
            pdfContainer.innerHTML = "";
            allRedactions = [];
            errorMsg.classList.add("hidden");
        });

        // Create Box element (Reusable for both Mobile & Desktop)
        function createBoxElement(
            x: number,
            y: number,
            w: number,
            h: number,
            index: number,
            overlay: HTMLElement,
            pageIndex: number,
            viewport: any,
            currentScale: number,
        ) {
            const box = document.createElement("div");
            box.className =
                "absolute bg-black/80 border border-blue-500 group pointer-events-auto";
            box.style.left = `${x}px`;
            box.style.top = `${y}px`;
            box.style.width = `${w}px`;
            box.style.height = `${h}px`;
            box.style.cursor = "move";
            box.dataset.index = index.toString();

            const delBtn = document.createElement("button");
            delBtn.innerHTML = "×";
            delBtn.className =
                "absolute -top-4 -right-4 w-8 h-8 bg-red-500 text-white rounded-full flex items-center justify-center font-bold text-lg shadow-md hover:bg-red-600 transition hidden group-hover:flex z-10";
            delBtn.title = "Delete box";
            delBtn.addEventListener("mousedown", (e) => e.stopPropagation());
            delBtn.addEventListener("touchstart", (e) => e.stopPropagation());
            delBtn.addEventListener("click", (e) => {
                e.stopPropagation();
                box.remove();
                allRedactions[pageIndex][index] = null as any;
            });
            box.appendChild(delBtn);

            const resizeHandle = document.createElement("div");
            resizeHandle.className =
                "absolute bottom-0 right-0 w-5 h-5 bg-blue-500 cursor-se-resize z-10 rounded-tl-sm";

            // Attach event listeners for resize
            const handleResizeStart = (clientX: number, clientY: number) => {
                const rect = overlay.getBoundingClientRect();
                (window as any)._isResizing = true;
                (window as any)._activeBoxElement = box;
                (window as any)._activeBoxIndex = index;
                (window as any)._resizeStartX = clientX - rect.left;
                (window as any)._resizeStartY = clientY - rect.top;
                (window as any)._initialW = parseFloat(box.style.width);
                (window as any)._initialH = parseFloat(box.style.height);
                (window as any)._pageIndex = pageIndex;
                (window as any)._viewport = viewport;
                (window as any)._currentScale = currentScale;
            };

            resizeHandle.addEventListener("mousedown", (e) => {
                e.stopPropagation();
                handleResizeStart(e.clientX, e.clientY);
            });
            resizeHandle.addEventListener("touchstart", (e) => {
                e.stopPropagation();
                e.preventDefault();
                handleResizeStart(e.touches[0].clientX, e.touches[0].clientY);
            });

            box.appendChild(resizeHandle);
            overlay.appendChild(box);
            return box;
        }

        function attachOverlayEvents(
            overlay: HTMLDivElement,
            pageIndex: number,
            viewport: any,
            currentScale: number,
        ) {
            let isDrawing = false;
            let startX = 0,
                startY = 0;
            let currentBox: HTMLDivElement | null = null;
            let dragOffsetX = 0,
                dragOffsetY = 0;

            function syncBoxData(el: HTMLDivElement, idx: number) {
                const left = parseFloat(el.style.left);
                const top = parseFloat(el.style.top);
                const w = parseFloat(el.style.width);
                const h = parseFloat(el.style.height);

                allRedactions[pageIndex][idx] = {
                    x: left / currentScale,
                    y:
                        viewport.height / currentScale -
                        (top + h) / currentScale,
                    w: w / currentScale,
                    h: h / currentScale,
                };
            }

            function handleStart(
                clientX: number,
                clientY: number,
                target: HTMLElement,
            ) {
                const rect = overlay.getBoundingClientRect();

                if (target.classList.contains("bg-black/80")) {
                    (window as any)._isDragging = true;
                    (window as any)._activeBoxElement =
                        target as HTMLDivElement;
                    (window as any)._activeBoxIndex = parseInt(
                        target.dataset.index || "-1",
                    );
                    dragOffsetX =
                        clientX -
                        rect.left -
                        parseFloat((target as HTMLDivElement).style.left);
                    dragOffsetY =
                        clientY -
                        rect.top -
                        parseFloat((target as HTMLDivElement).style.top);
                    (window as any)._pageIndex = pageIndex;
                    return;
                }

                startX = clientX - rect.left;
                startY = clientY - rect.top;

                isDrawing = true;
                currentBox = document.createElement("div");
                currentBox.className =
                    "absolute bg-black/80 border border-blue-500 pointer-events-none";
                currentBox.style.left = `${startX}px`;
                currentBox.style.top = `${startY}px`;
                currentBox.style.width = "0px";
                currentBox.style.height = "0px";
                overlay.appendChild(currentBox);
            }

            function handleMove(clientX: number, clientY: number) {
                const rect = overlay.getBoundingClientRect();

                if (
                    (window as any)._isResizing &&
                    (window as any)._activeBoxElement
                ) {
                    const currentX = clientX - rect.left;
                    const currentY = clientY - rect.top;
                    let newW =
                        (window as any)._initialW +
                        (currentX - (window as any)._resizeStartX);
                    let newH =
                        (window as any)._initialH +
                        (currentY - (window as any)._resizeStartY);
                    if (newW > 10)
                        (window as any)._activeBoxElement.style.width =
                            `${newW}px`;
                    if (newH > 10)
                        (window as any)._activeBoxElement.style.height =
                            `${newH}px`;
                    syncBoxData(
                        (window as any)._activeBoxElement,
                        (window as any)._activeBoxIndex,
                    );
                    return;
                }

                if (
                    (window as any)._isDragging &&
                    (window as any)._activeBoxElement
                ) {
                    const currentX = clientX - rect.left;
                    const currentY = clientY - rect.top;
                    (window as any)._activeBoxElement.style.left =
                        `${currentX - dragOffsetX}px`;
                    (window as any)._activeBoxElement.style.top =
                        `${currentY - dragOffsetY}px`;
                    syncBoxData(
                        (window as any)._activeBoxElement,
                        (window as any)._activeBoxIndex,
                    );
                    return;
                }

                if (!isDrawing || !currentBox) return;

                const currentX = clientX - rect.left;
                const currentY = clientY - rect.top;
                const width = currentX - startX;
                const height = currentY - startY;

                if (width < 0) {
                    currentBox.style.left = `${currentX}px`;
                    currentBox.style.width = `${Math.abs(width)}px`;
                } else {
                    currentBox.style.width = `${width}px`;
                }
                if (height < 0) {
                    currentBox.style.top = `${currentY}px`;
                    currentBox.style.height = `${Math.abs(height)}px`;
                } else {
                    currentBox.style.height = `${height}px`;
                }
            }

            function handleEnd() {
                if ((window as any)._isResizing) {
                    (window as any)._isResizing = false;
                    (window as any)._activeBoxElement = null;
                    return;
                }
                if ((window as any)._isDragging) {
                    (window as any)._isDragging = false;
                    (window as any)._activeBoxElement = null;
                    return;
                }
                if (!isDrawing || !currentBox) return;
                isDrawing = false;

                const w = parseFloat(currentBox.style.width);
                const h = parseFloat(currentBox.style.height);

                if (w > 5 && h > 5) {
                    const left = parseFloat(currentBox.style.left);
                    const top = parseFloat(currentBox.style.top);
                    const index = allRedactions[pageIndex].length;

                    allRedactions[pageIndex].push({
                        x: left / currentScale,
                        y:
                            viewport.height / currentScale -
                            (top + h) / currentScale,
                        w: w / currentScale,
                        h: h / currentScale,
                    });

                    currentBox.remove();
                    createBoxElement(
                        left,
                        top,
                        w,
                        h,
                        index,
                        overlay,
                        pageIndex,
                        viewport,
                        currentScale,
                    );
                    currentBox = null;
                } else {
                    currentBox.remove();
                    currentBox = null;
                }
            }

            overlay.addEventListener("mousedown", (e) =>
                handleStart(e.clientX, e.clientY, e.target as HTMLElement),
            );
            overlay.addEventListener("mousemove", (e) =>
                handleMove(e.clientX, e.clientY),
            );
            overlay.addEventListener("mouseup", handleEnd);

            overlay.addEventListener(
                "touchstart",
                (e) => {
                    if (e.touches.length === 1)
                        handleStart(
                            e.touches[0].clientX,
                            e.touches[0].clientY,
                            e.target as HTMLElement,
                        );
                },
                { passive: false },
            );

            overlay.addEventListener(
                "touchmove",
                (e) => {
                    if (e.touches.length === 1) {
                        e.preventDefault();
                        handleMove(e.touches[0].clientX, e.touches[0].clientY);
                    }
                },
                { passive: false },
            );

            overlay.addEventListener("touchend", handleEnd);
            overlay.addEventListener("mouseleave", handleEnd);
        }

        applyBtn.addEventListener("click", async () => {
            const hasRedactions = allRedactions.some(
                (pageBoxes) =>
                    pageBoxes && pageBoxes.filter((b) => b !== null).length > 0,
            );
            if (!currentPdfFile || !hasRedactions) {
                alert(
                    "Please draw at least one box over the text you want to redact.",
                );
                return;
            }

            applyBtn.textContent = "Processing securely...";
            applyBtn.disabled = true;

            try {
                const arrayBuffer = await currentPdfFile.arrayBuffer();
                const pdfLibDoc = await PDFDocument.load(arrayBuffer as any);
                const newPdf = await PDFDocument.create();

                for (let i = 0; i < pdfDoc.numPages; i++) {
                    const pageBoxes = allRedactions[i]
                        ? allRedactions[i].filter((b) => b !== null)
                        : [];

                    if (pageBoxes.length === 0) {
                        const [copiedPage] = await newPdf.copyPages(pdfLibDoc, [
                            i,
                        ]);
                        newPdf.addPage(copiedPage);
                        continue;
                    }

                    const page = await pdfDoc.getPage(i + 1);
                    const scale = 2;
                    const viewport = page.getViewport({ scale });

                    const tempCanvas = document.createElement("canvas");
                    tempCanvas.width = viewport.width;
                    tempCanvas.height = viewport.height;
                    const ctx = tempCanvas.getContext("2d")!;
                    await page.render({ canvasContext: ctx, viewport }).promise;

                    ctx.fillStyle = "black";
                    pageBoxes.forEach((box) => {
                        ctx.fillRect(
                            box.x * scale,
                            (pageViewports[i].height / actualScales[i] -
                                box.y -
                                box.h) *
                                scale,
                            box.w * scale,
                            box.h * scale,
                        );
                    });

                    const imgDataUrl = tempCanvas.toDataURL("image/jpeg", 0.95);
                    const image = await newPdf.embedJpg(imgDataUrl);
                    const imgPage = newPdf.addPage([
                        image.width / scale,
                        image.height / scale,
                    ]);
                    imgPage.drawImage(image, {
                        x: 0,
                        y: 0,
                        width: image.width / scale,
                        height: image.height / scale,
                    });
                }

                const pdfBytes = await newPdf.save();
                const blob = new Blob([pdfBytes as any], {
                    type: "application/pdf",
                });
                const url = URL.createObjectURL(blob);

                const a = document.createElement("a");
                a.href = url;
                a.download = `redacted-${currentPdfFile.name}`;
                a.click();
                URL.revokeObjectURL(url);
            } catch (err) {
                console.error(err);
                alert("An error occurred during redaction. Please try again.");
            } finally {
                applyBtn.textContent = "Apply Redactions & Download";
                applyBtn.disabled = false;
            }
        });
    </script>

    <script
        type="application/ld+json"
        set:html={JSON.stringify(webAppSchema)}
    />
    <script
        type="application/ld+json"
        set:html={JSON.stringify(breadcrumbSchema)}
    />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Layout>
