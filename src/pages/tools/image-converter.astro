---
import Layout from "../../layouts/Layout.astro";
---

<Layout
    title="Image Converter — Convert JPG, PNG & WebP Online Free"
    description="Convert JPG to PNG, PNG to WebP, WebP to JPG and more. Free online image converter with no signup, no upload, and no watermarks."
>
    <div class="max-w-3xl mx-auto">
        <header class="mb-8">
            <h1 class="text-3xl md:text-4xl font-bold mb-3">Image Converter</h1>
            <p class="text-gray-600 mb-2">
                Convert images between JPG, PNG, and WebP instantly. No upload,
                no signup, 100% private.
            </p>
            <p class="text-xs text-gray-500">
                Works entirely in your browser. Your images never leave your
                device.
            </p>
        </header>

        <!-- Upload Section -->
        <section class="bg-white p-6 rounded-xl border border-gray-200 mb-6">
            <div
                id="drop-zone"
                class="border-2 border-dashed border-gray-300 rounded-lg p-8 text-center hover:border-blue-400 transition cursor-pointer"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="48"
                    height="48"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="#2563eb"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="mx-auto mb-3"
                >
                    <polyline points="16 3 21 3 21 8"></polyline>
                    <line x1="4" y1="20" x2="21" y2="3"></line>
                    <polyline points="21 16 21 21 16 21"></polyline>
                    <line x1="15" y1="15" x2="21" y2="21"></line>
                    <line x1="4" y1="4" x2="9" y2="9"></line>
                </svg>
                <p class="font-medium mb-1">Drop your image here</p>
                <p class="text-sm text-gray-500">
                    or click to select (JPG, PNG, WebP)
                </p>
                <input
                    type="file"
                    id="file-input"
                    accept="image/jpeg,image/png,image/webp"
                    class="hidden"
                />
            </div>

            <!-- Convert Options -->
            <div id="options-section" class="mt-6 hidden">
                <div>
                    <label for="format" class="block text-sm font-medium mb-2"
                        >Convert to:</label
                    >
                    <select
                        id="format"
                        class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                    >
                        <option value="image/jpeg">JPG (JPEG)</option>
                        <option value="image/png">PNG</option>
                        <option value="image/webp">WebP</option>
                    </select>
                </div>

                <div id="quality-section" class="mt-4">
                    <label for="quality" class="block text-sm font-medium mb-2">
                        Quality: <span id="quality-value">90</span>%
                    </label>
                    <input
                        type="range"
                        id="quality"
                        min="10"
                        max="100"
                        value="90"
                        class="w-full"
                    />
                    <p class="text-xs text-gray-500 mt-1">
                        Lower quality = smaller file size (JPG/WebP only)
                    </p>
                </div>

                <button
                    id="convert-btn"
                    class="mt-6 px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium transition"
                >
                    Convert Image
                </button>
            </div>
        </section>

        <!-- Results -->
        <section id="results" class="hidden">
            <div class="bg-white p-6 rounded-xl border border-gray-200 mb-6">
                <h2 class="text-xl font-semibold mb-4">Conversion Result</h2>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                    <div class="bg-gray-50 p-4 rounded-lg text-center">
                        <div class="text-xs text-gray-500 mb-1">
                            Original Format
                        </div>
                        <div
                            id="original-format"
                            class="text-base font-bold text-gray-700"
                        >
                            —
                        </div>
                    </div>
                    <div class="bg-blue-50 p-4 rounded-lg text-center">
                        <div class="text-xs text-gray-500 mb-1">New Format</div>
                        <div
                            id="new-format"
                            class="text-base font-bold text-blue-600"
                        >
                            —
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                    <div>
                        <div class="flex items-center justify-between mb-2">
                            <p class="text-sm font-medium">Original</p>
                            <p id="original-size" class="text-xs text-gray-500">
                                —
                            </p>
                        </div>
                        <img
                            id="preview-original"
                            class="w-full rounded-lg border border-gray-200"
                            alt="Original"
                        />
                    </div>
                    <div>
                        <div class="flex items-center justify-between mb-2">
                            <p class="text-sm font-medium">Converted</p>
                            <p
                                id="new-size"
                                class="text-xs text-green-600 font-medium"
                            >
                                —
                            </p>
                        </div>
                        <img
                            id="preview-converted"
                            class="w-full rounded-lg border border-gray-200"
                            alt="Converted"
                        />
                    </div>
                </div>

                <div
                    id="size-saved"
                    class="hidden mb-6 p-3 rounded-lg text-center text-sm font-medium"
                >
                </div>

                <div class="flex flex-wrap gap-3">
                    <a
                        id="download-btn"
                        class="px-6 py-3 bg-green-600 text-white rounded-lg hover:bg-green-700 font-medium transition"
                        download
                    >
                        Download Converted Image
                    </a>
                    <button
                        id="reset-btn"
                        class="px-6 py-3 bg-gray-200 text-gray-800 rounded-lg hover:bg-gray-300 font-medium transition"
                    >
                        Convert Another Image
                    </button>
                </div>
            </div>
        </section>
    </div>

    <!-- SEO Content -->
    <section class="max-w-3xl mx-auto mt-16">
        <h2 class="text-2xl font-bold mb-4">About This Image Converter</h2>
        <p class="text-gray-700 mb-4">
            This free online image converter lets you change image formats
            between JPG, PNG, and WebP instantly. It runs entirely in your
            browser — your images never leave your device.
        </p>

        <h3 class="text-xl font-semibold mt-6 mb-3">How to Use</h3>
        <ol class="list-decimal pl-6 text-gray-700 space-y-2">
            <li>
                Drop your image into the box above, or click to select a file
            </li>
            <li>
                Choose the format you want to convert to (JPG, PNG, or WebP)
            </li>
            <li>Adjust quality if converting to JPG or WebP</li>
            <li>Click "Convert Image"</li>
            <li>Preview the result and download</li>
        </ol>

        <h3 class="text-xl font-semibold mt-6 mb-3">Features</h3>
        <ul class="list-disc pl-6 text-gray-700 space-y-2">
            <li>Converts between JPG, PNG, and WebP</li>
            <li>Adjustable quality for lossy formats</li>
            <li>Before/after preview with file sizes</li>
            <li>100% client-side — your images never leave your device</li>
            <li>No signup, no watermarks, completely free</li>
        </ul>

        <h3 class="text-xl font-semibold mt-6 mb-3">
            Frequently Asked Questions
        </h3>
        <div class="space-y-4 mt-3">
            <div>
                <h4 class="font-semibold text-gray-900">
                    Which format should I use?
                </h4>
                <p class="text-gray-700 mt-1">
                    Use JPG for photos (smaller file size), PNG for images with
                    transparency or text, and WebP for the best balance of
                    quality and size on modern browsers.
                </p>
            </div>
            <div>
                <h4 class="font-semibold text-gray-900">
                    Does converting affect image quality?
                </h4>
                <p class="text-gray-700 mt-1">
                    JPG and WebP are lossy formats — they discard some data to
                    reduce size. PNG is lossless. Use a high quality setting
                    (90%+) to preserve visual quality.
                </p>
            </div>
            <div>
                <h4 class="font-semibold text-gray-900">
                    Are my images uploaded to a server?
                </h4>
                <p class="text-gray-700 mt-1">
                    No. All conversion happens in your browser. Your images
                    never leave your device.
                </p>
            </div>
            <div>
                <h4 class="font-semibold text-gray-900">Is this tool free?</h4>
                <p class="text-gray-700 mt-1">
                    Yes, completely free with no signup, no limits, and no
                    watermarks.
                </p>
            </div>
        </div>
    </section>

    <script>
        const dropZone = document.getElementById("drop-zone") as HTMLDivElement;
        const fileInput = document.getElementById(
            "file-input",
        ) as HTMLInputElement;
        const optionsSection = document.getElementById("options-section")!;
        const formatSelect = document.getElementById(
            "format",
        ) as HTMLSelectElement;
        const qualitySection = document.getElementById("quality-section")!;
        const qualitySlider = document.getElementById(
            "quality",
        ) as HTMLInputElement;
        const qualityValue = document.getElementById("quality-value")!;
        const convertBtn = document.getElementById("convert-btn")!;
        const results = document.getElementById("results")!;
        const downloadBtn = document.getElementById(
            "download-btn",
        ) as HTMLAnchorElement;
        const resetBtn = document.getElementById("reset-btn")!;

        let selectedFile: File | null = null;
        let originalImage: HTMLImageElement | null = null;

        function formatBytes(bytes: number): string {
            if (bytes < 1024) return bytes + " B";
            if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + " KB";
            return (bytes / (1024 * 1024)).toFixed(2) + " MB";
        }

        function getFormatLabel(mime: string): string {
            if (mime.includes("jpeg")) return "JPG";
            if (mime.includes("png")) return "PNG";
            if (mime.includes("webp")) return "WebP";
            return mime;
        }

        function updateQualityVisibility() {
            const fmt = formatSelect.value;
            if (fmt === "image/png") {
                qualitySection.classList.add("hidden");
            } else {
                qualitySection.classList.remove("hidden");
            }
        }

        formatSelect.addEventListener("change", updateQualityVisibility);

        qualitySlider.addEventListener("input", () => {
            qualityValue.textContent = qualitySlider.value;
        });

        dropZone.addEventListener("click", () => fileInput.click());

        dropZone.addEventListener("dragover", (e) => {
            e.preventDefault();
            dropZone.classList.add("border-blue-500", "bg-blue-50");
        });

        dropZone.addEventListener("dragleave", () => {
            dropZone.classList.remove("border-blue-500", "bg-blue-50");
        });

        dropZone.addEventListener("drop", (e) => {
            e.preventDefault();
            dropZone.classList.remove("border-blue-500", "bg-blue-50");
            const files = (e as DragEvent).dataTransfer?.files;
            if (files && files.length > 0) handleFile(files[0]);
        });

        fileInput.addEventListener("change", () => {
            if (fileInput.files && fileInput.files.length > 0) {
                handleFile(fileInput.files[0]);
            }
        });

        function handleFile(file: File) {
            if (!file.type.startsWith("image/")) {
                alert("Please select an image file (JPG, PNG, or WebP).");
                return;
            }
            if (file.size > 20 * 1024 * 1024) {
                alert(
                    "File size too large. Please select an image under 20 MB.",
                );
                return;
            }
            selectedFile = file;
            const img = new Image();
            img.onload = () => {
                originalImage = img;
                optionsSection.classList.remove("hidden");
                updateQualityVisibility();
                dropZone.querySelector("p")!.textContent =
                    `Selected: ${file.name}`;
            };
            img.src = URL.createObjectURL(file);
        }

        convertBtn.addEventListener("click", () => {
            if (!selectedFile || !originalImage) return;

            const targetFormat = formatSelect.value;
            const quality = parseInt(qualitySlider.value) / 100;

            const canvas = document.createElement("canvas");
            canvas.width = originalImage.naturalWidth;
            canvas.height = originalImage.naturalHeight;
            const ctx = canvas.getContext("2d")!;

            // Fill white background for JPG (no transparency support)
            if (targetFormat === "image/jpeg") {
                ctx.fillStyle = "#ffffff";
                ctx.fillRect(0, 0, canvas.width, canvas.height);
            }

            ctx.drawImage(originalImage, 0, 0);

            canvas.toBlob(
                (blob) => {
                    if (!blob) return;
                    const convertedUrl = URL.createObjectURL(blob);

                    document.getElementById("original-format")!.textContent =
                        getFormatLabel(selectedFile!.type);
                    document.getElementById("new-format")!.textContent =
                        getFormatLabel(targetFormat);

                    document.getElementById("original-size")!.textContent =
                        formatBytes(selectedFile!.size);
                    document.getElementById("new-size")!.textContent =
                        formatBytes(blob.size);

                    const savedBox = document.getElementById("size-saved")!;
                    savedBox.classList.remove("hidden");
                    const diff = selectedFile!.size - blob.size;
                    if (diff >= 0) {
                        savedBox.textContent = `✓ File size reduced by ${formatBytes(diff)}`;
                        savedBox.className =
                            "mb-6 p-3 rounded-lg text-center text-sm font-medium bg-green-50 text-green-700 border border-green-200";
                    } else {
                        savedBox.textContent = `File size increased by ${formatBytes(Math.abs(diff))}`;
                        savedBox.className =
                            "mb-6 p-3 rounded-lg text-center text-sm font-medium bg-yellow-50 text-yellow-700 border border-yellow-200";
                    }

                    (
                        document.getElementById(
                            "preview-original",
                        ) as HTMLImageElement
                    ).src = URL.createObjectURL(selectedFile!);
                    (
                        document.getElementById(
                            "preview-converted",
                        ) as HTMLImageElement
                    ).src = convertedUrl;

                    const ext =
                        targetFormat === "image/jpeg"
                            ? "jpg"
                            : targetFormat.split("/")[1];
                    const baseName = selectedFile!.name.replace(/\.[^.]+$/, "");
                    downloadBtn.href = convertedUrl;
                    downloadBtn.download = `${baseName}.${ext}`;

                    results.classList.remove("hidden");
                    results.scrollIntoView({ behavior: "smooth" });
                },
                targetFormat,
                quality,
            );
        });

        resetBtn.addEventListener("click", () => {
            selectedFile = null;
            originalImage = null;
            fileInput.value = "";
            results.classList.add("hidden");
            optionsSection.classList.add("hidden");
            dropZone.querySelector("p")!.textContent = "Drop your image here";
        });
    </script>
</Layout>
