---
import Layout from "../../layouts/Layout.astro";
---

<Layout
    title="Percentage Calculator — Solve Percentage Problems Free"
    description="Free online percentage calculator by ToolsVibe. Instantly solve X% of Y, calculate percentage increases or decreases, final discount prices, and markups."
>
    <div class="max-w-3xl mx-auto">
        <header class="mb-8">
            <h1 class="text-3xl md:text-4xl font-bold mb-3">
                Multi-Purpose Percentage Calculator
            </h1>
            <p class="text-gray-600 mb-2">
                Solve any percentage problem instantly: find X% of Y, calculate
                percentage changes, markups, retail discounts, and more.
            </p>
            <p class="text-xs text-gray-500">
                ⚡ Instant Results: Calculations update in real-time as you
                type, completely in your browser.
            </p>
        </header>

        <!-- Calculator 1: X% of Y -->
        <section class="bg-white p-6 rounded-xl border border-gray-200 mb-4">
            <h2 class="text-lg font-semibold mb-4">What is X% of Y?</h2>
            <div class="flex flex-wrap items-center gap-3">
                <span class="text-gray-700">What is</span>
                <input
                    type="number"
                    id="c1-x"
                    value="15"
                    class="w-24 p-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                />
                <span class="text-gray-700">% of</span>
                <input
                    type="number"
                    id="c1-y"
                    value="200"
                    class="w-32 p-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                />
                <span class="text-gray-700">?</span>
            </div>
            <div class="mt-4 p-4 bg-blue-50 border border-blue-200 rounded-lg">
                <p class="text-sm text-gray-600 mb-1">Result</p>
                <p id="c1-result" class="text-2xl font-bold text-blue-700">
                    30
                </p>
            </div>
        </section>

        <!-- Calculator 2: X is what % of Y -->
        <section class="bg-white p-6 rounded-xl border border-gray-200 mb-4">
            <h2 class="text-lg font-semibold mb-4">X is what percent of Y?</h2>
            <div class="flex flex-wrap items-center gap-3">
                <input
                    type="number"
                    id="c2-x"
                    value="30"
                    class="w-32 p-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                />
                <span class="text-gray-700">is what percent of</span>
                <input
                    type="number"
                    id="c2-y"
                    value="200"
                    class="w-32 p-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                />
                <span class="text-gray-700">?</span>
            </div>
            <div class="mt-4 p-4 bg-blue-50 border border-blue-200 rounded-lg">
                <p class="text-sm text-gray-600 mb-1">Result</p>
                <p id="c2-result" class="text-2xl font-bold text-blue-700">
                    15%
                </p>
            </div>
        </section>

        <!-- Calculator 3: Percentage Increase/Decrease -->
        <section class="bg-white p-6 rounded-xl border border-gray-200 mb-4">
            <h2 class="text-lg font-semibold mb-4">
                Percentage Increase / Decrease
            </h2>
            <div class="flex flex-wrap items-center gap-3">
                <span class="text-gray-700">From</span>
                <input
                    type="number"
                    id="c3-from"
                    value="100"
                    class="w-32 p-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                />
                <span class="text-gray-700">to</span>
                <input
                    type="number"
                    id="c3-to"
                    value="150"
                    class="w-32 p-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                />
            </div>
            <div class="mt-4 p-4 bg-blue-50 border border-blue-200 rounded-lg">
                <p class="text-sm text-gray-600 mb-1">Change</p>
                <p id="c3-result" class="text-2xl font-bold text-blue-700">
                    +50%
                </p>
            </div>
        </section>

        <!-- Calculator 4: Discount -->
        <section class="bg-white p-6 rounded-xl border border-gray-200 mb-4">
            <h2 class="text-lg font-semibold mb-4">Discount Calculator</h2>
            <div class="flex flex-wrap items-center gap-3">
                <span class="text-gray-700">Original price</span>
                <input
                    type="number"
                    id="c4-price"
                    value="1000"
                    class="w-32 p-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                />
                <span class="text-gray-700">with</span>
                <input
                    type="number"
                    id="c4-discount"
                    value="20"
                    class="w-24 p-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                />
                <span class="text-gray-700">% off</span>
            </div>
            <div class="mt-4 grid grid-cols-2 gap-3">
                <div class="p-4 bg-green-50 border border-green-200 rounded-lg">
                    <p class="text-sm text-gray-600 mb-1">Final Price</p>
                    <p id="c4-final" class="text-xl font-bold text-green-700">
                        800
                    </p>
                </div>
                <div class="p-4 bg-red-50 border border-red-200 rounded-lg">
                    <p class="text-sm text-gray-600 mb-1">You Save</p>
                    <p id="c4-saved" class="text-xl font-bold text-red-700">
                        200
                    </p>
                </div>
            </div>
        </section>
    </div>

    <!-- SEO Content (800+ words) -->
    <section class="max-w-3xl mx-auto mt-16">
        <h2 class="text-2xl font-bold mb-4">
            About This Percentage Calculator
        </h2>
        <p class="text-gray-700 mb-4">
            This free percentage calculator handles the four most common
            percentage problems: finding X% of Y, calculating what percent X is
            of Y, percentage increase/decrease, and discount calculations. All
            results update instantly as you type. It runs entirely in your
            browser — no data is sent anywhere.
        </p>
        <p class="text-gray-700 mb-4">
            Percentages show up everywhere: shopping discounts, tax
            calculations, tip amounts, grade scores, interest rates, and
            business growth. This tool gives you a single page to solve every
            percentage problem you'll encounter.
        </p>

        <h3 class="text-xl font-semibold mt-6 mb-3">The Four Calculators</h3>
        <ul class="list-disc pl-6 text-gray-700 space-y-2">
            <li><strong>What is X% of Y:</strong> Find 15% of 200 = 30</li>
            <li>
                <strong>X is what % of Y:</strong> 30 is what percent of 200 = 15%
            </li>
            <li>
                <strong>Percentage Change:</strong> From 100 to 150 = +50% increase
            </li>
            <li>
                <strong>Discount:</strong> 20% off 1000 = 800 (you save 200)
            </li>
        </ul>

        <h3 class="text-xl font-semibold mt-6 mb-3">
            Common Percentage Formulas
        </h3>
        <ul class="list-disc pl-6 text-gray-700 space-y-2">
            <li>X% of Y = (X ÷ 100) × Y</li>
            <li>X is what % of Y = (X ÷ Y) × 100</li>
            <li>Percentage change = ((New − Old) ÷ Old) × 100</li>
            <li>Final price = Original × (1 − Discount ÷ 100)</li>
        </ul>

        <h3 class="text-xl font-semibold mt-6 mb-3">How to Use</h3>
        <ol class="list-decimal pl-6 text-gray-700 space-y-2">
            <li>Pick the calculator that matches your problem</li>
            <li>Enter the numbers in the fields</li>
            <li>Results update automatically as you type</li>
            <li>No button needed — instant answers</li>
        </ol>

        <h3 class="text-xl font-semibold mt-6 mb-3">Common Use Cases</h3>

        <h4 class="font-semibold mt-4 mb-2">1. Shopping Discounts</h4>
        <p class="text-gray-700 mb-4">
            A jacket is PKR 5,000 with 30% off. What's the final price? The
            Discount Calculator shows 3,500 — you save 1,500. Works for every
            sale, coupon, and promotion.
        </p>

        <h4 class="font-semibold mt-4 mb-2">2. Tax Calculations</h4>
        <p class="text-gray-700 mb-4">
            If sales tax is 17%, what's the tax on a PKR 10,000 purchase? Use
            the "X% of Y" calculator: 17% of 10,000 = 1,700.
        </p>

        <h4 class="font-semibold mt-4 mb-2">3. Grade and Exam Scores</h4>
        <p class="text-gray-700 mb-4">
            You scored 87 out of 100 — what percentage is that? Use "X is what %
            of Y": 87 ÷ 100 × 100 = 87%. Works for any score-to-percentage
            conversion.
        </p>

        <h4 class="font-semibold mt-4 mb-2">4. Business Growth Analysis</h4>
        <p class="text-gray-700 mb-4">
            Revenue grew from PKR 500,000 to PKR 750,000 — what's the growth
            rate? Use the Percentage Change calculator: ((750,000 − 500,000) ÷
            500,000) × 100 = 50% growth.
        </p>

        <h4 class="font-semibold mt-4 mb-2">5. Tip Calculations</h4>
        <p class="text-gray-700 mb-4">
            If a restaurant bill is PKR 2,500 and you want to tip 15%, use "X%
            of Y": 15% of 2,500 = 375. Total to pay: 2,875.
        </p>

        <h4 class="font-semibold mt-4 mb-2">
            6. Interest and Investment Returns
        </h4>
        <p class="text-gray-700 mb-4">
            An investment grew from PKR 100,000 to PKR 125,000. The Percentage
            Change calculator shows a +25% return. The same formula works for
            loss percentages.
        </p>

        <h4 class="font-semibold mt-4 mb-2">7. Price Comparison</h4>
        <p class="text-gray-700 mb-4">
            One shop sells at PKR 1,200 with 15% off, another at PKR 1,100 with
            10% off. Use the Discount Calculator for both, then compare the
            final prices. This makes it easy to spot which deal is actually
            better.
        </p>

        <h4 class="font-semibold mt-4 mb-2">8. Sales Commission</h4>
        <p class="text-gray-700 mb-4">
            A salesperson earns 3% commission on a PKR 800,000 sale. Use "X% of
            Y": 3% of 800,000 = 24,000. Works for any commission structure.
        </p>

        <h3 class="text-xl font-semibold mt-6 mb-3">A Worked Example</h3>
        <p class="text-gray-700 mb-4">
            Here's what happens across the four calculators with a real
            scenario:
        </p>
        <ul class="list-disc pl-6 text-gray-700 space-y-2">
            <li>
                <strong>Sale price:</strong> A PKR 4,000 item is 25% off — final price
                3,000, savings 1,000
            </li>
            <li><strong>Tax on the sale:</strong> 17% tax on 3,000 = 510</li>
            <li><strong>Total to pay:</strong> 3,000 + 510 = 3,510</li>
            <li>
                <strong>Comparison:</strong> You saved 1,000 vs the original price
                — a 25% saving
            </li>
        </ul>
        <p class="text-gray-700 mt-4 mb-4">
            That's how a real shopping scenario uses all four percentage
            operations in one flow.
        </p>

        <h3 class="text-xl font-semibold mt-6 mb-3">
            Frequently Asked Questions
        </h3>
        <div class="space-y-4 mt-3">
            <div>
                <h4 class="font-semibold text-gray-900">
                    What's the difference between percentage and percent?
                </h4>
                <p class="text-gray-700 mt-1">
                    They mean the same thing. "Percent" (per cent) literally
                    means "per hundred." "Percentage" is the noun form — e.g.
                    "calculate the percentage."
                </p>
            </div>
            <div>
                <h4 class="font-semibold text-gray-900">
                    How do I calculate percentage increase?
                </h4>
                <p class="text-gray-700 mt-1">
                    Subtract the original value from the new value, divide by
                    the original value, then multiply by 100. Example: 100 → 150
                    gives (50 ÷ 100) × 100 = 50% increase.
                </p>
            </div>
            <div>
                <h4 class="font-semibold text-gray-900">
                    How do I calculate percentage decrease?
                </h4>
                <p class="text-gray-700 mt-1">
                    The same formula works. If the new value is lower, the
                    result is negative. Example: 150 → 100 gives (−50 ÷ 150) ×
                    100 = −33.33% decrease.
                </p>
            </div>
            <div>
                <h4 class="font-semibold text-gray-900">
                    What's the difference between percentage change and
                    percentage points?
                </h4>
                <p class="text-gray-700 mt-1">
                    Percentage points measure the simple difference between two
                    percentages (5% to 8% is a 3 percentage point increase).
                    Percentage change measures the relative difference ((8 − 5)
                    ÷ 5 × 100 = 60% change).
                </p>
            </div>
            <div>
                <h4 class="font-semibold text-gray-900">
                    Can I calculate discounts on multiple items?
                </h4>
                <p class="text-gray-700 mt-1">
                    Yes. Use the Discount Calculator once per item. For a cart
                    with several discounted items, calculate each final price,
                    then add them together.
                </p>
            </div>
            <div>
                <h4 class="font-semibold text-gray-900">Is this tool free?</h4>
                <p class="text-gray-700 mt-1">
                    Yes, completely free with no signup, no limits, and no
                    watermarks.
                </p>
            </div>
        </div>
    </section>

    <!-- Related Tools -->
    <section class="max-w-3xl mx-auto mt-16">
        <h2 class="text-2xl font-bold mb-6">Related Tools</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <a
                href="/tools/emi-calculator/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-semibold mb-1">EMI Calculator</h3>
                <p class="text-sm text-gray-600">
                    Calculate loan EMI and total interest.
                </p>
            </a>
            <a
                href="/tools/unit-converter/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-semibold mb-1">Unit Converter</h3>
                <p class="text-sm text-gray-600">
                    Convert length, weight, and temperature.
                </p>
            </a>
            <a
                href="/tools/age-calculator/"
                class="block p-4 bg-white rounded-xl border border-gray-200 hover:shadow-md hover:border-blue-300 transition"
            >
                <h3 class="font-semibold mb-1">Age Calculator</h3>
                <p class="text-sm text-gray-600">
                    Find your exact age in years, months, and days.
                </p>
            </a>
        </div>
    </section>

    <script>
        const c1x = document.getElementById("c1-x") as HTMLInputElement;
        const c1y = document.getElementById("c1-y") as HTMLInputElement;
        const c1Result = document.getElementById("c1-result")!;

        const c2x = document.getElementById("c2-x") as HTMLInputElement;
        const c2y = document.getElementById("c2-y") as HTMLInputElement;
        const c2Result = document.getElementById("c2-result")!;

        const c3From = document.getElementById("c3-from") as HTMLInputElement;
        const c3To = document.getElementById("c3-to") as HTMLInputElement;
        const c3Result = document.getElementById("c3-result")!;

        const c4Price = document.getElementById("c4-price") as HTMLInputElement;
        const c4Discount = document.getElementById(
            "c4-discount",
        ) as HTMLInputElement;
        const c4Final = document.getElementById("c4-final")!;
        const c4Saved = document.getElementById("c4-saved")!;

        function format(num: number): string {
            if (!isFinite(num)) return "—";
            return num.toLocaleString("en-US", { maximumFractionDigits: 4 });
        }

        function calc1() {
            const x = parseFloat(c1x.value) || 0;
            const y = parseFloat(c1y.value) || 0;
            c1Result.textContent = format((x / 100) * y);
        }

        function calc2() {
            const x = parseFloat(c2x.value) || 0;
            const y = parseFloat(c2y.value) || 0;
            if (y === 0) {
                c2Result.textContent = "—";
                return;
            }
            c2Result.textContent = format((x / y) * 100) + "%";
        }

        function calc3() {
            const from = parseFloat(c3From.value) || 0;
            const to = parseFloat(c3To.value) || 0;
            if (from === 0) {
                c3Result.textContent = "—";
                return;
            }
            const change = ((to - from) / from) * 100;
            const sign = change > 0 ? "+" : "";
            c3Result.textContent = sign + format(change) + "%";
            c3Result.className =
                "text-2xl font-bold " +
                (change >= 0 ? "text-green-600" : "text-red-600");
        }

        function calc4() {
            const price = parseFloat(c4Price.value) || 0;
            const discount = parseFloat(c4Discount.value) || 0;
            const saved = (price * discount) / 100;
            const final = price - saved;
            c4Final.textContent = format(final);
            c4Saved.textContent = format(saved);
        }

        [c1x, c1y].forEach((el) => el.addEventListener("input", calc1));
        [c2x, c2y].forEach((el) => el.addEventListener("input", calc2));
        [c3From, c3To].forEach((el) => el.addEventListener("input", calc3));
        [c4Price, c4Discount].forEach((el) =>
            el.addEventListener("input", calc4),
        );

        calc1();
        calc2();
        calc3();
        calc4();
    </script>

    <script
        type="application/ld+json"
        set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "SoftwareApplication",
            name: "Percentage Calculator",
            applicationCategory: "UtilityApplication",
            operatingSystem: "Any",
            description:
                "Free online percentage calculator. Solve X% of Y, percentage change, discounts, and more.",
            offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
        })}
    />

    <script
        type="application/ld+json"
        set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "FAQPage",
            mainEntity: [
                {
                    "@type": "Question",
                    name: "What's the difference between percentage and percent?",
                    acceptedAnswer: {
                        "@type": "Answer",
                        text: "They mean the same thing. Percent (per cent) literally means per hundred. Percentage is the noun form — e.g. calculate the percentage.",
                    },
                },
                {
                    "@type": "Question",
                    name: "How do I calculate percentage increase?",
                    acceptedAnswer: {
                        "@type": "Answer",
                        text: "Subtract the original value from the new value, divide by the original value, then multiply by 100. Example: 100 to 150 gives (50 divided by 100) times 100 = 50% increase.",
                    },
                },
                {
                    "@type": "Question",
                    name: "Is this tool free?",
                    acceptedAnswer: {
                        "@type": "Answer",
                        text: "Yes, completely free with no signup, no limits, and no watermarks.",
                    },
                },
            ],
        })}
    />
</Layout>
