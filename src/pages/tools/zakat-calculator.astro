    <script>
        const cfg = document.getElementById("calc-config")!;
        const SILVER_NISAB_GRAMS = parseFloat(cfg.dataset.silverNisab!);
        const GOLD_NISAB_GRAMS = parseFloat(cfg.dataset.goldNisab!);

        const cashInput = document.getElementById("cash") as HTMLInputElement;
        const goldInput = document.getElementById("gold") as HTMLInputElement;
        const goldPriceInput = document.getElementById(
            "gold-price",
        ) as HTMLInputElement;
        const silverInput = document.getElementById(
            "silver",
        ) as HTMLInputElement;
        const silverPriceInput = document.getElementById(
            "silver-price",
        ) as HTMLInputElement;
        const investmentsInput = document.getElementById(
            "investments",
        ) as HTMLInputElement;
        const businessInput = document.getElementById(
            "business",
        ) as HTMLInputElement;
        const receivablesInput = document.getElementById(
            "receivables",
        ) as HTMLInputElement;
        const debtsInput = document.getElementById("debts") as HTMLInputElement;
        const calculateBtn = document.getElementById("calculate-btn")!;
        const results = document.getElementById("results")!;
        const errorBox = document.getElementById("error")!;
        const nisabRadios = document.querySelectorAll<HTMLInputElement>(
            'input[name="nisab-type"]',
        );

        function formatPKR(num: number): string {
            return "PKR " + Math.round(num).toLocaleString("en-US");
        }

        // Empty, invalid or negative values count as 0
        function num(el: HTMLInputElement): number {
            const v = parseFloat(el.value);
            return Number.isFinite(v) && v > 0 ? v : 0;
        }

        function getSelectedNisab(): "gold" | "silver" {
            for (const radio of nisabRadios) {
                if (radio.checked) return radio.value as "gold" | "silver";
            }
            return "silver";
        }

        // Returns true when the inputs were valid and the results were updated.
        // With showErrors = false (live typing) invalid input is ignored and
        // the previous results stay on screen.
        function calculate(showErrors: boolean): boolean {
            const cash = num(cashInput);
            const goldGrams = num(goldInput);
            const goldPrice = num(goldPriceInput);
            const silverGrams = num(silverInput);
            const silverPrice = num(silverPriceInput);
            const investments = num(investmentsInput);
            const business = num(businessInput);
            const receivables = num(receivablesInput);
            const debts = num(debtsInput);

            const nisabType = getSelectedNisab();
            const nisabPrice = nisabType === "gold" ? goldPrice : silverPrice;

            let message = "";
            if (!(nisabPrice > 0)) {
                message = `Enter today's ${nisabType} price per gram so the Nisab can be worked out.`;
            } else if (goldGrams > 0 && !(goldPrice > 0)) {
                message = "Enter the gold price per gram.";
            } else if (silverGrams > 0 && !(silverPrice > 0)) {
                message = "Enter the silver price per gram.";
            }
            if (message) {
                if (showErrors) {
                    errorBox.textContent = message;
                    errorBox.classList.remove("hidden");
                }
                return false;
            }
            errorBox.classList.add("hidden");

            const goldValue = goldGrams * goldPrice;
            const silverValue = silverGrams * silverPrice;

            const totalAssets =
                cash +
                goldValue +
                silverValue +
                investments +
                business +
                receivables;
            const netWealth = Math.max(0, totalAssets - debts);

            const nisabThreshold =
                (nisabType === "gold" ? GOLD_NISAB_GRAMS : SILVER_NISAB_GRAMS) *
                nisabPrice;

            const isZakatable = netWealth >= nisabThreshold;
            const zakat = isZakatable ? netWealth * 0.025 : 0;

            // Update results
            document.getElementById("zakat-result")!.textContent =
                formatPKR(zakat);
            const statusEl = document.getElementById("zakat-status")!;
            if (isZakatable) {
                statusEl.textContent =
                    "✓ Your net wealth is at or above the Nisab — Zakat is obligatory once a full lunar year has passed.";
                statusEl.className = "text-sm text-green-700 mt-2 font-medium";
            } else {
                statusEl.textContent =
                    "ℹ Your net wealth is below the Nisab — Zakat is not obligatory.";
                statusEl.className = "text-sm text-gray-600 mt-2";
            }

            // Breakdown
            document.getElementById("breakdown-cash")!.textContent =
                formatPKR(cash);
            document.getElementById("breakdown-gold")!.textContent =
                formatPKR(goldValue);
            document.getElementById("breakdown-silver")!.textContent =
                formatPKR(silverValue);
            document.getElementById("breakdown-investments")!.textContent =
                formatPKR(investments);
            document.getElementById("breakdown-business")!.textContent =
                formatPKR(business);
            document.getElementById("breakdown-receivables")!.textContent =
                formatPKR(receivables);
            document.getElementById("breakdown-total-assets")!.textContent =
                formatPKR(totalAssets);
            document.getElementById("breakdown-debts")!.textContent =
                formatPKR(debts);
            document.getElementById("breakdown-net")!.textContent =
                formatPKR(netWealth);
            document.getElementById("breakdown-nisab")!.textContent =
                formatPKR(nisabThreshold);
            document.getElementById("breakdown-zakat")!.textContent =
                formatPKR(zakat);

            results.classList.remove("hidden");
            return true;
        }

        // Live updates while the person changes any value.
        [
            cashInput,
            goldInput,
            goldPriceInput,
            silverInput,
            silverPriceInput,
            investmentsInput,
            businessInput,
            receivablesInput,
            debtsInput,
        ].forEach((el) => el.addEventListener("input", () => calculate(false)));
        nisabRadios.forEach((radio) =>
            radio.addEventListener("change", () => calculate(false)),
        );

        calculateBtn.addEventListener("click", () => {
            if (calculate(true)) {
                results.scrollIntoView({ behavior: "smooth" });
            }
        });

        calculate(false);
    </script>

