---
import Layout from "../../layouts/Layout.astro";

const pageUrl = new URL(Astro.url.pathname, "https://toolsvibe.online").href;

// ---------------------------------------------------------------------------
// EDIT THIS BLOCK when you re-check the figures (gold and silver move daily,
// so refresh the example prices every month or so).
// ---------------------------------------------------------------------------
const PRICES_DATE = "October 17, 2026";
const DEFAULT_GOLD_PRICE = 37800; // PKR per gram, 24K gold
const DEFAULT_SILVER_PRICE = 536; // PKR per gram, silver
const GOVT_NISAB = 503529; // PKR, Nisab the government notified for bank Zakat deduction
const GOVT_NISAB_YEAR = "2026";
// ---------------------------------------------------------------------------

const SILVER_NISAB_GRAMS = 612.36; // 52.5 tola
const GOLD_NISAB_GRAMS = 87.48; // 7.5 tola

const pkr = (n: number) => "PKR " + Math.round(n).toLocaleString("en-US");

// The worked example uses the same maths as the calculator and the example
// prices above, so it can never go out of step with them.
const ex = { cash: 800000, goldGrams: 50, investments: 200000, debts: 100000 };
const exGoldValue = ex.goldGrams * DEFAULT_GOLD_PRICE;
const exTotalAssets = ex.cash + exGoldValue + ex.investments;
const exNetWealth = exTotalAssets - ex.debts;
const exNisab = SILVER_NISAB_GRAMS * DEFAULT_SILVER_PRICE;
const exZakat = exNetWealth >= exNisab ? exNetWealth * 0.025 : 0;

// One source of truth: shown on the page AND used for the FAQ schema,
// so the visible text and the structured data always match.
const faqs = [
    {
        q: "What is the rate of Zakat?",
        a: "Zakat is 2.5% (one-fortieth) of your net qualifying wealth, once that wealth has stayed at or above the Nisab for one lunar year.",
    },
    {
        q: "Should I use gold or silver Nisab?",
        a: "In Pakistan the silver Nisab is the usual default, following the Hanafi view, and the government also sets its bank-deduction Nisab from the silver price. Some scholars use the gold Nisab instead. Choose the one your scholar recommends.",
    },
    {
        q: "Do I pay Zakat on my house or car?",
        a: "No. Personal-use items like your primary home, personal vehicle, and household furniture are not Zakatable.",
    },
    {
        q: "Is gold jewelry Zakatable?",
        a: "In the Hanafi school, which many people in Pakistan follow, Zakat is due on gold and silver jewelry that you own. Other schools differ for jewelry that is worn regularly. Ask your scholar if you are unsure.",
    },
    {
        q: "What if I don't know current gold or silver prices?",
        a: "Enter today's market price per gram. One tola is 11.664 grams, so divide a price per tola by 11.664 to get the price per gram. Use the 24K rate for pure gold, or ask your jeweller for the rate that matches your jewelry.",
    },
    {
        q: "Which debts can I deduct?",
        a: "Debts that are due now, such as bills and instalments you owe, are generally deducted from your wealth before Zakat is calculated. Scholars differ on long-term loans such as a home mortgage, so ask your scholar.",
    },
    {
        q: "Why does my bank deduct Zakat in Ramadan?",
        a: `Under the Zakat and Ushr Ordinance 1980, banks deduct 2.5% Zakat at source from eligible accounts on the first day of Ramadan when the balance is at or above the Nisab the government notifies each year (Rs ${GOVT_NISAB.toLocaleString("en-US")} for ${GOVT_NISAB_YEAR}). Account holders who have submitted the required declaration are exempt, and current accounts are generally not included. This calculator is for your own Zakat, so ask a scholar how to treat any amount your bank has already deducted.`,
    },
    {
        q: "Does Zakat apply to all my wealth?",
        a: "Zakat applies only to specific categories: cash, gold, silver, investments, business inventory, and receivables. Personal items like your home, car, and clothing are excluded.",
    },
    {
        q: "Is my data safe?",
        a: "Yes. All calculations happen in your browser. Your financial information is never sent to any server.",
    },
];

const webAppSchema = {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Zakat Calculator Pakistan",
    url: pageUrl,
    applicationCategory: "FinanceApplication",
    operatingSystem: "Any",
    browserRequirements: "Requires JavaScript",
    isAccessibleForFree: true,
    description:
        "Free Zakat calculator for Pakistan. Calculate Zakat on cash, gold, silver, investments, business inventory and receivables against the silver or gold Nisab.",
    offers: { "@type": "Offer", price: "0", priceCurrency: "PKR" },
};

const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
};

const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item: "https://toolsvibe.online/",
        },
        {
            "@type": "ListItem",
            position: 2,
            name: "Tools",
            item: "https://toolsvibe.online/tools/",
        },
        {
            "@type": "ListItem",
            position: 3,
            name: "Zakat Calculator",
            item: pageUrl,
        },
    ],
};
---

<Layout
    title="Zakat Calculator Pakistan: Gold, Silver, Cash & Nisab"
    description="Free Zakat calculator for Pakistan. Enter cash, gold, silver, shares and business assets to see your Zakat at 2.5% against the silver or gold Nisab."
>
    <div class="max-w-3xl mx-auto">
        <header class="mb-8">
            <nav aria-label="Breadcrumb" class="text-xs text-gray-500 mb-4">
                <a href="/" class="hover:underline">Home</a>
                <span aria-hidden="true">/</span>
                <a href="/tools/" class="hover:underline">Tools</a>
                <span aria-hidden="true">/</span>
                <span>Zakat Calculator</span>
            </nav>
            <h1 class="text-3xl md:text-4xl font-bold mb-3">
                Zakat Calculator Pakistan
            </h1>
            <p class="text-gray-600 mb-2">
                Calculate your annual Zakat on cash, gold, silver, savings, and
                investments.
            </p>
            <p class="text-xs text-gray-500">
                Works entirely in your browser. Your financial data never leaves
                your device.
            </p>
        </header>

        <!-- Values the calculator script reads (same constants as the page text) -->
        <div
            id="calc-config"
            data-silver-nisab={SILVER_NISAB_GRAMS}
            data-gold-nisab={GOLD_NISAB_GRAMS}
            hidden
        >
        </div>

        <!-- Nisab Info -->
        <section class="bg-blue-50 border border-blue-200 p-4 rounded-xl mb-6">
            <h2 class="font-semibold mb-2">Nisab Threshold</h2>
            <p class="text-sm text-gray-700 mb-3">
                Nisab is the minimum amount of wealth upon which Zakat becomes
                obligatory. Choose the Nisab basis:
            </p>
            <div class="flex flex-wrap gap-3">
                <label
                    class="flex items-center gap-2 text-sm p-2 bg-white rounded-lg cursor-pointer border border-gray-200"
                >
                    <input
                        type="radio"
                        name="nisab-type"
                        value="silver"
                        checked
                    />
                    <span><strong>Silver Nisab:</strong> 612.36g silver</span>
                </label>
                <label
                    class="flex items-center gap-2 text-sm p-2 bg-white rounded-lg cursor-pointer border border-gray-200"
                >
                    <input type="radio" name="nisab-type" value="gold" />
                    <span><strong>Gold Nisab:</strong> 87.48g gold</span>
                </label>
            </div>
            <p class="text-xs text-gray-600 mt-3">
                For reference, the government's Nisab for Zakat deducted from
                bank accounts is Rs {GOVT_NISAB.toLocaleString("en-US")} for {
                    GOVT_NISAB_YEAR
                }. It is fixed once a year, so it can differ from the Nisab
                worked out from today's price below.
            </p>
        </section>

        <!-- Assets Input -->
        <section class="bg-white p-6 rounded-xl border border-gray-200 mb-6">
            <h2 class="text-lg font-semibold mb-4">Your Assets</h2>

            <div class="space-y-5">
                <!-- Cash & Bank -->
                <div>
                    <label for="cash" class="block text-sm font-medium mb-2">
                        Cash in hand & bank accounts (PKR)
                    </label>
                    <input
                        type="number"
                        id="cash"
                        value="0"
                        min="0"
                        class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                    />
                </div>

                <!-- Gold -->
                <div>
                    <label for="gold" class="block text-sm font-medium mb-2">
                        Gold (grams)
                    </label>
                    <input
                        type="number"
                        id="gold"
                        value="0"
                        min="0"
                        step="0.1"
                        class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                    />
                    <p class="text-xs text-gray-500 mt-1">
                        Have it in tola? 1 tola = 11.664 grams.
                    </p>
                    <div class="mt-2">
                        <label
                            for="gold-price"
                            class="block text-xs text-gray-500 mb-1"
                            >Gold price per gram (PKR)</label
                        >
                        <input
                            type="number"
                            id="gold-price"
                            value={DEFAULT_GOLD_PRICE}
                            min="0"
                            class="w-full p-2 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                        />
                        <p class="text-xs text-gray-500 mt-1">
                            Example price from {PRICES_DATE}. Please enter
                            today's rate.
                        </p>
                    </div>
                    <div
                        class="mt-2 p-3 bg-yellow-50 border border-yellow-200 rounded-lg"
                    >
                        <p class="text-xs text-gray-700">
                            <strong>Tip:</strong> To check the current price of gold
                            please visit:{" "}
                            <a
                                href="https://gold.pk/"
                                target="_blank"
                                rel="noopener"
                                class="text-blue-600 hover:underline font-medium"
                            >
                                gold.pk
                            </a>{" "}
                            (24K gold per gram).
                        </p>
                    </div>
                </div>

                <!-- Silver -->
                <div>
                    <label for="silver" class="block text-sm font-medium mb-2">
                        Silver (grams)
                    </label>
                    <input
                        type="number"
                        id="silver"
                        value="0"
                        min="0"
                        step="0.1"
                        class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                    />
                    <div class="mt-2">
                        <label
                            for="silver-price"
                            class="block text-xs text-gray-500 mb-1"
                            >Silver price per gram (PKR)</label
                        >
                        <input
                            type="number"
                            id="silver-price"
                            value={DEFAULT_SILVER_PRICE}
                            min="0"
                            class="w-full p-2 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                        />
                        <p class="text-xs text-gray-500 mt-1">
                            Example price from {PRICES_DATE}. Please enter
                            today's rate.
                        </p>
                    </div>
                    <div
                        class="mt-2 p-3 bg-yellow-50 border border-yellow-200 rounded-lg"
                    >
                        <p class="text-xs text-gray-700">
                            <strong>Tip:</strong> To check the current price of silver
                            please visit:{" "}
                            <a
                                href="https://forex.pk/bullion.php?base=PKR&curr=XAG&type=grams"
                                target="_blank"
                                rel="noopener"
                                class="text-blue-600 hover:underline font-medium"
                            >
                                forex.pk
                            </a>{" "}
                            (silver per gram).
                        </p>
                    </div>
                </div>

                <!-- Investments -->
                <div>
                    <label
                        for="investments"
                        class="block text-sm font-medium mb-2"
                    >
                        Investments, shares, mutual funds (PKR)
                    </label>
                    <input
                        type="number"
                        id="investments"
                        value="0"
                        min="0"
                        class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                    />
                </div>

                <!-- Business Inventory -->
                <div>
                    <label
                        for="business"
                        class="block text-sm font-medium mb-2"
                    >
                        Business inventory / stock value (PKR)
                    </label>
                    <input
                        type="number"
                        id="business"
                        value="0"
                        min="0"
                        class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                    />
                </div>

                <!-- Receivables -->
                <div>
                    <label
                        for="receivables"
                        class="block text-sm font-medium mb-2"
                    >
                        Money owed to you (PKR)
                    </label>
                    <input
                        type="number"
                        id="receivables"
                        value="0"
                        min="0"
                        class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                    />
                </div>
            </div>

            <!-- Liabilities -->
            <h2 class="text-lg font-semibold mt-6 mb-4">
                Your Liabilities (Deductible Debts)
            </h2>
            <div>
                <label for="debts" class="block text-sm font-medium mb-2">
                    Debts & immediate liabilities (PKR)
                </label>
                <input
                    type="number"
                    id="debts"
                    value="0"
                    min="0"
                    class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                />
                <p class="text-xs text-gray-500 mt-1">
                    Enter debts that are due now. Ask your scholar about
                    long-term loans.
                </p>
            </div>

            <p id="error" role="alert" class="hidden mt-4 text-sm text-red-600">
            </p>

            <button
                id="calculate-btn"
                class="w-full mt-6 px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium transition"
            >
                Calculate Zakat
            </button>
        </section>

        <!-- Results -->
        <section id="results" class="hidden" aria-live="polite">
            <div
                class="bg-green-50 border border-green-200 p-6 rounded-xl mb-6 text-center"
            >
                <p class="text-sm text-gray-600 mb-2">Your Zakat (2.5%)</p>
                <p id="zakat-result" class="text-4xl font-bold text-green-700">
                    PKR 0
                </p>
                <p id="zakat-status" class="text-sm text-gray-600 mt-2">—</p>
                <p class="text-xs text-gray-500 mt-3">
                    Zakat is due only if your wealth stayed at or above the
                    Nisab for one full lunar year (Hawl).
                </p>
            </div>

            <div class="bg-white p-6 rounded-xl border border-gray-200">
                <h2 class="text-lg font-semibold mb-4">Detailed Breakdown</h2>
                <table class="w-full text-sm">
                    <tbody class="divide-y divide-gray-100">
                        <tr>
                            <td class="py-2 text-gray-600">Total Cash</td>
                            <td
                                id="breakdown-cash"
                                class="py-2 text-right font-medium">PKR 0</td
                            >
                        </tr>
                        <tr>
                            <td class="py-2 text-gray-600">Gold Value</td>
                            <td
                                id="breakdown-gold"
                                class="py-2 text-right font-medium">PKR 0</td
                            >
                        </tr>
                        <tr>
                            <td class="py-2 text-gray-600">Silver Value</td>
                            <td
                                id="breakdown-silver"
                                class="py-2 text-right font-medium">PKR 0</td
                            >
                        </tr>
                        <tr>
                            <td class="py-2 text-gray-600">Investments</td>
                            <td
                                id="breakdown-investments"
                                class="py-2 text-right font-medium">PKR 0</td
                            >
                        </tr>
                        <tr>
                            <td class="py-2 text-gray-600"
                                >Business Inventory</td
                            >
                            <td
                                id="breakdown-business"
                                class="py-2 text-right font-medium">PKR 0</td
                            >
                        </tr>
                        <tr>
                            <td class="py-2 text-gray-600">Receivables</td>
                            <td
                                id="breakdown-receivables"
                                class="py-2 text-right font-medium">PKR 0</td
                            >
                        </tr>
                        <tr class="border-t-2 border-gray-300">
                            <td class="py-2 font-semibold">Total Assets</td>
                            <td
                                id="breakdown-total-assets"
                                class="py-2 text-right font-semibold">PKR 0</td
                            >
                        </tr>
                        <tr>
                            <td class="py-2 text-gray-600">Less: Debts</td>
                            <td
                                id="breakdown-debts"
                                class="py-2 text-right font-medium text-red-600"
                                >PKR 0</td
                            >
                        </tr>
                        <tr class="bg-gray-50">
                            <td class="py-3 font-semibold">Net Wealth</td>
                            <td
                                id="breakdown-net"
                                class="py-3 text-right font-bold text-blue-700"
                                >PKR 0</td
                            >
                        </tr>
                        <tr>
                            <td class="py-2 text-gray-600">Nisab Threshold</td>
                            <td
                                id="breakdown-nisab"
                                class="py-2 text-right font-medium">PKR 0</td
                            >
                        </tr>
                        <tr class="bg-green-50">
                            <td class="py-3 font-semibold">Zakat Due (2.5%)</td>
                            <td
                                id="breakdown-zakat"
                                class="py-3 text-right font-bold text-green-700 text-lg"
                                >PKR 0</td
                            >
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    <!-- SEO Content -->
    <section class="max-w-3xl mx-auto mt-16">
        <h2 class="text-2xl font-bold mb-4">About This Zakat Calculator</h2>
        <p class="text-gray-700 mb-4">
            This free Zakat calculator helps Muslims calculate their annual
            Zakat on cash, gold, silver, savings, investments, business
            inventory, and receivables. It uses the standard Nisab thresholds
            based on gold and silver weights. Everything runs in your browser,
            so your financial data never leaves your device.
        </p>
        <p class="text-gray-700 mb-4">
            Zakat is one of the Five Pillars of Islam, and calculating it
            accurately is important for every eligible Muslim. This tool makes
            that calculation simple, transparent, and private. No signup and no
            data stored on any server.
        </p>

        <h3 class="text-xl font-semibold mt-6 mb-3">What is Zakat?</h3>
        <p class="text-gray-700 mb-4">
            Zakat is an obligatory annual charity of <strong>2.5%</strong> on a Muslim's
            qualifying wealth, provided that wealth reaches the Nisab threshold and
            has been held for one lunar year (Hawl).
        </p>
        <p class="text-gray-700 mb-4">
            Unlike voluntary charity (Sadaqah), Zakat is a religious obligation
            for every Muslim who meets the criteria. It purifies wealth and
            supports those in need within the community.
        </p>

        <h3 class="text-xl font-semibold mt-6 mb-3">Nisab Threshold</h3>
        <p class="text-gray-700 mb-4">
            Nisab is the minimum amount of wealth upon which Zakat becomes
            obligatory:
        </p>
        <ul class="list-disc pl-6 text-gray-700 space-y-2">
            <li>
                <strong>Silver Nisab:</strong> 612.36 grams of silver (≈ 52.5 tola)
            </li>
            <li>
                <strong>Gold Nisab:</strong> 87.48 grams of gold (≈ 7.5 tola)
            </li>
        </ul>
        <p class="text-gray-700 mt-3 mb-4">
            In Pakistan the silver Nisab is commonly used, following the Hanafi
            view, because it is lower and so covers more people. Some scholars
            use the gold Nisab instead. If you are unsure, ask your scholar.
        </p>
        <p class="text-gray-700 mb-4">
            The Nisab in rupees depends on the price of silver or gold, so it
            changes as prices change. The government notifies one fixed Nisab
            each year for Zakat deducted from bank accounts (Rs {
                GOVT_NISAB.toLocaleString("en-US")
            } for {GOVT_NISAB_YEAR}), which can differ from the figure worked
            out from today's price.
        </p>

        <h3 class="text-xl font-semibold mt-6 mb-3">
            How to Use This Calculator
        </h3>
        <ol class="list-decimal pl-6 text-gray-700 space-y-2">
            <li>Choose your Nisab basis (silver or gold)</li>
            <li>Enter your cash in hand and bank accounts</li>
            <li>Enter your gold in grams and today's gold price per gram</li>
            <li>
                Enter your silver in grams and today's silver price per gram
            </li>
            <li>Add any investments, business inventory, and receivables</li>
            <li>Enter any debts that are due now</li>
            <li>
                See your Zakat. It updates as you type, and "Calculate Zakat"
                jumps you to the results.
            </li>
        </ol>

        <h3 class="text-xl font-semibold mt-6 mb-3">
            What Assets Are Zakatable?
        </h3>
        <ul class="list-disc pl-6 text-gray-700 space-y-2">
            <li>
                <strong>Cash in hand and bank accounts:</strong> All money you own,
                whether in a savings account, current account, or in cash.
            </li>
            <li>
                <strong>Gold and silver:</strong> In any form: jewelry, coins, bars,
                or ornaments (scholars differ on jewelry that is worn regularly; see
                the FAQ below).
            </li>
            <li>
                <strong>Investments:</strong> Shares, mutual funds, and other financial
                instruments. Many scholars apply Zakat on the market value of investments
                held to trade or as an investment, and rulings differ for long-term
                holdings, so ask your scholar.
            </li>
            <li>
                <strong>Business inventory:</strong> Stock and goods held for sale.
            </li>
            <li>
                <strong>Receivables:</strong> Money owed to you that you expect to
                receive.
            </li>
        </ul>

        <h3 class="text-xl font-semibold mt-6 mb-3">What Is Not Zakatable?</h3>
        <ul class="list-disc pl-6 text-gray-700 space-y-2">
            <li>Your primary residence</li>
            <li>Your personal vehicle</li>
            <li>Household furniture and appliances</li>
            <li>Personal clothing</li>
            <li>Tools used for your profession</li>
        </ul>

        <h3 class="text-xl font-semibold mt-6 mb-3">Common Use Cases</h3>

        <h4 class="font-semibold mt-4 mb-2">1. Annual Zakat on Savings</h4>
        <p class="text-gray-700 mb-4">
            The most common scenario: you have cash in bank accounts and want to
            calculate Zakat on it. Enter your total savings, and the calculator
            shows the amount due at 2.5%.
        </p>

        <h4 class="font-semibold mt-4 mb-2">2. Zakat on Gold Jewelry</h4>
        <p class="text-gray-700 mb-4">
            If you own gold jewelry, enter the total grams and the current gold
            price per gram. The calculator converts it to value and includes it
            in your total Zakatable wealth.
        </p>

        <h4 class="font-semibold mt-4 mb-2">3. Zakat on Business Assets</h4>
        <p class="text-gray-700 mb-4">
            Business owners need to include cash, inventory, and receivables.
            Debts that are due now can be subtracted before calculating Zakat.
        </p>

        <h4 class="font-semibold mt-4 mb-2">4. Zakat on Investments</h4>
        <p class="text-gray-700 mb-4">
            Enter the current market value of the shares, mutual funds, or other
            investments you want to include, and the calculator adds it to your
            total. Ask your scholar which of your holdings count.
        </p>

        <h4 class="font-semibold mt-4 mb-2">5. Checking Nisab Eligibility</h4>
        <p class="text-gray-700 mb-4">
            If your net wealth is below the Nisab, Zakat is not obligatory. The
            calculator tells you immediately whether you meet the threshold.
        </p>

        <h4 class="font-semibold mt-4 mb-2">6. Ramadan Zakat Planning</h4>
        <p class="text-gray-700 mb-4">
            Many Muslims prefer to pay Zakat during Ramadan. Use this tool to
            calculate your Zakat in advance and plan your giving.
        </p>

        <h3 class="text-xl font-semibold mt-6 mb-3">A Worked Example</h3>
        <p class="text-gray-700 mb-4">
            Here's a sample calculation using the example prices from {
                PRICES_DATE
