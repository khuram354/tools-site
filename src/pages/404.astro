---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found — ToolsSite"
  description="The page you are looking for could not be found."
>
  <div class="max-w-2xl mx-auto text-center py-20">
    <h1 class="text-6xl font-bold text-blue-600 mb-4">404</h1>
    <h2 class="text-2xl font-semibold mb-4">Page Not Found</h2>
    <p class="text-gray-600 mb-8">
      Sorry, the page you're looking for doesn't exist or has been moved.
    </p>
    <div class="flex gap-3 justify-center">
      <a
        href="/"
        class="px-5 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 text-sm font-medium"
      >
        Go Home
      </a>
      <a
        href="/tools"
        class="px-5 py-2 bg-gray-200 text-gray-800 rounded-lg hover:bg-gray-300 text-sm font-medium"
      >
        Browse Tools
      </a>
    </div>
  </div>
</Layout>